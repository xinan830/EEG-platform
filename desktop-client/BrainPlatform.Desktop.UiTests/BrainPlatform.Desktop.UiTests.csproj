<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BrainPlatform.Desktop/BrainPlatform.Desktop.csproj" />
    <Compile Include="../BrainPlatform.Desktop/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <EmbeddedResource Include="../BrainPlatform.Desktop/App.xaml" LogicalName="ProductionApp.xaml" />
  </ItemGroup>
</Project>
