<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BrainPlatform.Desktop.Shared.Controls"
                    xmlns:views="clr-namespace:BrainPlatform.Desktop.Modules.Acquisition.Views">

    <!-- 基础调色板 (对齐示波工作台规范) -->
    <SolidColorBrush x:Key="EegInstrumentInkBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="EegInstrumentMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="EegInstrumentLineBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="EegInstrumentPanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EegInstrumentAccentBrush" Color="#1677FF" />
    <SolidColorBrush x:Key="EegInstrumentActivePillBrush" Color="#E0F2FE" />
    <SolidColorBrush x:Key="EegInstrumentActivePillBorderBrush" Color="#BAE6FD" />
    <SolidColorBrush x:Key="EegInstrumentActivePillTextBrush" Color="#0284C7" />

    <!-- 基础按钮样式 -->
    <Style x:Key="EegInstrumentButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource EegInstrumentInkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F1F5F9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E2E8F0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EegInstrumentPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EegInstrumentButtonStyle}">
        <Setter Property="Background" Value="#EFF6FF" />
        <Setter Property="Foreground" Value="{StaticResource EegInstrumentAccentBrush}" />
        <Setter Property="BorderBrush" Value="#BFDBFE" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="EegInstrumentWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource EegInstrumentButtonStyle}">
        <Setter Property="Foreground" Value="#D97706" />
        <Setter Property="Background" Value="#FEF3C7" />
    </Style>

    <!-- 窗口标题栏控制按钮 (最小化、最大化、关闭) -->
    <Style x:Key="EegCaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#F1F5F9" />
                            <Setter Property="Foreground" Value="#0F172A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#E2E8F0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 窗口标题栏红色关闭按钮 -->
    <Style x:Key="EegCaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource EegCaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#EF4444" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#DC2626" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 顶部导航菜单项样式 -->
    <Style x:Key="EegCaptionMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.12" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                            <Setter Property="Foreground" Value="#0F172A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EegCaptionMenuStyle" TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource EegInstrumentInkBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource EegCaptionMenuItemStyle}" />
    </Style>

    <!-- 顶部大图标功能 Ribbon 按钮样式 (上图下字) -->
    <Style TargetType="{x:Type controls:EegToolButton}">
        <Setter Property="Height" Value="56" />
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="#334155" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EegToolButton}">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{TemplateBinding Glyph}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                            <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F1F5F9" />
                            <Setter Property="Foreground" Value="#0F172A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E2E8F0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 激活选中的 Ribbon 工具按钮 (如标注按钮选中态：浅蓝底+蓝字+浅蓝边框) -->
    <Style x:Key="EegActiveToolButtonStyle" TargetType="{x:Type controls:EegToolButton}">
        <Setter Property="Height" Value="56" />
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{StaticResource EegInstrumentActivePillTextBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{StaticResource EegInstrumentActivePillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EegInstrumentActivePillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EegToolButton}">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{TemplateBinding Glyph}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                            <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#BAE6FD" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 浮动标签参数框控件 (Notched Field: 边框+内嵌置顶小标题) -->
    <Style TargetType="{x:Type controls:EegParameterField}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="86" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource EegInstrumentMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EegParameterField}">
                    <Grid>
                        <!-- 边框槽与内容承载 -->
                        <Border Margin="0,5,0,0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Background="#FFFFFF" Padding="4,0">
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center" />
                        </Border>
                        <!-- 置顶凹槽小标签 -->
                        <Border Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0" Padding="4,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 参数框专用无边框 ComboBox -->
    <Style x:Key="EegParameterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppFilterComboBoxStyle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                              Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="#64748B" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="4,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Slide">
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,3,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.12" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer Margin="3" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 凹槽参数框单选头样式 (走纸速度 / 时间基模式切换) -->
    <Style x:Key="EegParameterFieldRadioHeaderStyle" TargetType="RadioButton">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,3,0" VerticalAlignment="Center"
                                 Stroke="#94A3B8" StrokeThickness="1.2" Fill="Transparent" />
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Stroke" Value="#0284C7" />
                            <Setter TargetName="Dot" Property="Fill" Value="#0284C7" />
                            <Setter Property="Foreground" Value="#0284C7" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Foreground" Value="#64748B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 走纸速度 / 时间基专用带可见性切换的参数框 ComboBox 样式 -->
    <Style x:Key="ReviewPaperSpeedValueStyle" TargetType="ComboBox" BasedOn="{StaticResource EegParameterComboBoxStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPaperSpeedMode}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ReviewTimebaseValueStyle" TargetType="ComboBox" BasedOn="{StaticResource EegParameterComboBoxStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsTimebaseMode}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 底部播放大按钮 (浅蓝方圆底 + 空心蓝三角/暂停图标，精确对齐截图) -->
    <Style x:Key="EegPlayButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="#EAF5FE" />
        <Setter Property="BorderBrush" Value="#CBE6FD" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 空心播放三角图标 (描边 1.6px, 稍带圆角闭合) -->
                            <Path x:Name="PlayIcon"
                                  Data="M 0,0 L 9,6.5 L 0,13 Z"
                                  Stroke="#1677FF" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Fill="Transparent" Width="10" Height="14" Stretch="Uniform" Margin="2,0,0,0" />
                            <!-- 暂停图标 (双条空心/实心) -->
                            <Path x:Name="PauseIcon"
                                  Data="M 0,0 H 3.5 V 13 H 0 Z M 6.5,0 H 10 V 13 H 6.5 Z"
                                  Fill="#1677FF" Width="10" Height="13" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter TargetName="PlayIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PauseIcon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D6ECFD" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#99CEFA" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#BAE0FD" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 底部极简快退/步进/快进图标按钮 (深灰蓝线条描边图标) -->
    <Style x:Key="EegTransportNavButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工作区外壳模板 -->
    <Style x:Key="EegInstrumentShellStyle" TargetType="{x:Type views:EegWorkspaceShell}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:EegWorkspaceShell}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0" Content="{TemplateBinding TopBar}" />
                        <ContentPresenter Grid.Row="1" Content="{TemplateBinding Waveform}" DataContext="{TemplateBinding WaveformDataContext}" />
                        <Border x:Name="Transport" Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,6" MinHeight="44">
                            <ContentPresenter Content="{TemplateBinding BottomBar}" />
                        </Border>
                        <ContentPresenter Grid.RowSpan="3" Panel.ZIndex="10" Content="{TemplateBinding Overlay}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowBottomBar" Value="False">
                            <Setter TargetName="Transport" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

