<Window x:Class="BrainPlatform.Desktop.Shared.Dialogs.OperationConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 弹窗右上角精致关闭按钮样式 -->
            <Style x:Key="DialogCloseIconButton" TargetType="Button" BasedOn="{StaticResource AppDialogCloseButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗底部取消按钮样式 -->
            <Style x:Key="DialogCancelButton" TargetType="Button" BasedOn="{StaticResource AppDialogSecondaryButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="MinWidth" Value="80" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#D0D7DE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗底部确认按钮样式（主色蓝） -->
            <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource AppDialogDangerButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="BorderBrush" Value="#2563EB" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1E40AF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 居中浮层卡片外框（外边距为阴影预留充足空间） -->
    <Border Width="470" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
            Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.18" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0. 顶部标题栏 -->
                <RowDefinition Height="Auto" /> <!-- 1. 主体内容区（左侧圆标+右侧说明） -->
                <RowDefinition Height="1" />    <!-- 2. 全宽下划分割线 -->
                <RowDefinition Height="Auto" /> <!-- 3. 底部操作栏 -->
            </Grid.RowDefinitions>

            <!-- 0. 顶部标题与右上角关闭 X 按钮 -->
            <Grid Grid.Row="0" Margin="24,20,18,0">
                <TextBlock Text="提示" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                <Button Style="{StaticResource DialogCloseIconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsCancel="True" ToolTip="关闭">
                    <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="11" Height="11" Stretch="Uniform"
                          Stroke="#94A3B8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <!-- 1. 主体内容区：左侧蓝色 i 柔光圆形徽标 + 右侧问题标题与说明文本 -->
            <Grid Grid.Row="1" Margin="24,18,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 蓝色信息圆形徽标 -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0" VerticalAlignment="Top">
                    <Border.Background>
                        <RadialGradientBrush Center="0.4,0.35" GradientOrigin="0.3,0.25" RadiusX="0.65" RadiusY="0.65">
                            <GradientStop Color="#EFF6FF" Offset="0.0" />
                            <GradientStop Color="#DBEAFE" Offset="0.65" />
                            <GradientStop Color="#BFDBFE" Offset="1.0" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <TextBlock Text="i" FontFamily="Georgia, Times New Roman, serif" FontStyle="Italic" FontWeight="Bold"
                               FontSize="25" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-3,0,0" />
                </Border>

                <!-- 右侧文本区域 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TitleText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#1E293B" LineHeight="23" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MessageText}" Margin="0,8,0,0" FontSize="13" LineHeight="20"
                               Foreground="#64748B" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- 2. 全宽下划分割线 -->
            <Border Grid.Row="2" Height="1" Background="#F1F5F9" />

            <!-- 3. 底部操作栏（取消 + 确认按钮） -->
            <Border Grid.Row="3" Padding="24,14,24,16" Background="#FFFFFF" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 取消按钮 -->
                    <Button Style="{StaticResource DialogCancelButton}"
                            Content="取消"
                            IsCancel="True"
                            Margin="0,0,12,0"
                            ToolTip="取消" />

                    <!-- 确认按钮 -->
                    <Button Style="{StaticResource DialogDangerButton}"
                            Content="{Binding ConfirmText}"
                            IsDefault="True"
                            Click="OnConfirmClick"
                            ToolTip="{Binding ConfirmText}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
