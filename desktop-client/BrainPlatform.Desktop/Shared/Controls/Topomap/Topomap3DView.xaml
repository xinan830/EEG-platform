<UserControl x:Class="BrainPlatform.Desktop.Shared.Controls.Topomap.Topomap3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F8FAFC" ClipToBounds="True">
        <Viewport3D x:Name="SurfaceViewport" ClipToBounds="True"
                    MouseDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
                    MouseUp="OnViewportMouseUp" MouseWheel="OnViewportMouseWheel"
                    SizeChanged="OnViewportSizeChanged">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" Position="0,0.18,-1.7" LookDirection="0,-0.08,1"
                                   UpDirection="0,1,0" FieldOfView="42" />
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#7D8590" />
                        <DirectionalLight Color="#FFFFFF" Direction="-0.4,-0.7,1" />
                        <DirectionalLight Color="#D8E2EE" Direction="0.5,0.4,-0.8" />
                        <Model3DGroup x:Name="SceneRoot">
                            <Model3DGroup x:Name="StaticSceneRoot" />
                            <Model3DGroup x:Name="SelectedMarkerRoot" />
                        </Model3DGroup>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

        <!-- 3D-Projected Electrode Name Labels (auto backface-culled) -->
        <Canvas x:Name="ElectrodeLabelOverlay" IsHitTestVisible="False" ClipToBounds="True" />

        <!-- Top-left metadata card -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Background="#E8FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="10,7" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="BandText" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
                <TextBlock x:Name="WindowText" FontSize="11" Foreground="#475569" Margin="0,2,0,0" />
                <TextBlock Text="标准模板可视化 · 非个体定位" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Top-right Reset View Button -->
        <Button x:Name="ResetViewButton" Content="复位视角" Click="OnResetViewClick"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Cursor="Hand" Padding="12,6" FontSize="12" FontWeight="Medium"
                Foreground="#1E293B" Background="#F2FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                ToolTip="平滑恢复初始正视视角">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12 4 A 8 8 0 1 0 19.3 15 M 19 4 L 19 9 L 14 9"
                                  Stroke="#2563EB" StrokeThickness="1.7" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#EFF6FF" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#93C5FD" />
                            <Setter Property="Foreground" Value="#1D4ED8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#DBEAFE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Bottom-left Interaction Hint Pill -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                Background="#DCFFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="14" Padding="12,5" IsHitTestVisible="False">
            <TextBlock Text="左键拖动：旋转  ·  Shift + 左键：平移  ·  滚轮：缩放"
                       FontSize="11" Foreground="#475569" />
        </Border>

        <TextBlock x:Name="UnavailableText" Text="等待头模" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="#64748B" FontSize="14"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
