<UserControl x:Class="BrainPlatform.Desktop.Shared.Controls.Topomap.Topomap3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TopomapOverlayActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#93C5FD" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="#F8FAFC" ClipToBounds="True">
        <Viewport3D x:Name="SurfaceViewport" ClipToBounds="True"
                    MouseDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
                    MouseUp="OnViewportMouseUp" MouseWheel="OnViewportMouseWheel"
                    SizeChanged="OnViewportSizeChanged">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" Position="0,0.18,-1.7" LookDirection="0,-0.08,1"
                                   UpDirection="0,1,0" FieldOfView="42" />
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#8A929E" />
                        <DirectionalLight Color="#FFFFFF" Direction="-0.4,-0.7,1" />
                        <DirectionalLight Color="#DCE5F0" Direction="0.5,0.4,-0.8" />
                        <Model3DGroup x:Name="SceneRoot">
                            <Model3DGroup x:Name="StaticSceneRoot" />
                            <Model3DGroup x:Name="SelectedMarkerRoot" />
                        </Model3DGroup>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

        <!-- 3D-Projected Electrode Name Labels (auto backface-culled, transparent background) -->
        <Canvas x:Name="ElectrodeLabelOverlay" IsHitTestVisible="False" ClipToBounds="True" />

        <!-- Top-right Action Bar (Heatmap Preset / Colormap Switcher + Reset View Button) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
            <Button x:Name="PresetCycleButton" Content="分布：枕叶 Alpha" Click="OnCyclePresetClick"
                    Style="{StaticResource TopomapOverlayActionButtonStyle}" Margin="0,0,8,0"
                    Visibility="Collapsed" ToolTip="切换 3D 地形图示意脑区分布并自动转向对应脑区" />
            <Button x:Name="ColormapCycleButton" Content="色带：Turbo" Click="OnCycleColormapClick"
                    Style="{StaticResource TopomapOverlayActionButtonStyle}" Margin="0,0,8,0"
                    Visibility="Collapsed" ToolTip="切换 3D 地形图热力色带 (Turbo / Jet / RdBu / Viridis)" />
            <Button x:Name="ResetViewButton" Click="OnResetViewClick"
                    Style="{StaticResource TopomapOverlayActionButtonStyle}"
                    ToolTip="平滑恢复初始正视视角">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 12 4 A 8 8 0 1 0 19.3 15 M 19 4 L 19 9 L 14 9"
                          Stroke="#2563EB" StrokeThickness="1.7" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="复位视角" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Right Vertical Colorbar (visible in 3D Topomap preview or real Field mode) -->
        <Border x:Name="ColorbarCard" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,48,14,48" Background="#EBFFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="10" Padding="10,10" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="ColorbarUnitText" Text="示意强度" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155"
                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                <Grid Height="168">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ColorbarGradientBar" Grid.Column="0" Width="14" CornerRadius="4"
                            BorderBrush="#CBD5E1" BorderThickness="1" />
                    <Grid Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock x:Name="ColorbarMaxText" Text="1.0 高" FontSize="10" Foreground="#334155" VerticalAlignment="Top" />
                        <TextBlock x:Name="ColorbarMidText" Text="0.5 中" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock x:Name="ColorbarMinText" Text="0.0 低" FontSize="10" Foreground="#334155" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom-left Interaction Hint Pill -->
        <Border x:Name="InteractionHintPill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                Background="#DCFFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="14" Padding="12,5" IsHitTestVisible="False">
            <TextBlock Text="左键拖动：旋转  ·  Shift + 左键：平移  ·  滚轮：缩放"
                       FontSize="11" Foreground="#475569" />
        </Border>

        <TextBlock x:Name="UnavailableText" Text="等待头模" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="#64748B" FontSize="14"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
