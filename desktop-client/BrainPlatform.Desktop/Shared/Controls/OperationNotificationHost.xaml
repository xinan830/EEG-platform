<UserControl x:Class="BrainPlatform.Desktop.Shared.Controls.OperationNotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             IsHitTestVisible="True">
    <Border MinWidth="320" MaxWidth="600" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
            Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
            Padding="12,0,12,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#0F172A" Opacity="0.08" />
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Notifications.IsVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel LastChildFill="True">
            <!-- 1. 左侧状态圆圈图标 (26x26) -->
            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Margin="0,0,12,0" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Notifications.Kind}" Value="Information"><Setter Property="Background" Value="#DBEAFE" /></DataTrigger>
                            <DataTrigger Binding="{Binding Notifications.Kind}" Value="Warning"><Setter Property="Background" Value="#FEF3C7" /></DataTrigger>
                            <DataTrigger Binding="{Binding Notifications.Kind}" Value="Error"><Setter Property="Background" Value="#FEE2E2" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 成功勾选 (圆角笔画平滑矢量勾) -->
                    <Path Data="M 1.5,5.5 L 4.8,9 L 11.5,2.2"
                          Stroke="#10B981" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="12" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.Kind}" Value="Information"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Notifications.Kind}" Value="Warning"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Notifications.Kind}" Value="Error"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- 信息提示 -->
                    <TextBlock Text="i" FontFamily="Georgia, serif" FontStyle="Italic" FontWeight="Bold"
                               FontSize="15" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.Kind}" Value="Information"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 警告注意 -->
                    <TextBlock Text="!" FontFamily="Segoe UI, sans-serif" FontWeight="Bold"
                               FontSize="15" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.Kind}" Value="Warning"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 错误失败 -->
                    <Path Data="M 2,2 L 8.5,8.5 M 8.5,2 L 2,8.5"
                          Stroke="#DC2626" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="8.5" Height="8.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.Kind}" Value="Error"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Border>

            <!-- 2. 右侧关闭按钮 (22x22) -->
            <Border DockPanel.Dock="Right" Width="22" Height="22"
                    Background="Transparent" CornerRadius="4"
                    VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="关闭提示" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding DismissNotificationCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Path Data="M 1,1 L 9,9 M 9,1 L 1,9"
                      Width="9" Height="9" Stretch="Uniform"
                      Stroke="#94A3B8" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- 3. 中间单行文字（状态标签 + 空格 + 详细消息） -->
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Notifications.KindLabel, Mode=OneWay}" FontWeight="Medium" Foreground="#1E293B" FontSize="13.5" />
                <Run Text=" " />
                <Run Text="{Binding Notifications.Message, Mode=OneWay}" Foreground="#1E293B" FontSize="13.5" />
            </TextBlock>
        </DockPanel>
    </Border>
</UserControl>
