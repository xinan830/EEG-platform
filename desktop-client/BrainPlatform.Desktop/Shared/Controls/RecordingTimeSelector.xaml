<UserControl x:Class="BrainPlatform.Desktop.Shared.Controls.RecordingTimeSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TimeSegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="Transparent" CornerRadius="3" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#0369A1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#E0F2FE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="2">
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="记录时间" Style="{StaticResource TimeSegmentStyle}"
                         IsChecked="{Binding IsRecordTime, Mode=TwoWay}" ToolTip="从记录起点开始的秒数" />
            <RadioButton Content="采集时间" Style="{StaticResource TimeSegmentStyle}"
                         IsChecked="{Binding IsClockTime, Mode=TwoWay}" IsEnabled="{Binding CanShowClock}"
                         ToolTip="{Binding ClockAvailabilityText}" ToolTipService.ShowOnDisabled="True" />
        </StackPanel>
    </Border>
</UserControl>
