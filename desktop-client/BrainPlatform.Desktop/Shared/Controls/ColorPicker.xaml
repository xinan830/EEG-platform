<UserControl x:Class="BrainPlatform.Desktop.Shared.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Picker" Unloaded="OnPickerUnloaded">
    <UserControl.Resources>
        <Style x:Key="SwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <WrapPanel VerticalAlignment="Center">
        <StackPanel x:Name="InlineSwatches" Orientation="Horizontal" VerticalAlignment="Center" />
        <TextBox x:Name="InlineHex" Width="98" Height="32" Margin="8,0" Padding="8,0"
                 VerticalContentAlignment="Center" MaxLength="7" FontSize="13"
                 Text="{Binding SelectedColor, ElementName=Picker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="颜色值 #RRGGBB" />
        <Button x:Name="OpenButton" Width="42" Height="32" Padding="5" Click="OnOpenClick"
                Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"
                ToolTip="选择颜色" AutomationProperties.Name="选择颜色">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Border x:Name="SelectedPreview" CornerRadius="4" BorderThickness="1" BorderBrush="#CBD5E1" />
        </Button>
        <Popup x:Name="CustomColorPopup" PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
            <Border Width="322" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="颜色" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12" />
                    <WrapPanel x:Name="PopupSwatches" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="PickerColorPreview" Width="32" Height="32" CornerRadius="5"
                                BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Left" />
                        <TextBox x:Name="CustomHex" Grid.Column="1" Height="32" MaxLength="7" Padding="8,0"
                                 VerticalContentAlignment="Center" TextChanged="OnHexChanged" ToolTip="颜色值 #RRGGBB" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <TextBlock Text="R" Foreground="#DC2626" VerticalAlignment="Center" />
                        <Slider x:Name="RedColorSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnRgbChanged" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RedColorSlider, StringFormat=F0}" TextAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <TextBlock Text="G" Foreground="#16A34A" VerticalAlignment="Center" />
                        <Slider x:Name="GreenColorSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnRgbChanged" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GreenColorSlider, StringFormat=F0}" TextAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <TextBlock Text="B" Foreground="#2563EB" VerticalAlignment="Center" />
                        <Slider x:Name="BlueColorSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnRgbChanged" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=BlueColorSlider, StringFormat=F0}" TextAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="ColorError" Text="请输入 #RRGGBB 格式的颜色" Foreground="#DC2626"
                               FontSize="12" Margin="0,0,0,10" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Click="OnCancelClick" Padding="12,5" Margin="0,0,8,0"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1" />
                        <Button x:Name="ApplyButton" Content="应用颜色" Click="OnApplyClick" Padding="12,5"
                                Background="#2563EB" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </WrapPanel>
</UserControl>
