<UserControl x:Class="BrainPlatform.Desktop.Modules.Review.Views.ReviewScalarAnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Analysis"
             xmlns:review="clr-namespace:BrainPlatform.Desktop.Modules.Review.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/AnalysisStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <shared:AnalysisPanelShell Title="" CloseCommand="{Binding CloseAnalysisCommand}"
                               StatusText="{Binding ActiveScalarAnalysis.StatusText}">
        <shared:AnalysisPanelShell.HeaderContent>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding ActiveScalarParameters.Channels}"
                          SelectedItem="{Binding ActiveScalarParameters.Channel}"
                          Style="{StaticResource AppFilterComboBoxStyle}" Height="32" MinWidth="105"
                          VerticalAlignment="Center" ToolTip="输入通道" />
                <ComboBox Margin="6,0,0,0" ItemsSource="{Binding ActiveScalarParameters.SecondaryChannels}"
                          SelectedItem="{Binding ActiveScalarParameters.SecondaryChannel}"
                          Style="{StaticResource AppFilterComboBoxStyle}" Height="32" MinWidth="105"
                          VerticalAlignment="Center" ToolTip="第二输入通道"
                          Visibility="{Binding HasSecondaryScalarChannel, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </shared:AnalysisPanelShell.HeaderContent>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <review:ReviewScalarTrendChart Grid.Row="0" MinHeight="180"
                Points="{Binding ActiveScalarAnalysis.Points}"
                Unit="{Binding ActiveScalarAnalysis.Unit}"
                StartSeconds="{Binding AnalysisPanelStartSeconds}"
                EndSeconds="{Binding PositionSeconds}" />
            <TextBlock Grid.Row="1" Text="{Binding ActiveScalarAnalysis.SourceText}"
                       Foreground="#64748B" FontSize="11" Margin="2,4,0,0" />
        </Grid>
    </shared:AnalysisPanelShell>
</UserControl>
