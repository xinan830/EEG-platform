<UserControl x:Class="BrainPlatform.Desktop.Modules.Review.Views.ReviewCustomFrequencyInspectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Analysis"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Modules.Review.Views"
             xmlns:vm="clr-namespace:BrainPlatform.Desktop.Modules.Review.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/AnalysisStyles.xaml" />
                <ResourceDictionary Source="ReviewCustomFrequencyStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FrequencyStepButtonStyle" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Delay" Value="350" />
                <Setter Property="Interval" Value="90" />
                <Setter Property="Foreground" Value="#8492A6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF" />
                                    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 频段数值精细输入框样式 (复刻 HTML 的 .input: width 88, border #D8E2F1, radius 8) -->
            <Style x:Key="CustomFrequencyInputStyle" TargetType="TextBox">
                <Setter Property="Width" Value="88" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextInkBrush}" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#D8E2F1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" SnapsToDevicePixels="True">
                                <Grid Margin="4,3,3,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                    <Grid x:Name="StepButtons" Grid.Column="1" Visibility="Hidden"
                                          IsEnabled="{Binding HasBins}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <RepeatButton x:Name="IncreaseFrequency" Tag="1" Style="{StaticResource FrequencyStepButtonStyle}"
                                                      Click="OnFrequencyStepClick" ToolTip="下一个频点" AutomationProperties.Name="增加频率">
                                            <Path Data="M 0,4 L 3.5,0 L 7,4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
                                        </RepeatButton>
                                        <RepeatButton x:Name="DecreaseFrequency" Grid.Row="1" Tag="-1" Style="{StaticResource FrequencyStepButtonStyle}"
                                                      Click="OnFrequencyStepClick" ToolTip="上一个频点" AutomationProperties.Name="减少频率">
                                            <Path Data="M 0,0 L 7,0 L 3.5,4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
                                        </RepeatButton>
                                    </Grid>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="#93C5FD" />
                                    <Setter TargetName="StepButtons" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="StepButtons" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
                                    <Setter TargetName="InputBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#1D67E9" BlurRadius="4" ShadowDepth="0" Opacity="0.18" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <shared:AnalysisPanelShell Title="" CloseCommand="{Binding CloseAnalysisCommand}" StatusText="">
        <!-- 顶部工具栏胶囊区域 (复刻 HTML 的 .controls) -->
        <shared:AnalysisPanelShell.HeaderContent>
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="自定义频段" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextInkBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Border Height="16" Width="1" Background="#E2E8F0" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <!-- 分析模式切换 -->
                    <TextBlock Text="分析模式" FontSize="12" FontWeight="SemiBold" Foreground="#5E718E"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ModeSelector" SelectedValuePath="Tag"
                              SelectedValue="{Binding CustomFrequencyInspection.Mode, Mode=TwoWay}"
                              Style="{StaticResource AppFilterComboBoxStyle}" Width="124" Height="32"
                              AutomationProperties.Name="频率选择模式">
                        <ComboBoxItem Content="单频点" Tag="{x:Static vm:ReviewCustomFrequencyMode.SingleFrequency}" />
                        <ComboBoxItem Content="自定义范围" Tag="{x:Static vm:ReviewCustomFrequencyMode.Range}" />
                    </ComboBox>

                    <Border Height="20" Width="1" Background="{StaticResource PanelBorderBrush}" Margin="16,0" VerticalAlignment="Center" />

                    <!-- 单频点输入区域 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                DataContext="{Binding CustomFrequencyInspection}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:ReviewCustomFrequencyMode.Range}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="当前频率" FontSize="12" FontWeight="SemiBold" Foreground="#5E718E"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="FrequencyInput" Style="{StaticResource CustomFrequencyInputStyle}"
                                 Text="{Binding SelectedFrequencyHz, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnExceptions=True}"
                                 PreviewKeyDown="OnFrequencyInputKeyDown" AutomationProperties.Name="单频点 Hz" />
                        <TextBlock Text="Hz" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="6,0,12,0" />
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActualFrequencyHz, StringFormat=实际 {0:0.###} Hz, TargetNullValue=频点不可用}"
                                       Foreground="#0284C7" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- 自定义范围输入区域 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                DataContext="{Binding CustomFrequencyInspection}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:ReviewCustomFrequencyMode.Range}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="频率范围" FontSize="12" FontWeight="SemiBold" Foreground="#5E718E"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="RangeLowInput" Style="{StaticResource CustomFrequencyInputStyle}"
                                 Text="{Binding RangeLowHz, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnExceptions=True}"
                                 PreviewKeyDown="OnFrequencyInputKeyDown" AutomationProperties.Name="范围起点 Hz" />
                        <TextBlock Text="—" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" />
                        <TextBox x:Name="RangeHighInput" Style="{StaticResource CustomFrequencyInputStyle}"
                                 Text="{Binding RangeHighHz, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnExceptions=True}"
                                 PreviewKeyDown="OnFrequencyInputKeyDown" AutomationProperties.Name="范围终点 Hz" />
                        <TextBlock Text="Hz" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 右侧时间窗口小胶囊 -->
                <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="12" Padding="10,4"
                        VerticalAlignment="Center" ToolTip="{Binding CustomFrequencyInspection.ProvenanceText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="11"
                                   Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding CustomFrequencyInspection.WindowText}" FontSize="11"
                                   Foreground="#475569" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </shared:AnalysisPanelShell.HeaderContent>

        <!-- 主体区域：左右双栏黄金分割 38% : 62% (复刻 HTML 的 .layout) -->
        <Grid DataContext="{Binding CustomFrequencyInspection}" Margin="12,6,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38*" MinWidth="390" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="62*" MinWidth="460" />
                </Grid.ColumnDefinitions>

                <!-- 左侧面板：通道数据表格卡片 (~38%) -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 卡片表头：标题与当前频段上下文胶囊 -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource TableDividerBrush}"
                                BorderThickness="0,0,0,1" Padding="16,0">
                            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                <TextBlock Text="通道数据" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextInkBrush}" VerticalAlignment="Center" />
                                <Border DockPanel.Dock="Right" Background="#EDF4FF" CornerRadius="6"
                                        Padding="8,3" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Foreground="{StaticResource BrandBlueBrush}" FontWeight="Bold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:ReviewCustomFrequencyMode.Range}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:0.00}–{1:0.00} Hz">
                                                    <Binding Path="RangeLowHz" />
                                                    <Binding Path="RangeHighHz" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource BrandBlueBrush}" FontWeight="Bold" FontSize="12"
                                                   Text="{Binding ActualFrequencyHz, StringFormat={}{0:0.00} Hz, TargetNullValue=频点不可用}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:ReviewCustomFrequencyMode.Range}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- 表格 (保持 DataGridTextColumn 保证契约测试与极速虚拟化渲染) -->
                        <DataGrid Grid.Row="1" x:Name="ChannelTable" ItemsSource="{Binding Rows}"
                                  SelectedValuePath="Channel" SelectedValue="{Binding SelectedChannel, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                                  CanUserResizeRows="False" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0" FrozenColumnCount="1"
                                  Background="#FFFFFF" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource TableDividerBrush}"
                                  ColumnHeaderHeight="48"
                                  ColumnHeaderStyle="{StaticResource CustomFreqNumericHeaderStyle}"
                                  CellStyle="{StaticResource CustomFreqDataGridCellStyle}"
                                  RowStyle="{StaticResource CustomFreqDataGridRowStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  AutomationProperties.Name="自定义频段逐导联数值">
                            <DataGrid.Columns>
                                <!-- 1. 通道 (左对齐) -->
                                <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="92"
                                                    HeaderStyle="{StaticResource CustomFreqChannelHeaderStyle}"
                                                    ElementStyle="{StaticResource CustomFreqChannelCellStyle}" />

                                <!-- 2. 等效 RMS (µV) -->
                                <DataGridTextColumn Header="等效 RMS&#x0a;(µV)"
                                                    Binding="{Binding AmplitudeRmsUv, StringFormat=F2, TargetNullValue=—}"
                                                    HeaderStyle="{StaticResource CustomFreqNumericHeaderStyle}"
                                                    ElementStyle="{StaticResource CustomFreqNumericCellStyle}" Width="108" />

                                <!-- 3. 绝对功率 (µV²) -->
                                <DataGridTextColumn Header="绝对功率&#x0a;(µV²)"
                                                    Binding="{Binding AbsolutePowerUv2, StringFormat=F2, TargetNullValue=—}"
                                                    HeaderStyle="{StaticResource CustomFreqNumericHeaderStyle}"
                                                    ElementStyle="{StaticResource CustomFreqNumericCellStyle}" Width="108" />

                                <!-- 4. 相对功率 (%) -->
                                <DataGridTextColumn Header="相对功率&#x0a;(%)"
                                                    Binding="{Binding RelativePowerPercent, StringFormat=F2, TargetNullValue=—}"
                                                    HeaderStyle="{StaticResource CustomFreqNumericHeaderStyle}"
                                                    ElementStyle="{StaticResource CustomFreqNumericCellStyle}" Width="108" />

                                <!-- 5. 功率谱密度 (µV²/Hz) -->
                                <DataGridTextColumn Header="PSD&#x0a;(µV²/Hz)"
                                                    Binding="{Binding PsdDensityUv2PerHz, StringFormat=F2, TargetNullValue=—}"
                                                    HeaderStyle="{StaticResource CustomFreqNumericHeaderStyle}"
                                                    ElementStyle="{StaticResource CustomFreqNumericCellStyle}" Width="116" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 拖拽分割栏 -->
                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="Transparent" ShowsPreview="True" ResizeBehavior="PreviousAndNext"
                              ToolTip="调整左右面板宽度" AutomationProperties.Name="调整表格与频谱宽度" />

                <!-- 右侧面板：PSD 频谱图卡片 (~62%) -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 频谱图表头 -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource TableDividerBrush}"
                                BorderThickness="0,0,0,1" Padding="18,0">
                            <TextBlock Text="PSD 频谱图" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextInkBrush}" VerticalAlignment="Center" />
                        </Border>

                        <!-- 科学图表主体 (SciChart) -->
                        <views:ReviewCustomFrequencyChart x:Name="FrequencyChart" Grid.Row="1" Model="{Binding}"
                                                          MinHeight="220" Margin="10,6"
                                                          AutomationProperties.Name="自定义频率 PSD 曲线" />

                    </Grid>
                </Border>
            </Grid>

            <!-- 底部轻量辅助状态信息 -->
            <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                       FontSize="11" Foreground="#94A3B8" Margin="4,8,4,0" TextTrimming="CharacterEllipsis" />
        </Grid>
    </shared:AnalysisPanelShell>
</UserControl>
