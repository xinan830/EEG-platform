<UserControl x:Class="BrainPlatform.Desktop.Modules.Review.Views.PsdReviewAnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Analysis"
             xmlns:psd="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Psd"
             xmlns:topomap="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Topomap">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/AnalysisStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <shared:AnalysisPanelShell Title="" CloseCommand="{Binding CloseAnalysisCommand}"
                               StatusText="{Binding AnalysisPreparationText}">
        <shared:AnalysisPanelShell.HeaderContent>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding PsdAnalysis.Channels}"
                          SelectedItem="{Binding PsdAnalysis.SelectedChannel, UpdateSourceTrigger=PropertyChanged}"
                          Height="32" MinWidth="120" VerticalAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource AppFilterComboBoxStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PsdAnalysis.IsTopomapSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <ComboBox ItemsSource="{Binding PsdAnalysis.ViewOptions}"
                          SelectedItem="{Binding PsdAnalysis.SelectedView, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource AppFilterComboBoxStyle}" Height="32" MinWidth="120"
                          Margin="8,0,0,0" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding PsdAnalysis.FrequencyOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Index"
                          SelectedValue="{Binding PsdAnalysis.SelectedFrequencyIndex, UpdateSourceTrigger=PropertyChanged}"
                          Height="32" MinWidth="110"
                          Margin="8,0,0,0" VerticalAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource AppFilterComboBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PsdAnalysis.IsTopomapSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </StackPanel>
        </shared:AnalysisPanelShell.HeaderContent>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <psd:PsdSpectrumChart Grid.Row="0" MinHeight="180" Points="{Binding PsdAnalysis.Points}"
                                  Unit="{Binding PsdAnalysis.ValueUnit}">
                <psd:PsdSpectrumChart.Style>
                    <Style TargetType="psd:PsdSpectrumChart">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PsdAnalysis.IsTopomapSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </psd:PsdSpectrumChart.Style>
            </psd:PsdSpectrumChart>
            <topomap:TopomapCanvas Grid.Row="0" Field="{Binding PsdAnalysis.TopomapField}"
                                   ColorScaleState="{Binding PsdAnalysis.TopomapColorScales}">
                <topomap:TopomapCanvas.Style>
                    <Style TargetType="topomap:TopomapCanvas">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PsdAnalysis.IsTopomapSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </topomap:TopomapCanvas.Style>
            </topomap:TopomapCanvas>
            <TextBlock Grid.Row="1" Text="{Binding PsdAnalysis.StatusText}" TextWrapping="Wrap"
                       Foreground="#64748B" FontSize="11" Margin="2,4,0,0" />
        </Grid>
    </shared:AnalysisPanelShell>
</UserControl>
