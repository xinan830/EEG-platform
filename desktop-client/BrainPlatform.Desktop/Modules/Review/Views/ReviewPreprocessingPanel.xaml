<UserControl x:Class="BrainPlatform.Desktop.Modules.Review.Views.ReviewPreprocessingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Analysis"
             Background="#F8FAFC">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <shared:AnalysisPanelShell Title="科学预处理"
                               StatusText="{Binding Preprocessing.ActiveSummaryBadge}"
                               CloseCommand="{Binding CloseAnalysisCommand}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10,12,16">
            <StackPanel DataContext="{Binding Preprocessing}">
                <!-- 顶部状态与重置 -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#1E3A8A" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="重置" Command="{Binding ResetAllCommand}" Margin="8,0,0,0"
                                Padding="10,4" FontSize="11.5" Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#334155" />
                    </Grid>
                </Border>

                <!-- 卡片 1：坏导检测与处理 -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="1. 坏导检测与修复（重参考前）" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="坏导体检" Command="{Binding InspectBadChannelsCommand}"
                                    Padding="10,4" FontSize="12" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" />
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="处理策略" Foreground="#475569" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding BadChannelPolicy, Mode=TwoWay}" FontSize="12">
                                <ComboBoxItem Content="不处理 (none)" Tag="none" />
                                <ComboBoxItem Content="球面样条插值修复 (interpolate)" Tag="interpolate" />
                                <ComboBoxItem Content="重参考前排除 (exclude)" Tag="exclude" />
                            </ComboBox>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding BadChannelRows}" MaxHeight="160">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" Margin="0,2" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid ToolTip="{Binding MetricsSummary}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#DC2626" Margin="0,0,4,0"
                                                         Visibility="{Binding IsBadCandidate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding Channel}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ReasonsSummary}" FontSize="11.5" Foreground="#64748B"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 卡片 2：坏段质控 -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#D97706" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="2. 坏段质控（爆幅 / EMG 肌电）" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="扫描坏段" Command="{Binding InspectArtifactSegmentsCommand}"
                                    Padding="10,4" FontSize="12" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" />
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="爆幅阈值 (µV)" Foreground="#64748B" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding PeakToPeakUv, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontSize="12" Padding="6,3" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="肌电 z-score 阈值" Foreground="#64748B" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding MuscleZScoreThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontSize="12" Padding="6,3" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ArtifactPolicy, Mode=TwoWay}" FontSize="12" Margin="0,0,8,0">
                                <ComboBoxItem Content="不处理 (none)" Tag="none" />
                                <ComboBoxItem Content="仅标注区间 (annotate)" Tag="annotate" />
                                <ComboBoxItem Content="掩码为 NaN 剔除 (reject)" Tag="reject" />
                            </ComboBox>
                            <CheckBox Grid.Column="1" Content="波形显示色带" IsChecked="{Binding ShowArtifactBandsOnWaveform, Mode=TwoWay}"
                                      VerticalAlignment="Center" FontSize="11.5" Foreground="#334155" />
                        </Grid>

                        <TextBlock Text="{Binding CleanRatioSummary}" FontSize="11.5" Foreground="#475569" Margin="0,0,0,6" />

                        <ItemsControl ItemsSource="{Binding ArtifactSegments}" MaxHeight="160">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.JumpToSegmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,2"
                                            Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Cursor="Hand"
                                            ToolTip="{Binding TooltipText}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ReasonLabel}" FontWeight="SemiBold" FontSize="11.5" Foreground="#B45309" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding TimeRangeText}" FontSize="11.5" Foreground="#0F172A" />
                                                <TextBlock Text="{Binding ChannelsSummary}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 卡片 3：离线去伪迹（ICA 审查 + 叠图对比） -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="#0891B2" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="3. 眼电/心电去伪迹与叠图对比" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" SelectedValuePath="Tag" SelectedValue="{Binding RemovalMethod, Mode=TwoWay}" FontSize="12">
                                <ComboBoxItem Content="不启用去伪迹 (none)" Tag="none" />
                                <ComboBoxItem Content="可审查 Infomax ICA (推荐)" Tag="ica_infomax" />
                                <ComboBoxItem Content="MNE SSP 眼电投影" Tag="ssp_eog" />
                                <ComboBoxItem Content="EOG 回归（需专用 EOG）" Tag="eog_regression" />
                            </ComboBox>
                            <TextBox Grid.Column="2" Text="{Binding IcaComponentCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     FontSize="12" Padding="6,3" ToolTip="ICA 成分数（默认 15）" />
                        </Grid>

                        <CheckBox Content="无专用 EOG 时允许使用前额 Fp1/Fp2 作为代理"
                                  IsChecked="{Binding AllowFrontalEogProxy, Mode=TwoWay}"
                                  FontSize="11.5" Foreground="#475569" Margin="0,0,0,8" />

                        <Button x:Name="OpenIcaReviewButton" Content="拟合 ICA 并打开 2D 头皮热力图审查弹窗"
                                Click="OnOpenIcaReviewClick" Padding="12,7" FontSize="12.5" FontWeight="SemiBold"
                                Background="#0F172A" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,0,8" Cursor="Hand" />

                        <TextBlock Text="{Binding IcaSummaryText}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding ArtifactRemovalScopeNotice}" FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <CheckBox Content="开启主波形「原波形(浅灰) vs 清洗后(深色/青虚线)」叠图对比"
                                          IsChecked="{Binding IsOverlayCompareEnabled, Mode=TwoWay}"
                                          FontWeight="SemiBold" FontSize="12" Foreground="#0F766E" />
                                <TextBlock Text="{Binding OverlayStatusText}" FontSize="11" Foreground="#115E59"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </shared:AnalysisPanelShell>
</UserControl>
