<UserControl x:Class="BrainPlatform.Desktop.Modules.Review.Views.RbpReviewAnalysisPanel"
             x:Name="RbpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Analysis"
             xmlns:topomap="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Topomap"
             xmlns:rbp="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Rbp">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/AnalysisStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <shared:AnalysisPanelShell Title="" ToolTip="{Binding RbpAnalysis.WindowText}"
                               CloseCommand="{Binding CloseAnalysisCommand}">
        <shared:AnalysisPanelShell.Style>
            <Style TargetType="{x:Type shared:AnalysisPanelShell}" BasedOn="{StaticResource {x:Type shared:AnalysisPanelShell}}">
                <Setter Property="StatusText" Value="{Binding AnalysisPreparationText}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RbpAnalysis.HasResult}" Value="True">
                        <Setter Property="StatusText" Value="" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </shared:AnalysisPanelShell.Style>
        <shared:AnalysisPanelShell.HeaderContent>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="RBP 图表" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"
                           VerticalAlignment="Center" />
                <ComboBox Width="150" Margin="10,0,0,0"
                          ItemsSource="{Binding RbpAnalysis.ChartOptions}"
                          SelectedItem="{Binding RbpAnalysis.SelectedChart, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource AppFilterComboBoxStyle}" Height="32"
                          VerticalAlignment="Center" />
            </StackPanel>
        </shared:AnalysisPanelShell.HeaderContent>
        <Grid>
            <Border Margin="4,2,4,4" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RbpAnalysis.IsTopomapSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,4">
                        <ComboBox Width="120" Height="32" Margin="0,0,8,0"
                                  ItemsSource="{Binding RbpAnalysis.TopomapPowerTypeOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding RbpAnalysis.SelectedTopomapPowerType, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="选择功率类型" Style="{StaticResource AppFilterComboBoxStyle}" />
                        <ComboBox Width="120" Height="32"
                                  ItemsSource="{Binding RbpAnalysis.TopomapBandOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding RbpAnalysis.SelectedTopomapBandId, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="选择地形图频段" Style="{StaticResource AppFilterComboBoxStyle}" />
                    </StackPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RbpAnalysis.TopomapBands}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RbpAnalysis.IsAllTopomapBandsSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <topomap:TopomapCanvas Band="{Binding Band}"
                                    ColorScaleState="{Binding DataContext.RbpAnalysis.TopomapColorScales, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Margin="8,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RbpAnalysis.IsAllTopomapBandsSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <topomap:TopomapCanvas Band="{Binding RbpAnalysis.SelectedTopomapBand}"
                                               ColorScaleState="{Binding RbpAnalysis.TopomapColorScales}"
                                               Width="640" Height="640" />
                    </Viewbox>
                </Grid>
            </Border>
            <Border Margin="4,2,4,4" Padding="6" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RbpAnalysis.IsTopomapSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ListBox x:Name="ChannelHistoryList" ItemsSource="{Binding RbpAnalysis.ChannelHistories}"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6" ToolTip="{Binding QualitySummary}">
                                <TextBlock Text="{Binding Channel}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" />
                                <rbp:RbpChart Height="120" IsStackedHistory="True" ShowAxisTitles="False"
                                              VisibleStartSeconds="{Binding DataContext.AnalysisPanelStartSeconds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Bands="{Binding Bands}" Windows="{Binding Windows}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </shared:AnalysisPanelShell>
</UserControl>
