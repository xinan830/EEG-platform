<UserControl x:Class="BrainPlatform.Desktop.Modules.Review.Views.ReviewTnkAnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Analysis"
             xmlns:tnk="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/AnalysisStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <shared:AnalysisPanelShell Title="" Padding="6,4" CloseCommand="{Binding CloseAnalysisCommand}">
        <shared:AnalysisPanelShell.HeaderContent>
            <ItemsControl x:Name="ChannelSelectors" ItemsSource="{Binding TnkParameters.Roles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="1,0" MinWidth="0">
                            <TextBlock Text="{Binding Role}" FontSize="10" Foreground="#64748B"
                                       HorizontalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Channels}"
                                      SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                      Style="{StaticResource AppFilterComboBoxStyle}"
                                      Height="28" MinWidth="0" ToolTip="TNK 角色来源通道" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </shared:AnalysisPanelShell.HeaderContent>
        <Grid x:Name="TnkPanelLayout">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="175" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <ListBox x:Name="MetricTabs" Grid.Row="0" Grid.Column="0" Margin="0,0,8,4" Height="34"
                     ItemsSource="{Binding TnkAnalysis.AnalysisTabs}"
                     SelectedIndex="{Binding TnkAnalysis.SelectedTabIndex, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="9" Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" TextAlignment="Center" VerticalAlignment="Center" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,3" />
                        <Setter Property="Margin" Value="1,0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#E8F2FC" />
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#1769BD" />
                                            <Setter Property="Foreground" Value="#1769BD" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#F3F7FA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <ScrollViewer x:Name="MetricContent" Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,8,0">
                <ItemsControl ItemsSource="{Binding TnkAnalysis.ActivePlots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <tnk:TnkAnalysisPlotView Panel="{Binding}" ShowPlaybackCursor="False"
                                VisibleStartSeconds="{Binding DataContext.AnalysisPanelStartSeconds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,0,0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="SummarySidebar" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Header="综合冥想指数" Margin="0" Padding="5">
                        <StackPanel>
                            <Grid Margin="0,4,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TnkAnalysis.CompositeValue}" Foreground="#42A5F5"
                                           FontSize="38" FontWeight="Bold" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding TnkAnalysis.CompositeQuality}" Foreground="#667580"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="当前游标窗口" Foreground="#8A939B" FontSize="11" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar Value="{Binding TnkAnalysis.CompositeProgress, Mode=OneWay}" Maximum="100" Height="10"
                                         Foreground="#42A5F5" Background="#E4E8EB" BorderThickness="0"
                                         Visibility="{Binding TnkAnalysis.HasCompositeValue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding TnkAnalysis.ScoreStates}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="{Binding DurationText}" DockPanel.Dock="Right" FontSize="11" />
                                                <TextBlock Text="{Binding Label}" Foreground="{Binding Color}"
                                                           FontWeight="SemiBold" FontSize="11" />
                                            </DockPanel>
                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="9"
                                                         Foreground="{Binding Color}" Background="#E4E8EB"
                                                         BorderThickness="0" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding TnkAnalysis.ScoreStateStatus}" FontSize="10"
                                       Foreground="#8A939B" Margin="0,1,0,3" />
                            <GroupBox Header="当前窗口 / 最近有效结果" Margin="0,2,0,0" Padding="3,5">
                                <StackPanel x:Name="RecentMetricsLayout">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="IAPF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding TnkAnalysis.IapfValue}" FontSize="16" FontWeight="Bold"
                                                   Foreground="#1769BD" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TnkAnalysis.IapfValue}" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TnkAnalysis.IapfValueStatus}"
                                                   FontSize="9" Foreground="#718096" Margin="0,1,0,0" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="皮质兴奋/抑制" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="CorticalValueText" Grid.Column="1" Text="{Binding TnkAnalysis.CorticalValue}"
                                                   FontSize="16" FontWeight="Bold" Foreground="#00897B" HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TnkAnalysis.CorticalValue}" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TnkAnalysis.CorticalValueStatus}"
                                                   FontSize="9" Foreground="#718096" Margin="0,1,0,0" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="脑负荷指数" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding TnkAnalysis.BrainbeatValue}" FontSize="16" FontWeight="Bold"
                                                   Foreground="#9966CC" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TnkAnalysis.BrainbeatValue}" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </shared:AnalysisPanelShell>
</UserControl>
