<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.IcaReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:topomap="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Topomap"
        xmlns:prep="clr-namespace:BrainPlatform.Desktop.Modules.Review.Preprocessing"
        Title="ICA 独立成分审查（2D 头皮热力图与时间波形）"
        Width="1020" Height="700" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8FB">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Modules/Review/Views/Preprocessing/PreprocessingDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="22,14">
            <StackPanel>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="ICA 生理伪迹成分审查" FontSize="17" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock x:Name="HeaderSubtitleText" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="740" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#F8FAFC" BorderBrush="#E5E9F0" BorderThickness="1"
                            CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock x:Name="FingerprintText" FontFamily="Consolas" FontSize="11.5" Foreground="#475569" />
                    </Border>
                </DockPanel>

                <!-- Classifier status + quick filter bar -->
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <RadioButton x:Name="FilterAllRadio" GroupName="IcaCardFilter" Content="全部成分" IsChecked="True"
                                     Checked="OnFilterChanged" Style="{StaticResource PrepPolicyOptionCardStyle}"
                                     Padding="10,5" FontSize="11.5" Margin="0,0,6,0" />
                        <RadioButton x:Name="FilterRecommendedRadio" GroupName="IcaCardFilter" Content="仅看建议剔除"
                                     Checked="OnFilterChanged" Style="{StaticResource PrepPolicyOptionCardStyle}"
                                     Padding="10,5" FontSize="11.5" />
                    </StackPanel>
                    <Border x:Name="ClassifierBanner" Background="#F8FAFC" BorderBrush="#E5E9F0" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock x:Name="ClassifierStatusText" FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" />
                    </Border>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Component Cards Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,16">
            <ItemsControl x:Name="ComponentsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="222" Margin="0,0,14,14" CornerRadius="12" Padding="12" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="BorderBrush" Value="#E5E9F0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrepAlertAccentBrush}" />
                                            <Setter Property="Background" Value="{StaticResource PrepAlertSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" ToolTip="{Binding ScoreTooltip}">
                                    <CheckBox IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                              Content="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"
                                              VerticalAlignment="Center" Checked="OnSelectionChanged" Unchecked="OnSelectionChanged" />
                                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="7,2" VerticalAlignment="Center"
                                            ToolTip="{Binding ScoreTooltip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecommendedExclude}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrepAlertPillBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ScoreBadgeText}" FontSize="10.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64748B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RecommendedExclude}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PrepAlertBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>

                                <!-- 2D Scalp Topomap -->
                                <Border Height="134" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                                    <topomap:TopomapCanvas Field="{Binding Topomap}" />
                                </Border>

                                <!-- 10s Component Sparkline -->
                                <prep:IcSparklineControl Samples="{Binding PreviewWaveform}" TimesSeconds="{Binding PreviewTimesSeconds}"
                                                         DurationSeconds="{Binding PreviewDurationSeconds}" Height="36" Margin="0,0,0,6" />

                                <TextBlock Text="{Binding EvrText}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="SelectionSummaryText" DockPanel.Dock="Left" FontSize="12.5" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="恢复系统推荐" Click="OnResetRecommendedClick" Style="{StaticResource PrepGhostButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="取消" Click="OnCancelClick" IsCancel="True" Style="{StaticResource PrepSecondaryButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="确认剔除选中成分" Click="OnConfirmClick" IsDefault="True" Style="{StaticResource PrepPrimaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
