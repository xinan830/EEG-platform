<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.IcaReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:topomap="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Topomap"
        xmlns:prep="clr-namespace:BrainPlatform.Desktop.Modules.Review.Preprocessing"
        Title="ICA 独立成分审查（2D 头皮热力图与时间波形）"
        Width="980" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F1F5F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部说明栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="ICA 生理伪迹成分审查" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock x:Name="HeaderSubtitleText" FontSize="12" Foreground="#475569" Margin="0,3,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="FingerprintText" FontFamily="Consolas" FontSize="11.5" Foreground="#334155" />
                </Border>
            </DockPanel>
        </Border>

        <!-- 中间 IC 网格卡片 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ComponentsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="216" Margin="0,0,12,12" CornerRadius="10" Padding="10" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                            <Setter Property="BorderBrush" Value="#DC2626" />
                                            <Setter Property="Background" Value="#FEF2F2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- 卡片头：勾选 + 建议徽章 -->
                                <DockPanel Margin="0,0,0,6">
                                    <CheckBox IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                              Content="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"
                                              VerticalAlignment="Center" Checked="OnSelectionChanged" Unchecked="OnSelectionChanged" />
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecommendedExclude}" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ScoreBadgeText}" FontSize="10.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RecommendedExclude}" Value="True">
                                                            <Setter Property="Foreground" Value="#B91C1C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>

                                <!-- 2D 头皮热力图（复用共享 TopomapCanvas） -->
                                <Border Height="132" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6">
                                    <topomap:TopomapCanvas Field="{Binding Topomap}" />
                                </Border>

                                <!-- 10 秒成分时间波形迷你图 -->
                                <prep:IcSparklineControl Samples="{Binding PreviewWaveform}" Height="36" Margin="0,0,0,4" />

                                <TextBlock Text="{Binding EvrText}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部确认栏 -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="SelectionSummaryText" FontSize="12.5" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="恢复系统推荐" Click="OnResetRecommendedClick" Padding="12,6" Margin="0,0,8,0"
                            Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#334155" Cursor="Hand" />
                    <Button Content="取消" Click="OnCancelClick" Padding="14,6" Margin="0,0,8,0"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#334155" Cursor="Hand" />
                    <Button Content="确认剔除选中成分" Click="OnConfirmClick" Padding="16,6" FontWeight="SemiBold"
                            Background="#2563EB" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
