<UserControl x:Class="BrainPlatform.Desktop.Modules.Review.Views.RecordingReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Views"
             xmlns:review="clr-namespace:BrainPlatform.Desktop.Modules.Review.Waveform"
             Background="#F3F5F8">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ReviewPaperSpeedValueStyle" TargetType="ComboBox" BasedOn="{StaticResource AppFilterComboBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPaperSpeedMode}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReviewTimebaseValueStyle" TargetType="ComboBox" BasedOn="{StaticResource AppFilterComboBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTimebaseMode}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <views:EegWorkspaceShell WaveformDataContext="{Binding}"
                             IsImmersiveWaveform="True">
        <views:EegWorkspaceShell.TopBar>
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←  返回项目"
                            Click="OnBackClick"
                            Height="32"
                            Padding="12,0"
                            Style="{StaticResource ModernDialogSecondaryButtonStyle}"
                            ToolTip="返回项目列表" />
                    <Separator Width="1" Height="30" Background="#E2E8F0" Margin="18,0" />
                    <TextBlock Text="高通" Foreground="#334155" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="82" Style="{StaticResource AppFilterComboBoxStyle}"
                              SelectedValuePath="Tag" SelectedValue="{Binding HighPassHz, Mode=TwoWay}">
                        <ComboBoxItem Content="0.01 Hz" Tag="0.01" /><ComboBoxItem Content="0.05 Hz" Tag="0.05" />
                        <ComboBoxItem Content="0.1 Hz" Tag="0.1" /><ComboBoxItem Content="0.2 Hz" Tag="0.2" />
                        <ComboBoxItem Content="0.3 Hz" Tag="0.3" /><ComboBoxItem Content="0.4 Hz" Tag="0.4" />
                        <ComboBoxItem Content="0.5 Hz" Tag="0.5" /><ComboBoxItem Content="0.6 Hz" Tag="0.6" />
                        <ComboBoxItem Content="0.7 Hz" Tag="0.7" /><ComboBoxItem Content="0.8 Hz" Tag="0.8" />
                        <ComboBoxItem Content="0.9 Hz" Tag="0.9" />
                        <ComboBoxItem Content="1 Hz" Tag="1" /><ComboBoxItem Content="1.5 Hz" Tag="1.5" />
                        <ComboBoxItem Content="2 Hz" Tag="2" /><ComboBoxItem Content="3 Hz" Tag="3" />
                        <ComboBoxItem Content="5 Hz" Tag="5" /><ComboBoxItem Content="10 Hz" Tag="10" />
                    </ComboBox>
                    <TextBlock Text="低通" Foreground="#334155" FontSize="12" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <ComboBox Width="82" Style="{StaticResource AppFilterComboBoxStyle}"
                              SelectedValuePath="Tag" SelectedValue="{Binding LowPassHz, Mode=TwoWay}">
                        <ComboBoxItem Content="10 Hz" Tag="10" /><ComboBoxItem Content="20 Hz" Tag="20" />
                        <ComboBoxItem Content="30 Hz" Tag="30" /><ComboBoxItem Content="40 Hz" Tag="40" />
                        <ComboBoxItem Content="50 Hz" Tag="50" /><ComboBoxItem Content="60 Hz" Tag="60" />
                        <ComboBoxItem Content="70 Hz" Tag="70" /><ComboBoxItem Content="80 Hz" Tag="80" />
                        <ComboBoxItem Content="90 Hz" Tag="90" /><ComboBoxItem Content="100 Hz" Tag="100" />
                    </ComboBox>
                    <TextBlock Text="陷波" Foreground="#334155" FontSize="12" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <ComboBox Width="72" Style="{StaticResource AppFilterComboBoxStyle}"
                              SelectedValuePath="Tag" SelectedValue="{Binding NotchHz, Mode=TwoWay}">
                        <ComboBoxItem Content="关闭" Tag="0" /><ComboBoxItem Content="50 Hz" Tag="50" /><ComboBoxItem Content="60 Hz" Tag="60" />
                    </ComboBox>
                    <TextBlock Text="灵敏度" Foreground="#334155" FontSize="12" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <ComboBox Width="88" Style="{StaticResource AppFilterComboBoxStyle}"
                              SelectedValuePath="Tag" SelectedValue="{Binding SensitivityMicrovoltsPerMillimeter, Mode=TwoWay}">
                        <ComboBoxItem Content="5 µV/mm" Tag="5" /><ComboBoxItem Content="10 µV/mm" Tag="10" />
                        <ComboBoxItem Content="20 µV/mm" Tag="20" /><ComboBoxItem Content="50 µV/mm" Tag="50" />
                        <ComboBoxItem Content="100 µV/mm" Tag="100" />
                    </ComboBox>
                    <Separator Width="1" Height="30" Background="#E2E8F0" Margin="12,0" />
                    <TextBlock Text="当前查看导联" Foreground="#334155" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="MontageSelector"
                              Width="170"
                              Style="{StaticResource AppFilterComboBoxStyle}"
                              ItemsSource="{Binding CompatibleViewingMontages}"
                              SelectionChanged="OnMontageSelectionChanged"
                              ToolTip="只改变回溯显示方式，不修改原始记录">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <RadioButton Content="走纸速度" GroupName="ReviewHorizontalScale" Foreground="#334155" FontSize="12"
                                 VerticalAlignment="Center" Margin="10,0,5,0" IsChecked="{Binding IsPaperSpeedMode, Mode=TwoWay}"
                                 ToolTip="名义纸速输入；真实物理毫米需要工作站校准。" />
                    <ComboBox Width="82" Style="{StaticResource ReviewPaperSpeedValueStyle}"
                              IsEnabled="{Binding IsPaperSpeedMode}" SelectedValuePath="Tag"
                              SelectionChanged="OnPaperSpeedSelectionChanged"
                              SelectedValue="{Binding PaperSpeedMillimetersPerSecond, Mode=TwoWay}">
                        <ComboBoxItem Content="5 mm/s" Tag="5" /><ComboBoxItem Content="10 mm/s" Tag="10" />
                        <ComboBoxItem Content="15 mm/s" Tag="15" /><ComboBoxItem Content="30 mm/s" Tag="30" />
                        <ComboBoxItem Content="60 mm/s" Tag="60" />
                    </ComboBox>
                    <RadioButton Content="时间基" GroupName="ReviewHorizontalScale" Foreground="#334155" FontSize="12"
                                 VerticalAlignment="Center" Margin="10,0,5,0" IsChecked="{Binding IsTimebaseMode, Mode=TwoWay}"
                                 ToolTip="秒/屏输入，直接控制当前回溯窗口长度。" />
                    <ComboBox Width="74" Style="{StaticResource ReviewTimebaseValueStyle}"
                              IsEnabled="{Binding IsTimebaseMode}" SelectedValuePath="Tag"
                              SelectionChanged="OnTimebaseSelectionChanged"
                              SelectedValue="{Binding TimebaseSecondsPerScreen, Mode=TwoWay}">
                        <ComboBoxItem Content="5 s/屏" Tag="5" /><ComboBoxItem Content="10 s/屏" Tag="10" />
                        <ComboBoxItem Content="15 s/屏" Tag="15" /><ComboBoxItem Content="20 s/屏" Tag="20" />
                        <ComboBoxItem Content="30 s/屏" Tag="30" />
                    </ComboBox>
                    <TextBlock Text="采样率" Foreground="#334155" FontSize="13" VerticalAlignment="Center" Margin="14,0,8,0" />
                    <TextBlock Text="{Binding SamplingRateHz, Mode=OneWay, StringFormat={}{0} Hz}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                    <ComboBox Width="150" Margin="14,0,0,0" ItemsSource="{Binding RecordingEvents}"
                              SelectedItem="{Binding SelectedRecordingEvent, Mode=TwoWay}"
                              ToolTip="选择历史事件并跳转">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DefinitionSnapshot.Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="跳转事件" Click="OnSeekToEventClick" Margin="6,0,0,0" Padding="9,4"
                            ToolTip="跳转到选中的历史事件" />
                    <ComboBox Width="112" Margin="8,0,0,0"
                              ItemsSource="{Binding EnabledEventDefinitions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedEventDefinitionId, Mode=TwoWay}"
                              ToolTip="选择要在当前位置标记的事件类型" />
                    <Button Content="标记" Command="{Binding MarkSelectedEventCommand}" Margin="6,0,0,0" Padding="9,4"
                            ToolTip="在当前回溯位置添加人工事件标记" />
                    <Button Content="删除事件" Command="{Binding DeleteSelectedEventCommand}" Margin="6,0,0,0" Padding="9,4"
                            IsEnabled="{Binding CanEditSelectedEvent}"
                            ToolTip="仅可删除人工创建的事件标记" />
                    <Button Content="编辑事件" Command="{Binding OpenEventEditorCommand}" Margin="6,0,0,0" Padding="9,4"
                            ToolTip="编辑人工事件的时间范围和备注" />
                </StackPanel>

                <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,6" Background="#EFF6FF"
                        BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5"
                        ToolTip="当前回溯记录所属项目与记录名称">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="项目：" FontSize="12" Foreground="#64748B" />
                        <TextBlock Text="{Binding ProjectName, Mode=OneWay}"
                                   MaxWidth="130" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text=" / " FontSize="12" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding RecordingName, Mode=OneWay}"
                                   MaxWidth="150" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </views:EegWorkspaceShell.TopBar>

        <views:EegWorkspaceShell.Waveform>
            <review:RecordingReviewSciChartCanvas />
        </views:EegWorkspaceShell.Waveform>

        <views:EegWorkspaceShell.Overlay>
            <Popup IsOpen="{Binding IsEventEditorOpen, Mode=TwoWay}" Placement="Center" StaysOpen="True" AllowsTransparency="True">
                <Border Width="360" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="22">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.16" Color="#0F172A" /></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="编辑事件" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="仅人工事件可修改；时间基于 Recording 的采样坐标。" Margin="0,5,0,16" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="起始时间（秒）" Foreground="#475569" />
                        <TextBox Text="{Binding EditEventStartSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <TextBlock Text="持续时间（秒，0 为点事件）" Foreground="#475569" />
                        <TextBox Text="{Binding EditEventDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <TextBlock Text="备注" Foreground="#475569" />
                        <TextBox Text="{Binding EditEventNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" TextWrapping="Wrap" Margin="0,4,0,16" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Command="{Binding CloseEventEditorCommand}" Padding="14,7" Margin="0,0,8,0" />
                            <Button Content="保存" Command="{Binding SaveEditedEventCommand}" Padding="14,7" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </views:EegWorkspaceShell.Overlay>

        <views:EegWorkspaceShell.BottomBar>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Tag="-1000000" Click="OnNavigateClick" Style="{StaticResource FlatIconButtonStyle}" ToolTip="跳到记录开始">
                        <Path Data="M 3,4 V 20 M 6,12 L 17,4 V 20 Z" Fill="#334155" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Tag="page-back" Click="OnNavigateClick" Style="{StaticResource FlatIconButtonStyle}" ToolTip="后退一屏">
                        <Path Data="M 4,12 L 14,4 V 20 Z M 15,4 V 20" Fill="#334155" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Tag="-1" Click="OnNavigateClick" Style="{StaticResource FlatIconButtonStyle}" ToolTip="后退一秒">
                        <Path Data="M 5,12 L 16,4 V 20 Z" Fill="#334155" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button Click="OnPlayClick" Style="{StaticResource FlatIconButtonStyle}" ToolTip="播放或暂停回溯">
                        <Grid Width="20" Height="20">
                            <Path Data="M 6,4 L 18,12 L 6,20 Z" Fill="#0F172A" Stretch="Uniform">
                                <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style>
                            </Path>
                            <Path Data="M 5,4 H 9 V 20 H 5 Z M 14,4 H 18 V 20 H 14 Z" Fill="#0F172A" Stretch="Uniform">
                                <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Button Tag="1" Click="OnNavigateClick" Style="{StaticResource FlatIconButtonStyle}" ToolTip="前进一秒">
                        <Path Data="M 15,12 L 4,4 V 20 Z" Fill="#334155" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button Tag="page-forward" Click="OnNavigateClick" Style="{StaticResource FlatIconButtonStyle}" ToolTip="前进一屏">
                        <Path Data="M 14,12 L 4,4 V 20 Z M 3,4 V 20" Fill="#334155" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Tag="1000000" Click="OnNavigateClick" Style="{StaticResource FlatIconButtonStyle}" ToolTip="跳到记录结束">
                        <Path Data="M 17,4 V 20 M 14,12 L 3,4 V 20 Z" Fill="#334155" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Click="OnPlaybackSpeedClick" Style="{StaticResource FlatIconButtonStyle}" ToolTip="切换回放速度">
                        <TextBlock Text="{Binding PlaybackSpeedText, Mode=OneWay}" Margin="8,0" FontWeight="SemiBold" Foreground="#334155" />
                    </Button>
                    <Button Style="{StaticResource FlatIconButtonStyle}" ToolTip="更多回溯操作">
                        <TextBlock Text="⋮" FontSize="20" FontWeight="SemiBold" Foreground="#334155" />
                    </Button>
                </StackPanel>

                <review:ReviewTimelineNavigator x:Name="TimelineNavigator" Grid.Column="1" Height="22"
                    DurationSeconds="{Binding DurationSeconds, Mode=OneWay}"
                    ViewportStartSeconds="{Binding ViewportStartSeconds, Mode=OneWay}"
                    VisibleDurationSeconds="{Binding VisibleDurationSeconds, Mode=OneWay}"
                    PreviewPositionChanged="OnTimelinePreviewPositionChanged"
                    PositionCommitted="OnTimelinePositionCommitted"
                    ToolTip="点击白色空白轨道跳转；拖动灰色窗口浏览整段记录。蓝线仅显示位置。" />
            </Grid>
        </views:EegWorkspaceShell.BottomBar>
    </views:EegWorkspaceShell>
</UserControl>
