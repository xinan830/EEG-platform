<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.Preprocessing.ArtifactRemovalStepDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="05 · 眼电 / 心电去伪迹与 ICA 审查"
        Width="740" Height="640" MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8FB">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/ControlStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Modules/Review/Views/Preprocessing/PreprocessingDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + Busy Bar -->
        <Grid Grid.Row="0">
            <Border Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="22,15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource PrepBrandSoftBrush}" Margin="0,0,9,0">
                            <TextBlock Text="05" Foreground="{StaticResource PrepBrandBrush}" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="眼电 / 心电去伪迹与 ICA 审查" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="选择去伪迹方式；Infomax ICA 审查确认后将生成模型指纹，下游连续分析自动复用"
                               FontSize="12" Foreground="#64748B" Margin="33,3,0,0" />
                </StackPanel>
            </Border>
            <ProgressBar VerticalAlignment="Bottom" Style="{StaticResource PrepBusyBarStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource PrepBoolToVis}}" />
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16" Background="#F6F8FB">
            <StackPanel>
                <TextBlock Text="去伪迹方式" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <RadioButton Grid.Row="0" Grid.Column="0" GroupName="RemovalMethodGroup"
                                 IsChecked="{Binding IsRemovalNone, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="不启用去伪迹" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="保留原始眼电与心电成分" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Row="0" Grid.Column="2" GroupName="RemovalMethodGroup"
                                 IsChecked="{Binding IsRemovalIca, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="可审查 Infomax ICA（推荐）" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="可视化 2D 头皮热力图与波形，手动确认剔除成分" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Row="2" Grid.Column="0" GroupName="RemovalMethodGroup"
                                 IsChecked="{Binding IsRemovalSsp, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MNE SSP 眼电投影" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="自动构建眼电空间投影算子去除眨眼伪迹" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Row="2" Grid.Column="2" GroupName="RemovalMethodGroup"
                                 IsChecked="{Binding IsRemovalEog, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="EOG 线性回归" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="需要记录中包含专用 EOG 导联通道" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <Border Background="White" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="通道身份与评分用途（来自当前录音）" FontSize="13" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="先按实际接线确认身份并保存；勾选眼电用途不会改变通道身份。EEG 代理仍参与脑电拟合，专用 EOG/ECG 独立处理。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="眼电 EOG：可多选" FontSize="12" Foreground="#475569" Margin="0,0,0,5" />
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="EogReferenceChoices" ItemsSource="{Binding ReferenceChannels}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource AppRoundedFilterComboBoxStyle}" ItemsSource="{Binding IdentityOptions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Identity, Mode=TwoWay}" Margin="0,0,12,0" />
                                        <CheckBox Grid.Column="2" Content="用于眼电评分" IsChecked="{Binding IsEog, Mode=TwoWay}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Content="保存通道身份" Command="{Binding SaveChannelIdentitiesCommand}" IsEnabled="{Binding HasUnsavedChannelIdentities}" Style="{StaticResource PrepPrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                        <TextBlock Text="心电 ECG（仅 ICA）" FontSize="12" Foreground="#475569" Margin="0,10,0,5" />
                        <ComboBox x:Name="EcgReferenceChoice" Style="{StaticResource AppRoundedFilterComboBoxStyle}" ItemsSource="{Binding EcgChannelOptions}" SelectedItem="{Binding SelectedEcgChannel, Mode=TwoWay}" IsEnabled="{Binding IsRemovalIca}">
                            <ComboBox.ItemTemplate><DataTemplate>
                                <TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding}" Value="">
                                        <Setter Property="Text" Value="自动识别（不指定）" />
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style></TextBlock>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding ReferenceStatusText}" FontSize="12" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <!-- Parameters Card -->
                <Border Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="12" Padding="16,13" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="156" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <DockPanel LastChildFill="False" Margin="0,0,0,5">
                                <TextBlock DockPanel.Dock="Left" Text="ICA 成分数" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                <TextBlock DockPanel.Dock="Right" Text="2–32" FontSize="11" Foreground="#94A3B8" />
                            </DockPanel>
                            <TextBox Text="{Binding IcaComponentCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource PrepNumericTextBoxStyle}" ToolTip="默认 15" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <CheckBox Content="无专用 EOG 时允许使用前额 Fp1/Fp2 作为代理"
                                      IsChecked="{Binding AllowFrontalEogProxy, Mode=TwoWay}"
                                      Style="{StaticResource PrepToggleSwitchStyle}" />
                            <TextBlock Text="用于辅助计算各成分与眨眼的 EOG 相关性评分（r 值）" FontSize="11.5" Foreground="#64748B" Margin="48,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ICA Action Card -->
                <Border Background="#FFFFFF" BorderBrush="{StaticResource PrepBrandBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="ICA 成分可视化审查" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="{Binding IcaSummaryText}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="OpenIcaReviewButton" Grid.Column="1" Content="拟合 ICA 并打开审查"
                                Click="OnOpenIcaReviewClick" Style="{StaticResource PrepPrimaryButtonStyle}"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Quiet Scope Notice -->
                <Border Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PrepAlertAccentBrush}" CornerRadius="1.5" />
                        <TextBlock Grid.Column="1" Text="{Binding ArtifactRemovalScopeNotice}" FontSize="12" Foreground="#475569"
                                   TextWrapping="Wrap" Margin="10,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12.5" Foreground="#64748B">
                    <Run Text="当前状态：" />
                    <Run Text="{Binding RemovalNodeBadge, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F172A" />
                </TextBlock>
                <Button DockPanel.Dock="Right" Content="完成返回" Click="OnDoneClick" IsDefault="True" IsCancel="True"
                        Style="{StaticResource PrepPrimaryButtonStyle}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
