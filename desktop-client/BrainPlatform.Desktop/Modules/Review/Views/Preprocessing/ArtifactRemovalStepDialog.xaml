<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.Preprocessing.ArtifactRemovalStepDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="05 · 眼电 / 心电去伪迹与 ICA 审查"
        Width="780" Height="680" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8FB">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/ControlStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Modules/Review/Views/Preprocessing/PreprocessingDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + Busy Bar -->
        <Grid Grid.Row="0">
            <Border Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="22,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource PrepBrandSoftBrush}" Margin="0,0,9,0">
                            <TextBlock Text="05" Foreground="{StaticResource PrepBrandBrush}" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="眼电 / 心电去伪迹与 ICA 审查" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="选择去伪迹方式；Infomax ICA 审查确认后将生成模型指纹，下游连续分析自动复用"
                               FontSize="12" Foreground="#64748B" Margin="33,3,0,0" />
                </StackPanel>
            </Border>
            <ProgressBar VerticalAlignment="Bottom" Style="{StaticResource PrepBusyBarStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource PrepBoolToVis}}" />
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,14" Background="#F6F8FB">
            <StackPanel>
                <!-- 1. Physical Channel Identity Summary Card (Top entry; opens dedicated modal dialog) -->
                <Border CornerRadius="12" Padding="16,13" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFFFFF" />
                            <Setter Property="BorderBrush" Value="#E5E9F0" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChannelIdentities}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrepAlertAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="通道物理身份管理" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                <Border Background="#F1F5F9" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="仅外接专用 EOG / ECG 电极时修改" FontSize="10.5" Foreground="#64748B" />
                                </Border>
                                <Border Visibility="{Binding HasUnsavedChannelIdentities, Converter={StaticResource PrepBoolToVis}}"
                                        Background="{StaticResource PrepAlertPillBrush}" CornerRadius="5" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="有未保存修改" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrepAlertBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ChannelIdentitySummaryText}" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="OpenChannelIdentityButton" Grid.Column="1" Content="配置通道身份…"
                                Click="OnOpenChannelIdentityClick" Style="{StaticResource PrepSecondaryButtonStyle}"
                                MinHeight="32" Padding="14,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 2. Removal Method -->
                <TextBlock Text="去伪迹方式" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <RadioButton Grid.Row="0" Grid.Column="0" GroupName="RemovalMethodGroup"
                                 IsChecked="{Binding IsRemovalNone, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="不启用去伪迹" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="保留原始眼电与心电成分" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Row="0" Grid.Column="2" GroupName="RemovalMethodGroup"
                                 IsChecked="{Binding IsRemovalIca, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="可审查 Infomax ICA（推荐）" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="可视化 2D 头皮热力图与波形，手动确认剔除成分" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Row="2" Grid.Column="0" GroupName="RemovalMethodGroup"
                                 IsChecked="{Binding IsRemovalSsp, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="MNE SSP 眼电投影" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="自动构建眼电空间投影算子去除眨眼伪迹" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Row="2" Grid.Column="2" GroupName="RemovalMethodGroup"
                                 IsChecked="{Binding IsRemovalEog, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="EOG 线性回归" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="需要记录中已标记专用 EOG 眼电通道" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <!-- 2A. ICA Review & Parameters Card (ONLY visible when Infomax ICA is selected) -->
                <Border x:Name="IcaActionCard"
                        Visibility="{Binding IsRemovalIca, Converter={StaticResource PrepBoolToVis}}"
                        Background="#FFFFFF" BorderBrush="{StaticResource PrepBrandBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16,13" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="ICA 成分可视化审查" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="{Binding IcaSummaryText}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="OpenIcaReviewButton" Grid.Column="1" Content="拟合 ICA 并打开审查"
                                    Click="OnOpenIcaReviewClick" Style="{StaticResource PrepPrimaryButtonStyle}"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="#F1F5F9" Margin="0,12,0,11" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Left" Text="ICA 成分数" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                    <TextBlock DockPanel.Dock="Right" Text="2–32" FontSize="11" Foreground="#94A3B8" />
                                </DockPanel>
                                <TextBox Text="{Binding IcaComponentCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource PrepNumericTextBoxStyle}" Height="32" ToolTip="默认 15" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <CheckBox Content="无专用 EOG 时允许使用前额 Fp1/Fp2 作为代理"
                                          IsChecked="{Binding AllowFrontalEogProxy, Mode=TwoWay}"
                                          Style="{StaticResource PrepToggleSwitchStyle}" />
                                <TextBlock Text="仅用于计算各成分与眨眼的 EOG 相关性评分（r 值），不会移出脑电"
                                           FontSize="11.5" Foreground="#64748B" Margin="48,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2B. SSP Auto-Apply Info Card (ONLY visible when MNE SSP is selected) -->
                <Border x:Name="SspInfoCard"
                        Visibility="{Binding IsRemovalSsp, Converter={StaticResource PrepBoolToVis}}"
                        Background="#FFFFFF" BorderBrush="{StaticResource PrepBrandBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16,13" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MNE SSP 眼电投影 · 自动生效（无需成分审查）" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="点击右下角「完成返回」后，打开顶部「科学对比」或 PSD / RBP 等算法面板即可查看 SSP 空间投影去眨眼结果；不需要点击 ICA 审查。"
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <CheckBox Content="无专用 EOG 时允许使用前额 Fp1/Fp2 作为代理"
                                  IsChecked="{Binding AllowFrontalEogProxy, Mode=TwoWay}"
                                  Style="{StaticResource PrepToggleSwitchStyle}" />
                    </StackPanel>
                </Border>

                <!-- 2C. EOG Regression Auto-Apply Info Card (ONLY visible when EOG Regression is selected) -->
                <Border x:Name="EogRegressionInfoCard"
                        Visibility="{Binding IsRemovalEog, Converter={StaticResource PrepBoolToVis}}"
                        Background="#FFFFFF" BorderBrush="{StaticResource PrepBrandBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16,13" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="EOG 线性回归 · 自动生效（无需成分审查）" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="点击右下角「完成返回」后，打开顶部「科学对比」或 PSD / RBP 等算法面板即可查看线性回归去眼电结果；仅接受已标记为「专用 EOG 眼电」的通道。"
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Border Visibility="{Binding IsEogRegressionMissingDedicatedEog, Converter={StaticResource PrepBoolToVis}}"
                                Background="{StaticResource PrepAlertSoftBrush}" BorderBrush="{StaticResource PrepAlertBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,9,0,0">
                            <TextBlock Text="当前录音尚未标记专用 EOG 通道，线性回归无法使用 EEG 通道作为自变量；请先在上方「配置通道身份…」中标记专用 EOG，或改用 Infomax ICA / SSP。"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource PrepAlertBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. Scoring Reference Selection Card (Visible when any removal method is active) -->
                <Border Visibility="{Binding IsRemovalActive, Converter={StaticResource PrepBoolToVis}}"
                        Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="12" Padding="16,13" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="伪迹参考通道" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="5" Padding="8,2.5">
                                <TextBlock Text="仅用于去伪迹参考 · 不改变通道身份" FontSize="11" Foreground="#475569" />
                            </Border>
                        </DockPanel>

                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="眼电（EOG）参考" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                            <TextBlock DockPanel.Dock="Right" Text="可多选，留空则按自动 / 代理策略" FontSize="11.5" Foreground="#64748B" />
                        </DockPanel>
                        <Border Background="#F8FAFC" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="8" Padding="10,9,4,2">
                            <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="EogReferenceChoices" ItemsSource="{Binding ReferenceChannels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEog, Mode=TwoWay}" Style="{StaticResource PrepChannelChipCheckBoxStyle}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <Border Visibility="{Binding HasNonEegBadge, Converter={StaticResource PrepBoolToVis}}"
                                                            Background="#E2E8F0" CornerRadius="4" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ShortIdentityBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#475569" />
                                                    </Border>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Grid Visibility="{Binding IsRemovalIca, Converter={StaticResource PrepBoolToVis}}" Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="心电（ECG）评分参考（仅 ICA）" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5" />
                                <ComboBox x:Name="EcgReferenceChoice" Style="{StaticResource AppRoundedFilterComboBoxStyle}"
                                          ItemsSource="{Binding EcgChannelOptions}" SelectedItem="{Binding SelectedEcgChannel, Mode=TwoWay}"
                                          IsEnabled="{Binding IsRemovalIca}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="">
                                                                <Setter Property="Text" Value="自动识别（不指定）" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding EcgSelectorHintText}" FontSize="11.5" Foreground="#64748B"
                                       TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </Grid>

                        <!-- Unified Reference Status / Warning Banner -->
                        <Border CornerRadius="8" Padding="10,7" Margin="0,10,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E5E9F0" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreScientificInputsBlocked}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrepAlertSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrepAlertBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ReferenceStatusText}" FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#475569" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AreScientificInputsBlocked}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrepAlertBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 5. Quiet Scope Notice -->
                <Border Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="10" Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PrepAlertAccentBrush}" CornerRadius="1.5" />
                        <TextBlock Grid.Column="1" Text="{Binding ArtifactRemovalScopeNotice}" FontSize="12" Foreground="#475569"
                                   TextWrapping="Wrap" Margin="10,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12.5" Foreground="#64748B">
                    <Run Text="当前状态：" />
                    <Run Text="{Binding RemovalNodeBadge, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F172A" />
                </TextBlock>
                <Button DockPanel.Dock="Right" Content="完成返回" Click="OnDoneClick" IsDefault="True" IsCancel="True"
                        Style="{StaticResource PrepPrimaryButtonStyle}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
