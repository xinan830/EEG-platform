<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.Preprocessing.ArtifactSegmentStepDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="04 · 坏段质控（爆幅 / EMG 肌电）"
        Width="740" Height="640" MinWidth="660" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8FB">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Modules/Review/Views/Preprocessing/PreprocessingDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + Busy Bar -->
        <Grid Grid.Row="0">
            <Border Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="22,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource PrepBrandSoftBrush}" Margin="0,0,9,0">
                                <TextBlock Text="04" Foreground="{StaticResource PrepBrandBrush}" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="坏段质控（爆幅 / EMG 肌电）" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="按通道扫描极端峰峰值爆幅与 MNE 宽带肌电，仅掩膜受污染通道，不误伤干净通道"
                                   FontSize="12" Foreground="#64748B" Margin="33,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="一键扫描坏段" Command="{Binding InspectArtifactSegmentsCommand}"
                            Style="{StaticResource PrepPrimaryButtonStyle}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ProgressBar VerticalAlignment="Bottom" Style="{StaticResource PrepBusyBarStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource PrepBoolToVis}}" />
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Thresholds -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="12" Padding="15,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel LastChildFill="False" Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Left" Text="爆幅峰峰值阈值" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                            <TextBlock DockPanel.Dock="Right" Text="50–2000 µV" FontSize="11" Foreground="#94A3B8" />
                        </DockPanel>
                        <Grid>
                            <TextBox Text="{Binding PeakToPeakUv, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource PrepNumericTextBoxStyle}" Padding="10,0,36,0" />
                            <TextBlock Text="µV" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <DockPanel LastChildFill="False" Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Left" Text="宽带肌电 z-score 阈值" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                            <TextBlock DockPanel.Dock="Right" Text="1.5–12.0" FontSize="11" Foreground="#94A3B8" />
                        </DockPanel>
                        <Grid>
                            <TextBox Text="{Binding MuscleZScoreThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource PrepNumericTextBoxStyle}" Padding="10,0,46,0" />
                            <TextBlock Text="z-score" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Policy Cards -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="处理策略" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" GroupName="ArtifactPolicyGroup"
                                 IsChecked="{Binding IsArtifactPolicyNone, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="不处理" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="跳过坏段质控，全段参与计算" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="2" GroupName="ArtifactPolicyGroup"
                                 IsChecked="{Binding IsArtifactPolicyAnnotate, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="仅标注区间" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="在波形与记录中标出坏段，不剔除采样" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="4" GroupName="ArtifactPolicyGroup"
                                 IsChecked="{Binding IsArtifactPolicyReject, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="掩膜为 NaN 剔除" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="推荐 · 按通道屏蔽坏段，防拉偏频谱" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </StackPanel>

            <!-- Quiet Summary Strip -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                <TextBlock Text="{Binding CleanRatioSummary}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" />
            </Border>

            <!-- Segment List -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasArtifactSegments}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="暂无检出的坏段" FontSize="14" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" />
                        <TextBlock Text="点击右上角「一键扫描坏段」扫描爆幅与 EMG 肌电伪迹；点击条目可直接定位主波形。"
                                   FontSize="12" Foreground="#64748B" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasArtifactSegments, Converter={StaticResource PrepBoolToVis}}">
                        <ItemsControl ItemsSource="{Binding ArtifactSegments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1"
                                            CornerRadius="8" Padding="12,8" Margin="0,0,0,5" ToolTip="{Binding TooltipText}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource PrepAlertSoftBrush}" BorderBrush="{StaticResource PrepAlertBorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding ReasonLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrepAlertBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimeRangeText}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
                                                <TextBlock Text="{Binding ChannelsSummary}" FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="定位波形"
                                                    Command="{Binding DataContext.JumpToSegmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrepSoftBrandButtonStyle}" MinHeight="28" Padding="12,0" FontSize="12" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel LastChildFill="False">
                <CheckBox DockPanel.Dock="Left" Content="在主波形上显示坏段色带"
                          IsChecked="{Binding ShowArtifactBandsOnWaveform, Mode=TwoWay}"
                          Style="{StaticResource PrepToggleSwitchStyle}" />
                <Button DockPanel.Dock="Right" Content="完成返回" Click="OnDoneClick" IsDefault="True" IsCancel="True"
                        Style="{StaticResource PrepPrimaryButtonStyle}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
