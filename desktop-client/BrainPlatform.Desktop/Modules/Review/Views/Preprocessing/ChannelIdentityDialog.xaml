<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.Preprocessing.ChannelIdentityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="通道物理身份管理"
        Width="640" Height="580" MinWidth="540" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8FB">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/ControlStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Modules/Review/Views/Preprocessing/PreprocessingDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + Busy Bar -->
        <Grid Grid.Row="0">
            <Border Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="22,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Height="22" CornerRadius="6" Background="{StaticResource PrepBrandSoftBrush}" Padding="8,0" Margin="0,0,9,0">
                            <TextBlock Text="身份" Foreground="{StaticResource PrepBrandBrush}" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="通道物理身份管理" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="按实际硬件接线声明各电压通道身份，保存后绑定到当前录音，不修改原始采样数据"
                               FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <ProgressBar VerticalAlignment="Bottom" Style="{StaticResource PrepBusyBarStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource PrepBoolToVis}}" />
        </Grid>

        <!-- Body (full-height scrollable table, zero nested ScrollViewers) -->
        <Grid Grid.Row="1" Margin="22,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PrepAlertSoftBrush}" BorderBrush="{StaticResource PrepAlertBorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,0,12">
                <TextBlock FontSize="12" Foreground="{StaticResource PrepAlertBrush}" TextWrapping="Wrap"
                           Text="提示：仅当某路物理上连接的是外置眼电/心电电极时，才改为「专用 EOG / 专用 ECG」（该路将移出 EEG 脑电拟合与输出）。常规脑电帽的 Fp1/Fp2 请保持「EEG 脑电」。" />
            </Border>

            <!-- Table Header -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E5E9F0" BorderThickness="1,1,1,0"
                    CornerRadius="10,10,0,0" Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="原始通道" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                    <TextBlock Grid.Column="1" Text="物理电极身份" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                </Grid>
            </Border>

            <!-- Scrollable Channel Rows -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1"
                    CornerRadius="0,0,10,10" Padding="14,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChannelIdentityChoices" ItemsSource="{Binding ReferenceChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#0F172A" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource AppRoundedFilterComboBoxStyle}"
                                                  ItemsSource="{Binding IdentityOptions}" SelectedValuePath="Key"
                                                  DisplayMemberPath="Value" SelectedValue="{Binding Identity, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Status / Validation Banner -->
            <Border Grid.Row="3" CornerRadius="8" Padding="11,7" Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Setter Property="BorderBrush" Value="#E5E9F0" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AreScientificInputsBlocked}" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrepAlertSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PrepAlertBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ReferenceStatusText}" FontSize="12" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#475569" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AreScientificInputsBlocked}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrepAlertBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding ChannelIdentitySummaryText}"
                           FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CancelIdentitiesButton" Content="取消" Click="OnCancelClick" IsCancel="True"
                            Style="{StaticResource PrepSecondaryButtonStyle}" Margin="0,0,10,0" />
                    <Button x:Name="SaveIdentitiesButton" Content="保存并关闭" Click="OnSaveClick"
                            IsEnabled="{Binding HasUnsavedChannelIdentities}"
                            Style="{StaticResource PrepPrimaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
