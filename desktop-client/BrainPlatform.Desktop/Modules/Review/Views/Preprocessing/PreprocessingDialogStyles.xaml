<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="PrepBoolToVis" />

    <!-- Strict 3-color palette: Neutral Slate + Brand Blue + Restrained Warm Amber -->
    <SolidColorBrush x:Key="PrepCanvasBrush" Color="#F6F8FB" />
    <SolidColorBrush x:Key="PrepSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrepSubtleSurfaceBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="PrepBorderBrush" Color="#E5E9F0" />
    <SolidColorBrush x:Key="PrepBorderStrongBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="PrepInkPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="PrepInkSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="PrepInkMutedBrush" Color="#64748B" />

    <SolidColorBrush x:Key="PrepBrandBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PrepBrandHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="PrepBrandSoftBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="PrepBrandPillBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="PrepBrandBorderBrush" Color="#93C5FD" />

    <SolidColorBrush x:Key="PrepAlertBrush" Color="#B45309" />
    <SolidColorBrush x:Key="PrepAlertAccentBrush" Color="#D97706" />
    <SolidColorBrush x:Key="PrepAlertSoftBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="PrepAlertPillBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="PrepAlertBorderBrush" Color="#FDE68A" />

    <!-- Subtle top busy progress bar -->
    <Style x:Key="PrepBusyBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="2.5" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource PrepBrandBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Primary rounded button (Brand Blue) -->
    <Style x:Key="PrepPrimaryButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{StaticResource PrepBrandBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrepBrandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E40AF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary crisp neutral button -->
    <Style x:Key="PrepSecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{StaticResource PrepSurfaceBrush}" />
        <Setter Property="Foreground" Value="#334155" />
        <Setter Property="BorderBrush" Value="{StaticResource PrepBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrepSubtleSurfaceBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet ghost link/action button -->
    <Style x:Key="PrepGhostButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PrepInkSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                            <Setter Property="Foreground" Value="{StaticResource PrepInkPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Soft brand-tinted action button (for inline list actions like "定位") -->
    <Style x:Key="PrepSoftBrandButtonStyle" TargetType="Button" BasedOn="{StaticResource PrepGhostButtonStyle}">
        <Setter Property="Background" Value="{StaticResource PrepBrandSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrepBrandBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrepBrandPillBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#BFDBFE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded numeric input TextBox -->
    <Style x:Key="PrepNumericTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource PrepInkPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource PrepSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrepBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrepBrandBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrepSubtleSurfaceBrush}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sleek ToggleSwitch CheckBox -->
    <Style x:Key="PrepToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource PrepInkPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Track" Width="38" Height="21" CornerRadius="10.5"
                                Background="#CBD5E1" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="17" Height="17" Fill="#FFFFFF" HorizontalAlignment="Left">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="2.5" ShadowDepth="1" Opacity="0.18" Color="#0F172A" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource PrepBrandBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selectable Policy Card RadioButton -->
    <Style x:Key="PrepPolicyOptionCardStyle" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource PrepSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrepBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="13,11" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RadioOuter" Width="16" Height="16" CornerRadius="8"
                                    BorderBrush="{StaticResource PrepBorderStrongBrush}" BorderThickness="1.5" Background="#FFFFFF"
                                    VerticalAlignment="Top" Margin="0,2,10,0">
                                <Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="{StaticResource PrepBrandBrush}" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrepBrandBorderBrush}" />
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource PrepSubtleSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrepBrandBrush}" />
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource PrepBrandSoftBrush}" />
                            <Setter TargetName="RadioOuter" Property="BorderBrush" Value="{StaticResource PrepBrandBrush}" />
                            <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clickable Flowchart Step Card Button (refined Swiss-medical card with top accent bar) -->
    <Style x:Key="PrepFlowNodeButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource PrepSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrepBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardSurface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.045" Color="#0F172A" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardSurface" Property="BorderBrush" Value="{StaticResource PrepBrandBrush}" />
                            <Setter TargetName="CardSurface" Property="Background" Value="#FAFCFF" />
                            <Setter TargetName="CardSurface" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.09" Color="#1E3A8A" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CardSurface" Property="Background" Value="{StaticResource PrepBrandSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact selectable channel pill for EOG scoring -->
    <Style x:Key="PrepChannelChipCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,7,7" />
        <Setter Property="Foreground" Value="#334155" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Chip" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="7" Padding="9,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="13" Height="13" CornerRadius="3.5" Margin="0,0,6,0" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.2">
                                <Path x:Name="Tick" Data="M2.5,6.5 L5.2,9.2 L10.2,3.4" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrepBrandBorderBrush}" />
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource PrepSubtleSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource PrepBrandSoftBrush}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrepBrandBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrepBrandBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrepBrandBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource PrepBrandHoverBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
