<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.Preprocessing.BadChannelStepDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="02 · 重参考前坏导检测与修复"
        Width="740" Height="610" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8FB">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Modules/Review/Views/Preprocessing/PreprocessingDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + Busy Bar -->
        <Grid Grid.Row="0">
            <Border Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="22,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource PrepBrandSoftBrush}" Margin="0,0,9,0">
                                <TextBlock Text="02" Foreground="{StaticResource PrepBrandBrush}" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="重参考前坏导检测与修复" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="在重参考前修复或排除异常电极，防止单个坏导污染平均参考 (CAR)"
                                   FontSize="12" Foreground="#64748B" Margin="33,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="一键坏导体检" Command="{Binding InspectBadChannelsCommand}"
                            Style="{StaticResource PrepPrimaryButtonStyle}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ProgressBar VerticalAlignment="Bottom" Style="{StaticResource PrepBusyBarStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource PrepBoolToVis}}" />
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Policy Cards -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="处理策略" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" GroupName="BadChannelPolicyGroup"
                                 IsChecked="{Binding IsBadChannelPolicyNone, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="不处理" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="保留全部原始电极，仅记录体检指标" FontSize="11.5" Foreground="#64748B"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="2" GroupName="BadChannelPolicyGroup"
                                 IsChecked="{Binding IsBadChannelPolicyInterpolate, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="3D 球面样条插值" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="推荐 · 用邻近好导球面插值重建坏导" FontSize="11.5" Foreground="#64748B"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="4" GroupName="BadChannelPolicyGroup"
                                 IsChecked="{Binding IsBadChannelPolicyExclude, Mode=TwoWay}"
                                 Style="{StaticResource PrepPolicyOptionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="重参考前安全排除" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="无 3D 坐标时优先选用，从 CAR 中剔除" FontSize="11.5" Foreground="#64748B"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </StackPanel>

            <!-- Quiet Status Strip -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12" Foreground="#475569"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Visibility="{Binding HasBadChannelRows, Converter={StaticResource PrepBoolToVis}}">
                        <Button Content="仅选疑似坏导" Click="OnSelectCandidatesClick" Style="{StaticResource PrepGhostButtonStyle}"
                                MinHeight="26" Padding="8,0" FontSize="11.5" />
                        <Button Content="清空勾选" Click="OnClearSelectionClick" Style="{StaticResource PrepGhostButtonStyle}"
                                MinHeight="26" Padding="8,0" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Channel List Card -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBadChannelRows}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="尚未执行坏导体检" FontSize="14" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" />
                        <TextBlock Text="点击右上角「一键坏导体检」扫描平线、极端幅值、高频噪声与邻域失相关通道。"
                                   FontSize="12" Foreground="#64748B" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Channel rows -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasBadChannelRows, Converter={StaticResource PrepBoolToVis}}">
                        <ItemsControl ItemsSource="{Binding BadChannelRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,5" CornerRadius="8" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#E5E9F0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrepAlertSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrepAlertBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid ToolTip="{Binding MetricsSummary}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6.5" Height="6.5" Fill="{StaticResource PrepAlertAccentBrush}" Margin="0,0,6,0"
                                                         Visibility="{Binding IsBadCandidate, Converter={StaticResource PrepBoolToVis}}" />
                                                <TextBlock Text="{Binding Channel}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                                <TextBlock Text="{Binding ReasonsSummary}" FontSize="12" FontWeight="Medium" Foreground="#334155" />
                                                <TextBlock Text="{Binding MetricsSummary}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="3" Background="#F8FAFC" BorderBrush="#E5E9F0" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InterpolationHint}" FontSize="11" Foreground="#64748B" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12.5" Foreground="#64748B">
                    <Run Text="当前状态：" />
                    <Run Text="{Binding BadChannelNodeBadge, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F172A" />
                </TextBlock>
                <Button DockPanel.Dock="Right" Content="完成返回" Click="OnDoneClick" IsDefault="True" IsCancel="True"
                        Style="{StaticResource PrepPrimaryButtonStyle}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
