<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.Preprocessing.MontageFilterContractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="03 · 导联投影与零相位滤波契约"
        Width="660" Height="400" MinWidth="580" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F6F8FB">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Modules/Review/Views/Preprocessing/PreprocessingDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="22,15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource PrepBrandSoftBrush}" Margin="0,0,9,0">
                        <TextBlock Text="03" Foreground="{StaticResource PrepBrandBrush}" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="分析导联投影与零相位滤波" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="由科学计算引擎自动执行，与主波形顶部的屏幕显示滤波严格解耦"
                           FontSize="12" Foreground="#64748B" Margin="33,3,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Scientific pipeline card (Brand Blue accent) -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource PrepBrandBorderBrush}"
                    BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource PrepBrandBrush}" />
                    <StackPanel Grid.Row="1" Margin="16,14">
                        <Border Background="{StaticResource PrepBrandSoftBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="科学分析与叠图（自动执行）" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource PrepBrandBrush}" />
                        </Border>
                        <TextBlock Text="当前分析导联" FontSize="11.5" Foreground="#64748B" />
                        <TextBlock Text="{Binding ActiveMontageName}" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,12" TextWrapping="Wrap" />
                        <TextBlock Text="自动滤波规范" FontSize="11.5" Foreground="#64748B" />
                        <TextBlock Text="{Binding ScientificFilterSummary}" FontSize="12.5" Foreground="#475569"
                                   TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Display pipeline card (Neutral Slate accent) -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E5E9F0"
                    BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#CBD5E1" />
                    <StackPanel Grid.Row="1" Margin="16,14">
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="主波形浏览滤波（仅影响显示）" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" />
                        </Border>
                        <TextBlock Text="当前工具栏参数" FontSize="11.5" Foreground="#64748B" />
                        <TextBlock Text="{Binding DisplayFilterSummary}" FontSize="12.5" Foreground="#475569"
                                   TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,12" />
                        <TextBlock Text="调整顶部高通/低通/陷波或临时在线导联不会改动科学算法的计算输入，避免误改科研频段。"
                                   FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,1,0,0" Padding="22,12">
            <Button Content="知道了" Click="OnCloseClick" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                    Style="{StaticResource PrepPrimaryButtonStyle}" />
        </Border>
    </Grid>
</Window>
