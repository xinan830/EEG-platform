<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BrainPlatform.Desktop;component/Modules/Review/Views/Preprocessing/PreprocessingDialogStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Flow card border & subtle tint (strictly 3-color: Neutral / Brand Blue / Warm Amber) -->
    <Style x:Key="ActiveAwareFlowNodeStyle" TargetType="Button" BasedOn="{StaticResource PrepFlowNodeButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
                <Setter Property="BorderBrush" Value="{StaticResource PrepBrandBorderBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="BorderBrush" Value="{StaticResource PrepAlertBorderBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Top accent bar on each flow card -->
    <Style x:Key="NodeTopBarStyle" TargetType="Border">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
                <Setter Property="Background" Value="{StaticResource PrepBrandBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Background" Value="{StaticResource PrepAlertAccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Step numeral badge -->
    <Style x:Key="StepNumberBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="#F1F5F9" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
                <Setter Property="Background" Value="{StaticResource PrepBrandBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Background" Value="{StaticResource PrepAlertAccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StepNumberTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#475569" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Status pill -->
    <Style x:Key="NodeStatusPillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
                <Setter Property="Background" Value="{StaticResource PrepBrandSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Background" Value="{StaticResource PrepAlertPillBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NodeStatusPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#64748B" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
                <Setter Property="Foreground" Value="{StaticResource PrepBrandBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Foreground" Value="{StaticResource PrepAlertBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Connector arrow -->
    <Style x:Key="FlowArrowStyle" TargetType="Path">
        <Setter Property="Data" Value="M 2,8 L 16,8 M 11.5,3.5 L 16,8 L 11.5,12.5" />
        <Setter Property="Stroke" Value="#CBD5E1" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
                <Setter Property="Stroke" Value="{StaticResource PrepBrandBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
