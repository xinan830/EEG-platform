<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.AlgorithmListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Table Row Item Style with Selection Border and Hover Background matching Design Mockup -->
        <Style x:Key="AlgorithmTableRowItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder" Background="Transparent" CornerRadius="8"
                                BorderBrush="Transparent" BorderThickness="1" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation & Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <!-- Page Title & Subtitle -->
            <TextBlock Text="算法列表" FontSize="26" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="官方算法由后端统一计算。" FontSize="13" Foreground="#64748B" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Main Card Container: Filters, Table & Status Footer -->
        <Border Grid.Row="1" Style="{StaticResource AppTableSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filter Bar: Search Input + 3 Dropdown Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" MaxWidth="400" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box with Icon -->
                    <Border Grid.Column="0" Height="38" Background="#FFFFFF" BorderBrush="#E2E8F0"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Margin="12,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="M 10 2 A 8 8 0 1 0 16 14.5 L 21 19.5 L 19.5 21 L 14.5 16 A 8 8 0 0 0 10 2 Z M 10 4 A 6 6 0 1 1 4 10 A 6 6 0 0 1 10 4 Z"
                                  Fill="#2563EB" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />

                            <TextBox Grid.Column="1" x:Name="AlgorithmSearchBox" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="13" Foreground="#0F172A"
                                     Text="{Binding AlgorithmWorkspace.Catalog.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="1" Text="搜索算法名称 / 关键词" Foreground="#94A3B8" FontSize="13"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AlgorithmSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Analysis Mode Filter -->
                    <TextBlock Grid.Column="2" Text="分析模式" VerticalAlignment="Center"
                               Margin="20,0,10,0" Foreground="#334155" FontSize="13" FontWeight="Medium" />
                    <ComboBox Grid.Column="3" Style="{StaticResource AppFilterComboBoxStyle}"
                              ItemsSource="{Binding AlgorithmWorkspace.Catalog.ModeFilters}"
                              SelectedItem="{Binding AlgorithmWorkspace.Catalog.SelectedModeFilter}" />

                    <!-- Availability Filter -->
                    <TextBlock Grid.Column="4" Text="算法状态" VerticalAlignment="Center"
                               Margin="20,0,10,0" Foreground="#334155" FontSize="13" FontWeight="Medium" />
                    <ComboBox Grid.Column="5" Style="{StaticResource AppFilterComboBoxStyle}"
                              ItemsSource="{Binding AlgorithmWorkspace.Catalog.AvailabilityFilters}"
                              SelectedItem="{Binding AlgorithmWorkspace.Catalog.SelectedAvailabilityFilter}" />

                    <!-- Algorithm Type Filter -->
                    <TextBlock Grid.Column="6" Text="算法类型" VerticalAlignment="Center"
                               Margin="20,0,10,0" Foreground="#334155" FontSize="13" FontWeight="Medium" />
                    <ComboBox Grid.Column="7" Style="{StaticResource AppFilterComboBoxStyle}"
                              ItemsSource="{Binding AlgorithmWorkspace.Catalog.TypeFilters}"
                              SelectedItem="{Binding AlgorithmWorkspace.Catalog.SelectedTypeFilter}" />
                </Grid>

                <!-- Table Header Bar: Shared Adaptive Column Definitions -->
                <Border Grid.Row="1" Style="{StaticResource AppTableHeaderBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" MinWidth="130" />
                            <ColumnDefinition Width="1.1*" MinWidth="100" />
                            <ColumnDefinition Width="2.8*" MinWidth="240" />
                            <ColumnDefinition Width="1.0*" MinWidth="90" />
                            <ColumnDefinition Width="1.0*" MinWidth="90" />
                            <ColumnDefinition Width="0.9*" MinWidth="80" />
                            <ColumnDefinition Width="1.0*" MinWidth="90" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource AppTableHeaderTextStyle}" Text="算法中文名称" />
                        <TextBlock Grid.Column="1" Style="{StaticResource AppTableHeaderTextStyle}" Text="算法编码" />
                        <TextBlock Grid.Column="2" Style="{StaticResource AppTableHeaderTextStyle}" Text="用途说明" />
                        <TextBlock Grid.Column="3" Style="{StaticResource AppTableHeaderTextStyle}" Text="支持模式" />
                        <TextBlock Grid.Column="4" Style="{StaticResource AppTableHeaderTextStyle}" Text="结果类型" />
                        <TextBlock Grid.Column="5" Style="{StaticResource AppTableHeaderTextStyle}" Text="科学版本" />
                        <TextBlock Grid.Column="6" Style="{StaticResource AppTableHeaderTextStyle}" Text="当前状态" />
                        <TextBlock Grid.Column="7" Style="{StaticResource AppTableHeaderTextStyle}" Text="查看详情" />
                    </Grid>
                </Border>

                <!-- Table Body: ListView with Shared Adaptive Column Definitions per Row -->
                <ListView Grid.Row="2" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding AlgorithmWorkspace.Catalog.VisibleItems}"
                          SelectedItem="{Binding AlgorithmWorkspace.Catalog.SelectedAlgorithm, Mode=TwoWay}"
                          SelectionMode="Single"
                          ItemContainerStyle="{StaticResource AlgorithmTableRowItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="50">
                                <!-- Identical Column Definitions as Header Bar for Mathematical Alignment -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" MinWidth="130" />
                                    <ColumnDefinition Width="1.1*" MinWidth="100" />
                                    <ColumnDefinition Width="2.8*" MinWidth="240" />
                                    <ColumnDefinition Width="1.0*" MinWidth="90" />
                                    <ColumnDefinition Width="1.0*" MinWidth="90" />
                                    <ColumnDefinition Width="0.9*" MinWidth="80" />
                                    <ColumnDefinition Width="1.0*" MinWidth="90" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <!-- Row Divider Line -->
                                <Border Grid.ColumnSpan="8" Style="{StaticResource AppTableRowDividerStyle}" />

                                <!-- Column 0: Chinese Name -->
                                <TextBlock Grid.Column="0" Style="{StaticResource AppTableCellTextStyle}"
                                           Text="{Binding DisplayNameZh}" FontWeight="SemiBold" Foreground="#0F172A" />

                                <!-- Column 1: Algorithm Code / Abbreviation -->
                                <TextBlock Grid.Column="1" Style="{StaticResource AppTableCellTextStyle}"
                                           Text="{Binding Abbreviation}" Foreground="#334155" />

                                <!-- Column 2: Purpose Description -->
                                <TextBlock Grid.Column="2" Style="{StaticResource AppTableCellTextStyle}"
                                           Text="{Binding Description}" Foreground="#475569"
                                           ToolTipService.InitialShowDelay="100"
                                           ToolTipService.ShowDuration="20000">
                                    <TextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource AppDescriptionToolTipStyle}" Content="{Binding Description}" />
                                    </TextBlock.ToolTip>
                                </TextBlock>

                                <!-- Column 3: Supported Modes -->
                                <TextBlock Grid.Column="3" Style="{StaticResource AppTableCellTextStyle}"
                                           Text="{Binding ModesDisplay}" Foreground="#334155" />

                                <!-- Column 4: Result Type -->
                                <TextBlock Grid.Column="4" Style="{StaticResource AppTableCellTextStyle}"
                                           Text="{Binding ResultTypeDisplay}" Foreground="#334155" />

                                <!-- Column 5: Scientific Version -->
                                <TextBlock Grid.Column="5" Style="{StaticResource AppTableCellTextStyle}"
                                           Text="{Binding Version}" Foreground="#334155"
                                           ToolTipService.InitialShowDelay="100"
                                           ToolTipService.ShowDuration="20000">
                                    <TextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource AppDescriptionToolTipStyle}" Content="{Binding Version}" />
                                    </TextBlock.ToolTip>
                                </TextBlock>

                                <!-- Column 6: Current Status Pill Badge -->
                                <Border Grid.Column="6" Height="24" CornerRadius="12" Padding="8,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#ECFDF5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusDisplay}" Value="验证中">
                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusDisplay}" Value="不可用">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusDisplay}" Value="不可运行">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#10B981" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="验证中">
                                                            <Setter Property="Fill" Value="#2563EB" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="不可用">
                                                            <Setter Property="Fill" Value="#94A3B8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="不可运行">
                                                            <Setter Property="Fill" Value="#94A3B8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#059669" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="验证中">
                                                            <Setter Property="Foreground" Value="#2563EB" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="不可用">
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusDisplay}" Value="不可运行">
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Column 7: View Details Button -->
                                <Button Grid.Column="7" Content="查看详情"
                                        Command="{Binding DataContext.AlgorithmWorkspace.OpenDetailCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                                        Height="28" Padding="12,0" Background="#EFF6FF" Foreground="#2563EB"
                                        FontSize="12" FontWeight="Medium" Cursor="Hand" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="#DBEAFE" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State Message -->
                <TextBlock Grid.Row="2" Text="暂无符合条件的算法" Foreground="#94A3B8" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AlgorithmWorkspace.Catalog.VisibleItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Footer Status Bar -->
                <Grid Grid.Row="3" Margin="16,14,16,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status Text (e.g. 已加载 9 个官方算法) -->
                    <TextBlock Grid.Column="0" Text="{Binding AlgorithmWorkspace.Catalog.StatusText}"
                               Foreground="#475569" FontSize="13" VerticalAlignment="Center" />

                    <!-- Right: Status Indicators from Mockup (Loading, Failed, Empty) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Loading Indicator -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Catalog.IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="M 12 2 A 10 10 0 0 1 22 12" Stroke="#2563EB" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13"
                                  RenderTransformOrigin="0.5,0.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlgorithmWorkspace.Catalog.IsLoading}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="正在加载..." Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Load Failed Indicator -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Catalog.IsLoadFailed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="M 12 2 A 10 10 0 1 0 22 12 A 10 10 0 0 0 12 2 Z M 15 9 L 9 15 M 9 9 L 15 15"
                                  Stroke="#EF4444" Fill="#EF4444" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="加载失败" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- No Algorithms Indicator -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding AlgorithmWorkspace.Catalog.IsLoading}" Value="False" />
                                                <Condition Binding="{Binding AlgorithmWorkspace.Catalog.IsLoadFailed}" Value="False" />
                                                <Condition Binding="{Binding AlgorithmWorkspace.Catalog.VisibleItems.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="M 12 2 A 10 10 0 1 0 22 12 A 10 10 0 0 0 12 2 Z M 12 16 L 12 11 M 12 8 L 12.01 8"
                                  Stroke="#64748B" Fill="#64748B" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="暂无算法" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
