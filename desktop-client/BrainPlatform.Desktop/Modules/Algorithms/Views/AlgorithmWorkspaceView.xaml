<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.AlgorithmWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views"
             Background="#F8FAFC">
    <Grid>
        <views:AlgorithmListView>
            <views:AlgorithmListView.Style>
                <Style TargetType="views:AlgorithmListView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AlgorithmWorkspace.IsListOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:AlgorithmListView.Style>
        </views:AlgorithmListView>
        <views:AlgorithmDetailView>
            <views:AlgorithmDetailView.Style>
                <Style TargetType="views:AlgorithmDetailView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AlgorithmWorkspace.IsDetailOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:AlgorithmDetailView.Style>
        </views:AlgorithmDetailView>
    </Grid>
</UserControl>
