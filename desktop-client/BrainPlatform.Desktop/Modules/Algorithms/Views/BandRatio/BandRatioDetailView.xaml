<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.BandRatio.BandRatioDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.BandRatio">
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20,18"><StackPanel>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="频段功率比" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/><TextBlock Grid.Column="1" Text="{Binding ChannelText, StringFormat=通道：{0}}" FontSize="12" Foreground="#475569"/></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18,16"><StackPanel><TextBlock Text="当前比值" Foreground="#64748B" FontSize="12"/><TextBlock Text="{Binding ValueText}" Foreground="#0F172A" FontSize="32" FontWeight="SemiBold" Margin="0,3,0,5"/><TextBlock Text="{Binding QualityText}" Foreground="#475569" TextWrapping="Wrap"/><TextBlock Text="无量纲比值" Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="220"/><ColumnDefinition Width="160"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="分析窗口" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding WindowText}"/><TextBlock Grid.Column="2" Text="分子频段" Foreground="#64748B"/><TextBlock Grid.Column="3" Text="{Binding NumeratorRangeText}"/><TextBlock Grid.Row="1" Text="分母频段" Foreground="#64748B"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DenominatorRangeText}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="分子功率" Foreground="#64748B"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding NumeratorPowerText}"/><TextBlock Grid.Row="2" Text="分母功率" Foreground="#64748B"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DenominatorPowerText}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="计算公式" Foreground="#64748B"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding FormulaText}" TextWrapping="Wrap"/></Grid></Border></Grid>
        <Grid Margin="0,24,0,0" Height="420"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDynamicResult}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><local:BandRatioTrendChart Points="{Binding TrendPoints}" StartSeconds="{Binding TimelineStartSeconds}" EndSeconds="{Binding TimelineEndSeconds}"/></Grid>
    </StackPanel></Border>
</UserControl>
