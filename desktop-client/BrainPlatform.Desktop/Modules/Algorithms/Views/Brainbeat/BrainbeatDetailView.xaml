<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Brainbeat.BrainbeatDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:brainbeat="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Brainbeat">
  <StackPanel>
    <TextBlock Text="算法专属结果" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
    <Border Margin="0,12,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
      <StackPanel>
        <TextBlock Text="Brainbeat 脑节律指标" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
        <TextBlock Text="{Binding ResultText}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#1677FF" />
        <TextBlock Text="{Binding ChannelText, StringFormat=来源通道：{0}}" Margin="0,8,0,0" Foreground="#475569" />
      </StackPanel>
    </Border>
    <brainbeat:BrainbeatTrendChart Points="{Binding TrendPoints}" StartSeconds="{Binding TimelineStartSeconds}" EndSeconds="{Binding TimelineEndSeconds}" Height="420" Margin="0,18,0,0" />
  </StackPanel>
</UserControl>
