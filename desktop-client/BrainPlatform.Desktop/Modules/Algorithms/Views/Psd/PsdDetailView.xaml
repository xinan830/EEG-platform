<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Psd.PsdDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Psd"
             Background="Transparent">

    <!-- Card: 功率谱密度（PSD） -->
    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header Toolbar -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Chart Plot & Axes -->
                <RowDefinition Height="*" MinHeight="640" />
            </Grid.RowDefinitions>

            <!-- Top Header Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title with Network/Scatter Icon and Info Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Synapse / Scatter PSD Icon matching mockup -->
                    <Canvas Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Path Stroke="#1677FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 3,4 L 15,14 M 3,14 L 7,10 M 15,4 L 11,8" />
                        <Ellipse Canvas.Left="1" Canvas.Top="2" Width="4.5" Height="4.5" Fill="#1677FF" />
                        <Ellipse Canvas.Left="1" Canvas.Top="11.5" Width="4.5" Height="4.5" Fill="#1677FF" />
                        <Ellipse Canvas.Left="12.5" Canvas.Top="2" Width="4.5" Height="4.5" Fill="#1677FF" />
                        <Ellipse Canvas.Left="12.5" Canvas.Top="11.5" Width="4.5" Height="4.5" Fill="#1677FF" />
                    </Canvas>
                    <TextBlock Text="{Binding SelectedChart.Label}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    <TextBlock Text="ⓘ" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"
                               ToolTip="功率谱密度（PSD）反映脑电信号在各频段上的功率分布特征" Cursor="Help" />
                </StackPanel>

                <!-- Right: Channel and chart selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="通道: " FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedChannel, TargetNullValue=Pz, FallbackValue=Pz}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                    </StackPanel>

                    <ComboBox Width="152" Height="32"
                              Style="{StaticResource AppFilterComboBoxStyle}"
                              ItemsSource="{Binding ChartOptions}"
                              SelectedItem="{Binding SelectedChart, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Main Chart Area (Plot + Y Axis + X Axis) -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSpectrumSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.RowDefinitions>
                    <!-- Row 0: Frequency band legend, kept outside the plot -->
                <RowDefinition Height="16" />
                    <!-- Row 1: Plot Canvas Area (with Y-ticks on left) -->
                    <RowDefinition Height="*" />
                    <!-- Row 1: X-axis Ticks & Numbers -->
                    <RowDefinition Height="0" />
                    <!-- Row 2: X-axis Title (频率（Hz）) -->
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Leave only the external unit/axis-label gutter here. The
                         chart owns its numeric Y labels; a wider gutter makes
                         its internal axis boundary look like extra vertical lines. -->
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Col 0, Row 1: Y-axis Title Rotated -90 degrees -->
                <TextBlock Visibility="Collapsed" Grid.Row="1" Grid.Column="0"
                           Text="{Binding ValueUnit, StringFormat='功率谱密度（{0}）', TargetNullValue='功率谱密度（μV²/Hz）', FallbackValue='功率谱密度（μV²/Hz）'}"
                           FontSize="9" FontWeight="Medium" Foreground="#475569"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <!-- Col 1, Row 0: Y-axis Ticks (50, 40, 30, 20, 10, 0) -->
                <!-- Frequency band legend, separate from the plot so labels never overlap the axis unit. -->
                <Grid Visibility="Collapsed" Grid.Row="0" Grid.Column="1" ClipToBounds="True" Margin="0,0,38,0">
                    <Border BorderBrush="Transparent" BorderThickness="0" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Delta: 0 - 4 Hz (4/50) -->
                                <ColumnDefinition Width="4*" />
                                <!-- Theta: 4 - 8 Hz (4/50) -->
                                <ColumnDefinition Width="4*" />
                                <!-- Alpha: 8 - 13 Hz (5/50) -->
                                <ColumnDefinition Width="5*" />
                                <!-- Beta: 13 - 30 Hz (17/50) -->
                                <ColumnDefinition Width="17*" />
                                <!-- Gamma: 30 - 50 Hz (20/50) -->
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>

                            <!-- δ Delta (0.5 – 4 Hz) -->
                            <Border Grid.Column="0" Background="#EFF6FF">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="δ Delta" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="0.5 – 4 Hz" Foreground="#2563EB" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- θ Theta (4 – 8 Hz) -->
                            <Border Grid.Column="1" Background="#ECFDF5">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="θ Theta" Foreground="#059669" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="4 – 8 Hz" Foreground="#059669" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- α Alpha (8 – 13 Hz) -->
                            <Border Grid.Column="2" Background="#FFF1F2">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="α Alpha" Foreground="#DC2626" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="8 – 13 Hz" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- β Beta (13 – 30 Hz) -->
                            <Border Grid.Column="3" Background="#FFFBEB">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="β Beta" Foreground="#D97706" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="13 – 30 Hz" Foreground="#D97706" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- γ Gamma (30 – 50 Hz) -->
                            <Border Grid.Column="4" Background="#F5F3FF">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="γ Gamma" Foreground="#7C3AED" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="30 – 50 Hz" Foreground="#7C3AED" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                </Grid>

                <!-- Col 1, Row 1: Main PSD plot with colored frequency bands behind the curve. -->
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="Transparent" BorderThickness="0" ClipToBounds="True">
                    <Grid>
                        <local:PsdLiveChart Grid.ColumnSpan="5"
                                            Points="{Binding PreviewPoints}"
                                            Unit="{Binding ValueUnit, TargetNullValue='μV²/Hz', FallbackValue='μV²/Hz'}"
                                            ClipToBounds="True" Panel.ZIndex="1" />
                    </Grid>
                </Border>

                <!-- Col 2, Row 1: X-axis Ticks & Numbers (0, 10, 20, 30, 40, 50) -->
                <Grid Visibility="Collapsed" Grid.Row="2" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Tick 0 -->
                    <Line Grid.Column="0" X1="0" Y1="0" X2="0" Y2="4" Stroke="#94A3B8" StrokeThickness="1" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="0" Text="0" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" Margin="-3,6,0,0" />

                    <!-- Tick 10 -->
                    <Line Grid.Column="0" X1="0" Y1="0" X2="0" Y2="4" Stroke="#94A3B8" StrokeThickness="1" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="0" Text="10" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,6,-6,0" />

                    <!-- Tick 20 -->
                    <Line Grid.Column="1" X1="0" Y1="0" X2="0" Y2="4" Stroke="#94A3B8" StrokeThickness="1" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Text="20" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,6,-6,0" />

                    <!-- Tick 30 -->
                    <Line Grid.Column="2" X1="0" Y1="0" X2="0" Y2="4" Stroke="#94A3B8" StrokeThickness="1" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="30" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,6,-6,0" />

                    <!-- Tick 40 -->
                    <Line Grid.Column="3" X1="0" Y1="0" X2="0" Y2="4" Stroke="#94A3B8" StrokeThickness="1" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="40" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,6,-6,0" />

                    <!-- Tick 50 -->
                    <Line Grid.Column="4" X1="0" Y1="0" X2="0" Y2="4" Stroke="#94A3B8" StrokeThickness="1" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="50" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,6,-6,0" />
                </Grid>

                <!-- Col 2, Row 2: X-axis Title (频率（Hz）) -->
                <TextBlock Visibility="Collapsed" Grid.Row="3" Grid.Column="1" Text="频率（Hz）" FontSize="9" FontWeight="Medium" Foreground="#475569"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" />
            </Grid>
            <local:PsdBandShareChart Grid.Row="1" Margin="0,0,0,8"
                                     Points="{Binding BandSharePoints}">
                <local:PsdBandShareChart.Style><Style TargetType="local:PsdBandShareChart"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBandShareSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:PsdBandShareChart.Style>
            </local:PsdBandShareChart>
        </Grid>
    </Border>
</UserControl>
