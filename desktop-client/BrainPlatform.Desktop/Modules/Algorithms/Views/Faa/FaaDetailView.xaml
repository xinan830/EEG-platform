<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Faa.FaaDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Faa">
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20,18">
        <StackPanel>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="额叶 Alpha 不对称性" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/><TextBlock Grid.Column="1" Text="{Binding ChannelText, StringFormat=通道：{0}}" FontSize="12" Foreground="#475569"/></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18,16"><StackPanel><TextBlock Text="当前 FAA" Foreground="#64748B" FontSize="12"/><TextBlock Text="{Binding ValueText}" Foreground="#0F172A" FontSize="32" FontWeight="SemiBold" Margin="0,3,0,5"/><TextBlock Text="{Binding StatusText}" Foreground="#475569" TextWrapping="Wrap"/><TextBlock Text="无量纲对数差" Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20,14" HorizontalAlignment="Left" MaxWidth="760"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="分析窗口" Foreground="#64748B" Margin="0,0,12,10"/><TextBlock Grid.Column="1" Text="{Binding WindowText}" Foreground="#0F172A" Margin="0,0,20,10"/><TextBlock Grid.Column="2" Text="Alpha 频段" Foreground="#64748B" Margin="0,0,12,10"/><TextBlock Grid.Column="3" Text="{Binding AlphaBandText}" Foreground="#0F172A" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Text="左侧来源（F3）" Foreground="#64748B" Margin="0,0,12,10"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LeftChannelText}" Foreground="#0F172A" Margin="0,0,20,10"/><TextBlock Grid.Row="1" Grid.Column="2" Text="右侧来源（F4）" Foreground="#64748B" Margin="0,0,12,10"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding RightChannelText}" Foreground="#0F172A" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="2" Text="左侧 Alpha 功率" Foreground="#64748B" Margin="0,0,12,10"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LeftPowerText}" Foreground="#0F172A" Margin="0,0,20,10"/><TextBlock Grid.Row="2" Grid.Column="2" Text="右侧 Alpha 功率" Foreground="#64748B" Margin="0,0,12,10"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding RightPowerText}" Foreground="#0F172A" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="3" Text="有效 Epoch" Foreground="#64748B" Margin="0,0,12,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EpochText}" Foreground="#0F172A" Margin="0,0,20,0"/><TextBlock Grid.Row="3" Grid.Column="2" Text="计算公式" Foreground="#64748B" Margin="0,0,12,0"/><TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding FormulaText}" Foreground="#0F172A" TextWrapping="Wrap"/>
                </Grid></Border>
            </Grid>
            <Grid Margin="0,24,0,0" Height="520" HorizontalAlignment="Stretch"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDynamicResult}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><local:FaaTrendChart HorizontalAlignment="Stretch" Points="{Binding TrendPoints}" StartSeconds="{Binding TimelineStartSeconds}" EndSeconds="{Binding TimelineEndSeconds}"/></Grid>
        </StackPanel>
    </Border>
</UserControl>
