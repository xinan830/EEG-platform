<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Shared.QualityStatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <UserControl.Resources>
        <!-- Pill Badge for Quality Status -->
        <Style x:Key="QualityPillBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2.5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding QualityText}" Value="良好">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityText}" Value="通过">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityText}" Value="尚未运行分析">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QualityPillBadgeDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#2563EB" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding QualityText}" Value="良好">
                    <Setter Property="Fill" Value="#10B981" />
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityText}" Value="通过">
                    <Setter Property="Fill" Value="#10B981" />
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityText}" Value="尚未运行分析">
                    <Setter Property="Fill" Value="#94A3B8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QualityPillBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding QualityText}" Value="良好">
                    <Setter Property="Foreground" Value="#059669" />
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityText}" Value="通过">
                    <Setter Property="Foreground" Value="#059669" />
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityText}" Value="尚未运行分析">
                    <Setter Property="Foreground" Value="#64748B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Action Button for Failure Details -->
        <Style x:Key="FailureDetailsButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1677FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,18">
        <StackPanel>
            <!-- Header (matches Card 4 on the left) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                <Border Width="22" Height="22" CornerRadius="11" Background="#1677FF" Margin="0,0,8,0">
                    <TextBlock Text="5" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="质量状态" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Top Metrics: 4 distinct columns with ample breathing room to prevent collision -->
            <Grid Margin="0,2,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Column 0: 数据质量状态 (Pill Badge) -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Center">
                    <TextBlock Text="数据质量状态" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" HorizontalAlignment="Center" TextAlignment="Center" />
                    <Border Style="{StaticResource QualityPillBadgeBorderStyle}" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource QualityPillBadgeDotStyle}" />
                            <TextBlock Text="{Binding QualityText}" Style="{StaticResource QualityPillBadgeTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Column 1: 质量门 (Pill Badge) -->
                <StackPanel Grid.Column="1" Margin="0,0,8,0" HorizontalAlignment="Center">
                    <TextBlock Text="质量门" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" HorizontalAlignment="Center" TextAlignment="Center" />
                    <Border Style="{StaticResource QualityPillBadgeBorderStyle}" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource QualityPillBadgeDotStyle}" />
                            <TextBlock Text="{Binding QualityText}" Style="{StaticResource QualityPillBadgeTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Column 2: 不可用窗口 -->
                <StackPanel Grid.Column="2" Margin="0,0,8,0" HorizontalAlignment="Center">
                    <TextBlock Text="不可用窗口" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding UnavailableWindowCount}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <!-- Column 3: 被拒绝窗口 -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="被拒绝窗口" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding RejectedWindowCount}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Diagnostic Sub-Card: 窗口状态、失败原因与排查入口 (Mirrors Card 4's Preview Sub-Card) -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,2,0,0">
                <StackPanel>
                    <!-- Window Status and Failure Reason in balanced two columns -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 窗口状态 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="窗口状态" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding WindowStateSummary}"
                                       FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 失败原因 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="失败原因" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding FailureReasonText, TargetNullValue=无}"
                                       FontSize="12" Foreground="#475569" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Sleek Secondary Action Button for Failure Details -->
                    <Button Command="{Binding ToggleFailureDetailsCommand}"
                            Style="{StaticResource FailureDetailsButtonStyle}"
                            Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 11,16 H 13 V 18 H 11 Z M 11,6 H 13 V 14 H 11 Z"
                                  Fill="#64748B" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="查看窗口失败原因" FontSize="11.5" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center" />
                            <Path Data="M 1,1 L 4.5,4.5 L 8,1" Stroke="#64748B" StrokeThickness="1.5" Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="6,1,0,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFailureDetailsExpanded}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" CenterX="4" CenterY="2.5" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </StackPanel>
                    </Button>

                    <!-- Expandable Failure Details Card -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFailureDetailsExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer MaxHeight="160"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding FailureDetailsText}"
                                       FontSize="11.5"
                                       Foreground="#334155"
                                       LineHeight="18"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
