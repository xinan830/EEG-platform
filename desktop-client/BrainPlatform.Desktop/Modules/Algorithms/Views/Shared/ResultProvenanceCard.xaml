<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Shared.ResultProvenanceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ProvenanceLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#64748B" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ProvenanceValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="#0F172A" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,16">
        <StackPanel>
            <TextBlock Text="结果溯源" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" /><RowDefinition Height="25" /><RowDefinition Height="25" /><RowDefinition Height="25" />
                    <RowDefinition Height="25" /><RowDefinition Height="25" /><RowDefinition Height="25" /><RowDefinition Height="28" />
                    <RowDefinition Height="25" /><RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Text="Run ID" Style="{StaticResource ProvenanceLabelStyle}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RunIdText}" Style="{StaticResource ProvenanceValueStyle}" />
                <TextBlock Grid.Row="1" Text="Recording ID" Style="{StaticResource ProvenanceLabelStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RecordingIdText}" Style="{StaticResource ProvenanceValueStyle}" />
                <TextBlock Grid.Row="2" Text="算法版本" Style="{StaticResource ProvenanceLabelStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AlgorithmVersionText}" Style="{StaticResource ProvenanceValueStyle}" />
                <TextBlock Grid.Row="3" Text="实现版本" Style="{StaticResource ProvenanceLabelStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ImplementationVersionText}" Style="{StaticResource ProvenanceValueStyle}" />
                <TextBlock Grid.Row="4" Text="实际通道" Style="{StaticResource ProvenanceLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedChannelText}" Style="{StaticResource ProvenanceValueStyle}" />
                <TextBlock Grid.Row="5" Text="请求时间范围" Style="{StaticResource ProvenanceLabelStyle}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RequestedRangeText}" Style="{StaticResource ProvenanceValueStyle}" />
                <TextBlock Grid.Row="6" Text="实际分析范围" Style="{StaticResource ProvenanceLabelStyle}" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ActualRangeText, Mode=OneWay}" Style="{StaticResource ProvenanceValueStyle}" />
                <TextBlock Grid.Row="7" Text="参数快照" Style="{StaticResource ProvenanceLabelStyle}" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ParameterSnapshotText}" Style="{StaticResource ProvenanceValueStyle}" />
                <TextBlock Grid.Row="8" Text="输出单位" Style="{StaticResource ProvenanceLabelStyle}" /><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding OutputUnitText}" Style="{StaticResource ProvenanceValueStyle}" />
                <TextBlock Grid.Row="9" Text="结果生成时间" Style="{StaticResource ProvenanceLabelStyle}" /><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ResultTimeText}" Style="{StaticResource ProvenanceValueStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
