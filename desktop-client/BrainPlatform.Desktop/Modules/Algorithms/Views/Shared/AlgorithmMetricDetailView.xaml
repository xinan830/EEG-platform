<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Shared.AlgorithmMetricDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel>
        <TextBlock Text="算法专属参数" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
        <ItemsControl ItemsSource="{Binding AlgorithmWorkspace.Detail.Algorithm.Parameters}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding LabelZh}" Foreground="#475569" />
                        <TextBlock Grid.Column="1" Text="{Binding DescriptionZh}" Foreground="#64748B" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Margin="0,20,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Text="该算法的专属结果和图表将在此展示。" Foreground="#64748B" />
                <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Algorithm.ResultTypeDisplay, StringFormat=结果类型：{0}}"
                           Margin="0,8,0,0" Foreground="#0F172A" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
