<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Shared.DynamicResultCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,18">
        <StackPanel>
            <!-- Card Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="11" Background="#1677FF" Margin="0,0,8,0">
                        <TextBlock Text="8" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="动态结果（按时间）" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Record Count Pill Badge -->
                <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,2.5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="共 " FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DynamicPreviewRows.Count, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="#1677FF" VerticalAlignment="Center" />
                        <TextBlock Text=" 窗口" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Table Container with Rounded Border and ClipToBounds -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="窗口开始时间" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="1" Text="窗口结束时间" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="2" Text="窗口状态" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="3" Text="质量状态" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="4" Text="失败原因" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="12,0,12,0" />
                        </Grid>
                    </Border>

                    <!-- Table Body -->
                    <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DynamicPreviewRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Start Seconds -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StartSeconds, StringFormat={}{0:0.##} 秒}"
                                                       FontSize="12" Foreground="#334155" FontWeight="Medium"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />

                                            <!-- End Seconds -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EndSeconds, StringFormat={}{0:0.##} 秒}"
                                                       FontSize="12" Foreground="#334155" FontWeight="Medium"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />

                                            <!-- State (完整 / 已拒绝 / 不可用) with color styling -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding State}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#334155" />
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="完整">
                                                                <Setter Property="Foreground" Value="#059669" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="已拒绝">
                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="不可用">
                                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Quality (clean / gate_failed) with color styling -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Quality}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569" />
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="clean">
                                                                <Setter Property="Foreground" Value="#059669" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="gate_failed">
                                                                <Setter Property="Foreground" Value="#D97706" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Failure Reason -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Failure, TargetNullValue=-}"
                                                       FontSize="12" Foreground="#64748B"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Margin="12,0,12,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
