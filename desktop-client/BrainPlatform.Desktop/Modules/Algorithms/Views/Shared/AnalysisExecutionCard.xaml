<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Shared.AnalysisExecutionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Modern Slider Styles -->
        <Style x:Key="ModernSliderTrackRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" CornerRadius="{TemplateBinding Tag}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="16" Height="16">
                            <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#1677FF" StrokeThickness="2.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Color="#0F172A" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="4" Height="4" Fill="#1677FF" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ProgressBar Template -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#1677FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Track" CornerRadius="3" ClipToBounds="True">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="3" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,18">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="22" Height="22" CornerRadius="11" Background="#1677FF" Margin="0,0,8,0">
                    <TextBlock Text="4" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="执行分析" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Auto Analysis Badge & Retry Button -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="10,3.5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="选择后自动分析" FontSize="12" FontWeight="Medium" Foreground="#1D4ED8" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 重试分析按钮 -->
                <Button Grid.Column="2"
                        Command="{Binding RunCommand}"
                        Height="30" Padding="12,0"
                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC" />
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#EFF6FF" />
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1677FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 M 17,4 V 9 H 22"
                              Stroke="#475569" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="重试分析" FontSize="12" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Execution Progress -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Value="{Binding RunProgressPercent, Mode=OneWay}"
                             Maximum="100"
                             Style="{StaticResource ModernProgressBarStyle}"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding RunProgressText, Mode=OneWay}"
                           FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Dynamic Preview Container -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDynamicMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="时间同步预览" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <TextBlock Text="（基于已完成记录，不接入采集/回溯）" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Control Buttons: 开始, 暂停, 单步, 重置 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <!-- 开始/暂停 动态切换按钮 (统一为一个按钮) -->
                        <Grid Margin="0,0,8,0">
                            <!-- 未播放时显示：开始 -->
                            <Button Command="{Binding StartDynamicPreviewCommand}" Height="28" Padding="12,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDynamicPreviewPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#DBEAFE" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#93C5FD" /></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#BFDBFE" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#2563EB" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 2,1 L 9,6 L 2,11 Z" Fill="#1677FF" Width="9" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="开始" FontSize="12" Foreground="#1677FF" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 播放中时显示：暂停 -->
                            <Button Command="{Binding PauseDynamicPreviewCommand}" Height="28" Padding="12,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDynamicPreviewPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#DBEAFE" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#93C5FD" /></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#BFDBFE" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#2563EB" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 1,1 H 3 V 10 H 1 Z M 5,1 H 7 V 10 H 5 Z" Fill="#1D4ED8" Width="8" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="暂停" FontSize="12" Foreground="#1D4ED8" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 单步按钮 -->
                        <Button Command="{Binding StepDynamicPreviewCommand}" Height="28" Padding="12,0" Margin="8,0,0,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8" /></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#EFF6FF" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#1677FF" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 1,1 L 6.5,5.5 L 1,10 Z M 7,1 H 9 V 10 H 7 Z" Fill="#334155" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="单步" FontSize="12" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 重置按钮 -->
                        <Button Command="{Binding ResetDynamicPreviewCommand}" Height="28" Padding="12,0" Margin="8,0,0,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8" /></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#EFF6FF" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#1677FF" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 M 17,4 V 9 H 22"
                                      Stroke="#334155" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="重置" FontSize="12" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Status indicators: 游标, 已释放窗口, 状态 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="游标" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DynamicPreviewCursorText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="5,0,14,0" VerticalAlignment="Center" />
                        <TextBlock Text="已释放窗口" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DynamicPreviewRows.Count, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="5,0,14,0" VerticalAlignment="Center" />
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DynamicPreviewStatusText, Mode=OneWay}" FontSize="11" Foreground="#059669" FontWeight="Medium" />
                        </Border>
                    </StackPanel>

                    <!-- Slider Progress -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Value="{Binding DynamicTimeProgressPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0"
                                Maximum="100"
                                IsMoveToPointEnabled="True"
                                Height="20"
                                VerticalAlignment="Center"
                                ToolTip="拖动时间进度，查看对应的动态分析窗口">
                            <Slider.Template>
                                <ControlTemplate TargetType="Slider">
                                    <Grid VerticalAlignment="Center">
                                        <Track x:Name="PART_Track">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ModernSliderTrackRepeatButtonStyle}" Background="#1677FF" Height="5" Tag="2.5,0,0,2.5" Command="Slider.DecreaseLarge" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ModernSliderThumbStyle}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ModernSliderTrackRepeatButtonStyle}" Background="#E2E8F0" Height="5" Tag="0,2.5,2.5,0" Command="Slider.IncreaseLarge" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Slider.Template>
                        </Slider>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DynamicTimeProgressText, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#334155"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding DynamicCurrentWindowText, Mode=OneWay}"
                               FontSize="11.5"
                               Foreground="#64748B"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
