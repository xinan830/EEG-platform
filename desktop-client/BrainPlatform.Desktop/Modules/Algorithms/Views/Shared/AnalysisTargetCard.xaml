<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Shared.AnalysisTargetCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,0,0,14">
        <StackPanel>
            <!-- Card Header -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                <Border Width="22" Height="22" CornerRadius="11" Background="#1677FF" Margin="0,0,8,0">
                    <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="分析对象" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Control Bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. 项目 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="项目" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource AppFilterComboBoxStyle}" Width="180" Height="32"
                              ItemsSource="{Binding Projects.Projects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 2. 已完成记录 -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="已完成记录" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource AppFilterComboBoxStyle}" Width="210" Height="32"
                              ItemsSource="{Binding CompletedRecordings}"
                              SelectedItem="{Binding SelectedProjectRecording, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 3. 选择后自动注册 徽标 -->
                <Border Grid.Column="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12"
                        Padding="10,3.5" Margin="0,24,0,0" VerticalAlignment="Top" Height="30">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="选择后自动注册" FontSize="11.5" FontWeight="Medium" Foreground="#1D4ED8" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 4. 记录元数据指标卡片 -->
                <Border Grid.Column="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                        Padding="16,6" Height="56" VerticalAlignment="Top">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="75" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="75" />
                        </Grid.ColumnDefinitions>

                        <!-- 记录时长 -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="记录时长" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding RegisteredRecording.DurationSeconds, StringFormat='{}{0:0.###} s', FallbackValue='未注册', TargetNullValue='未注册'}"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" />
                        </StackPanel>

                        <!-- 分割线 1 -->
                        <Border Grid.Column="1" Width="1" Height="22" Background="#E2E8F0" Margin="16,0" VerticalAlignment="Center" />

                        <!-- 采样率 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="采样率" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding RegisteredRecording.SamplingRateHz, StringFormat='{}{0:0.###} Hz', FallbackValue='未注册', TargetNullValue='未注册'}"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" />
                        </StackPanel>

                        <!-- 分割线 2 -->
                        <Border Grid.Column="3" Width="1" Height="22" Background="#E2E8F0" Margin="16,0" VerticalAlignment="Center" />

                        <!-- 可用通道 -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="可用通道" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding RegisteredChannels.Count, FallbackValue='0', TargetNullValue='0'}"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 5. 分析通道 -->
                <StackPanel Grid.Column="8">
                    <TextBlock Text="分析通道" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                    <ComboBox Style="{StaticResource AppFilterComboBoxStyle}" Width="140" Height="32"
                              ItemsSource="{Binding RegisteredChannels}"
                              SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
