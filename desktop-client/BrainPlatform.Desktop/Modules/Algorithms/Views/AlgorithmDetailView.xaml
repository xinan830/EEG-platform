<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.AlgorithmDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:psd="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Psd"
             xmlns:stft="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Stft"
             xmlns:rbp="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Rbp"
             xmlns:faa="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Faa"
             xmlns:iapf="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Iapf"
             xmlns:peak="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.PeakFrequency"
             xmlns:ratio="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.BandRatio"
             xmlns:theta="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.ThetaBeta"
             xmlns:brainbeat="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Brainbeat"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Shared"
             Background="#F8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,12,16,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Top Header & Navigation -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <Button Command="{Binding AlgorithmWorkspace.BackToListCommand}" Style="{StaticResource AppIconButtonStyle}" Width="Auto" Height="26" HorizontalAlignment="Left" Margin="0,0,0,14" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 12,6 L 4,6 M 7,3 L 4,6 L 7,9" Stroke="#334155" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="返回算法列表" FontSize="13" FontWeight="Medium" Foreground="#334155" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Title Row: Title & Right Badges in SAME horizontal alignment -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Algorithm.DisplayNameZh, TargetNullValue=功率谱密度}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Algorithm.Abbreviation, TargetNullValue=PSD}" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 可用 Badge -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Algorithm.StatusDisplay, TargetNullValue=可用}" Foreground="#059669" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- Divider 1 -->
                        <Border Width="1" Height="14" Background="#CBD5E1" Margin="14,0" VerticalAlignment="Center" />
                        <!-- 科学版本 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="科学版本" FontSize="12" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Algorithm.Version, TargetNullValue=v1.0.0}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Divider 2 -->
                        <Border Width="1" Height="14" Background="#CBD5E1" Margin="14,0" VerticalAlignment="Center" />
                        <!-- 支持模式 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="支持模式" FontSize="12" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Border Background="#DBEAFE" CornerRadius="6" Padding="12,4" Margin="0,0,6,0" VerticalAlignment="Center"><TextBlock Text="静态" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" /></Border>
                            <Border Background="#FFEDD5" CornerRadius="6" Padding="12,4" VerticalAlignment="Center"><TextBlock Text="动态" FontSize="12" FontWeight="SemiBold" Foreground="#C2410C" /></Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- Subtitle below the title row -->
                <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Algorithm.Description}" Margin="0,6,0,0" Foreground="#64748B" FontSize="12.5" />
            </StackPanel>

            <shared:AnalysisTargetCard Grid.Row="1" DataContext="{Binding AlgorithmWorkspace.Detail.Context}" />
            <shared:AnalysisParameterCard Grid.Row="2" DataContext="{Binding AlgorithmWorkspace.Detail.Context}" />
            <Grid Grid.Row="3" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="440"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*" MinWidth="440"/></Grid.ColumnDefinitions><shared:AnalysisExecutionCard Grid.Column="0" DataContext="{Binding AlgorithmWorkspace.Detail.Context}"/><shared:QualityStatusCard Grid.Column="2" DataContext="{Binding AlgorithmWorkspace.Detail.Quality}" /></Grid>
            <!-- Row 4: PSD 结果和结果溯源分成两个完整宽度区块 -->
            <StackPanel Grid.Row="4">
                <!-- Left: Card 6 PSD 结果 View -->
                <Grid>
                    <psd:PsdDetailView>
                        <psd:PsdDetailView.Style>
                            <Style TargetType="psd:PsdDetailView">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsPsd}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </psd:PsdDetailView.Style>
                    </psd:PsdDetailView>
                    <stft:StftDetailView><stft:StftDetailView.Style><Style TargetType="stft:StftDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsStft}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></stft:StftDetailView.Style></stft:StftDetailView>
                    <rbp:RbpDetailView><rbp:RbpDetailView.Style><Style TargetType="rbp:RbpDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsRbp}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></rbp:RbpDetailView.Style></rbp:RbpDetailView>
                    <faa:FaaDetailView><faa:FaaDetailView.Style><Style TargetType="faa:FaaDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsFaa}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></faa:FaaDetailView.Style></faa:FaaDetailView>
                    <iapf:IapfDetailView><iapf:IapfDetailView.Style><Style TargetType="iapf:IapfDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsIapf}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></iapf:IapfDetailView.Style></iapf:IapfDetailView>
                    <peak:PeakFrequencyDetailView><peak:PeakFrequencyDetailView.Style><Style TargetType="peak:PeakFrequencyDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsPeakFrequency}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></peak:PeakFrequencyDetailView.Style></peak:PeakFrequencyDetailView>
                    <ratio:BandRatioDetailView><ratio:BandRatioDetailView.Style><Style TargetType="ratio:BandRatioDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsBandRatio}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ratio:BandRatioDetailView.Style></ratio:BandRatioDetailView>
                    <theta:ThetaBetaDetailView><theta:ThetaBetaDetailView.Style><Style TargetType="theta:ThetaBetaDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsThetaBeta}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></theta:ThetaBetaDetailView.Style></theta:ThetaBetaDetailView>
                    <brainbeat:BrainbeatDetailView><brainbeat:BrainbeatDetailView.Style><Style TargetType="brainbeat:BrainbeatDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsBrainbeat}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></brainbeat:BrainbeatDetailView.Style></brainbeat:BrainbeatDetailView>
                </Grid>

                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" MinWidth="430"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.45*" MinWidth="620"/></Grid.ColumnDefinitions><shared:ResultProvenanceCard Grid.Column="0" DataContext="{Binding AlgorithmWorkspace.Detail.Context.Provenance}"/><shared:DynamicResultCard Grid.Column="2" DataContext="{Binding AlgorithmWorkspace.Detail.Context}" /></Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
