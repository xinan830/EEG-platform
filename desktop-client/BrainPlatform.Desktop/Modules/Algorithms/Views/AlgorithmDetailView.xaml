<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.AlgorithmDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:psd="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Psd"
             xmlns:stft="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Stft"
             xmlns:rbp="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Rbp"
             xmlns:faa="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Faa"
             xmlns:iapf="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Iapf"
             xmlns:peak="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.PeakFrequency"
             xmlns:ratio="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.BandRatio"
             xmlns:theta="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.ThetaBeta"
             xmlns:brainbeat="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Brainbeat"
             Background="#F8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,12,16,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Top Header & Navigation -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <Button Command="{Binding AlgorithmWorkspace.BackToListCommand}" Style="{StaticResource AppIconButtonStyle}" Width="Auto" Height="26" HorizontalAlignment="Left" Margin="0,0,0,14" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 12,6 L 4,6 M 7,3 L 4,6 L 7,9" Stroke="#334155" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="返回算法列表" FontSize="13" FontWeight="Medium" Foreground="#334155" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Title Row: Title & Right Badges in SAME horizontal alignment -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Algorithm.DisplayNameZh, TargetNullValue=功率谱密度}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Algorithm.Abbreviation, TargetNullValue=PSD}" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 可用 Badge -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Algorithm.StatusDisplay, TargetNullValue=可用}" Foreground="#059669" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- Divider 1 -->
                        <Border Width="1" Height="14" Background="#CBD5E1" Margin="14,0" VerticalAlignment="Center" />
                        <!-- 科学版本 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="科学版本" FontSize="12" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Algorithm.Version, TargetNullValue=v1.0.0}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Divider 2 -->
                        <Border Width="1" Height="14" Background="#CBD5E1" Margin="14,0" VerticalAlignment="Center" />
                        <!-- 支持模式 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="支持模式" FontSize="12" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Border Background="#DBEAFE" CornerRadius="6" Padding="12,4" Margin="0,0,6,0" VerticalAlignment="Center"><TextBlock Text="静态" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" /></Border>
                            <Border Background="#FFEDD5" CornerRadius="6" Padding="12,4" VerticalAlignment="Center"><TextBlock Text="动态" FontSize="12" FontWeight="SemiBold" Foreground="#C2410C" /></Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- Subtitle below the title row -->
                <TextBlock Text="分析 EEG 信号的频率功率分布，用于分析各频段的功率分布。" Margin="0,6,0,0" Foreground="#64748B" FontSize="12.5" />
            </StackPanel>

            <!-- Card 1: 分析对象 (Full width) -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#1677FF" Margin="0,0,8,0">
                            <TextBlock Text="1" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="分析对象" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <!-- Middle spring spacer pushes right cluster to align with right edge! -->
                            <ColumnDefinition Width="*" MinWidth="16" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 项目 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="项目" FontSize="12" Foreground="#64748B" Margin="0,0,0,5" />
                            <ComboBox Style="{StaticResource AppFilterComboBoxStyle}" Width="190" Height="34" ItemsSource="{Binding AlgorithmWorkspace.Detail.Context.Projects.Projects}" SelectedItem="{Binding AlgorithmWorkspace.Detail.Context.SelectedProject, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <!-- 已完成记录 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="已完成记录" FontSize="12" Foreground="#64748B" Margin="0,0,0,5" />
                            <ComboBox Style="{StaticResource AppFilterComboBoxStyle}" Width="210" Height="34" ItemsSource="{Binding AlgorithmWorkspace.Detail.Context.CompletedRecordings}" SelectedItem="{Binding AlgorithmWorkspace.Detail.Context.SelectedProjectRecording, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <!-- 选择完成记录后由业务层自动注册，无需额外确认步骤。 -->
                        <TextBlock Grid.Column="4" Text="选择后自动注册" FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                        <!-- 记录时长 | 采样率 | 可用通道 灰蓝圆角底框卡片 -->
                        <Border Grid.Column="6" Background="#F1F5F9" CornerRadius="8" Padding="16,6" Height="58" VerticalAlignment="Bottom">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="75" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="记录时长" FontSize="12" Foreground="#64748B" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Context.RegisteredRecording.DurationSeconds, StringFormat='{}{0:0.###} s', FallbackValue='未注册', TargetNullValue='未注册'}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Height="20" Background="#CBD5E1" Margin="14,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="采样率" FontSize="12" Foreground="#64748B" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Context.RegisteredRecording.SamplingRateHz, StringFormat='{}{0:0.###} Hz', FallbackValue='未注册', TargetNullValue='未注册'}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                </StackPanel>
                                <Border Grid.Column="3" Width="1" Height="20" Background="#CBD5E1" Margin="14,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Text="可用通道" FontSize="12" Foreground="#64748B" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Context.RegisteredChannels.Count, FallbackValue='0', TargetNullValue='0'}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- PSD 分析通道 外框卡片 (白底灰边，右对齐) -->
                        <Border Grid.Column="8" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="#FFFFFF" Padding="14,5,14,6" Height="58" VerticalAlignment="Bottom" Width="190">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PSD 分析通道" FontSize="12" Foreground="#64748B" Margin="0,0,0,3" />
                                <ComboBox Style="{StaticResource AppFilterComboBoxStyle}" Height="28" Padding="8,0" ItemsSource="{Binding AlgorithmWorkspace.Detail.Context.RegisteredChannels}" SelectedItem="{Binding AlgorithmWorkspace.Detail.Context.SelectedChannel, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Row 2: Card 2 (分析范围) + Card 3 (PSD 参数) -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" MinWidth="340" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.85*" MinWidth="540" /></Grid.ColumnDefinitions>
                <!-- Card 2: 分析范围 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                            <Border Width="20" Height="20" CornerRadius="10" Background="#1677FF" Margin="0,0,8,0">
                                <TextBlock Text="2" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="分析范围" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="静态分析" Command="{Binding AlgorithmWorkspace.Detail.Context.SelectStaticModeCommand}" Padding="16,5" Height="28" FontSize="12" FontWeight="SemiBold">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Context.IsDynamicMode}" Value="False">
                                                    <Setter Property="BorderBrush" Value="#2563EB" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="动态分析" Command="{Binding AlgorithmWorkspace.Detail.Context.SelectDynamicModeCommand}" IsEnabled="{Binding AlgorithmWorkspace.Detail.Context.IsDynamicModeAvailable}" Padding="16,5" Height="28" Margin="4,0,0,0" FontSize="12" FontWeight="Medium">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Context.IsDynamicMode}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2563EB" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="开始时间" FontSize="12" Foreground="#475569" Margin="0,0,0,6" />
                                <Grid>
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" Padding="10,0,28,0" Text="{Binding AlgorithmWorkspace.Detail.Context.StartSeconds, UpdateSourceTrigger=LostFocus, TargetNullValue=00:00:00}" />
                                    <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,6 C 12,6 12,12 12,12 L 15,14" Stroke="#94A3B8" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="结束时间" FontSize="12" Foreground="#475569" Margin="0,0,0,6" />
                                <Grid>
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" Padding="10,0,28,0" Text="{Binding AlgorithmWorkspace.Detail.Context.EndSeconds, UpdateSourceTrigger=LostFocus, TargetNullValue=00:05:00}" />
                                    <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,6 C 12,6 12,12 12,12 L 15,14" Stroke="#94A3B8" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Border Background="#EFF6FF" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="i" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                    <TextBlock FontSize="12" Foreground="#334155"><Run Text="实际分析范围：" /><Run Text="{Binding AlgorithmWorkspace.Detail.Psd.ActualRangeText, Mode=OneWay}" FontWeight="Medium" /></TextBlock>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="#334155" Margin="22,3,0,0"><Run Text="窗口状态：" /><Run Text="{Binding AlgorithmWorkspace.Detail.Psd.WindowStateSummary, Mode=OneWay}" FontWeight="Medium" /></TextBlock>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Context.IsDynamicMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="动态参数" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="动态窗口" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                                    <ComboBox Style="{StaticResource AppFilterComboBoxStyle}" Height="30" Padding="8,0"
                                              ItemsSource="{Binding AlgorithmWorkspace.Detail.Context.DynamicWindowOptions}"
                                              SelectedItem="{Binding AlgorithmWorkspace.Detail.Context.SelectedDynamicWindowSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="刷新步长" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" Height="30" Padding="8,0"
                                             Text="{Binding AlgorithmWorkspace.Detail.Context.DynamicStepText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3: PSD 参数 (Shared Table Column Definitions) -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Border Width="20" Height="20" CornerRadius="10" Background="#1677FF" Margin="0,0,8,0">
                                <TextBlock Text="3" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="PSD 参数" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Header Row (Shared Column Definition) -->
                        <Border Style="{StaticResource AppTableHeaderBarStyle}" Background="Transparent" Height="30">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="105" /><ColumnDefinition Width="50" /><ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="参数名称" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="1" Text="当前值" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="2" Text="单位" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="3" Text="默认值" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="4" Text="可选范围" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="5" Text="参数说明" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                        <!-- Row 1: 高通截止频率 -->
                        <Border Style="{StaticResource AppTableRowDividerStyle}">
                            <Grid Height="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="105" /><ColumnDefinition Width="50" /><ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="高通截止频率" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBox Grid.Column="1" Style="{StaticResource AppTextBoxStyle}" Height="30" Padding="8,0" Text="{Binding AlgorithmWorkspace.Detail.Context.Catalog.LowFrequencyText, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Hz" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="3" Text="1" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="4" Text="&gt; 0" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="5" Text="去除低于此频率的慢漂移成分" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                            </Grid>
                        </Border>
                        <!-- Row 2: 低通截止频率 -->
                        <Border Style="{StaticResource AppTableRowDividerStyle}">
                            <Grid Height="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="105" /><ColumnDefinition Width="50" /><ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="低通截止频率" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBox Grid.Column="1" Style="{StaticResource AppTextBoxStyle}" Height="30" Padding="8,0" Text="{Binding AlgorithmWorkspace.Detail.Context.Catalog.HighFrequencyText, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Hz" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="3" Text="30" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="4" Text="&lt; 奈奎斯特频率" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="5" Text="去除高于此频率的成分；动态趋势固定显示 1–50 Hz" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                            </Grid>
                        </Border>
                        <!-- Row 3: 陷波频率 -->
                        <Border Style="{StaticResource AppTableRowDividerStyle}">
                            <Grid Height="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="105" /><ColumnDefinition Width="50" /><ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="陷波频率" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <ComboBox Grid.Column="1" Style="{StaticResource AppFilterComboBoxStyle}" Height="30" Padding="8,0" VerticalAlignment="Center" ItemsSource="{Binding AlgorithmWorkspace.Detail.Context.Catalog.NotchFrequencyOptions}" SelectedItem="{Binding AlgorithmWorkspace.Detail.Context.Catalog.SelectedNotchFrequency, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="Hz" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="3" Text="50" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="4" Text="关闭 / 50 / 60" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="5" Text="抑制工频干扰；选择后写入 PSD 溯源" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                            </Grid>
                        </Border>
                        <!-- Row 3: Welch 窗口长度 -->
                        <Border Style="{StaticResource AppTableRowDividerStyle}">
                            <Grid Height="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="105" /><ColumnDefinition Width="50" /><ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Welch 窗口长度" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="1" Text="4" Style="{StaticResource AppTableCellTextStyle}" Foreground="#0F172A" />
                                <TextBlock Grid.Column="2" Text="s" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="3" Text="4" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="4" Text="官方固定" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="5" Text="官方 Welch 合同，当前不可修改" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                            </Grid>
                        </Border>
                        <!-- Row 4: Welch 重叠比例 -->
                        <Border Style="{StaticResource AppTableRowDividerStyle}">
                            <Grid Height="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="105" /><ColumnDefinition Width="50" /><ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Welch 重叠比例" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="1" Text="50" Style="{StaticResource AppTableCellTextStyle}" Foreground="#0F172A" />
                                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="3" Text="50" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="4" Text="官方固定" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="5" Text="官方 Welch 合同，当前不可修改" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                            </Grid>
                        </Border>
                        <!-- Row 5: 窗函数 -->
                        <Border Style="{StaticResource AppTableRowDividerStyle}">
                            <Grid Height="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="105" /><ColumnDefinition Width="50" /><ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="窗函数" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="1" Text="Hann" Style="{StaticResource AppTableCellTextStyle}" Foreground="#0F172A" />
                                <TextBlock Grid.Column="2" Text="-" Style="{StaticResource AppTableCellTextStyle}" Foreground="#94A3B8" />
                                <TextBlock Grid.Column="3" Text="Hann" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="4" Text="官方固定" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="5" Text="官方 Welch 合同，当前不可修改" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                            </Grid>
                        </Border>
                        <!-- Row 6: 计算通道 -->
                        <Border>
                            <Grid Height="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="105" /><ColumnDefinition Width="50" /><ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="计算通道" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <ComboBox Grid.Column="1" Style="{StaticResource AppFilterComboBoxStyle}" Height="30" Padding="8,0" VerticalAlignment="Center" ItemsSource="{Binding AlgorithmWorkspace.Detail.Context.RegisteredChannels}" SelectedItem="{Binding AlgorithmWorkspace.Detail.Context.SelectedChannel, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="-" Style="{StaticResource AppTableCellTextStyle}" Foreground="#94A3B8" />
                                <TextBlock Grid.Column="3" Text="当前所选" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="4" Text="可用通道列表" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                                <TextBlock Grid.Column="5" Text="用于计算 PSD 的通道" Style="{StaticResource AppTableCellTextStyle}" Foreground="#64748B" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: Card 4 (执行分析) + Card 5 (质量状态) -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="440" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" MinWidth="440" />
                </Grid.ColumnDefinitions>

                <!-- Card 4: 执行分析 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,18">
                    <StackPanel>
                        <!-- Title Row -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#1677FF" Margin="0,0,8,0">
                                <TextBlock Text="4" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="执行分析" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Action Buttons Row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 提示标签：选择后自动分析 -->
                            <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="#1677FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="选择后自动分析" FontSize="12" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 重试分析 (Refined Secondary Button) -->
                            <Button Grid.Column="2" Command="{Binding AlgorithmWorkspace.Detail.Context.RunCommand}" Height="32" Padding="14,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC" />
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9" />
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#64748B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 M 22,2 V 8 H 16" Stroke="#334155" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="重试分析" FontSize="12.5" FontWeight="Medium" Foreground="#1E293B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Run Progress Indicator -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Height="6" CornerRadius="3" Background="#E2E8F0" VerticalAlignment="Center" Margin="0,0,12,0" ClipToBounds="True">
                                <ProgressBar Value="{Binding AlgorithmWorkspace.Detail.Psd.RunProgressPercent, Mode=OneWay}" Maximum="100" Height="6" BorderThickness="0" Background="Transparent" Foreground="#1677FF">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border Background="{TemplateBinding Background}">
                                                <Border x:Name="PART_Track">
                                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                                                </Border>
                                            </Border>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding AlgorithmWorkspace.Detail.Psd.RunProgressText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Dynamic Preview Container -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Context.IsDynamicMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="时间同步预览" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" />
                                    <TextBlock Text="（基于已完成记录，不接入采集/回溯）" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <!-- 开始 / 暂停 二合一按钮 -->
                                    <Grid Margin="0,0,8,0">
                                        <!-- 未播放时显示：开始 -->
                                        <Button Command="{Binding AlgorithmWorkspace.Detail.Context.StartDynamicPreviewCommand}" Height="28" Padding="12,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Context.IsDynamicPreviewPlaying}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8" /></Trigger>
                                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#EFF6FF" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#1677FF" /></Trigger>
                                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="btnBorder" Property="Opacity" Value="0.5" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M 2,1 L 9,5.5 L 2,10 Z" Fill="#334155" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="开始" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- 播放中时显示：暂停 -->
                                        <Button Command="{Binding AlgorithmWorkspace.Detail.Context.PauseDynamicPreviewCommand}" Height="28" Padding="12,0" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Context.IsDynamicPreviewPlaying}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#DBEAFE" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#60A5FA" /></Trigger>
                                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#BFDBFE" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#2563EB" /></Trigger>
                                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="btnBorder" Property="Opacity" Value="0.5" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M 1,1 H 3.5 V 9 H 1 Z M 5.5,1 H 8 V 9 H 5.5 Z" Fill="#1D4ED8" Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="暂停" FontSize="12" Foreground="#1D4ED8" FontWeight="Medium" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Button Command="{Binding AlgorithmWorkspace.Detail.Context.StepDynamicPreviewCommand}" Height="28" Padding="12,0" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8" /></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#EFF6FF" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#1677FF" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 1,1 L 6.5,5.5 L 1,10 Z M 7,1 H 9 V 10 H 7 Z" Fill="#334155" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="单步" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding AlgorithmWorkspace.Detail.Context.ResetDynamicPreviewCommand}" Height="28" Padding="12,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8" /></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="btnBorder" Property="Background" Value="#EFF6FF" /><Setter TargetName="btnBorder" Property="BorderBrush" Value="#1677FF" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 M 17,4 V 9 H 22" Stroke="#334155" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="重置" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="游标" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Context.DynamicPreviewCursorText}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="5,0,14,0" VerticalAlignment="Center" />
                                    <TextBlock Text="已释放窗口" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Context.DynamicPreviewRows.Count}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="5,0,14,0" VerticalAlignment="Center" />
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Context.DynamicPreviewStatusText}" FontSize="11" Foreground="#059669" FontWeight="Medium" />
                                    </Border>
                                </StackPanel>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Value="{Binding AlgorithmWorkspace.Detail.Psd.DynamicTimeProgressPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0"
                                            Maximum="100"
                                            IsMoveToPointEnabled="True"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            ToolTip="拖动时间进度，查看对应的动态分析窗口">
                                        <Slider.Resources>
                                            <Style x:Key="ModernSliderTrackRepeatButtonStyle" TargetType="RepeatButton">
                                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                                <Setter Property="IsTabStop" Value="False" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" CornerRadius="{TemplateBinding Tag}" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style x:Key="ModernSliderThumbStyle" TargetType="Thumb">
                                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Grid Width="16" Height="16">
                                                                <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#1677FF" StrokeThickness="2.5">
                                                                    <Ellipse.Effect>
                                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Color="#0F172A" />
                                                                    </Ellipse.Effect>
                                                                </Ellipse>
                                                                <Ellipse Width="4" Height="4" Fill="#1677FF" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Slider.Resources>
                                        <Slider.Template>
                                            <ControlTemplate TargetType="Slider">
                                                <Grid VerticalAlignment="Center">
                                                    <Track x:Name="PART_Track">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Style="{StaticResource ModernSliderTrackRepeatButtonStyle}" Background="#1677FF" Height="5" Tag="2.5,0,0,2.5" Command="Slider.DecreaseLarge" />
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Style="{StaticResource ModernSliderThumbStyle}" />
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Style="{StaticResource ModernSliderTrackRepeatButtonStyle}" Background="#E2E8F0" Height="5" Tag="0,2.5,2.5,0" Command="Slider.IncreaseLarge" />
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Slider.Template>
                                    </Slider>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AlgorithmWorkspace.Detail.Psd.DynamicTimeProgressText}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="#334155"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Psd.DynamicCurrentWindowText}"
                                           FontSize="11.5"
                                           Foreground="#64748B"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 5: 质量状态 -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                            <Border Width="20" Height="20" CornerRadius="10" Background="#1677FF" Margin="0,0,8,0">
                                <TextBlock Text="5" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="质量状态" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Top Metrics: 4 distinct columns with ample breathing room to prevent collision -->
                        <Grid Margin="0,2,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: 数据质量状态 (Pill Badge) -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="数据质量状态" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                                <Border BorderThickness="1" CornerRadius="10" Padding="8,2.5" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFF6FF" />
                                            <Setter Property="BorderBrush" Value="#BFDBFE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="良好">
                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="通过">
                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="尚未运行分析">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#2563EB" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="良好">
                                                            <Setter Property="Fill" Value="#10B981" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="通过">
                                                            <Setter Property="Fill" Value="#10B981" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="尚未运行分析">
                                                            <Setter Property="Fill" Value="#94A3B8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="良好">
                                                            <Setter Property="Foreground" Value="#059669" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="通过">
                                                            <Setter Property="Foreground" Value="#059669" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="尚未运行分析">
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Column 1: 质量门 (Pill Badge) -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="质量门" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                                <Border BorderThickness="1" CornerRadius="10" Padding="8,2.5" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFF6FF" />
                                            <Setter Property="BorderBrush" Value="#BFDBFE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="良好">
                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="通过">
                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="尚未运行分析">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#2563EB" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="良好">
                                                            <Setter Property="Fill" Value="#10B981" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="通过">
                                                            <Setter Property="Fill" Value="#10B981" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="尚未运行分析">
                                                            <Setter Property="Fill" Value="#94A3B8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="良好">
                                                            <Setter Property="Foreground" Value="#059669" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="通过">
                                                            <Setter Property="Foreground" Value="#059669" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.QualityText}" Value="尚未运行分析">
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Column 2: 不可用窗口 -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="不可用窗口" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Psd.UnavailableWindowCount}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Column 3: 被拒绝窗口 -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="被拒绝窗口" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Psd.RejectedWindowCount}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Diagnostic Sub-Card: 窗口状态、失败原因与排查入口 (Mirrors Card 4's Preview Sub-Card) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,2,0,0">
                            <StackPanel>
                                <!-- Window Status and Failure Reason in balanced two columns -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="180" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 窗口状态 -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="窗口状态" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Psd.WindowStateSummary, Mode=OneWay}"
                                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 失败原因 -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="失败原因" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Psd.FailureReasonText, TargetNullValue=无}"
                                                   FontSize="12" Foreground="#475569" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Sleek Secondary Action Button for Failure Details -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                    <Button Command="{Binding AlgorithmWorkspace.Detail.Psd.ToggleFailureDetailsCommand}"
                                            Height="26" Padding="10,0" Cursor="Hand" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9" />
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#EFF6FF" />
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1677FF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 11,16 H 13 V 18 H 11 Z M 11,6 H 13 V 14 H 11 Z"
                                                  Fill="#64748B" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="查看窗口失败原因" FontSize="11.5" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center" />
                                            <Path Data="M 1,1 L 4.5,4.5 L 8,1" Stroke="#64748B" StrokeThickness="1.5" Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="6,1,0,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.IsFailureDetailsExpanded}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="180" CenterX="4" CenterY="2.5" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Expandable Failure Details Card -->
                                <Border Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,10,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.Psd.IsFailureDetailsExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ScrollViewer MaxHeight="160"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding AlgorithmWorkspace.Detail.Psd.FailureDetailsText}"
                                                   FontSize="11.5"
                                                   Foreground="#334155"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 4: PSD 结果和结果溯源分成两个完整宽度区块 -->
            <StackPanel Grid.Row="4">
                <!-- Left: Card 6 PSD 结果 View -->
                <Grid>
                    <psd:PsdDetailView>
                        <psd:PsdDetailView.Style>
                            <Style TargetType="psd:PsdDetailView">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsPsd}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </psd:PsdDetailView.Style>
                    </psd:PsdDetailView>
                    <stft:StftDetailView><stft:StftDetailView.Style><Style TargetType="stft:StftDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsStft}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></stft:StftDetailView.Style></stft:StftDetailView>
                    <rbp:RbpDetailView><rbp:RbpDetailView.Style><Style TargetType="rbp:RbpDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsRbp}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></rbp:RbpDetailView.Style></rbp:RbpDetailView>
                    <faa:FaaDetailView><faa:FaaDetailView.Style><Style TargetType="faa:FaaDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsFaa}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></faa:FaaDetailView.Style></faa:FaaDetailView>
                    <iapf:IapfDetailView><iapf:IapfDetailView.Style><Style TargetType="iapf:IapfDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsIapf}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></iapf:IapfDetailView.Style></iapf:IapfDetailView>
                    <peak:PeakFrequencyDetailView><peak:PeakFrequencyDetailView.Style><Style TargetType="peak:PeakFrequencyDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsPeakFrequency}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></peak:PeakFrequencyDetailView.Style></peak:PeakFrequencyDetailView>
                    <ratio:BandRatioDetailView><ratio:BandRatioDetailView.Style><Style TargetType="ratio:BandRatioDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsBandRatio}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ratio:BandRatioDetailView.Style></ratio:BandRatioDetailView>
                    <theta:ThetaBetaDetailView><theta:ThetaBetaDetailView.Style><Style TargetType="theta:ThetaBetaDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsThetaBeta}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></theta:ThetaBetaDetailView.Style></theta:ThetaBetaDetailView>
                    <brainbeat:BrainbeatDetailView><brainbeat:BrainbeatDetailView.Style><Style TargetType="brainbeat:BrainbeatDetailView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AlgorithmWorkspace.Detail.IsBrainbeat}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></brainbeat:BrainbeatDetailView.Style></brainbeat:BrainbeatDetailView>
                </Grid>

                <!-- Card 7：结果溯源与动态结果左右两栏 -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" MinWidth="430" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.45*" MinWidth="620" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                            <Border Width="20" Height="20" CornerRadius="10" Background="#1677FF" Margin="0,0,8,0">
                                <TextBlock Text="7" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="结果溯源" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" /><RowDefinition Height="25" /><RowDefinition Height="25" /><RowDefinition Height="25" /><RowDefinition Height="25" />
                                <RowDefinition Height="25" /><RowDefinition Height="25" /><RowDefinition Height="28" /><RowDefinition Height="25" /><RowDefinition Height="25" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Run ID" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AlgorithmWorkspace.Detail.Psd.RunIdText}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Recording ID" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AlgorithmWorkspace.Detail.Context.RegisteredRecording.Id, TargetNullValue=REC-20250918-0001}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="算法版本" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AlgorithmWorkspace.Detail.Algorithm.Version, TargetNullValue=v1.0.0}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="实现版本" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AlgorithmWorkspace.Detail.Algorithm.ImplementationIdentity, TargetNullValue=后端未提供}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="实际通道" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AlgorithmWorkspace.Detail.Context.SelectedChannel, TargetNullValue=Pz}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="请求时间范围" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AlgorithmWorkspace.Detail.Psd.RequestedRangeText}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="实际分析范围" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AlgorithmWorkspace.Detail.Psd.ActualRangeText}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="参数快照" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <Border Grid.Row="7" Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" MinWidth="130">
                                <Grid>
                                    <TextBlock Text="{}{...}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Path Data="M 16,1 H 4 C 2.9,1 2,1.9 2,3 V 17 H 4 V 3 H 16 V 1 Z M 19,5 H 8 C 6.9,5 6,5.9 6,7 V 21 C 6,22.1 6.9,23 8,23 H 19 C 20.1,23 21,22.1 21,21 V 7 C 21,5.9 20.1,5 19,5 Z M 19,21 H 8 V 7 H 19 V 21 Z" Fill="#64748B" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="输出单位" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding AlgorithmWorkspace.Detail.Psd.ValueUnit, TargetNullValue=μV²/Hz}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="结果生成时间" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding AlgorithmWorkspace.Detail.Psd.ResultTimeText}" FontSize="12" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#1677FF" Margin="0,0,8,0">
                                    <TextBlock Text="8" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="动态结果（按时间）" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Background="#F8FBFF" BorderBrush="#E2EEF9" BorderThickness="1" CornerRadius="7" Padding="8,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Background="#EEF6FF">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.25*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="窗口开始时间" FontSize="11" Foreground="#49658D" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="1" Text="窗口结束时间" FontSize="11" Foreground="#49658D" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="窗口状态" FontSize="11" Foreground="#49658D" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="质量状态" FontSize="11" Foreground="#49658D" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="4" Text="失败原因" FontSize="11" Foreground="#49658D" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding AlgorithmWorkspace.Detail.Psd.DynamicWindowRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E2EAF3" BorderThickness="0,0,0,1" Padding="0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.15*" />
                                                                <ColumnDefinition Width="1.15*" />
                                                                <ColumnDefinition Width="1.1*" />
                                                                <ColumnDefinition Width="1.1*" />
                                                                <ColumnDefinition Width="1.25*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding StartSeconds, StringFormat={}{0:0.##} 秒}" FontSize="11" Foreground="#45628F" Margin="8,0,0,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding EndSeconds, StringFormat={}{0:0.##} 秒}" FontSize="11" Foreground="#45628F" Margin="8,0,0,0" />
                                                            <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="11" Foreground="#167A57" Margin="8,0,0,0" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Quality}" FontSize="11" Foreground="#167A57" Margin="8,0,0,0" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Failure, TargetNullValue=-}" FontSize="11" Foreground="#64748B" Margin="8,0,0,0" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
