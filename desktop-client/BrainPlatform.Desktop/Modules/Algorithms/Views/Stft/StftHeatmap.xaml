<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Stft.StftHeatmap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scichart="http://schemas.abtsoftware.co.uk/scichart">
    <Grid Background="White">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
        <scichart:SciChartSurface x:Name="Surface" Grid.Column="0" />
        <scichart:HeatmapColorMap x:Name="ColourMap"
                                  Grid.Column="1"
                                  Margin="8,0,4,0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Orientation="Vertical"
                                  TextFormatting="0.#"
                                  FontSize="11"
                                  Foreground="#475569" />
    </Grid>
</UserControl>
