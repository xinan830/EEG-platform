<UserControl x:Class="BrainPlatform.Desktop.Modules.Algorithms.Views.Stft.StftHeatmap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scichart="http://schemas.abtsoftware.co.uk/scichart">
    <Grid Background="White">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <scichart:SciChartSurface x:Name="Surface" Grid.Column="0" Grid.RowSpan="2" />
        <scichart:HeatmapColorMap x:Name="ColourMap"
                                  Grid.Column="1"
                                  Margin="8,0,4,2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Orientation="Vertical"
                                  TextFormatting="0.#"
                                  FontSize="11"
                                  Foreground="#475569" />
        <TextBlock Grid.Column="1" Grid.Row="1" Text="dB re 1 µV²/Hz" FontSize="9"
                   Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="0,2,0,0" />
    </Grid>
</UserControl>
