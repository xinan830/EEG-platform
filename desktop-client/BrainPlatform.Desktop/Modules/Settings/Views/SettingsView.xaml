<UserControl x:Class="BrainPlatform.Desktop.Modules.Settings.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 分组小标题 -->
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="Margin" Value="2,24,0,10" />
            </Style>

            <!-- 极简三色设置入口卡片 -->
            <Style x:Key="SettingCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="20,18">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BlueBrandPrimaryBrush}" />
                                    <Setter TargetName="CardBorder" Property="Background" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BlueBrandPrimaryBrush}" />
                                    <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 统一品牌蓝图标底块 -->
            <Style x:Key="SettingIconBoxStyle" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{StaticResource BlueBrandSoftBrush}" />
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 极简右向箭头 -->
            <Style x:Key="CardChevronStyle" TargetType="Path">
                <Setter Property="Data" Value="M 6,3 L 11,8 L 6,13" />
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Stroke" Value="#94A3B8" />
                <Setter Property="StrokeThickness" Value="1.8" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,0,2,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,32,40,36">
            <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">
            <!-- 标题 -->
            <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />

            <!-- ==================== 分组 1：采集与配置 ==================== -->
            <TextBlock Text="采集与配置" Style="{StaticResource SectionLabelStyle}" Margin="2,22,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 通道配置 -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingCardButtonStyle}" Click="OnOpenChannelListClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SettingIconBoxStyle}">
                            <Path Data="M 2,13 H 6 L 9,4 L 14,22 L 18,8 L 21,15 L 23,13 H 26"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{StaticResource BlueBrandPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="通道配置" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="输入通道与电极位置" FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                        <Path Grid.Column="2" Style="{StaticResource CardChevronStyle}" />
                    </Grid>
                </Button>

                <!-- 导联配置 -->
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingCardButtonStyle}" Click="OnOpenMontageListClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SettingIconBoxStyle}">
                            <Path Data="M 6,6 A 2.5,2.5 0 1 1 6,11 A 2.5,2.5 0 0 1 6,6 M 18,3 A 2.5,2.5 0 1 1 18,8 A 2.5,2.5 0 0 1 18,3 M 18,15 A 2.5,2.5 0 1 1 18,20 A 2.5,2.5 0 0 1 18,15 M 8.2,9.2 L 15.8,6.2 M 8.2,10.2 L 15.8,16.5"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{StaticResource BlueBrandPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="导联配置" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="参考方案与导联组合" FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                        <Path Grid.Column="2" Style="{StaticResource CardChevronStyle}" />
                    </Grid>
                </Button>

                <!-- 屏幕尺寸校准 -->
                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingCardButtonStyle}" Click="OnOpenScreenCalibrationClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SettingIconBoxStyle}">
                            <Path Data="M 3,4 H 21 V 17 H 3 Z M 8,21 H 16 M 12,17 V 21 M 7,4 V 8 M 12,4 V 7 M 17,4 V 8"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{StaticResource BlueBrandPrimaryBrush}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="屏幕尺寸校准" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="物理显示尺寸与标尺" FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                        <Path Grid.Column="2" Style="{StaticResource CardChevronStyle}" />
                    </Grid>
                </Button>

                <!-- 事件设置 -->
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingCardButtonStyle}" Click="OnOpenEventListClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SettingIconBoxStyle}">
                            <Path Data="M 5,3 V 21 M 5,4 H 19 L 16,9.5 L 19,15 H 5"
                                  Width="19" Height="19" Stretch="Uniform"
                                  Stroke="{StaticResource BlueBrandPrimaryBrush}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="事件设置" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="事件类型与快捷键" FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                        <Path Grid.Column="2" Style="{StaticResource CardChevronStyle}" />
                    </Grid>
                </Button>
            </Grid>

            <!-- ==================== 分组 2：视图与影像 ==================== -->
            <TextBlock Text="视图与影像" Style="{StaticResource SectionLabelStyle}" />
            <Button Style="{StaticResource SettingCardButtonStyle}" Click="OnOpenBrainImagingHubClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconBoxStyle}">
                        <Path Data="M 12,3 C 8.5,3 6,5.3 6,8.2 C 4.5,9 3.8,10.6 4.2,12.4 C 3.8,14.5 5.1,16.5 7.2,17 C 7.8,19.2 9.8,20.5 12,20.5 M 12,3 C 15.5,3 18,5.3 18,8.2 C 19.5,9 20.2,10.6 19.8,12.4 C 20.2,14.5 18.9,16.5 16.8,17 C 16.2,19.2 14.2,20.5 12,20.5 M 12,3 V 20.5 M 8.5,8.5 C 9.8,9.2 10.6,10.4 10.6,11.8 M 15.5,8.5 C 14.2,9.2 13.4,10.4 13.4,11.8"
                              Width="20" Height="20" Stretch="Uniform"
                              Stroke="{StaticResource BlueBrandPrimaryBrush}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="脑影像视图中心" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="皮层图谱 · 功能连接 · 源定位 · 白质纤维 · MRI" FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0" />
                    </StackPanel>
                    <Path Grid.Column="2" Style="{StaticResource CardChevronStyle}" />
                </Grid>
            </Button>

            <!-- ==================== 分组 3：系统维护 ==================== -->
            <TextBlock Text="系统维护" Style="{StaticResource SectionLabelStyle}" />
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="12" Padding="20,18" DataContext="{Binding CacheMaintenance}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingIconBoxStyle}" Background="#F1F5F9">
                        <Path Data="M 4,7 H 20 M 6,7 L 7,20 H 17 L 18,7 M 9,7 V 4 H 15 V 7"
                              Width="19" Height="19" Stretch="Uniform"
                              Stroke="#64748B" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="缓存管理" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="#64748B"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding ButtonText}" Command="{Binding ClearCommand}"
                            Style="{StaticResource ModernDialogSecondaryButtonStyle}" VerticalAlignment="Center"
                            Padding="18,8" MinWidth="104" AutomationProperties.Name="清除缓存" />
                </Grid>
            </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
