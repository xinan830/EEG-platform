<UserControl x:Class="BrainPlatform.Desktop.Modules.Settings.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 现代化设置入口卡片按钮样式 -->
            <Style x:Key="SettingCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    Padding="24,20">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3B82F6" />
                                    <Setter TargetName="CardBorder" Property="Background" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2563EB" />
                                    <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 流程建议引导胶囊按钮样式 -->
            <Style x:Key="StepCapsuleStyle" TargetType="Border">
                <Setter Property="Background" Value="#EFF6FF" />
                <Setter Property="BorderBrush" Value="#DBEAFE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <!-- 1. 标题区 -->
            <RowDefinition Height="Auto" />
            <!-- 2. 2x2 模块入口卡片区 -->
            <RowDefinition Height="Auto" />
            <!-- 3. 底部配置流程建议 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. 标题栏 ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="配置设备通道映射、导联参考方案、屏幕物理校准与事件标记规则"
                       FontSize="13" Foreground="#64748B" Margin="0,6,0,0" />
        </StackPanel>

        <!-- ==================== 2. 四大模块入口 (2x2 网格) ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========== 模块 1: 通道配置 ========== -->
            <Button Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource SettingCardButtonStyle}"
                    Click="OnOpenChannelListClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标容器 (蓝色主题) -->
                    <Border Grid.Column="0" Width="48" Height="48"
                            Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                            CornerRadius="12" Margin="0,0,18,0" VerticalAlignment="Center">
                        <!-- 脉冲波形图标 -->
                        <Path Data="M 2,13 H 6 L 9,4 L 14,22 L 18,8 L 21,15 L 23,13 H 26"
                              Width="22" Height="22" Stretch="Uniform"
                              Stroke="#2563EB" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- 标题与说明 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="通道配置" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="配置设备物理输入通道映射、电极命名与通道采样参数"
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                                   Margin="0,5,0,0" LineHeight="19" />
                    </StackPanel>

                    <!-- 进入箭头 -->
                    <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                        <Path Data="M 3,8 H 13 M 9,4 L 13,8 L 9,12"
                              Width="12" Height="12" Stretch="Uniform"
                              Stroke="#64748B" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <!-- ========== 模块 2: 导联配置 ========== -->
            <Button Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource SettingCardButtonStyle}"
                    Click="OnOpenMontageListClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标容器 (靛紫主题) -->
                    <Border Grid.Column="0" Width="48" Height="48"
                            Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="1"
                            CornerRadius="12" Margin="0,0,18,0" VerticalAlignment="Center">
                        <!-- 导联/拓扑节点图标 -->
                        <Path Data="M 6,6 A 2.5,2.5 0 1 1 6,11 A 2.5,2.5 0 0 1 6,6 M 18,3 A 2.5,2.5 0 1 1 18,8 A 2.5,2.5 0 0 1 18,3 M 18,15 A 2.5,2.5 0 1 1 18,20 A 2.5,2.5 0 0 1 18,15 M 8.2,9.2 L 15.8,6.2 M 8.2,10.2 L 15.8,16.5"
                              Width="22" Height="22" Stretch="Uniform"
                              Stroke="#4F46E5" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- 标题与说明 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="导联配置" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="配置电极参考方案、正负通道差分组合、显示排序与导联预设"
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                                   Margin="0,5,0,0" LineHeight="19" />
                    </StackPanel>

                    <!-- 进入箭头 -->
                    <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                        <Path Data="M 3,8 H 13 M 9,4 L 13,8 L 9,12"
                              Width="12" Height="12" Stretch="Uniform"
                              Stroke="#64748B" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <!-- ========== 模块 3: 屏幕尺寸校准 ========== -->
            <Button Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource SettingCardButtonStyle}"
                    Click="OnOpenScreenCalibrationClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标容器 (青绿主题) -->
                    <Border Grid.Column="0" Width="48" Height="48"
                            Background="#F0FDFA" BorderBrush="#CCFBF1" BorderThickness="1"
                            CornerRadius="12" Margin="0,0,18,0" VerticalAlignment="Center">
                        <!-- 屏幕尺标图标 -->
                        <Path Data="M 3,4 H 21 V 17 H 3 Z M 8,21 H 16 M 12,17 V 21 M 7,4 V 8 M 12,4 V 7 M 17,4 V 8"
                              Width="22" Height="22" Stretch="Uniform"
                              Stroke="#0D9488" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- 标题与说明 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="屏幕尺寸校准" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="校准物理显示尺寸与像素比，确保真实走纸速度与标尺准确"
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                                   Margin="0,5,0,0" LineHeight="19" />
                    </StackPanel>

                    <!-- 进入箭头 -->
                    <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                        <Path Data="M 3,8 H 13 M 9,4 L 13,8 L 9,12"
                              Width="12" Height="12" Stretch="Uniform"
                              Stroke="#64748B" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <!-- ========== 模块 4: 事件设置 ========== -->
            <Button Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource SettingCardButtonStyle}"
                    Click="OnOpenEventListClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标容器 (琥珀金主题) -->
                    <Border Grid.Column="0" Width="48" Height="48"
                            Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                            CornerRadius="12" Margin="0,0,18,0" VerticalAlignment="Center">
                        <!-- 标记旗帜/标签图标 -->
                        <Path Data="M 5,3 V 21 M 5,4 H 19 L 16,9.5 L 19,15 H 5"
                              Width="20" Height="20" Stretch="Uniform"
                              Stroke="#D97706" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- 标题与说明 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="事件设置" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="管理脑电标记事件类型、标签颜色以及采集与回溯中的快捷键映射"
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                                   Margin="0,5,0,0" LineHeight="19" />
                    </StackPanel>

                    <!-- 进入箭头 -->
                    <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                        <Path Data="M 3,8 H 13 M 9,4 L 13,8 L 9,12"
                              Width="12" Height="12" Stretch="Uniform"
                              Stroke="#64748B" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <!-- ==================== 3. 底部配置流程建议 ==================== -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
                Padding="20,14" Margin="0,24,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#EFF6FF" CornerRadius="14" Margin="0,0,12,0">
                        <Path Data="M 9,2 A 5,5 0 0 1 14,7 C 14,9 12.5,10.5 12,12 H 7 C 6.5,10.5 5,9 5,7 A 5,5 0 0 1 9,2 M 7,14 H 12 M 8,16 H 11"
                              Width="14" Height="14" Stretch="Uniform"
                              Stroke="#2563EB" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="配置建议：" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                    <TextBlock Text="首次采集前，建议先完成通道配置与导联配置，以保障脑电信号正常解析与显示。"
                               FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <!-- 流程步骤胶囊 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 步骤 1: 通道配置 -->
                    <Border Style="{StaticResource StepCapsuleStyle}" MouseLeftButtonUp="OnOpenChannelListClick">
                        <TextBlock Text="1. 通道配置" FontSize="12" FontWeight="Medium" Foreground="#2563EB" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="→" Foreground="#94A3B8" Margin="8,0" VerticalAlignment="Center" FontSize="12" />

                    <!-- 步骤 2: 导联配置 -->
                    <Border Style="{StaticResource StepCapsuleStyle}" MouseLeftButtonUp="OnOpenMontageListClick">
                        <TextBlock Text="2. 导联配置" FontSize="12" FontWeight="Medium" Foreground="#2563EB" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="→" Foreground="#94A3B8" Margin="8,0" VerticalAlignment="Center" FontSize="12" />

                    <!-- 步骤 3: 开始采集 -->
                    <Border Background="#F1F5F9" CornerRadius="14" Height="30" Padding="12,0">
                        <TextBlock Text="3. 开始采集" FontSize="12" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
