<UserControl x:Class="BrainPlatform.Desktop.Modules.Settings.Views.TemplateElectrodeAtlasPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BrainPlatform.Desktop.Modules.Settings.Views"
             xmlns:topomap="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Topomap"
             Background="#FFFFFF">

    <UserControl.Resources>
        <Style x:Key="AtlasSegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：两行紧凑布局，窄屏下也不会截断按钮或文字 -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="电极模板" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="MontageComboBox"
                                  Style="{StaticResource AppFilterComboBoxStyle}"
                                  Width="248"
                                  Height="32"
                                  FontSize="12.5"
                                  ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"
                                  SelectionChanged="OnMontageSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8"
                                Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MontageSummaryBadge" Text="加载中..." FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8" />
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ShowLabelsCheckBox"
                                  Content="显示标签"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Foreground="#334155"
                                  Margin="0,0,10,0"
                                  Checked="OnShowLabelsChanged"
                                  Unchecked="OnShowLabelsChanged" />

                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LayoutSplitRadio" Content="2D + 3D" GroupName="AtlasViewLayout" IsChecked="True"
                                             Style="{StaticResource AtlasSegmentButtonStyle}" Checked="OnLayoutModeChanged" />
                                <RadioButton x:Name="Layout2DRadio" Content="仅 2D" GroupName="AtlasViewLayout"
                                             Style="{StaticResource AtlasSegmentButtonStyle}" Checked="OnLayoutModeChanged" />
                                <RadioButton x:Name="Layout3DRadio" Content="仅 3D" GroupName="AtlasViewLayout"
                                             Style="{StaticResource AtlasSegmentButtonStyle}" Checked="OnLayoutModeChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock x:Name="ProjectionInfoText"
                               DockPanel.Dock="Left"
                               Text="投影方式：准备中..."
                               FontSize="11.5"
                               Foreground="#64748B"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="SelectedSiteSummary"
                               Text="点击 2D 点位可在 3D 头模中聚焦定位"
                               FontSize="11.5"
                               Foreground="#475569"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- 状态 / 错误提示条 -->
        <Border x:Name="StatusBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0"
                Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMessageText" Foreground="#991B1B" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="重试" Click="OnRetryClick" Padding="10,4" Margin="12,0,0,0" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- 主对照视图：2D 平面投影 + 3D 头模 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Column2D" Width="*" />
                <ColumnDefinition x:Name="ColumnGap" Width="12" />
                <ColumnDefinition x:Name="Column3D" Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Pane2D" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,6">
                        <TextBlock Text="2D 头皮平面投影" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" DockPanel.Dock="Left" />
                        <TextBlock Text="悬停查看名称 · 单击联动 3D" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right" />
                    </DockPanel>
                    <local:TemplateElectrodeMap2D x:Name="Map2D"
                                                  Grid.Row="1"
                                                  ShowLabels="True"
                                                  SiteClicked="OnMap2DSiteClicked"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                </Grid>
            </Border>

            <Border x:Name="Pane3D" Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,12,12,8" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,6">
                        <TextBlock Text="3D 头模电极分布" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" DockPanel.Dock="Left" />
                        <TextBlock Text="左键旋转 · Shift+左键平移 · 滚轮缩放" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right" />
                    </DockPanel>
                    <topomap:Topomap3DWebView x:Name="Map3D"
                                              Grid.Row="1"
                                              IsHeatmapPreview="False"
                                              EnablePreviewLabModes="False"
                                              HideInternalModeTabs="True"
                                              ExternalMode="electrodes"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
