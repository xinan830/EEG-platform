<UserControl x:Class="BrainPlatform.Desktop.Modules.Events.Views.EventDefinitionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:events="clr-namespace:BrainPlatform.Desktop.Modules.Events.Domain"
             Loaded="OnEditorLoaded" Unloaded="OnEditorUnloaded"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Form TextBox Style -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- System Protected TextBox Style -->
        <Style x:Key="SystemProtectedEditorStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDraftSystemDefinition}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Form ComboBox Style -->
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="MaxDropDownHeight" Value="240" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="#FFFFFF"
                                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                                  Data="M 0,0 L 4.5,4.5 L 9,0" Stroke="#64748B" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#CBD5E1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- System Protected ComboBox Style -->
        <Style x:Key="SystemProtectedComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDraftSystemDefinition}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Color Swatch Button Style -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Back Navigation Link + Titles -->
            <StackPanel Grid.Column="0">
                <Button Click="OnCancelClick" Cursor="Hand" Background="Transparent"
                        BorderThickness="0" Padding="0" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Path Data="M 14 12 L 4 12 M 9 7 L 4 12 L 9 17" Stroke="#1E293B" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"
                                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="返回" FontSize="14" FontWeight="Medium" Foreground="#1E293B" VerticalAlignment="Center" />
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Page Title (Auto-switches between "新建事件" and "编辑事件") -->
                <TextBlock Text="{Binding EventDefinitions.DraftPageTitle}" FontSize="26" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="配置采集与回放过程中使用的事件定义。" FontSize="13" Foreground="#64748B" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Right: Action Buttons (Cancel + Save) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Cancel Button -->
                <Button Click="OnCancelClick" Height="38" Padding="18,0" Background="#FFFFFF"
                        BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 14 6 L 6 14 M 6 6 L 14 14" Stroke="#2563EB" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="取消" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#F8FAFC" />
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#CBD5E1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Save Button -->
                <Button Click="OnSaveClick" IsEnabled="{Binding EventDefinitions.CanSave}"
                        Height="38" Padding="20,0" Margin="12,0,0,0" Background="#1677FF"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 19 21 H 5 A 2 2 0 0 1 3 19 V 5 A 2 2 0 0 1 5 3 H 16 L 21 8 V 19 A 2 2 0 0 1 19 21 Z M 17 21 V 13 H 7 V 21 Z M 7 3 V 8 H 15 V 3 Z"
                                          Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="保存" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#0958D9" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Form Container -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="14" Padding="36,32,36,28">
                <!-- DataContext switched to EventDefinitions inside the form -->
                <StackPanel DataContext="{Binding EventDefinitions}">

                    <!-- Form Grid Layout -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: 来源 (Source) -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="来源" Foreground="#334155" FontSize="13"
                                   FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                            <Border Height="40" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="8" Padding="12,0" HorizontalAlignment="Stretch">
                                <Border Height="24" CornerRadius="12" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#ECFDF5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDraftSystemDefinition}" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DraftSourceText}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDraftSystemDefinition}" Value="True">
                                                        <Setter Property="Foreground" Value="#2563EB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding DraftSourceHelper}" Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Row 1: 事件编码 (DraftCode) -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="事件编码" Foreground="#334155" FontSize="13"
                                   FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                            <TextBox x:Name="EventCodeTextBox" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True"
                                     Text="{Binding DraftCode, Mode=OneWay}"
                                     ToolTip="用于导出和事件匹配的稳定标识" />
                            <TextBlock Text="由系统自动生成，保存后不可修改。" Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Row 2: 名称 (DraftName) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="名称" Foreground="#334155" FontSize="13"
                                   FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,20" />
                        <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                        <!-- Row 3: 说明 (DraftDescription) -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="说明" Foreground="#334155" FontSize="13"
                                   FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,0,0" />
                        <Grid Grid.Row="3" Grid.Column="2" Margin="0,0,0,20">
                            <TextBox Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="200" MinHeight="84" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" Padding="14,10,14,24" FontSize="13" Foreground="#0F172A"
                                     Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <!-- Character Count Badge inside bottom-right of description box -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,12,8" IsHitTestVisible="False">
                                <TextBlock Text="{Binding DraftDescriptionLength}" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Text="/200" Foreground="#94A3B8" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 4: 颜色 (DraftColor) -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="颜色" Foreground="#334155" FontSize="13"
                                   FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,20" />
                        <WrapPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                            <!-- Swatches Panel (Named ColorSwatchPanel for code-behind) -->
                            <StackPanel x:Name="ColorSwatchPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Tag="#DC2626" Background="#DC2626" Click="OnColorClick" Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="红色" />
                                <Button Tag="#16A34A" Background="#16A34A" Click="OnColorClick" Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="绿色" />
                                <Button Tag="#2563EB" Background="#2563EB" Click="OnColorClick" Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="蓝色" />
                                <Button Tag="#EA580C" Background="#EA580C" Click="OnColorClick" Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="橙色" />
                                <Button Tag="#7C3AED" Background="#7C3AED" Click="OnColorClick" Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="紫色" />
                                <Button Tag="#06B6D4" Background="#06B6D4" Click="OnColorClick" Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="青色" />
                                <Button Tag="#EC4899" Background="#EC4899" Click="OnColorClick" Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="粉色" />
                                <Button Tag="#F59E0B" Background="#F59E0B" Click="OnColorClick" Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="黄色" />
                                <Button Tag="#0D9488" Background="#0D9488" Click="OnColorClick" Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="墨绿" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Divider Line -->
                            <Border Width="1" Height="20" Background="#E2E8F0" Margin="6,0,16,0" VerticalAlignment="Center" />

                            <!-- Preview Label + Swatch -->
                            <TextBlock Text="预览" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Width="30" Height="30" CornerRadius="8" Background="{Binding DraftColorPreviewBrush}"
                                    BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Center" ToolTip="当前颜色预览" />

                            <!-- Custom HEX Input -->
                            <TextBox Style="{StaticResource FormTextBoxStyle}" Height="34" Width="90"
                                     Text="{Binding DraftColor, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="12,0,0,0" Padding="8,0" FontSize="12" ToolTip="可输入 #RRGGBB 自定义颜色" />
                            <Button x:Name="CustomColorButton" Content="更多颜色" Click="OnPickColorClick"
                                    Height="34" Padding="12,0" Margin="10,0,0,0"
                                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Foreground="#2563EB" FontSize="12" Cursor="Hand" ToolTip="打开颜色选择器">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="CustomColorPopup" PlacementTarget="{Binding ElementName=CustomColorButton}"
                                   Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                                <Border Width="292" Background="#FFFFFF" BorderBrush="#CBD5E1"
                                        BorderThickness="1" CornerRadius="8" Padding="16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.15" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="自定义颜色" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#0F172A" VerticalAlignment="Center" />
                                            <Border x:Name="PickerColorPreview" Width="34" Height="34"
                                                    HorizontalAlignment="Right" CornerRadius="6"
                                                    BorderBrush="#CBD5E1" BorderThickness="1" />
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="R" Foreground="#DC2626" VerticalAlignment="Center" />
                                            <Slider x:Name="RedColorSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                                    ValueChanged="OnPickerValueChanged" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RedColorSlider, StringFormat=F0}"
                                                       TextAlignment="Right" Foreground="#475569" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="G" Foreground="#16A34A" VerticalAlignment="Center" />
                                            <Slider x:Name="GreenColorSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                                    ValueChanged="OnPickerValueChanged" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GreenColorSlider, StringFormat=F0}"
                                                       TextAlignment="Right" Foreground="#475569" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="B" Foreground="#2563EB" VerticalAlignment="Center" />
                                            <Slider x:Name="BlueColorSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                                    ValueChanged="OnPickerValueChanged" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=BlueColorSlider, StringFormat=F0}"
                                                       TextAlignment="Right" Foreground="#475569" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="取消" Click="OnCancelPickerColorClick" Padding="12,5"
                                                    Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="#CBD5E1"
                                                    BorderThickness="1" Cursor="Hand" />
                                            <Button Content="应用颜色" Click="OnApplyPickerColorClick" Padding="12,5"
                                                    Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0"
                                                    Cursor="Hand" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Row 5: 快捷键 (DraftShortcut) -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="快捷键" Foreground="#334155" FontSize="13"
                                   FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,20" />
                        <Grid Grid.Row="5" Grid.Column="2" Margin="0,0,0,20">
                            <TextBox Style="{StaticResource SystemProtectedEditorStyle}"
                                     Text="{Binding DraftShortcut, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True" PreviewKeyDown="OnShortcutPreviewKeyDown"
                                     Padding="14,0,36,0" ToolTip="在输入框中直接按下快捷键；留空表示不绑定" />

                            <!-- Clear Shortcut Button -->
                            <Button Click="OnClearShortcutClick" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,10,0" Width="20" Height="20" Cursor="Hand" Background="Transparent"
                                    BorderThickness="0" ToolTip="清空快捷键">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DraftShortcut}" Value="" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsDraftSystemDefinition}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DraftShortcut, Converter={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#E2E8F0" CornerRadius="10" Width="18" Height="18">
                                            <Path Data="M 12 6 L 6 12 M 6 6 L 12 12" Stroke="#64748B" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" Width="8" Height="8" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Row 6: 快捷键作用范围 (DraftShortcutScope) -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="快捷键作用范围" Foreground="#334155" FontSize="13"
                                   FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,20" />
                        <ComboBox Grid.Row="6" Grid.Column="2" Style="{StaticResource SystemProtectedComboBoxStyle}"
                                  ItemsSource="{Binding ShortcutScopes}"
                                  SelectedItem="{Binding DraftShortcutScope, Mode=TwoWay}"
                                  Margin="0,0,0,20">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="实时采集" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static events:ShortcutScope.Review}">
                                                        <Setter Property="Text" Value="数据回溯" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static events:ShortcutScope.Global}">
                                                        <Setter Property="Text" Value="全局" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Row 7: 启用状态 (DraftIsEnabled) -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="启用状态" Foreground="#334155" FontSize="13"
                                   FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="7" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <ToggleButton IsChecked="{Binding DraftIsEnabled, Mode=TwoWay}"
                                          Width="38" Height="22" Cursor="Hand" BorderThickness="0" ToolTip="切换启用状态">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="#CBD5E1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#2563EB" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="11" Width="38" Height="22">
                                            <Ellipse Width="16" Height="16" Fill="White" Margin="3,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Text="{Binding DraftEnabledText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="#334155" FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <!-- System Definition Restriction Info Banner -->
                    <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                            CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDraftSystemDefinition}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12 2 A 10 10 0 1 0 22 12 A 10 10 0 0 0 12 2 Z M 12 16 L 12 11 M 12 8 L 12.01 8"
                                  Stroke="#2563EB" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="16" Height="16"
                                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="系统预设的快捷键和快捷键作用范围不可修改。" Foreground="#2563EB"
                                       FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Bottom Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="取消" Click="OnCancelClick" Height="38" Padding="24,0"
                                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#F8FAFC" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#CBD5E1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="OnSaveClick" IsEnabled="{Binding CanSave}" Height="38" Padding="22,0"
                                Margin="12,0,0,0" Background="#1677FF" Foreground="#FFFFFF"
                                FontSize="13" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 19 21 H 5 A 2 2 0 0 1 3 19 V 5 A 2 2 0 0 1 5 3 H 16 L 21 8 V 19 A 2 2 0 0 1 19 21 Z M 17 21 V 13 H 7 V 21 Z M 7 3 V 8 H 15 V 3 Z"
                                                  Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="保存事件" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#0958D9" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
