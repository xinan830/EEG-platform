<UserControl x:Class="BrainPlatform.Desktop.Modules.Events.Views.EventListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style x:Key="EventTableHeaderCenteredStyle" TargetType="TextBlock"
               BasedOn="{StaticResource AppTableHeaderTextStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="EventTableCellCenteredStyle" TargetType="TextBlock"
               BasedOn="{StaticResource AppTableCellTextStyle}">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Back Navigation + Titles -->
            <StackPanel Grid.Column="0">
                <!-- Back Link Button -->
                <Button Click="OnBackClick" Cursor="Hand" Background="Transparent"
                        BorderThickness="0" Padding="0" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Path Data="M 14 12 L 4 12 M 9 7 L 4 12 L 9 17" Stroke="#1E293B" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"
                                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="返回" FontSize="14" FontWeight="Medium" Foreground="#1E293B" VerticalAlignment="Center" />
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Page Title & Subtitle -->
                <TextBlock Text="事件设置" FontSize="26" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="管理采集和回放过程中使用的事件标记。" FontSize="13" Foreground="#64748B" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Right: Action Buttons (Refresh + New Event) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Refresh Button -->
                <Button Command="{Binding EventDefinitions.RefreshCommand}" Height="38" Padding="16,0"
                        Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 17.65 6.35 A 8 8 0 1 0 19 12 M 19 4 L 19 8 L 15 8" Stroke="#2563EB"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="刷新" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#F8FAFC" />
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#CBD5E1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- New Event Button -->
                <Button Click="OnNewClick" Height="38" Padding="18,0" Margin="12,0,0,0"
                        Background="#1677FF" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 12 2 A 10 10 0 1 0 22 12 A 10 10 0 0 0 12 2 Z M 12 7 L 12 17 M 7 12 L 17 12"
                                          Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="新建事件" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#0958D9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter bar and table -->
        <Border Grid.Row="1" Style="{StaticResource AppTableSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filter Bar: Search Input + Source Filter + Status Filter -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" MaxWidth="440" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box with Icon -->
                    <Border Grid.Column="0" Height="38" Background="#FFFFFF" BorderBrush="#E2E8F0"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Margin="12,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="M 10 2 A 8 8 0 1 0 16 14.5 L 21 19.5 L 19.5 21 L 14.5 16 A 8 8 0 0 0 10 2 Z M 10 4 A 6 6 0 1 1 4 10 A 6 6 0 0 1 10 4 Z"
                                  Fill="#2563EB" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />

                            <TextBox Grid.Column="1" x:Name="EventSearchBox" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="13" Foreground="#0F172A"
                                     Text="{Binding EventDefinitions.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="1" Text="搜索事件编码、名称或说明" Foreground="#94A3B8" FontSize="13"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=EventSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Source Filter -->
                    <TextBlock Grid.Column="2" Text="来源" VerticalAlignment="Center"
                               Margin="24,0,12,0" Foreground="#334155" FontSize="13" FontWeight="Medium" />
                    <ComboBox Grid.Column="3" Style="{StaticResource AppRoundedFilterComboBoxStyle}"
                              ItemsSource="{Binding EventDefinitions.SourceFilterOptions}"
                              SelectedItem="{Binding EventDefinitions.SourceFilter, Mode=TwoWay}" />

                    <!-- Status Filter -->
                    <TextBlock Grid.Column="4" Text="状态" VerticalAlignment="Center"
                               Margin="24,0,12,0" Foreground="#334155" FontSize="13" FontWeight="Medium" />
                    <ComboBox Grid.Column="5" Style="{StaticResource AppRoundedFilterComboBoxStyle}"
                              ItemsSource="{Binding EventDefinitions.StatusFilterOptions}"
                              SelectedItem="{Binding EventDefinitions.StatusFilter, Mode=TwoWay}" />
                </Grid>

                <!-- Table Header Bar -->
                <Border Grid.Row="1" Style="{StaticResource AppTableHeaderBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="颜色" Style="{StaticResource EventTableHeaderCenteredStyle}" />
                        <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource EventTableHeaderCenteredStyle}" />
                        <TextBlock Grid.Column="2" Text="事件编码" Style="{StaticResource EventTableHeaderCenteredStyle}" />
                        <TextBlock Grid.Column="3" Text="来源" Style="{StaticResource EventTableHeaderCenteredStyle}" />
                        <TextBlock Grid.Column="4" Text="启用状态" Style="{StaticResource EventTableHeaderCenteredStyle}" />
                        <TextBlock Grid.Column="5" Text="快捷键" Style="{StaticResource EventTableHeaderCenteredStyle}" />
                        <TextBlock Grid.Column="6" Text="历史引用" Style="{StaticResource EventTableHeaderCenteredStyle}" />
                        <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource EventTableHeaderCenteredStyle}" />
                    </Grid>
                </Border>

                <!-- Table Data Rows -->
                <ListBox Grid.Row="2" Style="{StaticResource AppTableBodyListBoxStyle}"
                         ItemsSource="{Binding EventDefinitions.FilteredRows}"
                         SelectedItem="{Binding EventDefinitions.SelectedRow, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Style="{StaticResource AppTableRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>

                                <!-- Row Bottom Divider -->
                                <Border Grid.ColumnSpan="8" Style="{StaticResource AppTableRowDividerStyle}" />

                                <!-- Column 0: Color -->
                                <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4"
                                        Background="{Binding Definition.Color}" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                <!-- Column 1: Name -->
                                <TextBlock Grid.Column="1" Text="{Binding Definition.Name}"
                                           Style="{StaticResource EventTableCellCenteredStyle}"
                                           Foreground="#1E293B" FontWeight="Medium" />

                                <!-- Column 2: Event Code -->
                                <TextBlock Grid.Column="2" Text="{Binding Definition.Code}"
                                           Style="{StaticResource EventTableCellCenteredStyle}" />

                                <!-- Column 3: Source (Pill Tag) -->
                                <Border Grid.Column="3" Height="24" CornerRadius="12" Padding="10,2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#ECFDF5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Definition.IsSystem}" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" FontWeight="Medium" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="用户创建" />
                                                <Setter Property="Foreground" Value="#10B981" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Definition.IsSystem}" Value="True">
                                                        <Setter Property="Text" Value="系统预设" />
                                                        <Setter Property="Foreground" Value="#2563EB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Column 4: Enabled Switch -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Click="OnToggleEnabledClick" Width="38" Height="22" Padding="0" Cursor="Hand"
                                            BorderThickness="0" ToolTip="切换启用状态">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#CBD5E1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Definition.IsEnabled}" Value="True">
                                                        <Setter Property="Background" Value="#2563EB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="11" Width="38" Height="22">
                                                    <Ellipse Width="16" Height="16" Fill="White" Margin="3,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Definition.IsEnabled}" Value="True">
                                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="已停用" />
                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Definition.IsEnabled}" Value="True">
                                                        <Setter Property="Text" Value="已启用" />
                                                        <Setter Property="Foreground" Value="#334155" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Column 5: Shortcut -->
                                <TextBlock Grid.Column="5" Text="{Binding Definition.Shortcut}"
                                           Style="{StaticResource EventTableCellCenteredStyle}" />

                                <TextBlock Grid.Column="6" Text="{Binding ReferenceStatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EventTableCellCenteredStyle}">
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReferenceStatusText}" Value="已被引用">
                                                    <Setter Property="Foreground" Value="#D97706" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Column 7: Actions (Edit + Delete) -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <!-- Edit Button -->
                                    <Button Click="OnEditClick" Cursor="Hand" Background="Transparent"
                                            BorderThickness="0" Padding="0" ToolTip="编辑事件">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                                    <Path Data="M 12 20 L 21 20 M 16.5 3.5 A 2.121 2.121 0 0 1 19.5 6.5 L 7 19 L 3 20 L 4 16 L 16.5 3.5 Z"
                                                          Stroke="#2563EB" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                                    <TextBlock Text="编辑" Foreground="#2563EB" FontSize="13" FontWeight="Medium"
                                                               Margin="5,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Delete Button (Disabled for System definitions) -->
                                    <Button Click="OnDeleteClick" Margin="16,0,0,0" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            ToolTip="{Binding DeleteRestrictionText}" IsEnabled="{Binding CanDelete}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.35" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                                    <Path Data="M 3 6 L 5 6 L 19 6 M 8 6 L 8 4 A 2 2 0 0 1 10 2 L 14 2 A 2 2 0 0 1 16 4 L 16 6 M 18 6 L 18 20 A 2 2 0 0 1 16 22 L 8 22 A 2 2 0 0 1 6 20 L 6 6 M 10 11 L 10 17 M 14 11 L 14 17"
                                                          Stroke="#EF4444" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                                    <TextBlock Text="删除" Foreground="#EF4444" FontSize="13" FontWeight="Medium"
                                                               Margin="5,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State Message -->
                <TextBlock Grid.Row="2" Text="暂无符合条件的事件" Foreground="#94A3B8" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EventDefinitions.FilteredDefinitions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Table Footer: Total Count -->
                <TextBlock Grid.Row="3" Margin="16,14,0,4" Foreground="#64748B" FontSize="13">
                    <Run Text="共 " /><Run Text="{Binding EventDefinitions.FilteredDefinitions.Count, Mode=OneWay}" /><Run Text=" 条记录" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
