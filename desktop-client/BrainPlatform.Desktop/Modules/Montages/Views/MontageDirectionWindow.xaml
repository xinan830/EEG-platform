<Window x:Class="BrainPlatform.Desktop.Modules.Montages.Views.MontageDirectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BrainPlatform.Desktop.Modules.Montages.Views"
        Title="导联指向图" Width="820" Height="720" MinWidth="620" MinHeight="560"
        WindowStyle="ToolWindow" ShowInTaskbar="False" ResizeMode="CanResize" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="导联指向关系" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
            <TextBlock Text="箭头从导联公式的正端指向负参考端，例如 F3-REF 显示为 F3 → REF。此图仅展示导联关系，不表示幅值或电极电位。" TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
            <views:MontageDirectionMap x:Name="DirectionMap"/>
        </Border>
        <TextBlock Grid.Row="2" Text="蓝色箭头：正端 → 负参考端 · 紫色：REF · 绿色：GND · 未解析位置的电极不会绘制" FontSize="11" Foreground="#64748B" Margin="4,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
