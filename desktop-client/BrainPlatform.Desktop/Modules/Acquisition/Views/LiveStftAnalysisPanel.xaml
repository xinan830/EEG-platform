<UserControl x:Class="BrainPlatform.Desktop.Modules.Acquisition.Views.LiveStftAnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Analysis"
             xmlns:stft="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Stft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/AnalysisStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <shared:AnalysisPanelShell Title="{Binding CardHeaderTitle, FallbackValue=''}" CloseCommand="{Binding CloseAnalysisCommand}"
                               DockCommand="{Binding DockCommand, FallbackValue={x:Null}}"
                               DockToolTip="{Binding DockToolTip, FallbackValue=停靠 / 分离}"
                               MaximizeCommand="{Binding MaximizeCommand, FallbackValue={x:Null}}"
                               MaximizeToolTip="{Binding MaximizeToolTip, FallbackValue=放大 / 还原}"
                               IsMaximizeVisible="{Binding CanMaximize, FallbackValue=False}"
                               IsMaximized="{Binding IsMaximized, FallbackValue=False}"
                               StatusText="{Binding StftAnalysis.StatusText}">
        <shared:AnalysisPanelShell.HeaderContent>
            <ComboBox ItemsSource="{Binding Channels}"
                      SelectedItem="{Binding SelectedChannel, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource AnalysisHeaderComboBoxStyle}"
                      MinWidth="92" MaxWidth="180" HorizontalAlignment="Left"
                      VerticalAlignment="Center" />
        </shared:AnalysisPanelShell.HeaderContent>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <stft:StftHeatmap Grid.Row="0" MinHeight="180" RetainHistory="True"
                              VisibleStartSeconds="{Binding StftAnalysis.AnalysisStartSeconds}"
                              Preview="{Binding StftAnalysis.Stft}"
                              AutomationProperties.Name="实时时频图" />
            <Border Grid.Row="1" Margin="0,4,0,0" Padding="2,4,2,0" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StftAnalysis.WindowText}" Foreground="#475569" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StftAnalysis.StatusText}" TextWrapping="Wrap"
                               Foreground="#64748B" FontSize="11" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StftAnalysis.StatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="PowerUnitFooterLabel" Grid.Column="2" Text="dB re 1 µV²/Hz"
                               Foreground="#64748B" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </shared:AnalysisPanelShell>
</UserControl>
