<UserControl x:Class="BrainPlatform.Desktop.Modules.Acquisition.Views.LiveAnalysisToolbarStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BrainPlatform.Desktop.Shared.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/InstrumentWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <controls:EegToolButton Content="RBP 算法"
                                IconSource="pack://application:,,,/Assets/AlgorithmIcons/rbp.png"
                                Command="{Binding Acquisition.LiveAnalysis.OpenRbpCommand}"
                                IsEnabled="{Binding Acquisition.LiveAnalysis.IsInteractive}"
                                ToolTip="打开实时相对频段功率趋势（支持多算法并行）">
            <controls:EegToolButton.Style><Style TargetType="{x:Type controls:EegToolButton}" BasedOn="{StaticResource {x:Type controls:EegToolButton}}"><Style.Triggers><DataTrigger Binding="{Binding Acquisition.LiveAnalysis.IsRbpOpen}" Value="True"><Setter Property="Background" Value="#DBEAFE" /><Setter Property="Foreground" Value="#2563EB" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></controls:EegToolButton.Style>
        </controls:EegToolButton>
        <controls:EegToolButton Content="PSD"
                                IconSource="pack://application:,,,/Assets/AlgorithmIcons/psd.png"
                                Command="{Binding Acquisition.LiveAnalysis.OpenPsdCommand}"
                                IsEnabled="{Binding Acquisition.LiveAnalysis.IsInteractive}"
                                ToolTip="打开实时功率谱密度（支持多算法并行）">
            <controls:EegToolButton.Style><Style TargetType="{x:Type controls:EegToolButton}" BasedOn="{StaticResource {x:Type controls:EegToolButton}}"><Style.Triggers><DataTrigger Binding="{Binding Acquisition.LiveAnalysis.IsPsdOpen}" Value="True"><Setter Property="Background" Value="#DBEAFE" /><Setter Property="Foreground" Value="#2563EB" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></controls:EegToolButton.Style>
        </controls:EegToolButton>
        <controls:EegToolButton Content="STFT 时频"
                                IconSource="pack://application:,,,/Assets/AlgorithmIcons/stft.png"
                                Command="{Binding Acquisition.LiveAnalysis.OpenStftCommand}"
                                IsEnabled="{Binding Acquisition.LiveAnalysis.IsInteractive}"
                                ToolTip="打开实时短时傅里叶时频图（支持多算法并行）">
            <controls:EegToolButton.Style><Style TargetType="{x:Type controls:EegToolButton}" BasedOn="{StaticResource {x:Type controls:EegToolButton}}"><Style.Triggers><DataTrigger Binding="{Binding Acquisition.LiveAnalysis.IsStftOpen}" Value="True"><Setter Property="Background" Value="#DBEAFE" /><Setter Property="Foreground" Value="#2563EB" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></controls:EegToolButton.Style>
        </controls:EegToolButton>
        <controls:EegToolButton Content="IAPF"
                                IconSource="pack://application:,,,/Assets/AlgorithmIcons/iapf.png"
                                Command="{Binding Acquisition.LiveAnalysis.OpenIapfCommand}"
                                IsEnabled="{Binding Acquisition.LiveAnalysis.IsInteractive}"
                                ToolTip="打开实时个体 Alpha 峰频率趋势（20 秒窗口）">
            <controls:EegToolButton.Style><Style TargetType="{x:Type controls:EegToolButton}" BasedOn="{StaticResource {x:Type controls:EegToolButton}}"><Style.Triggers><DataTrigger Binding="{Binding Acquisition.LiveAnalysis.IsIapfOpen}" Value="True"><Setter Property="Background" Value="#DBEAFE" /><Setter Property="Foreground" Value="#2563EB" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></controls:EegToolButton.Style>
        </controls:EegToolButton>
        <controls:EegToolButton Content="Theta/Beta"
                                IconSource="pack://application:,,,/Assets/AlgorithmIcons/theta-beta.png"
                                Command="{Binding Acquisition.LiveAnalysis.OpenThetaBetaCommand}"
                                IsEnabled="{Binding Acquisition.LiveAnalysis.IsInteractive}"
                                ToolTip="打开实时 Theta/Beta 比值趋势（20 秒窗口）">
            <controls:EegToolButton.Style><Style TargetType="{x:Type controls:EegToolButton}" BasedOn="{StaticResource {x:Type controls:EegToolButton}}"><Style.Triggers><DataTrigger Binding="{Binding Acquisition.LiveAnalysis.IsThetaBetaOpen}" Value="True"><Setter Property="Background" Value="#DBEAFE" /><Setter Property="Foreground" Value="#2563EB" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></controls:EegToolButton.Style>
        </controls:EegToolButton>
        <controls:EegToolButton Content="BrainBeat"
                                IconSource="pack://application:,,,/Assets/AlgorithmIcons/brainbeat.png"
                                Command="{Binding Acquisition.LiveAnalysis.OpenBrainbeatCommand}"
                                IsEnabled="{Binding Acquisition.LiveAnalysis.IsInteractive}"
                                ToolTip="打开实时经典 BrainBeat 趋势（Fz/Pz 来源通道，20 秒窗口）">
            <controls:EegToolButton.Style><Style TargetType="{x:Type controls:EegToolButton}" BasedOn="{StaticResource {x:Type controls:EegToolButton}}"><Style.Triggers><DataTrigger Binding="{Binding Acquisition.LiveAnalysis.IsBrainbeatOpen}" Value="True"><Setter Property="Background" Value="#DBEAFE" /><Setter Property="Foreground" Value="#2563EB" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></controls:EegToolButton.Style>
        </controls:EegToolButton>
    </StackPanel>
</UserControl>
