<UserControl x:Class="BrainPlatform.Desktop.Modules.Acquisition.Views.AcquisitionWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Modules.Acquisition.Views"
             xmlns:waveform="clr-namespace:BrainPlatform.Desktop.Modules.Acquisition.Waveform"
             xmlns:controls="clr-namespace:BrainPlatform.Desktop.Shared.Controls"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Behaviors"
             Background="#F3F5F8"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             shared:EegSessionPresentation.Menu="{Binding ElementName=PageMenu}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/InstrumentWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <Menu x:Name="PageMenu" Visibility="Collapsed" Style="{StaticResource EegCaptionMenuStyle}">
        <MenuItem Header="项目"><MenuItem Header="返回项目" Click="OnBackClick" /></MenuItem>
        <MenuItem Header="分析" IsEnabled="False" />
        <MenuItem Header="报告" IsEnabled="False" />
        <MenuItem Header="设置"><MenuItem Header="采集参数" Command="{Binding Acquisition.LiveMonitor.ToggleSettingsCommand}" /></MenuItem>
    </Menu>

    <views:EegWorkspaceShell Style="{StaticResource EegInstrumentShellStyle}" WaveformDataContext="{Binding Acquisition.LiveMonitor}"
                             IsImmersiveWaveform="True"
                             IsEdgeToEdgeTopBar="True"
                             ShowBottomBar="False">
        <views:EegWorkspaceShell.TopBar>
            <Grid Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. 功能 Ribbon 栏 -->
                <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6" Background="#FFFFFF">
                    <DockPanel LastChildFill="False">
                        <!-- 左侧：主要采集控制工具按钮组 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 开始记录按钮 (预览中显示) -->
                            <controls:EegToolButton Content="开始记录" Glyph="&#xE768;"
                                                    Command="{Binding Acquisition.StartRecordingCommand}"
                                                    IsEnabled="{Binding Acquisition.CanStartRecording}"
                                                    ToolTip="开始记录原始脑电数据">
                                <controls:EegToolButton.Style>
                                    <Style TargetType="{x:Type controls:EegToolButton}" BasedOn="{StaticResource {x:Type controls:EegToolButton}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPaused}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:EegToolButton.Style>
                            </controls:EegToolButton>

                            <!-- 恢复记录按钮 (暂停时显示) -->
                            <controls:EegToolButton Content="恢复记录" Glyph="&#xE768;"
                                                    Command="{Binding Acquisition.ResumeRecordingCommand}"
                                                    IsEnabled="{Binding Acquisition.CanResume}"
                                                    ToolTip="恢复脑电记录">
                                <controls:EegToolButton.Style>
                                    <Style TargetType="{x:Type controls:EegToolButton}" BasedOn="{StaticResource {x:Type controls:EegToolButton}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPaused}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:EegToolButton.Style>
                            </controls:EegToolButton>

                            <!-- 暂停记录按钮 -->
                            <controls:EegToolButton Content="暂停记录" Glyph="&#xE769;"
                                                    Command="{Binding Acquisition.PauseRecordingCommand}"
                                                    IsEnabled="{Binding Acquisition.CanPause}"
                                                    ToolTip="暂停记录（实时波形继续更新）" />

                            <!-- 完成记录 / 停止采集按钮 -->
                            <controls:EegToolButton Content="完成记录" Glyph="&#xE71A;"
                                                    Click="OnFinishRecordingClick"
                                                    IsEnabled="{Binding Acquisition.CanStop}"
                                                    ToolTip="完成记录并保存会话" />

                            <Border Width="1" Height="28" Background="#E2E8F0" Margin="6,0,6,0" VerticalAlignment="Center" />

                            <!-- 事件类型选择下拉框与事件标记工具按钮 -->
                            <ComboBox Style="{StaticResource AppFilterComboBoxStyle}"
                                      ItemsSource="{Binding Acquisition.EnabledEventDefinitions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Acquisition.SelectedEventDefinitionId, Mode=TwoWay}"
                                      Width="120" Height="32" Margin="2,0,4,0"
                                      VerticalAlignment="Center"
                                      ToolTip="选择要标记的事件类型">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <controls:EegToolButton Content="事件标记" Glyph="&#xE70F;"
                                                    Command="{Binding Acquisition.MarkSelectedEventCommand}"
                                                    IsEnabled="{Binding Acquisition.CanPause}"
                                                    ToolTip="在当前采样坐标添加标记" />

                            <Border Width="1" Height="28" Background="#E2E8F0" Margin="6,0,6,0" VerticalAlignment="Center" />

                            <!-- 数据信息与设置按钮 -->
                            <controls:EegToolButton Content="数据信息" Glyph="&#xE946;"
                                                    Command="{Binding Acquisition.LiveMonitor.ToggleSettingsCommand}"
                                                    ToolTip="查看项目与采集数据信息" />
                        </StackPanel>

                        <!-- 右侧：会话运行状态与计时器胶囊 -->
                        <Border DockPanel.Dock="Right" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="6" Height="34" Padding="12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 状态指示灯与状态文字 -->
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#94A3B8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsRecording}" Value="True">
                                                    <Setter Property="Fill" Value="#EF4444" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPaused}" Value="True">
                                                    <Setter Property="Fill" Value="#F59E0B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPreviewing}" Value="True">
                                                    <Setter Property="Fill" Value="#1677FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="就绪" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsRecording}" Value="True">
                                                    <Setter Property="Text" Value="录制中" />
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPaused}" Value="True">
                                                    <Setter Property="Text" Value="已暂停" />
                                                    <Setter Property="Foreground" Value="#D97706" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPreviewing}" Value="True">
                                                    <Setter Property="Text" Value="预览中" />
                                                    <Setter Property="Foreground" Value="#1677FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 分割竖线 -->
                                <Border Width="1" Height="14" Background="#CBD5E1" Margin="10,0" VerticalAlignment="Center" />

                                <!-- 计时器 -->
                                <TextBlock Text="{Binding Acquisition.LiveMonitor.RecordingElapsedText}"
                                           FontFamily="Consolas, monospace" FontWeight="SemiBold"
                                           FontSize="13.5" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 2. 显示滤波与标尺参数栏 -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
                    <DockPanel LastChildFill="False">
                        <!-- 左侧滤波与标尺控制组 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 高通 -->
                            <controls:EegParameterField Header="高通" MinWidth="86">
                                <ComboBox Style="{StaticResource EegParameterComboBoxStyle}"
                                          IsEnabled="{Binding Acquisition.DisplayPreferences.CanConfigureFilters}"
                                          SelectedValuePath="Tag" SelectedValue="{Binding Acquisition.DisplayPreferences.LiveHighPassHz, Mode=TwoWay}"
                                          ToolTip="由本地 Python 科学引擎执行的实时显示高通。原始记录保持未滤波。">
                                    <ComboBoxItem Content="0.01 Hz" Tag="0.01" />
                                    <ComboBoxItem Content="0.05 Hz" Tag="0.05" />
                                    <ComboBoxItem Content="0.1 Hz" Tag="0.1" />
                                    <ComboBoxItem Content="0.2 Hz" Tag="0.2" />
                                    <ComboBoxItem Content="0.3 Hz" Tag="0.3" />
                                    <ComboBoxItem Content="0.4 Hz" Tag="0.4" />
                                    <ComboBoxItem Content="0.5 Hz" Tag="0.5" />
                                    <ComboBoxItem Content="0.6 Hz" Tag="0.6" />
                                    <ComboBoxItem Content="0.7 Hz" Tag="0.7" />
                                    <ComboBoxItem Content="0.8 Hz" Tag="0.8" />
                                    <ComboBoxItem Content="0.9 Hz" Tag="0.9" />
                                    <ComboBoxItem Content="1 Hz" Tag="1" />
                                    <ComboBoxItem Content="1.5 Hz" Tag="1.5" />
                                    <ComboBoxItem Content="2 Hz" Tag="2" />
                                    <ComboBoxItem Content="3 Hz" Tag="3" />
                                    <ComboBoxItem Content="5 Hz" Tag="5" />
                                    <ComboBoxItem Content="10 Hz" Tag="10" />
                                </ComboBox>
                            </controls:EegParameterField>

                            <!-- 低通 -->
                            <controls:EegParameterField Header="低通" MinWidth="86">
                                <ComboBox Style="{StaticResource EegParameterComboBoxStyle}"
                                          IsEnabled="{Binding Acquisition.DisplayPreferences.CanConfigureFilters}"
                                          SelectedValuePath="Tag" SelectedValue="{Binding Acquisition.DisplayPreferences.LiveLowPassHz, Mode=TwoWay}"
                                          ToolTip="由本地 Python 科学引擎执行的实时显示低通。原始记录保持未滤波。">
                                    <ComboBoxItem Content="10 Hz" Tag="10" />
                                    <ComboBoxItem Content="20 Hz" Tag="20" />
                                    <ComboBoxItem Content="30 Hz" Tag="30" />
                                    <ComboBoxItem Content="40 Hz" Tag="40" />
                                    <ComboBoxItem Content="50 Hz" Tag="50" />
                                    <ComboBoxItem Content="60 Hz" Tag="60" />
                                    <ComboBoxItem Content="70 Hz" Tag="70" />
                                    <ComboBoxItem Content="80 Hz" Tag="80" />
                                    <ComboBoxItem Content="90 Hz" Tag="90" />
                                    <ComboBoxItem Content="100 Hz" Tag="100" />
                                </ComboBox>
                            </controls:EegParameterField>

                            <!-- 陷波 -->
                            <controls:EegParameterField Header="陷波" MinWidth="78">
                                <ComboBox Style="{StaticResource EegParameterComboBoxStyle}"
                                          IsEnabled="{Binding Acquisition.DisplayPreferences.CanConfigureFilters}"
                                          SelectedValuePath="Tag" SelectedValue="{Binding Acquisition.DisplayPreferences.LiveNotchHz, Mode=TwoWay}"
                                          ToolTip="由本地 Python 科学引擎执行的实时显示陷波。原始记录保持未滤波。">
                                    <ComboBoxItem Content="关闭" Tag="0" />
                                    <ComboBoxItem Content="50 Hz" Tag="50" />
                                    <ComboBoxItem Content="60 Hz" Tag="60" />
                                </ComboBox>
                            </controls:EegParameterField>

                            <!-- 灵敏度 -->
                            <controls:EegParameterField Header="灵敏度" MinWidth="94">
                                <ComboBox Style="{StaticResource EegParameterComboBoxStyle}"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding Acquisition.LiveMonitor.SensitivityMicrovoltsPerMillimeter, Mode=TwoWay}">
                                    <ComboBoxItem Content="1 µV/mm" Tag="1" />
                                    <ComboBoxItem Content="2 µV/mm" Tag="2" />
                                    <ComboBoxItem Content="5 µV/mm" Tag="5" />
                                    <ComboBoxItem Content="7 µV/mm" Tag="7" />
                                    <ComboBoxItem Content="10 µV/mm" Tag="10" />
                                    <ComboBoxItem Content="15 µV/mm" Tag="15" />
                                    <ComboBoxItem Content="20 µV/mm" Tag="20" />
                                    <ComboBoxItem Content="50 µV/mm" Tag="50" />
                                    <ComboBoxItem Content="70 µV/mm" Tag="70" />
                                    <ComboBoxItem Content="100 µV/mm" Tag="100" />
                                </ComboBox>
                            </controls:EegParameterField>

                            <!-- 走纸速度 -->
                            <controls:EegParameterField MinWidth="92">
                                <controls:EegParameterField.Header>
                                    <RadioButton Content="走纸速度" GroupName="LiveHorizontalScale"
                                                 IsChecked="{Binding Acquisition.LiveMonitor.IsPaperSpeedMode, Mode=TwoWay}"
                                                 Style="{StaticResource EegParameterFieldRadioHeaderStyle}"
                                                 ToolTip="名义纸速输入。未校准显示器的物理毫米仅作工作站显示参考。" />
                                </controls:EegParameterField.Header>
                                <ComboBox Style="{StaticResource EegParameterComboBoxStyle}"
                                          IsEnabled="{Binding Acquisition.LiveMonitor.IsPaperSpeedMode}"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding Acquisition.LiveMonitor.PaperSpeedMillimetersPerSecond, Mode=TwoWay}">
                                    <ComboBoxItem Content="5 mm/s" Tag="5" />
                                    <ComboBoxItem Content="10 mm/s" Tag="10" />
                                    <ComboBoxItem Content="15 mm/s" Tag="15" />
                                    <ComboBoxItem Content="30 mm/s" Tag="30" />
                                    <ComboBoxItem Content="60 mm/s" Tag="60" />
                                </ComboBox>
                            </controls:EegParameterField>

                            <!-- 时间基 -->
                            <controls:EegParameterField MinWidth="86">
                                <controls:EegParameterField.Header>
                                    <RadioButton Content="时间基" GroupName="LiveHorizontalScale"
                                                 IsChecked="{Binding Acquisition.LiveMonitor.IsTimebaseMode, Mode=TwoWay}"
                                                 Style="{StaticResource EegParameterFieldRadioHeaderStyle}"
                                                 ToolTip="秒/屏输入，直接控制当前显示窗口的 EEG 时间范围。" />
                                </controls:EegParameterField.Header>
                                <ComboBox Style="{StaticResource EegParameterComboBoxStyle}"
                                          IsEnabled="{Binding Acquisition.LiveMonitor.IsTimebaseMode}"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding Acquisition.LiveMonitor.TimebaseSecondsPerScreen, Mode=TwoWay}">
                                    <ComboBoxItem Content="5 s/屏" Tag="5" />
                                    <ComboBoxItem Content="10 s/屏" Tag="10" />
                                    <ComboBoxItem Content="15 s/屏" Tag="15" />
                                    <ComboBoxItem Content="20 s/屏" Tag="20" />
                                    <ComboBoxItem Content="30 s/屏" Tag="30" />
                                </ComboBox>
                            </controls:EegParameterField>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </views:EegWorkspaceShell.TopBar>

        <views:EegWorkspaceShell.Waveform>
            <waveform:LiveSciChartCanvas />
        </views:EegWorkspaceShell.Waveform>

        <views:EegWorkspaceShell.Overlay>
            <Popup IsOpen="{Binding Acquisition.LiveMonitor.IsSettingsOpen, Mode=TwoWay}" Placement="Center" StaysOpen="True" AllowsTransparency="True">
                <Border Width="500" MaxHeight="640" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="26,20,26,22">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.14" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="数据与采集信息" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ModernCloseCrossButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTip="关闭"
                                    Command="{Binding Acquisition.LiveMonitor.ToggleSettingsCommand}" />
                        </Grid>

                        <!-- Tabs Container -->
                        <TabControl Grid.Row="1" Style="{StaticResource ModernDialogTabControlStyle}">
                            <TabItem Header="数据信息">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,16,0,0">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="AcqInfoLabelCol" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 所属项目 -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="所属项目" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Acquisition.ProjectNameText}" Foreground="#0F172A" FontWeight="Medium" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                        <!-- 项目编号 -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="项目编号" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Acquisition.ProjectNumberText}" Foreground="#0F172A" FontSize="13" VerticalAlignment="Center" />

                                        <!-- 采样率 -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="采样率" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Acquisition.SelectedSamplingRateHz, StringFormat={}{0} Hz}" Foreground="#0F172A" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />

                                        <!-- 当前导联 -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="当前导联" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Acquisition.LiveMonitor.CurrentMontageName, TargetNullValue=未选择}" Foreground="#0F172A" FontWeight="Medium" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                        <!-- 导联通道数 -->
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="导联通道数" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="8" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Acquisition.LiveMonitor.MontageOutputChannelCount}" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text=" 个输出通道；当前显示 " Foreground="#64748B" FontSize="13" />
                                            <TextBlock Text="{Binding Acquisition.LiveMonitor.SelectedMontageDisplayChannelCount}" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text=" 个" Foreground="#64748B" FontSize="13" />
                                        </StackPanel>

                                        <!-- 采集设备 -->
                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="设备状态" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="10" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Acquisition.DeviceModelText, TargetNullValue=未知设备}" Foreground="#0F172A" FontWeight="Medium" FontSize="13" />
                                            <TextBlock Text="（" Foreground="#64748B" FontSize="13" />
                                            <TextBlock Text="{Binding Acquisition.DeviceConnectionStatusText}" Foreground="#10B981" FontWeight="Medium" FontSize="13" />
                                            <TextBlock Text="）" Foreground="#64748B" FontSize="13" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </TabItem>
                            <TabItem Header="通道设置">
                                <Grid Margin="0,16,0,0" Grid.IsSharedSizeScope="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 当前导联配置 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabelCol" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="当前导联" VerticalAlignment="Center" Foreground="#334155" FontSize="13.5" TextWrapping="NoWrap" />
                                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="36" Padding="12,0">
                                            <TextBlock Text="{Binding Acquisition.LiveMonitor.CurrentMontageName}"
                                                       VerticalAlignment="Center" Foreground="#1E293B" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabelCol" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="导联通道数" VerticalAlignment="Center" Foreground="#334155" FontSize="13.5" TextWrapping="NoWrap" />
                                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="36" Padding="12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Acquisition.LiveMonitor.MontageOutputChannelCount}" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text=" 个输出通道；当前显示 " Foreground="#64748B" FontSize="13" />
                                                <TextBlock Text="{Binding Acquisition.LiveMonitor.SelectedMontageDisplayChannelCount}" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text=" 个" Foreground="#64748B" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 通道可见性勾选 -->
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabelCol" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="选择通道" VerticalAlignment="Top" Margin="0,6,0,0" Foreground="#334155" FontSize="13.5" TextWrapping="NoWrap" />
                                        <ScrollViewer Grid.Column="2" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Acquisition.LiveMonitor.MontageChannels}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource ModernCheckBoxStyle}"
                                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                  Content="{Binding Name}"
                                                                  Margin="0,7,8,7" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <TextBlock Grid.Row="3" Margin="0,8,0,0"
                                               Text="通道顺序与重参考方式由所选导联配置决定；此处仅控制实时波形是否显示该导联。"
                                               Foreground="#64748B" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </TabItem>

                            <TabItem Header="放大器">
                                <Grid Margin="0,16,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Acquisition.DeviceState.IsAvailable}" Value="True">
                                                            <Setter Property="Fill" Value="#10B981" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Acquisition.DeviceState.StatusText}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <TextBlock Text="{Binding Acquisition.DeviceState.Detail}" Foreground="#64748B" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="放大器" VerticalAlignment="Center" Foreground="#475569" FontSize="13" />
                                        <ComboBox Grid.Column="1" Height="36" Style="{StaticResource AppFilterComboBoxStyle}"
                                                  ItemsSource="{Binding Acquisition.Devices}" SelectedItem="{Binding Acquisition.SelectedDevice}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="检测" Margin="8,0,0,0"
                                                Style="{StaticResource ModernDialogSecondaryButtonStyle}"
                                                Command="{Binding Acquisition.TestConnectionCommand}" />
                                        <Button Grid.Column="3" Content="更换 SDK" Margin="8,0,0,0"
                                                Style="{StaticResource ModernDialogSecondaryButtonStyle}"
                                                Command="{Binding Acquisition.BrowseSdkLibraryCommand}" />
                                    </Grid>
                                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                                        <TextBlock Text="采样率" Foreground="#64748B" FontSize="13" Margin="0,0,0,6" />
                                        <ComboBox Width="160" Height="36" HorizontalAlignment="Left" Style="{StaticResource AppFilterComboBoxStyle}"
                                                  ItemsSource="{Binding Acquisition.SamplingRatesHz}" SelectedItem="{Binding Acquisition.SelectedSamplingRateHz}" ToolTip="采样率 (Hz)" />
                                        <TextBlock Text="{Binding Acquisition.OperationMessage}" Foreground="#64748B" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Popup>
        </views:EegWorkspaceShell.Overlay>
    </views:EegWorkspaceShell>
    </Grid>
</UserControl>
