<UserControl x:Class="BrainPlatform.Desktop.Modules.Acquisition.Views.LiveRbpAnalysisPanel"
             x:Name="RbpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:topomap="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Topomap"
             xmlns:rbp="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Rbp">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/AnalysisStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Margin="4,2,4,4" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,4">
                <TextBlock Text="RBP 图表" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"
                           VerticalAlignment="Center" />
                <ComboBox Width="150" Height="32" Margin="10,0,0,0"
                          ItemsSource="{Binding ChartOptions}"
                          SelectedItem="{Binding SelectedChart, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource AppFilterComboBoxStyle}" />
            </StackPanel>
            <Border Grid.Row="1" Background="#F8FAFC">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTopomapSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,4">
                        <ComboBox Width="120" Height="32" Margin="0,0,8,0"
                                  ItemsSource="{Binding TopomapPowerTypeOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedTopomapPowerType, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource AppFilterComboBoxStyle}" />
                        <ComboBox Width="120" Height="32"
                                  ItemsSource="{Binding TopomapBandOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedTopomapBandId, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource AppFilterComboBoxStyle}" />
                    </StackPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopomapBands}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllTopomapBandsSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,2">
                                    <topomap:TopomapCanvas Field="{Binding Field}"
                                        ColorScaleState="{Binding DataContext.TopomapColorScales, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <TextBlock Text="{Binding DataContext.TopomapWindowText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                               Padding="5,2" Background="#E6FFFFFF" Foreground="#475569" FontSize="10"
                                               IsHitTestVisible="False" Panel.ZIndex="2" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllTopomapBandsSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Grid Width="640" Height="640">
                            <topomap:TopomapCanvas Field="{Binding SelectedTopomapField}"
                                                   ColorScaleState="{Binding TopomapColorScales}" />
                            <TextBlock Text="{Binding TopomapWindowText}"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                       Padding="5,2" Background="#E6FFFFFF" Foreground="#475569" FontSize="10"
                                       IsHitTestVisible="False" Panel.ZIndex="2" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTopomapSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ListBox ItemsSource="{Binding ChannelHistories}"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Channel}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" />
                                <Grid Height="120">
                                    <rbp:RbpChart IsStackedHistory="True" ShowAxisTitles="False"
                                                  Bands="{Binding Bands}" Windows="{Binding Windows}" />
                                    <TextBlock Text="{Binding DataContext.WindowText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                               Padding="5,2" Background="#E6FFFFFF" Foreground="#475569" FontSize="10"
                                               IsHitTestVisible="False" Panel.ZIndex="2" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Border>
</UserControl>
