<Window x:Class="BrainPlatform.Desktop.Modules.Acquisition.Views.AcquisitionImpedanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BrainPlatform.Desktop.Modules.Acquisition.Views"
        xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls"
        Title="阻抗检测" Width="1120" Height="900" MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F3F5F8"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" Closing="OnClosing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24" Background="#F3F5F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="阻抗检测" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A"/>
            <TextBlock Text="{Binding DeviceText}" Foreground="#64748B" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding StatusText}" Foreground="#2563EB" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="物理电极 · 接触阻抗" FontWeight="SemiBold" Foreground="#334155"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <views:ImpedanceScalpMap MinWidth="480" MinHeight="480" Rows="{Binding Rows}"
                                                SelectedRow="{Binding SelectedRow, Mode=TwoWay}"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <views:ImpedanceScaleLegend x:Name="ColorLegend" Height="62" Scale="{Binding ColorScale}"
                                                    AutomationProperties.Name="{Binding LegendText}"/>
                        <TextBlock Text="圈内为电极名称，圈上为阻抗值 / kΩ；无坐标项见列表。"
                                   Foreground="#64748B" TextWrapping="Wrap" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="电极读数 / kΩ · 阻抗降序" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                             AutomationProperties.Name="物理电极阻抗读数">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="0,6" ToolTip="{Binding AccessibleText}" AutomationProperties.Name="{Binding AccessibleText}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding NativeIdentityText}" FontSize="10" Foreground="#64748B"/></StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="{Binding HardwareStatusText}" TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SelectedRow.AccessibleText}" TextWrapping="Wrap" Foreground="#475569" FontSize="12"/>
                        <TextBlock Text="{Binding LastReceivedText}" Foreground="#64748B" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Expander Grid.Row="3" Header="渐变色标 · 范围与颜色" IsExpanded="True"
                              Foreground="#334155" Margin="0,16,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                                <TextBlock Text="最低" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2,4,2"
                                         VerticalContentAlignment="Center" AutomationProperties.Name="色标最低值，千欧"/>
                                <TextBlock Grid.Column="2" Text="kΩ" VerticalAlignment="Center"/>
                                <shared:ColorPicker Grid.Column="3" IsCompact="True" SelectedColor="{Binding LowColor, Mode=TwoWay}"
                                                    ToolTip="最低阻抗颜色" AutomationProperties.Name="最低阻抗颜色"/>
                                <TextBlock Grid.Row="1" Text="中间" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MiddleText, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2,4,2"
                                         VerticalContentAlignment="Center" AutomationProperties.Name="色标中间值，千欧"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="kΩ" VerticalAlignment="Center"/>
                                <shared:ColorPicker Grid.Row="1" Grid.Column="3" IsCompact="True" SelectedColor="{Binding MiddleColor, Mode=TwoWay}"
                                                    ToolTip="中间阻抗颜色" AutomationProperties.Name="中间阻抗颜色"/>
                                <TextBlock Grid.Row="2" Text="最高" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaximumText, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2,4,2"
                                         VerticalContentAlignment="Center" AutomationProperties.Name="色标最高值，千欧"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="kΩ" VerticalAlignment="Center"/>
                                <shared:ColorPicker Grid.Row="2" Grid.Column="3" IsCompact="True" SelectedColor="{Binding HighColor, Mode=TwoWay}"
                                                    ToolTip="最高阻抗颜色" AutomationProperties.Name="最高阻抗颜色"/>
                            </Grid>
                            <TextBlock Text="{Binding LegendText}" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="结束检测" Click="OnStopClick" Style="{StaticResource ModernDialogSecondaryButtonStyle}"/>
            <Button Content="结束检测并预览" Click="OnPreviewClick" Style="{StaticResource ModernDialogPrimaryButtonStyle}" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
