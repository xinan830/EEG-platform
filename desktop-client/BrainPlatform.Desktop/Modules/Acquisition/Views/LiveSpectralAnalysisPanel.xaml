<UserControl x:Class="BrainPlatform.Desktop.Modules.Acquisition.Views.LiveSpectralAnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Modules.Acquisition.Views"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Analysis"
             xmlns:psd="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Psd"
             xmlns:stft="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Stft"
             xmlns:topomap="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Topomap">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/AnalysisStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="ShowOption" />
        <DataTemplate x:Key="LiveRbp">
            <views:LiveRbpAnalysisPanel DataContext="{Binding Rbp}" />
        </DataTemplate>
        <DataTemplate x:Key="LivePsd">
            <Grid>
                <psd:PsdSpectrumChart MinHeight="180"
                                      Points="{Binding Psd.Points}" Unit="{Binding Psd.ValueUnit}"
                                      AutomationProperties.Name="实时功率谱密度" />
                <TextBlock Text="{Binding Window}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                           Padding="5,2" Background="#E6FFFFFF" Foreground="#475569" FontSize="10"
                           IsHitTestVisible="False" Panel.ZIndex="2" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LiveStft">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <stft:StftHeatmap Grid.Row="0" MinHeight="180" RetainHistory="True"
                                  VisibleStartSeconds="{Binding AnalysisStartSeconds}"
                                  Preview="{Binding Stft}" AutomationProperties.Name="实时时频图" />
                <Grid Grid.Row="1" Margin="2,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Window}" Foreground="#475569" FontSize="10"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap"
                               Foreground="#64748B" FontSize="11" Margin="12,0,0,0" />
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LiveMap">
            <topomap:TopomapCanvas Field="{Binding Field}" ColorScaleState="{Binding ColorScales}"
                                   AutomationProperties.Name="实时头皮地形图" />
        </DataTemplate>
        <DataTemplate x:Key="LivePsdTopomap">
            <Grid>
                <topomap:TopomapCanvas Field="{Binding Field}" ColorScaleState="{Binding ColorScales}"
                                       AutomationProperties.Name="实时脑电地形图" />
                <TextBlock Text="{Binding Window}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                           Padding="5,2" Background="#E6FFFFFF" Foreground="#475569" FontSize="10"
                           IsHitTestVisible="False" Panel.ZIndex="2" />
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <shared:AnalysisPanelShell Title="" StatusText="{Binding Status}" ToolTip="{Binding Status}"
                               CloseCommand="{Binding ToggleCommand}">
        <shared:AnalysisPanelShell.HeaderContent>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel, UpdateSourceTrigger=PropertyChanged}"
                          Height="32" MinWidth="120" VerticalAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource AppFilterComboBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveView}" Value="psd">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveView}" Value="stft">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <ComboBox ItemsSource="{Binding PsdViewOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedPsdView, UpdateSourceTrigger=PropertyChanged}"
                          Height="32" MinWidth="120"
                          Margin="8,0,0,0" VerticalAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource AppFilterComboBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveView}" Value="psd">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveView}" Value="psd-topomap">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <ComboBox ItemsSource="{Binding PsdTopomapBandOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Id" SelectedValue="{Binding Band, UpdateSourceTrigger=PropertyChanged}"
                          Height="32" MinWidth="130" Margin="8,0,0,0" VerticalAlignment="Center"
                          ToolTip="频带平均 PSD，单位 µV²/Hz">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource AppFilterComboBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveView}" Value="psd-topomap">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <TextBlock Text="{Binding ActiveLabel}" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource AnalysisHeadingBrush}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveView}" Value="rbp-topomap">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveView}" Value="rbp">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="RBP 图表" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"
                               VerticalAlignment="Center" />
                    <ComboBox Width="150" Height="32" Margin="10,0,0,0"
                              ItemsSource="{Binding Rbp.ChartOptions}"
                              SelectedItem="{Binding Rbp.SelectedChart, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource AppFilterComboBoxStyle}" />
                </StackPanel>
            </StackPanel>
        </shared:AnalysisPanelShell.HeaderContent>
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveView}" Value="psd">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActiveView}" Value="psd-topomap">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActiveView}" Value="rbp">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActiveView}" Value="stft">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <WrapPanel IsEnabled="{Binding IsInteractive}">
                    <ComboBox MinWidth="120" Height="32" Margin="0,0,8,4" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}"
                              Style="{StaticResource AppFilterComboBoxStyle}"
                              Visibility="{Binding NeedsChannel, Converter={StaticResource ShowOption}}"
                              AutomationProperties.Name="分析通道" />
                    <ComboBox MinWidth="120" Height="32" Margin="0,0,8,4" ItemsSource="{Binding Bands}" SelectedItem="{Binding Band}"
                              Style="{StaticResource AppFilterComboBoxStyle}"
                              Visibility="{Binding NeedsBand, Converter={StaticResource ShowOption}}"
                              AutomationProperties.Name="地形图频段" />
                    <ComboBox MinWidth="130" Height="32" Margin="0,0,8,4" ItemsSource="{Binding PowerOptions}" DisplayMemberPath="Label"
                              Style="{StaticResource AppFilterComboBoxStyle}"
                              SelectedValuePath="Id" SelectedValue="{Binding Power}"
                              Visibility="{Binding NeedsPower, Converter={StaticResource ShowOption}}"
                              AutomationProperties.Name="RBP 地形图指标" />
                    <Button Content="应用" Command="{Binding ApplyCommand}" Margin="0,0,0,4"
                            Height="32" Padding="16,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernDialogPrimaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveView}" Value="rbp">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </StackPanel>
            <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveView}" Value="rbp">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource LiveRbp}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActiveView}" Value="psd">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource LivePsd}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActiveView}" Value="stft">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource LiveStft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActiveView}" Value="rbp-topomap">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource LiveMap}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActiveView}" Value="psd-topomap">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource LivePsdTopomap}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DockPanel>
    </shared:AnalysisPanelShell>
</UserControl>
