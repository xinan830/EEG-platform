<UserControl x:Class="BrainPlatform.Desktop.Modules.Acquisition.Views.AcquisitionStatusBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border CornerRadius="9" Height="38" Padding="16,0" VerticalAlignment="Center" BorderThickness="1.5">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#F8FAFC" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPreviewing}" Value="True">
                        <Setter Property="Background" Value="#EFF6FF" />
                        <Setter Property="BorderBrush" Value="#3B82F6" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsRecording}" Value="True">
                        <Setter Property="Background" Value="#FEF2F2" />
                        <Setter Property="BorderBrush" Value="#EF4444" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPaused}" Value="True">
                        <Setter Property="Background" Value="#EFF6FF" />
                        <Setter Property="BorderBrush" Value="#60A5FA" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 状态指示灯 -->
            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#94A3B8" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPreviewing}" Value="True">
                                <Setter Property="Fill" Value="#2563EB" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsRecording}" Value="True">
                                <Setter Property="Fill" Value="#DC2626" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPaused}" Value="True">
                                <Setter Property="Fill" Value="#3B82F6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!-- 强区分状态标签 -->
            <TextBlock FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="就绪" />
                        <Setter Property="Foreground" Value="#64748B" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPreviewing}" Value="True">
                                <Setter Property="Text" Value="仅预览 · 未存盘" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsRecording}" Value="True">
                                <Setter Property="Text" Value="录制中" />
                                <Setter Property="Foreground" Value="#DC2626" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Acquisition.LiveMonitor.IsPaused}" Value="True">
                                <Setter Property="Text" Value="录制已暂停" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 录制 / 暂停常驻指标：已录制时长 · 实时文件大小 · 剩余磁盘空间 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding Acquisition.StorageStatus.HasActiveRecordingMetrics, Converter={StaticResource BoolToVis}}">
                <Border Width="1" Height="16" Background="#FCA5A5" Margin="12,0" VerticalAlignment="Center" />

                <TextBlock Text="{Binding Acquisition.LiveMonitor.RecordingElapsedText}"
                           FontFamily="Consolas, monospace" FontWeight="Bold"
                           FontSize="14.5" Foreground="#991B1B" VerticalAlignment="Center"
                           ToolTip="当前已录制时长" />

                <Border Width="1" Height="16" Background="#E2E8F0" Margin="12,0" VerticalAlignment="Center" />

                <TextBlock Text="{Binding Acquisition.StorageStatus.RecordedFileSizeText}"
                           FontFamily="Consolas, monospace" FontWeight="SemiBold"
                           FontSize="13" Foreground="#334155" VerticalAlignment="Center"
                           ToolTip="当前原始录制目录实时文件大小" />

                <Border Width="1" Height="16" Background="#E2E8F0" Margin="12,0" VerticalAlignment="Center" />

                <TextBlock Text="{Binding Acquisition.StorageStatus.AvailableDiskSpaceText}"
                           FontFamily="Consolas, monospace" FontSize="13" VerticalAlignment="Center"
                           ToolTip="录制目标磁盘当前剩余可用空间">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#475569" />
                            <Setter Property="FontWeight" Value="Medium" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Acquisition.StorageStatus.IsLowDiskSpace}" Value="True">
                                    <Setter Property="Foreground" Value="#DC2626" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
