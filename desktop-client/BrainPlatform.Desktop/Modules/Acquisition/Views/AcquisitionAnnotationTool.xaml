<UserControl x:Class="BrainPlatform.Desktop.Modules.Acquisition.Views.AcquisitionAnnotationTool"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BrainPlatform.Desktop.Shared.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/InstrumentWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <controls:EegToolButton x:Name="AnnotationButton" Content="事件标注" Glyph="&#xE70F;"
                                Click="OnOpenClick"
                                ToolTip="打开事件标注面板（支持单个事件与持续事件）"
                                AutomationProperties.Name="事件标注">
            <controls:EegToolButton.Style>
                <Style TargetType="{x:Type controls:EegToolButton}" BasedOn="{StaticResource {x:Type controls:EegToolButton}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen, ElementName=Root}" Value="True">
                            <Setter Property="Background" Value="{StaticResource BlueBrandSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BlueBrandPrimaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:EegToolButton.Style>
        </controls:EegToolButton>
    </Grid>
</UserControl>
