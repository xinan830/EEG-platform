<UserControl x:Class="BrainPlatform.Desktop.Modules.Acquisition.Views.LivePsdAnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Analysis"
             xmlns:psd="clr-namespace:BrainPlatform.Desktop.Modules.Algorithms.Views.Psd"
             xmlns:topomap="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Topomap">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/AnalysisStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <shared:AnalysisPanelShell Title="{Binding CardHeaderTitle, FallbackValue=''}" CloseCommand="{Binding CloseAnalysisCommand}"
                               DockCommand="{Binding DockCommand, FallbackValue={x:Null}}"
                               DockToolTip="{Binding DockToolTip, FallbackValue=停靠 / 分离}"
                               MaximizeCommand="{Binding MaximizeCommand, FallbackValue={x:Null}}"
                               MaximizeToolTip="{Binding MaximizeToolTip, FallbackValue=放大 / 还原}"
                               IsMaximizeVisible="{Binding CanMaximize, FallbackValue=False}"
                               IsMaximized="{Binding IsMaximized, FallbackValue=False}"
                               StatusText="{Binding PsdAnalysis.StatusText}">
        <shared:AnalysisPanelShell.HeaderContent>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Channels}"
                          SelectedItem="{Binding SelectedChannel, UpdateSourceTrigger=PropertyChanged}"
                          MinWidth="82" VerticalAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource AnalysisHeaderComboBoxStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PsdAnalysis.IsTopomapSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <ComboBox ItemsSource="{Binding PsdAnalysis.ViewOptions}"
                          SelectedItem="{Binding PsdAnalysis.SelectedView, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource AnalysisHeaderComboBoxStyle}" MinWidth="86"
                          Margin="5,0,0,0" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding PsdAnalysis.TopomapBandOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Id"
                          SelectedValue="{Binding PsdAnalysis.SelectedTopomapBandId, UpdateSourceTrigger=PropertyChanged}"
                          MinWidth="88" ToolTip="频带平均 PSD，单位 µV²/Hz"
                          Margin="5,0,0,0" VerticalAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource AnalysisHeaderComboBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PsdAnalysis.IsTopomapSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </StackPanel>
        </shared:AnalysisPanelShell.HeaderContent>
        <Grid>
            <psd:PsdSpectrumChart MinHeight="180" Points="{Binding PsdAnalysis.Points}"
                                  Unit="{Binding PsdAnalysis.ValueUnit}"
                                  AutomationProperties.Name="实时功率谱密度">
                <psd:PsdSpectrumChart.Style>
                    <Style TargetType="psd:PsdSpectrumChart">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PsdAnalysis.IsTopomapSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </psd:PsdSpectrumChart.Style>
            </psd:PsdSpectrumChart>
            <ItemsControl ItemsSource="{Binding PsdAnalysis.TopomapBands}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PsdAnalysis.IsTopomapSelected}" Value="True" />
                                    <Condition Binding="{Binding PsdAnalysis.IsAllTopomapBandsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <topomap:TopomapCanvas Field="{Binding Field}"
                            ColorScaleState="{Binding DataContext.PsdAnalysis.TopomapColorScales, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <topomap:TopomapSwitchableView Field="{Binding PsdAnalysis.SelectedTopomapField}"
                                           ColorScaleState="{Binding PsdAnalysis.TopomapColorScales}"
                                           WindowText="{Binding PsdAnalysis.CurrentRangeText}"
                                           AutomationProperties.Name="实时脑电地形图">
                <topomap:TopomapSwitchableView.Style>
                    <Style TargetType="topomap:TopomapSwitchableView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PsdAnalysis.IsTopomapSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PsdAnalysis.IsAllTopomapBandsSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </topomap:TopomapSwitchableView.Style>
            </topomap:TopomapSwitchableView>
            <TextBlock Text="{Binding PsdAnalysis.CurrentRangeText}"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                       Padding="5,2" Background="#E6FFFFFF" Foreground="#475569" FontSize="10"
                       IsHitTestVisible="False" Panel.ZIndex="2">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PsdAnalysis.CurrentRangeText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </shared:AnalysisPanelShell>
</UserControl>
