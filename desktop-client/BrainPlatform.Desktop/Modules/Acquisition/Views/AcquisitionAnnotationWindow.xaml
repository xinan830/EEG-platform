<Window x:Class="BrainPlatform.Desktop.Modules.Acquisition.Views.AcquisitionAnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:eventsViews="clr-namespace:BrainPlatform.Desktop.Modules.Events.Views"
        Title="事件标注" Width="408" Height="510" MinWidth="372" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Background="#F2F8FF" FontSize="13" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="5" CornerRadius="12"
                            GlassFrameThickness="1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/InstrumentWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#D6E4F5" BorderThickness="1" Background="#F2F8FF" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Crisp White Title Bar -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E6EEF8" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0" Padding="16,0,10,0">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ModernCloseCrossButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick"
                            ToolTip="关闭事件标注" AutomationProperties.Name="关闭事件标注" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0">
                            <Path Data="M 3,1 L 3,15 M 3,2 L 12,2 L 10,6 L 12,10 L 3,10"
                                  Stroke="{StaticResource BlueBrandPrimaryBrush}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Width="13" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="事件标注" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Preview-mode hint when recording has not started yet -->
            <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" Padding="16,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanPause}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="当前处于预览状态，点击“开始记录”后即可点击下方图标标注事件。"
                           FontSize="12" Foreground="#1D4ED8" TextWrapping="Wrap" />
            </Border>

            <!-- Airy Ice-Blue Icon Grid Surface -->
            <Grid Grid.Row="2" Margin="16,14,16,14">
                <eventsViews:EventAnnotationGridControl x:Name="EventGrid"
                                                        Tiles="{Binding EventGridTiles}"
                                                        HasActiveInterval="{Binding HasActiveInterval}"
                                                        ActiveIntervalStatusText="{Binding ActiveIntervalStatusText}"
                                                        TileActivated="OnEventTileActivated"
                                                        ActiveIntervalCancelled="OnActiveIntervalCancelled" />
            </Grid>

            <!-- Clean Footer -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E6EEF8" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="16,0">
                <TextBlock Text="单击图标立即标记 · 持续事件点一次标起点线，再点一次结束"
                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
