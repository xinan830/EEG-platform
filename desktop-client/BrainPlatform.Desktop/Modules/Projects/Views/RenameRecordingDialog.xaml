<Window x:Class="BrainPlatform.Desktop.Modules.Projects.Views.RenameRecordingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:subjects="clr-namespace:BrainPlatform.Desktop.Modules.Projects.Views"
        Title="编辑记录信息"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/BrandColors.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DialogInputShellStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="12,0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#94A3B8" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BlueBrandPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Width="440" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
            Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.16" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="24,20,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel MouseLeftButtonDown="OnHeaderMouseLeftButtonDown" Background="Transparent">
                    <TextBlock Text="编辑记录信息" FontSize="17" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="编辑记录名称与可选受试者信息。" Margin="0,4,0,0"
                               FontSize="12.5" Foreground="#64748B" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ModernCloseCrossButtonStyle}"
                        IsCancel="True" VerticalAlignment="Top" ToolTip="关闭" />
            </Grid>

            <!-- 输入主体 -->
            <StackPanel Grid.Row="1" Margin="24,18,24,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="记录名称" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" />
                    <TextBlock Text=" *" FontSize="13" FontWeight="Bold" Foreground="#EF4444" Margin="2,0,0,0" />
                </StackPanel>
                <Border Style="{StaticResource DialogInputShellStyle}">
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="NameBox" BorderThickness="0" Background="Transparent"
                                 FontSize="13.5" Foreground="#0F172A" VerticalAlignment="Center"
                                 MaxLength="120" TextChanged="OnNameTextChanged" />
                        <TextBlock Text="请输入记录名称" FontSize="13.5" Foreground="#94A3B8"
                                   IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <subjects:SubjectSelector x:Name="SubjectPicker" Margin="0,18,0,0" />
                <TextBlock x:Name="ValidationText" Visibility="Collapsed" Margin="0,8,0,0"
                           FontSize="12" Foreground="#DC2626" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 分割线 -->
            <Border Grid.Row="2" Height="1" Background="#F1F5F9" />

            <!-- 底部操作栏 -->
            <Border Grid.Row="3" Padding="24,14,24,16" Background="#FFFFFF" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Width="88" Height="36" Padding="0" Margin="0,0,10,0"
                            IsCancel="True" Style="{StaticResource ModernDialogSecondaryButtonStyle}" />
                    <Button x:Name="SaveButton" Content="保存" Width="96" Height="36" Padding="0"
                            IsDefault="True" Click="OnSaveClick"
                            Style="{StaticResource ModernDialogPrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
