<UserControl x:Class="BrainPlatform.Desktop.Modules.Projects.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Views"
             xmlns:behaviors="clr-namespace:BrainPlatform.Desktop.Shared.Behaviors"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls"
             mc:Ignorable="d"
             behaviors:SlimScrollBarBehavior.IsEnabled="True"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 主操作按钮样式 (新建项目) -->
            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppPrimaryButtonStyle}">
                <Setter Property="Background" Value="#1677FF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#0958D9" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#003EB3" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

           <!-- 现代化筛选下拉框样式 -->
           <!-- 行内操作图标按钮 -->
            <Style x:Key="RowActionIconBtn" TargetType="Button" BasedOn="{StaticResource AppRowActionIconButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 列表表头文字样式 -->
            <Style x:Key="TableHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#475569" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 项目列表行样式 -->
            <Style x:Key="ProjectRowStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="#F1F5F9" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#F8FAFC" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#F0F7FF" /></Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="IsSelected" Value="True" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题栏与新建项目按钮 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="项目列表" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="管理 EEG 采集项目及项目下的数据记录。" Margin="0,5,0,0" FontSize="13" Foreground="#64748B" />
            </StackPanel>

            <!-- 新建项目按钮 -->
            <Button Grid.Column="1" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnCreateProjectClick" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="+" FontSize="15" FontWeight="Bold" Margin="0,-1,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="新建项目" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. 搜索与筛选工具栏 -->
        <Grid Grid.Row="1" Margin="0,18,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 搜索框 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 放大镜图标 -->
                    <Path Data="M 14,14 L 19,19 M 6.5,12 A 5.5,5.5 0 1 1 12,6.5 A 5.5,5.5 0 0 1 6.5,12 Z"
                          Width="14" Height="14" Stretch="Uniform" Stroke="#94A3B8" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource AppSearchBoxStyle}"
                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" Foreground="#0F172A"
                             Text="{Binding Projects.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- 占位提示文字 -->
                    <TextBlock Grid.Column="1" Text="搜索项目名称、项目说明" FontSize="13" Foreground="#94A3B8"
                               IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 项目状态筛选 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="项目状态" FontSize="13" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Style="{StaticResource AppFilterComboBoxStyle}" Width="130"
                          ItemsSource="{Binding Projects.ProjectStatusFilterOptions}"
                          SelectedItem="{Binding Projects.ProjectStatusFilter, Mode=TwoWay}" />
            </StackPanel>

            <!-- 创建时间使用预设范围筛选，避免手输日期。 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="创建时间" FontSize="13" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Style="{StaticResource AppFilterComboBoxStyle}" Width="130"
                          ItemsSource="{Binding Projects.CreatedTimeFilterOptions}"
                          SelectedItem="{Binding Projects.CreatedTimeFilter, Mode=TwoWay}" />
            </StackPanel>

        </Grid>

        <!-- 3. 数据表格容器 (响应式全宽拉伸自适应，表头与每一行使用完全一致的自适应列定义) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="TableScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
                <Grid MinWidth="{Binding ViewportWidth, ElementName=TableScrollViewer}" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True"
                      UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 表头 (浅蓝底色 #F4F8FD，与每一行使用完全一致的列定义) -->
                    <Border Grid.Row="0" Background="#F4F8FD" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" CornerRadius="8,8,0,0">
                        <Grid Margin="16,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="项目名称" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="10,0,6,0" />
                            <TextBlock Grid.Column="1" Text="项目说明" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="8,0" />
                            <TextBlock Grid.Column="2" Text="数据记录数" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="创建时间" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="当前状态" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 表格内容 (与表头完全一致的自适应列定义) -->
                    <ListBox Grid.Row="1" BorderThickness="0" Background="#FFFFFF"
                             ItemContainerStyle="{StaticResource ProjectRowStyle}"
                             ItemsSource="{Binding Projects.PagedProjects}"
                             SelectedItem="{Binding Projects.SelectedProject, Mode=TwoWay}"
                             MouseDoubleClick="OnOpenProjectDetailClick"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="52" Margin="16,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 0. 项目名称 (选中项加粗变蓝) -->
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="10,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="#0F172A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="#1677FF" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 1. 项目说明 (文本省略 + 完整气泡) -->
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12.5" Foreground="#475569" ToolTip="{Binding Description}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="8,0" />

                                    <!-- 2. 数据记录数 (居中) -->
                                    <TextBlock Grid.Column="2" Text="{Binding RecordingCount}" FontSize="12.5" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- 3. 创建时间 (居中) -->
                                    <TextBlock Grid.Column="3" Text="{Binding CreatedAtText}" FontSize="12.5" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- 4. 当前状态 (居中状态标签) -->
                                    <Border Grid.Column="4" CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NormalizedStatus}" Value="已完成">
                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NormalizedStatus}" Value="暂停">
                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding NormalizedStatus}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NormalizedStatus}" Value="已完成">
                                                            <Setter Property="Foreground" Value="#2563EB" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NormalizedStatus}" Value="暂停">
                                                            <Setter Property="Foreground" Value="#D97706" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- 5. 操作按钮组 (居中: 查看、编辑、删除、开始采集) -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- 1. 查看详情按钮 -->
                                        <Button Style="{StaticResource RowActionIconBtn}" ToolTip="查看项目详情" Click="OnOpenProjectDetailClick">
                                            <Path Data="M 1,9 C 1,9 4.5,3 10,3 C 15.5,3 19,9 19,9 C 19,9 15.5,15 10,15 C 4.5,15 1,9 1,9 Z M 10,12 A 3,3 0 1 0 10,6 A 3,3 0 0 0 10,12 Z"
                                                  Width="15" Height="13" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.5" />
                                        </Button>

                                        <!-- 2. 编辑项目按钮 -->
                                        <Button Style="{StaticResource RowActionIconBtn}" ToolTip="编辑项目" Click="OnEditProjectClick">
                                            <Path Data="M 11,2 L 14,5 M 2,14 L 1,17 L 4,16 L 14.5,5.5 A 2.12,2.12 0 0 0 11.5,2.5 L 2,14 Z"
                                                  Width="14" Height="14" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>

                                        <!-- 3. 删除项目按钮 -->
                                        <Button Style="{StaticResource RowActionIconBtn}" ToolTip="移除项目" Click="OnDeleteProjectClick">
                                            <Path Data="M 2,5 H 16 M 6,5 V 3 A 1,1 0 0 1 7,2 H 11 A 1,1 0 0 1 12,3 V 5 M 14,5 V 15 A 2,2 0 0 1 12,17 H 6 A 2,2 0 0 1 4,15 V 5 M 7,9 V 13 M 11,9 V 13"
                                                  Width="14" Height="14" Stretch="Uniform" Stroke="#EF4444" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>

                                        <!-- 4. 开始采集按钮 -->
                                        <Button Style="{StaticResource RowActionIconBtn}" ToolTip="开始采集" Click="OnStartAcquisitionClick">
                                            <Path Data="M 4,2 L 16,9 L 4,16 Z"
                                                  Width="13" Height="13" Stretch="Uniform" Stroke="#1677FF" Fill="Transparent" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空状态提示 -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Projects.FilteredProjects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="尚无匹配项目" FontSize="15" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" />
                        <TextBlock Text="可尝试更换搜索关键词，或点击右上角新建项目" Margin="0,5,0,0" FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 4. 底部翻页与统计栏 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧总条数 -->
            <TextBlock Text="{Binding Projects.FilteredProjects.Count, FallbackValue=0, StringFormat=共 {0} 个项目}"
                       FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />

            <!-- 右侧翻页器 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 条数选择框 -->
                <ComboBox Margin="0,0,12,0" Style="{StaticResource PaginationPageSizeComboBoxStyle}"
                          ItemsSource="{Binding Projects.ProjectPageSizeOptions}"
                          SelectedItem="{Binding Projects.ProjectPageSize, Mode=TwoWay}"
                          ItemStringFormat="{}{0} 条/页" />
                <shared:PaginationControl CurrentPage="{Binding Projects.ProjectCurrentPage}"
                                         TotalPages="{Binding Projects.ProjectTotalPages}"
                                         PageRequested="OnProjectPageRequested" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
