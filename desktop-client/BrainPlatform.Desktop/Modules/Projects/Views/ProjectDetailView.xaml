<UserControl x:Class="BrainPlatform.Desktop.Modules.Projects.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:BrainPlatform.Desktop.Shared.Behaviors"
             xmlns:shared="clr-namespace:BrainPlatform.Desktop.Shared.Controls"
             mc:Ignorable="d"
             behaviors:SlimScrollBarBehavior.IsEnabled="True"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 主操作按钮样式 (开始采集) -->
            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppPrimaryButtonStyle}">
                <Setter Property="Background" Value="#1677FF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#0958D9" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#003EB3" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 次要操作按钮样式 (查看/编辑) -->
            <Style x:Key="OutlineActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#F8FAFC" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 危险操作按钮样式 (删除) -->
            <Style x:Key="DangerActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FEF2F2" />
                <Setter Property="Foreground" Value="#EF4444" />
                <Setter Property="BorderBrush" Value="#FECACA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#FEE2E2" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 返回导航文字按钮样式 -->
            <Style x:Key="BackNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 12,4 L 4,12 L 12,20 M 4,12 L 20,12" Width="13" Height="13" Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#1677FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

           <!-- 现代化下拉框样式 -->
           <!-- 行内操作图标按钮 -->
            <Style x:Key="RowActionIconBtn" TargetType="Button" BasedOn="{StaticResource AppRowActionIconButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 现代化弹出菜单样式 -->
            <Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="150" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 现代化菜单项样式 -->
            <Style x:Key="ModernMenuItemStyle" TargetType="MenuItem">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="10,0" Margin="1" SnapsToDevicePixels="True">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconGroup" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="IconPresenter" ContentSource="Icon" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 现代化危险菜单项样式 (删除数据记录) -->
            <Style x:Key="ModernDangerMenuItemStyle" TargetType="MenuItem">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="#DC2626" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="10,0" Margin="1" SnapsToDevicePixels="True">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconGroup" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="IconPresenter" ContentSource="Icon" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="Medium" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FEF2F2" />
                                    <Setter Property="Foreground" Value="#B91C1C" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 现代化菜单分隔线样式 -->
            <Style x:Key="ModernMenuSeparatorStyle" TargetType="Separator">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="4,3" />
                <Setter Property="Background" Value="#F1F5F9" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Background="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 列表表头文字样式 -->
            <Style x:Key="TableHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#475569" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 记录列表行样式 -->
            <Style x:Key="RecordingRowStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="#F1F5F9" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#F8FAFC" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#F0F7FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20" MaxWidth="1600" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. 返回操作与页面标题放在同一行 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                <Button Style="{StaticResource BackNavigationIconButtonStyle}" Click="OnBackToProjectListClick"
                        Margin="0,0,14,0" ToolTip="返回项目列表">
                    <Path Data="M 14,8 L 4,8 M 8,4 L 4,8 L 8,12"
                          Stroke="#475569" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <TextBlock Text="项目详情" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 2. 项目标题与主要操作按钮栏 -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Projects.SelectedProject.Name, FallbackValue=项目名称}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <!-- 项目状态 -->
                        <Border CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#DCFCE7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Projects.SelectedProject.NormalizedStatus}" Value="已完成"><Setter Property="Background" Value="#DBEAFE" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Projects.SelectedProject.NormalizedStatus}" Value="暂停"><Setter Property="Background" Value="#FEF3C7" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Projects.SelectedProject.NormalizedStatus}" FontSize="11.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#16A34A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Projects.SelectedProject.NormalizedStatus}" Value="已完成"><Setter Property="Foreground" Value="#2563EB" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Projects.SelectedProject.NormalizedStatus}" Value="暂停"><Setter Property="Foreground" Value="#D97706" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧操作按钮组: 编辑、删除、开始采集 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineActionButtonStyle}" Click="OnEditProjectClick" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 11,2 L 14,5 M 2,14 L 1,17 L 4,16 L 14.5,5.5 A 2.12,2.12 0 0 0 11.5,2.5 L 2,14 Z"
                                  Width="13" Height="13" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="编辑" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerActionButtonStyle}" Click="OnDeleteProjectClick" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 2,5 H 16 M 6,5 V 3 A 1,1 0 0 1 7,2 H 11 A 1,1 0 0 1 12,3 V 5 M 14,5 V 15 A 2,2 0 0 1 12,17 H 6 A 2,2 0 0 1 4,15 V 5 M 7,9 V 13 M 11,9 V 13"
                                  Width="13" Height="13" Stretch="Uniform" Stroke="#EF4444" StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="删除" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryActionButtonStyle}" Click="OnStartAcquisitionClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 4,2 L 16,9 L 4,16 Z" Width="12" Height="12" Stretch="Uniform" Stroke="#FFFFFF" Fill="#FFFFFF" StrokeThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="开始采集" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 3. 项目基本信息卡片 (真实模型字段绑定) -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="22,18" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="项目基本信息" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16" />

                    <!-- 两列信息网格 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左列字段 -->
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="项目名称" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Projects.SelectedProject.Name}" FontSize="13" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="项目说明" FontSize="13" Foreground="#64748B" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Projects.SelectedProject.Description}" FontSize="13" Foreground="#334155" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="项目目录" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Projects.SelectedProject.DirectoryPath}" FontSize="13" Foreground="#334155" TextTrimming="CharacterEllipsis" ToolTip="{Binding Projects.SelectedProject.DirectoryPath}" VerticalAlignment="Center" />
                                    <!-- 文件夹图标 (预留打开目录 UI) -->
                                    <Button Click="OnOpenProjectDirectoryClick" ToolTip="打开项目目录" Background="Transparent" BorderThickness="0" Padding="0" Margin="8,0,0,0" Cursor="Hand">
                                        <Path Data="M 2,4 C 2,2.9 2.9,2 4,2 H 8 L 10,4 H 16 C 17.1,4 18,4.9 18,6 V 14 C 18,15.1 17.1,16 16,16 H 4 C 2.9,16 2,15.1 2,14 Z"
                                              Width="15" Height="13" Stretch="Uniform" Stroke="#1677FF" Fill="Transparent" StrokeThickness="1.4" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="数据记录数量" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Projects.Recordings.Count}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="创建时间" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Projects.SelectedProject.CreatedAtText}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- 右列字段 -->
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="最后修改时间" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Projects.SelectedProject.UpdatedAtText}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="当前状态" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Projects.SelectedProject.NormalizedStatus}" Value="已完成"><Setter Property="Background" Value="#DBEAFE" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Projects.SelectedProject.NormalizedStatus}" Value="暂停"><Setter Property="Background" Value="#FEF3C7" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Projects.SelectedProject.NormalizedStatus}" FontSize="11.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#16A34A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Projects.SelectedProject.NormalizedStatus}" Value="已完成"><Setter Property="Foreground" Value="#2563EB" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Projects.SelectedProject.NormalizedStatus}" Value="暂停"><Setter Property="Foreground" Value="#D97706" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="创建人" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Projects.SelectedProject.Creator}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="备注" FontSize="13" Foreground="#64748B" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" MinHeight="50">
                                    <TextBlock Text="{Binding Projects.SelectedProject.Notes, TargetNullValue=暂无备注}" FontSize="12.5" Foreground="#475569" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. 数据记录列表卡片 (响应式全宽拉伸自适应，表头与每一行使用完全一致的自适应列定义) -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Tab 栏与操作 -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧 Tabs -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="{Binding Projects.Recordings.Count, StringFormat=数据记录 ({0})}" FontSize="14" FontWeight="Bold" Foreground="#1677FF" Margin="4,0,4,6" />
                                <Border Height="2.5" Background="#1677FF" CornerRadius="1.5" />
                            </StackPanel>
                            <TextBlock Text="项目信息与备注" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,6" Cursor="Hand" />
                        </StackPanel>

                        <!-- 右侧按钮 (回溯数据) -->
                        <Button Grid.Column="1" Style="{StaticResource OutlineActionButtonStyle}" Click="OnOpenSelectedReviewClick"
                                IsEnabled="{Binding Projects.CanReviewSelectedRecording}" Height="32" Padding="12,0"
                                VerticalAlignment="Center" ToolTip="回溯当前选中的数据记录">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 1,4 A 8,8 0 0 1 15,4 L 17,2 M 17,2 V 6 H 13" Width="12" Height="12" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="回溯数据" FontSize="12.5" Foreground="#1677FF" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 表格容器 -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="RecordingsScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
                            <Grid MinWidth="{Binding ViewportWidth, ElementName=RecordingsScrollViewer}" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True"
                                  UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 表头 (浅蓝底色 #F4F8FD，与每一行使用完全一致的自适应列定义) -->
                                <Border Grid.Row="0" Background="#F4F8FD" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" CornerRadius="8,8,0,0">
                                    <Grid Margin="16,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.8*" MinWidth="150" />
                                            <ColumnDefinition Width="1.8*" MinWidth="150" />
                                            <ColumnDefinition Width="1.1*" MinWidth="90" />
                                            <ColumnDefinition Width="1.1*" MinWidth="90" />
                                            <ColumnDefinition Width="1.3*" MinWidth="110" />
                                            <ColumnDefinition Width="1.1*" MinWidth="90" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="记录名称" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="10,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="采集时间" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="时长" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="采样率" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="信号通道数" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="记录状态" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="操作" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- 表格真实数据行 (与表头完全一致的自适应列定义) -->
                                <ListBox Grid.Row="1" BorderThickness="0" Background="#FFFFFF"
                                         ItemContainerStyle="{StaticResource RecordingRowStyle}"
                                         ItemsSource="{Binding Projects.PagedRecordings}"
                                         SelectedItem="{Binding Projects.SelectedRecording, Mode=TwoWay}"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="50" Margin="16,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.8*" MinWidth="150" />
                                                    <ColumnDefinition Width="1.8*" MinWidth="150" />
                                                    <ColumnDefinition Width="1.1*" MinWidth="90" />
                                                    <ColumnDefinition Width="1.1*" MinWidth="90" />
                                                    <ColumnDefinition Width="1.3*" MinWidth="110" />
                                                    <ColumnDefinition Width="1.1*" MinWidth="90" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 0. 记录名称 -->
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="10,0,6,0" />

                                                <!-- 1. 采集时间 -->
                                                <TextBlock Grid.Column="1" Text="{Binding StartedAtText}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0" />

                                                <!-- 2. 时长 -->
                                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                <!-- 3. 采样率 -->
                                                <TextBlock Grid.Column="3" Text="{Binding SamplingRateText}" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                <!-- 4. 信号通道数 -->
                                                <TextBlock Grid.Column="4" Text="{Binding ChannelCountText}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                <!-- 5. 记录状态 (胶囊标签) -->
                                                <Border Grid.Column="5" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EFF6FF" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="已中止"><Setter Property="Background" Value="#FEF3C7" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#2563EB" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="已中止"><Setter Property="Foreground" Value="#D97706" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- 6. 操作组 (回溯波形按钮) -->
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource RowActionIconBtn}" ToolTip="查看记录回溯" Click="OnOpenReviewClick" IsEnabled="{Binding CanReview}">
                                                        <Path Data="M 1,9 C 1,9 4.5,3 10,3 C 15.5,3 19,9 19,9 C 19,9 15.5,15 10,15 C 4.5,15 1,9 1,9 Z M 10,12 A 3,3 0 1 0 10,6 A 3,3 0 0 0 10,12 Z"
                                                              Width="15" Height="13" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.5" />
                                                    </Button>
                                                    <Button Style="{StaticResource RowActionIconBtn}" ToolTip="波形回溯" Click="OnOpenReviewClick" IsEnabled="{Binding CanReview}">
                                                        <Path Data="M 1,8 L 4,8 L 6,3 L 9,13 L 12,6 L 14,10 L 16,8 L 19,8"
                                                              Width="15" Height="13" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </Button>
                                                    <Button Style="{StaticResource RowActionIconBtn}" ToolTip="更多选项" Click="OnOpenRecordingMoreMenuClick">
                                                        <Button.ContextMenu>
                                                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                                                <MenuItem Style="{StaticResource ModernMenuItemStyle}" Header="编辑记录名称" Click="OnRenameRecordingClick">
                                                                    <MenuItem.Icon>
                                                                        <Path Data="M 11,2 L 14,5 M 2,14 L 1,17 L 4,16 L 14.5,5.5 A 2.12,2.12 0 0 0 11.5,2.5 L 2,14 Z"
                                                                              Width="12" Height="12" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.5"
                                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator Style="{StaticResource ModernMenuSeparatorStyle}" />
                                                                <MenuItem Style="{StaticResource ModernDangerMenuItemStyle}" Header="删除数据记录" Click="OnDeleteRecordingClick">
                                                                    <MenuItem.Icon>
                                                                        <Path Data="M 2,5 H 16 M 6,5 V 3 A 1,1 0 0 1 7,2 H 11 A 1,1 0 0 1 12,3 V 5 M 14,5 V 15 A 2,2 0 0 1 12,17 H 6 A 2,2 0 0 1 4,15 V 5 M 7,9 V 13 M 11,9 V 13"
                                                                              Width="12" Height="12" Stretch="Uniform" Stroke="#EF4444" StrokeThickness="1.5"
                                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <TextBlock Text="•••" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 空数据状态 (严谨业务无假数据) -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Projects.Recordings.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="当前项目暂无数据记录" FontSize="15" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" />
                                    <TextBlock Text="请点击“开始采集”，完成导联与采样率设置后创建第一条记录。" Margin="0,6,0,0" FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- 底部统计与翻页器 -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Projects.Recordings.Count, FallbackValue=0, StringFormat=共 {0} 条数据记录}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox Margin="0,0,12,0" Style="{StaticResource PaginationPageSizeComboBoxStyle}" SelectedItem="{Binding Projects.RecordingPageSize, Mode=TwoWay}" ItemStringFormat="{}{0} 条/页">
                                <ComboBox.ItemsSource><Binding Path="Projects.RecordingPageSizeOptions" /></ComboBox.ItemsSource>
                            </ComboBox>
                            <shared:PaginationControl CurrentPage="{Binding Projects.RecordingCurrentPage}"
                                                     TotalPages="{Binding Projects.RecordingTotalPages}"
                                                     PageRequested="OnRecordingPageRequested" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
