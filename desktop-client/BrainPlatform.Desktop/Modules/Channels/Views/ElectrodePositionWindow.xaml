<Window x:Class="BrainPlatform.Desktop.Modules.Channels.Views.ElectrodePositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BrainPlatform.Desktop.Modules.Channels.Views"
        Title="电极位置图" Width="860" Height="700" MinWidth="720" MinHeight="600"
        WindowStyle="ToolWindow" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <TextBlock Text="电极位置图" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock Text="右侧显示已开启的 EEG 电极，以及独立的 REF/GND 硬件位置标记。选中 EEG 通道可拖动其图示位置；也可直接拖动 REF 或 GND 标记单独调整。" FontSize="12" Foreground="#475569" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,14,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="选择通道" FontWeight="SemiBold" Foreground="#334155" Margin="2,0,0,8" />
                <ListBox x:Name="ElectrodeRows" ItemsSource="{Binding ChannelConfigurations.DraftRows}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ElectrodeLabel, TargetNullValue=(空名称)}"
                                               FontSize="13" Foreground="#0F172A" />
                                    <TextBlock Text="{Binding LocationText}" FontSize="10"
                                               Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ConfigurationStatus}"
                                           FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#16A34A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Foreground" Value="#64748B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="7,6" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEegInput}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                <views:ElectrodePositionMap Rows="{Binding ChannelConfigurations.DraftRows}"
                                            ReferencePosition="{Binding ChannelConfigurations.DraftHardwareLandmarks.ReferencePosition, Mode=TwoWay}"
                                            GroundPosition="{Binding ChannelConfigurations.DraftHardwareLandmarks.GroundPosition, Mode=TwoWay}"
                                            SelectedRow="{Binding SelectedItem, ElementName=ElectrodeRows}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
            <Button Grid.Row="1" Content="恢复全部默认模板位置" Click="ResetAllPositions_Click"
                    HorizontalAlignment="Right" Margin="0,10,0,0" Padding="14,6">
            </Button>
        </Grid>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="蓝色：标准模板位置 · 橙色：手动 EEG 示意位置 · 紫色：REF（默认位于 Pz/Cz 中间）· 绿色：GND（默认位于 Fz/Fpz 中间）。拖动标记可单独调整；恢复默认会重置通道和硬件标记位置。" FontSize="11" Foreground="#64748B" Margin="4,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
