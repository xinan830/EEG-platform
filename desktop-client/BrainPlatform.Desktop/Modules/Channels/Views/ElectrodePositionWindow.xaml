<Window x:Class="BrainPlatform.Desktop.Modules.Channels.Views.ElectrodePositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BrainPlatform.Desktop.Modules.Channels.Views"
        xmlns:topomap="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Topomap"
        Title="电极位置图" Width="860" Height="700" MinWidth="720" MinHeight="600"
        WindowStyle="ToolWindow" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
            <TextBlock Text="电极位置图" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock Text="右侧显示已开启的 EEG 电极，以及独立的 REF/GND 硬件位置标记。选中 EEG 通道可拖动其图示位置；也可直接拖动 REF 或 GND 标记单独调整。" FontSize="12" Foreground="#475569" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,14,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="选择通道" FontWeight="SemiBold" Foreground="#334155" Margin="2,0,0,8" />
                <Grid>
                    <ListBox x:Name="ElectrodeRows" ItemsSource="{Binding PositionRows}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ElectrodeLabel, TargetNullValue=(空名称)}"
                                                   FontSize="13" Foreground="#0F172A" />
                                        <TextBlock Text="{Binding LocationText}" FontSize="10"
                                                   Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ConfigurationStatus}"
                                               FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#16A34A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="7,6" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEegInput}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Text="当前配置没有可显示的 EEG 输入通道" Foreground="#64748B"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                               Margin="12" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPositionRows}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <RadioButton Content="2D" GroupName="ElectrodePositionView"
                             IsChecked="{Binding IsTwoDimensional, Mode=TwoWay}" Padding="10,5" />
                <RadioButton Content="3D" GroupName="ElectrodePositionView" Margin="6,0,0,0"
                             IsChecked="{Binding IsThreeDimensional, Mode=TwoWay}"
                             Checked="OnThreeDimensionalChecked" Padding="10,5" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTwoDimensional}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <views:ElectrodePositionMap Rows="{Binding PositionRows}"
                                                ReferencePosition="{Binding ChannelConfigurations.DraftHardwareLandmarks.ReferencePosition, Mode=TwoWay}"
                                                GroundPosition="{Binding ChannelConfigurations.DraftHardwareLandmarks.GroundPosition, Mode=TwoWay}"
                                                SelectedRow="{Binding SelectedItem, ElementName=ElectrodeRows}"
                                                IsHitTestVisible="{Binding HasEditableDraftRows}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThreeDimensional}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <topomap:Topomap3DView ScalpModel="{Binding Model}"
                                           ElectrodeLabels="{Binding EnabledElectrodeLabels}"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
            </Grid>
            <Button Grid.Row="2" Content="恢复全部默认模板位置" Click="ResetAllPositions_Click"
                    IsEnabled="{Binding HasEditableDraftRows}"
                    HorizontalAlignment="Right" Margin="0,10,0,0" Padding="14,6">
            </Button>
        </Grid>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding PositionViewHint}"
                   FontSize="11" Foreground="#64748B" Margin="4,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
