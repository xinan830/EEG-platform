<Window x:Class="BrainPlatform.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BrainPlatform.Desktop.Views"
        Title="脑科研平台 - 桌面客户端"
        Width="1440"
        Height="880"
        MinWidth="1200"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Styles/WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Global Left Navigation Sidebar -->
            <ColumnDefinition x:Name="NavigationColumn" Width="72" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border x:Name="GlobalNavigationHost" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Navigation Items -->
                <StackPanel Grid.Row="0" Margin="0,12,0,0">
                    <!-- 1. 总览 -->
                    <RadioButton x:Name="NavOverviewBtn"
                                 Style="{StaticResource GlobalNavRadioButtonStyle}"
                                 IsChecked="True"
                                 ToolTip="总览"
                                 Click="OnNavigationClick">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Home Icon -->
                            <Path Data="M 3,11 L 11,3 L 19,11 M 5,9 V 19 H 17 V 9"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="总览" Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- 2. 项目列表 (Active) -->
                    <RadioButton x:Name="NavProjectsBtn"
                                 Style="{StaticResource GlobalNavRadioButtonStyle}"
                                 ToolTip="项目列表"
                                 Click="OnNavigationClick">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Folder Icon -->
                            <Path Data="M 3,5 A 1,1 0 0 1 4,4 H 8 L 10,6 H 18 A 1,1 0 0 1 19,7 V 17 A 1,1 0 0 1 18,18 H 4 A 1,1 0 0 1 3,17 Z"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="项目列表" Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- 3. 数据回溯 -->
                    <RadioButton x:Name="NavPlaybackBtn"
                                 Style="{StaticResource GlobalNavRadioButtonStyle}"
                                 ToolTip="数据回溯"
                                 Click="OnNavigationClick">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Database Icon -->
                            <Path Data="M 3,5 C 3,3 19,3 19,5 C 19,7 3,7 3,5 M 3,5 V 17 C 3,19 19,19 19,17 V 5 M 3,11 C 3,13 19,13 19,11"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="数据回溯" Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- 4. 算法列表 -->
                    <RadioButton x:Name="NavAlgorithmsBtn"
                                 Style="{StaticResource GlobalNavRadioButtonStyle}"
                                 ToolTip="算法列表"
                                 Click="OnNavigationClick">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Branch / Nodes Icon -->
                            <Path Data="M 6,5 A 2,2 0 1 1 6,9 A 2,2 0 0 1 6,5 M 16,3 A 2,2 0 1 1 16,7 A 2,2 0 0 1 16,3 M 16,13 A 2,2 0 1 1 16,17 A 2,2 0 0 1 16,13 M 7.5,8 L 14.5,5.5 M 7.5,9 L 14.5,14"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="算法列表" Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- 5. 报告导出 -->
                    <RadioButton x:Name="NavReportsBtn"
                                 Style="{StaticResource GlobalNavRadioButtonStyle}"
                                 ToolTip="报告导出"
                                 Click="OnNavigationClick">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Document Icon -->
                            <Path Data="M 5,3 H 13 L 17,7 V 19 A 1,1 0 0 1 16,20 H 5 A 1,1 0 0 1 4,19 V 4 A 1,1 0 0 1 5,3 M 13,3 V 7 H 17 M 8,11 H 13 M 8,15 H 13"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="报告导出" Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom Settings Item -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <RadioButton x:Name="NavSettingsBtn"
                                 Style="{StaticResource GlobalNavRadioButtonStyle}"
                                 ToolTip="设置"
                                 Click="OnNavigationClick">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Gear Icon -->
                            <Path Data="M 12,8.5 A 3.5,3.5 0 1 0 12,15.5 A 3.5,3.5 0 0 0 12,8.5 M 19.4,13 A 1.6,1.6 0 0 0 19.7,11.3 L 18.2,10.2 A 8.5,8.5 0 0 0 17.5,8.8 L 18,7 A 1.6,1.6 0 0 0 16.7,5.1 L 15,5.6 A 8.5,8.5 0 0 0 13.6,4.9 L 13.1,3.2 A 1.6,1.6 0 0 0 11.2,2.3 H 9.7 A 1.6,1.6 0 0 0 8.2,3.2 L 7.7,4.9 A 8.5,8.5 0 0 0 6.3,5.6 L 4.6,5.1 A 1.6,1.6 0 0 0 3.3,7 L 3.8,8.8 A 8.5,8.5 0 0 0 3.1,10.2 L 1.6,11.3 A 1.6,1.6 0 0 0 1.9,13 L 3.4,14.1 A 8.5,8.5 0 0 0 4.1,15.5 L 3.6,17.3 A 1.6,1.6 0 0 0 4.9,19.2 L 6.6,18.7 A 8.5,8.5 0 0 0 8,19.4 L 8.5,21.1 A 1.6,1.6 0 0 0 10.4,22 H 11.9 A 1.6,1.6 0 0 0 13.4,21.1 L 13.9,19.4 A 8.5,8.5 0 0 0 15.3,18.7 L 17,19.2 A 1.6,1.6 0 0 0 18.3,17.3 L 17.8,15.5 A 8.5,8.5 0 0 0 18.5,14.1 Z"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="设置" Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Host -->
        <ContentControl x:Name="MainContentHost" Grid.Column="1" />

        <!-- 全局操作通知。页面内状态文本仍用于解释当前上下文。 -->
        <views:OperationNotificationHost x:Name="NotificationHost" Grid.Column="1" Panel.ZIndex="20" />
    </Grid>
</Window>
