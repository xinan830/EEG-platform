<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:BrainPlatform.Desktop.Views">

    <Style TargetType="{x:Type views:EegWorkspaceShell}">
        <Setter Property="Background" Value="#F3F5F8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:EegWorkspaceShell}">
                    <Grid x:Name="WorkspaceRoot" Background="{TemplateBinding Background}" Margin="16,12,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="TopWaveGap" Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition x:Name="WaveBottomGap" Height="12" />
                            <RowDefinition x:Name="BottomBarRow" Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="TopBarBorder" Grid.Row="0" Background="White" BorderBrush="#E5E9F0"
                                BorderThickness="1" CornerRadius="8" Padding="16,10">
                            <ContentPresenter Content="{TemplateBinding TopBar}" />
                        </Border>
                        <Border x:Name="WaveformBorder" Grid.Row="2" Background="White" BorderBrush="#E5E9F0"
                                BorderThickness="1" CornerRadius="8" Padding="16,14,14,10">
                            <ContentPresenter Content="{TemplateBinding Waveform}"
                                              DataContext="{TemplateBinding WaveformDataContext}" />
                        </Border>
                        <Border x:Name="BottomBarBorder" Grid.Row="4" Margin="-16,0,-16,-14" Padding="8,1,8,2"
                                MinHeight="32" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <ContentPresenter Content="{TemplateBinding BottomBar}" />
                        </Border>
                        <ContentPresenter Grid.RowSpan="5" Panel.ZIndex="10" Content="{TemplateBinding Overlay}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsImmersiveWaveform" Value="True">
                            <Setter TargetName="WorkspaceRoot" Property="Margin" Value="0,12,0,0" />
                            <Setter TargetName="TopBarBorder" Property="Margin" Value="16,0,16,0" />
                            <Setter TargetName="WaveformBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="WaveformBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="WaveformBorder" Property="Padding" Value="0" />
                            <Setter TargetName="WaveBottomGap" Property="Height" Value="0" />
                            <Setter TargetName="BottomBarBorder" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEdgeToEdgeTopBar" Value="True">
                            <Setter TargetName="WorkspaceRoot" Property="Margin" Value="0" />
                            <Setter TargetName="TopBarBorder" Property="Margin" Value="0" />
                            <Setter TargetName="TopBarBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="TopBarBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="TopWaveGap" Property="Height" Value="0" />
                        </Trigger>
                        <Trigger Property="ShowBottomBar" Value="False">
                            <Setter TargetName="WaveBottomGap" Property="Height" Value="0" />
                            <Setter TargetName="BottomBarRow" Property="Height" Value="0" />
                            <Setter TargetName="BottomBarBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

   <!-- ComboBoxItem Style with comfortable padding and hover states -->
   <!--
        WPF's default ComboBoxItem template binds its content alignment through
        FindAncestor ItemsControl. ComboBox popups live in a separate visual
        tree, so that binding is invalid there. Use the same explicit template
        as the filter items as the implicit fallback for every ComboBoxItem.
    -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource AppComboBoxItemStyle}" />

   <!-- Modern ComboBox Style for Top Filter Toolbar (Comfortable 36px Height) -->
   <!-- Toolbar Gear / Action Icon Button -->
    <Style x:Key="ToolbarGearButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#F8FAFC" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="#CBD5E1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bottom Primary Circular Action Button (Blue Stop) -->
    <Style x:Key="BottomPrimaryCircleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Name="Circle"
                                Background="#1D6FE9"
                                CornerRadius="22">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.25" Color="#1D6FE9" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="#2563EB" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="#1E40AF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bottom Secondary Circular Action Button (Stop, Flag) -->
    <Style x:Key="BottomSecondaryCircleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="Circle"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="22">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.05" Color="#000000" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="#F8FAFC" />
                            <Setter TargetName="Circle" Property="BorderBrush" Value="#CBD5E1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="#F1F5F9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent Icon Button Style -->
    <Style x:Key="FlatIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Close 'X' Button -->
    <Style x:Key="ModernCloseCrossButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <Path Name="ClosePath"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Width="10" Height="10" Stretch="None"
                              Stroke="#64748B"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#F1F5F9" />
                            <Setter TargetName="ClosePath" Property="Stroke" Value="#334155" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#E2E8F0" />
                            <Setter TargetName="ClosePath" Property="Stroke" Value="#0F172A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern TabItem with blue active indicator bar -->
    <Style x:Key="ModernDialogTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="Padding" Value="10,8,10,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Name="HeaderPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <Border Name="Indicator"
                                Height="2.5"
                                CornerRadius="1.25"
                                Background="#2563EB"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Width="36"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#1E293B" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#2563EB" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="SemiBold" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Clean TabControl without bulky borders -->
    <Style x:Key="ModernDialogTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernDialogTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0"
                                  IsItemsHost="True"
                                  KeyboardNavigation.TabIndex="1" />
                        <Border Grid.Row="1" Background="#F1F5F9" Height="1" />
                        <Border Grid.Row="2"
                                Background="{TemplateBinding Background}"
                                TextElement.FontWeight="Normal"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern CheckBox matching design specification -->
    <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Name="Box"
                                Grid.Column="0"
                                Width="18"
                                Height="18"
                                CornerRadius="4"
                                Background="#FFFFFF"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Path Name="CheckMark"
                                  Width="10"
                                  Height="8"
                                  Data="M 1,4.2 L 3.8,7 L 9,1.5"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#2563EB" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#3B82F6" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="#F8FAFC" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Dialog Primary Confirm Button -->
    <Style x:Key="ModernDialogPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#1D4ED8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#1E40AF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="#94A3B8" />
                            <Setter TargetName="Border" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Dialog Secondary Cancel Button -->
    <Style x:Key="ModernDialogSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="Foreground" Value="#334155" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#E2E8F0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#CBD5E1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global Navigation Sidebar RadioButton Style -->
    <Style x:Key="GlobalNavRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="GlobalNavigationGroup" />
        <Setter Property="Height" Value="62" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Left Active Indicator Bar -->
                        <Border Name="ActiveIndicator"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="#2563EB"
                                Visibility="Collapsed" />
                        <!-- Item Content Container -->
                        <Border Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="0,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                            <Setter Property="Foreground" Value="#1E293B" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="#2563EB" />
                            <Setter Property="TextElement.FontWeight" Value="Medium" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
