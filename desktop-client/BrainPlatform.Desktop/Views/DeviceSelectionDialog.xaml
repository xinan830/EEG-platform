<Window x:Class="BrainPlatform.Desktop.Views.DeviceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择设备" Width="552"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 选择设备弹窗专用的现代 ComboBox 样式 -->
            <Style x:Key="DevicePickerComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="38" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#0F172A" />
                <Setter Property="BorderBrush" Value="#D0D7DE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource ModernFilterComboBoxItemStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="DropDownToggle"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Focusable="False"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <Grid Margin="12,0">
                                                    <!-- 下拉小箭头：复刻原图高饱和蓝调精致箭头 -->
                                                    <Path x:Name="Arrow"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Data="M 0,0 L 4.5,4.5 L 9,0"
                                                          Stroke="#1677FF"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#1677FF" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#1677FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- 占位文字：当未选择设备时显示 -->
                                <TextBlock x:Name="PlaceholderText"
                                           Text="请选择设备"
                                           FontSize="13.5"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Margin="12,0,32,0"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />

                                <!-- 选中的设备文本显示 -->
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="12,0,32,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />

                                <!-- 下拉浮层 -->
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder"
                                                Background="#FFFFFF"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,4,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.12" />
                                            </Border.Effect>
                                            <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SelectedItem" Value="{x:Null}">
                                    <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗右上角关闭按钮样式 -->
            <Style x:Key="DialogCloseIconButton" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗底部取消按钮样式 -->
            <Style x:Key="DialogCancelButton" TargetType="Button">
                <Setter Property="Width" Value="76" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#D0D7DE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#1677FF" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#1677FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗底部确定按钮样式 -->
            <Style x:Key="DialogConfirmButton" TargetType="Button">
                <Setter Property="Width" Value="76" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Background" Value="#1677FF" />
                <Setter Property="BorderBrush" Value="#1677FF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4096FF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#BFDBFE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 居中浮层卡片外框（外边距为阴影预留空间） -->
    <Border Width="520" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
            Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.14" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0. 主体内容区 -->
                <RowDefinition Height="1" />    <!-- 1. 全宽分割线 -->
                <RowDefinition Height="Auto" /> <!-- 2. 底部操作栏 -->
            </Grid.RowDefinitions>

            <!-- 0. 主体内容区 -->
            <Grid Grid.Row="0" Margin="28,24,28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 标题行 -->
                    <RowDefinition Height="Auto" /> <!-- 说明提示 -->
                    <RowDefinition Height="Auto" /> <!-- 表单行 -->
                    <RowDefinition Height="Auto" /> <!-- 空状态提示 -->
                </Grid.RowDefinitions>

                <!-- 标题与右上角关闭 X 按钮 -->
                <Grid Grid.Row="0">
                    <TextBlock Text="选择设备" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    <Button Style="{StaticResource DialogCloseIconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="OnCancelClick" ToolTip="关闭">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="11" Height="11" Stretch="Uniform"
                              Stroke="#8E9AAF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <!-- 说明提示文字 -->
                <StackPanel Grid.Row="1" Margin="0,14,0,24">
                    <TextBlock Text="选择后自动读取该设备的物理输入和默认电极模板。" FontSize="13.5" Foreground="#475569" LineHeight="20" />
                    <TextBlock Text="未检测到设备时，请先到采集页测试放大器连接。" FontSize="13.5" Foreground="#475569" Margin="0,4,0,0" LineHeight="20" />
                </StackPanel>

                <!-- 表单：设备选择行 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设备" FontSize="13.5" Foreground="#334155" VerticalAlignment="Center" />
                    <ComboBox x:Name="DeviceComboBox" Grid.Column="1"
                              ItemsSource="{Binding Devices}" DisplayMemberPath="DisplayName"
                              SelectionChanged="OnDeviceSelectionChanged"
                              Style="{StaticResource DevicePickerComboBoxStyle}" />
                </Grid>

                <!-- 无可用设备时的提示 -->
                <TextBlock x:Name="EmptyHint" Grid.Row="3"
                           Text="当前没有可用设备。请先连接并在采集页完成设备检测。"
                           Foreground="#DC2626" FontSize="12.5" TextWrapping="Wrap" Margin="56,8,0,0"
                           Visibility="Collapsed" />
            </Grid>

            <!-- 1. 全宽分割线 -->
            <Border Grid.Row="1" Background="#F1F5F9" />

            <!-- 2. 底部操作按钮 -->
            <Border Grid.Row="2" Padding="28,14,28,16" Background="#FFFFFF">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 取消按钮 -->
                    <Button Style="{StaticResource DialogCancelButton}"
                            Click="OnCancelClick"
                            Margin="0,0,12,0"
                            Content="取消"
                            ToolTip="取消" />
                    <!-- 确定按钮 -->
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource DialogConfirmButton}"
                            Click="OnConfirmClick"
                            IsEnabled="False"
                            Content="确定"
                            ToolTip="确定" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
