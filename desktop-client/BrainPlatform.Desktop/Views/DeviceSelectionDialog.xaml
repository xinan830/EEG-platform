<Window x:Class="BrainPlatform.Desktop.Views.DeviceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择设备" Width="520" Height="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFFFFF">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="选择设备" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
            <Button Width="30" Height="30" Padding="0" BorderThickness="0" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" ToolTip="关闭"
                    Click="OnCancelClick">
                <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" Stretch="Uniform"
                      Stroke="#94A3B8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,14,0,24">
            <TextBlock Text="选择后自动读取该设备的物理输入和默认电极模板。" FontSize="14" Foreground="#475569" />
            <TextBlock Text="未检测到设备时，请先到采集页测试放大器连接。" FontSize="14" Foreground="#475569" Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="设备" FontSize="14" Foreground="#334155" VerticalAlignment="Center" />
            <ComboBox x:Name="DeviceComboBox" Grid.Column="1" Height="40"
                      ItemsSource="{Binding Devices}" DisplayMemberPath="DisplayName"
                      SelectionChanged="OnDeviceSelectionChanged" />
        </Grid>

        <TextBlock Grid.Row="3" x:Name="EmptyHint" Text="当前没有可用设备。请先连接并在采集页完成设备检测。"
                   Foreground="#94A3B8" FontSize="12.5" TextWrapping="Wrap" Margin="64,12,0,0"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Content="取消" Width="92" Height="36" Margin="0,0,12,0" Click="OnCancelClick"
                    Style="{StaticResource ModernDialogSecondaryButtonStyle}" />
            <Button x:Name="ConfirmButton" Content="确定" Width="92" Height="36" IsEnabled="False"
                    Click="OnConfirmClick" Style="{StaticResource ModernDialogPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
