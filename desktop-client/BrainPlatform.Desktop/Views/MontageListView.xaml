<UserControl x:Class="BrainPlatform.Desktop.Views.MontageListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cfg="clr-namespace:BrainPlatform.Desktop.Configuration"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Views"
             mc:Ignorable="d"
             views:SlimScrollBarBehavior.IsEnabled="True"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- 主操作按钮样式 (新建导联配置) -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1677FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#0958D9" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#003EB3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要图标按钮样式 (返回按钮) -->
        <Style x:Key="OutlineIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化筛选下拉框样式 -->
        <Style x:Key="ModernFilterComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0,28,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                    <Path x:Name="Arrow" Data="M 1,1.5 L 5,5.5 L 9,1.5" Stroke="#64748B" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Cursor="Hand">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade" VerticalOffset="4" Focusable="False">
                                <Border x:Name="DropDownBorder" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, ElementName=MainGrid}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4,4">
                                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08" /></Border.Effect>
                                    <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#CBD5E1" /></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#1677FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="10,0" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Foreground" Value="#334155" /><Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" /><Setter Property="Foreground" Value="#0F172A" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" /><Setter Property="Foreground" Value="#1677FF" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内操作图标按钮 -->
        <Style x:Key="RowActionIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="Margin" Value="2,0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F1F5F9" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表表头文字样式 -->
        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#64748B" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 列表行样式 -->
        <Style x:Key="MontageProfileRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="#F1F5F9" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#F8FAFC" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#F0F7FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题栏与新建按钮 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 返回设置主界面按钮 -->
                <Button Style="{StaticResource BackNavigationIconButtonStyle}" Margin="0,0,14,0"
                        Click="OnBackToSettingsClick" ToolTip="返回设置" VerticalAlignment="Center">
                    <Path Data="M 14,8 L 4,8 M 8,4 L 4,8 L 8,12" Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="导联配置" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="管理通道如何组合、重参考后形成最终显示波形。" Margin="0,5,0,0" FontSize="13" Foreground="#64748B" />
                </StackPanel>
            </StackPanel>

            <!-- 新建导联配置按钮 -->
            <Button Grid.Column="1" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnNewMontageProfileClick" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="+" FontSize="15" FontWeight="Bold" Margin="0,-1,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="新建导联配置" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. 搜索与筛选工具栏 (严格复刻图片: 搜索框 + 关联通道配置 + 导联方式 + 来源 + 状态) -->
        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 搜索框 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Path Data="M 14,14 L 19,19 M 6.5,12 A 5.5,5.5 0 1 1 12,6.5 A 5.5,5.5 0 0 1 6.5,12 Z" Width="14" Height="14" Stretch="Uniform" Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="MontageSearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" Foreground="#0F172A" Text="{Binding MontageConfigurations.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1" Text="搜索导联配置名称、说明..." FontSize="13" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=MontageSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 关联通道配置筛选 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="关联通道配置" FontSize="13" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Style="{StaticResource ModernFilterComboBox}" Width="130" ItemsSource="{Binding MontageConfigurations.ChannelConfigurationFilterOptions}" SelectedItem="{Binding MontageConfigurations.ChannelConfigurationFilter, Mode=TwoWay}" />
            </StackPanel>

            <!-- 导联方式筛选 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="导联方式" FontSize="13" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Style="{StaticResource ModernFilterComboBox}" Width="120" ItemsSource="{Binding MontageConfigurations.MontageMethodFilterOptions}" SelectedItem="{Binding MontageConfigurations.MontageMethodFilter, Mode=TwoWay}" />
            </StackPanel>

            <!-- 来源筛选 -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="来源" FontSize="13" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Style="{StaticResource ModernFilterComboBox}" Width="100" ItemsSource="{Binding MontageConfigurations.SourceFilterOptions}" SelectedItem="{Binding MontageConfigurations.SourceFilter, Mode=TwoWay}" />
            </StackPanel>

            <!-- 状态筛选 -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="状态" FontSize="13" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Style="{StaticResource ModernFilterComboBox}" Width="100" ItemsSource="{Binding MontageConfigurations.StatusFilterOptions}" SelectedItem="{Binding MontageConfigurations.StatusFilter, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- 3. 数据表格容器 (响应式全宽拉伸自适应，表头与每一行使用完全一致的自适应列定义) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="TableScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
                <Grid MinWidth="{Binding ViewportWidth, ElementName=TableScrollViewer}" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True"
                      UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 表头 (浅蓝底色 #F4F8FD，与每一行使用完全一致的列定义) -->
                    <Border Grid.Row="0" Background="#F4F8FD" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" CornerRadius="8,8,0,0">
                        <Grid Margin="16,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" MinWidth="150" />
                                <ColumnDefinition Width="1.10*" MinWidth="220" />
                                <ColumnDefinition Width="1.25*" MinWidth="210" />
                                <ColumnDefinition Width="1.00*" MinWidth="120" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="配置名称" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="10,0,6,0" />
                            <TextBlock Grid.Column="1" Text="配置说明" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="8,0,16,0" />
                            <TextBlock Grid.Column="2" Text="关联通道配置" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="16,0,8,0" />
                            <TextBlock Grid.Column="3" Text="导联方式" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="8,0" />
                            <TextBlock Grid.Column="4" Text="输出导联数" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="来源" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="创建时间" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="最后修改时间" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="8" Text="当前状态" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="9" Text="操作" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 表格内容 (与表头完全一致的自适应列定义) -->
                    <ListBox Grid.Row="1" BorderThickness="0" Background="#FFFFFF"
                             ItemContainerStyle="{StaticResource MontageProfileRowStyle}"
                             ItemsSource="{Binding MontageConfigurations.FilteredProfiles}"
                             SelectedItem="{Binding MontageConfigurations.SelectedProfile, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="52" Margin="16,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" MinWidth="150" />
                                        <ColumnDefinition Width="1.10*" MinWidth="220" />
                                        <ColumnDefinition Width="1.25*" MinWidth="210" />
                                        <ColumnDefinition Width="1.00*" MinWidth="120" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 0. 配置名称 -->
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="10,0,6,0" />

                                    <!-- 1. 配置说明 (文本省略 + 气泡) -->
                                    <TextBlock Grid.Column="1" Text="{Binding DescriptionPreview}" FontSize="12.5" Foreground="#64748B" ToolTip="{Binding Description}" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" TextTrimming="CharacterEllipsis" Margin="8,0,16,0" />

                                    <!-- 2. 关联通道配置 (文本省略 + 气泡) -->
                                    <TextBlock Grid.Column="2" Text="{Binding ChannelConfigurationName}" FontSize="12.5" Foreground="#334155" ToolTip="{Binding ChannelConfigurationName}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="16,0,8,0" />

                                    <!-- 3. 导联方式 (文本省略 + 气泡) -->
                                    <TextBlock Grid.Column="3" Text="{Binding ReferenceSummary}" FontSize="12.5" Foreground="#334155" ToolTip="{Binding ReferenceSummary}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="8,0" />

                                    <!-- 4. 输出导联数 -->
                                    <TextBlock Grid.Column="4" Text="{Binding ChannelCount}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />

                                    <!-- 5. 来源徽章 (系统默认蓝底蓝字 / 用户创建橙底橙字，与图片一致) -->
                                    <Border Grid.Column="5" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFF7ED" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}" Value="{x:Static cfg:MontageProfileSource.System}"><Setter Property="Background" Value="#EFF6FF" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11.5" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EA580C" /><Setter Property="Text" Value="用户创建" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source}" Value="{x:Static cfg:MontageProfileSource.System}">
                                                            <Setter Property="Foreground" Value="#2563EB" /><Setter Property="Text" Value="系统默认" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- 6. 创建时间 -->
                                    <TextBlock Grid.Column="6" Text="{Binding CreatedAtText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />

                                    <!-- 7. 最后修改时间 -->
                                    <TextBlock Grid.Column="7" Text="{Binding UpdatedAtText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />

                                    <!-- 8. 当前状态徽章 -->
                                    <Border Grid.Column="8" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding ChannelSnapshotStatusDetail}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ListStatusLabel}" Value="可用"><Setter Property="Background" Value="#DCFCE7" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding ListStatusLabel}" Value="被引用"><Setter Property="Background" Value="#EFF6FF" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding ListStatusLabel}" Value="不可修改"><Setter Property="Background" Value="#FFF7ED" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding ListStatusLabel}" Value="设备不匹配"><Setter Property="Background" Value="#FEF3C7" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding ListStatusLabel}" Value="来源已修改"><Setter Property="Background" Value="#FEF3C7" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding ListStatusLabel}" Value="来源已删除"><Setter Property="Background" Value="#FEE2E2" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding ListStatusLabel}" Value="配置无效"><Setter Property="Background" Value="#FEE2E2" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ListStatusLabel}" FontSize="11.5" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64748B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ListStatusLabel}" Value="可用"><Setter Property="Foreground" Value="#16A34A" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ListStatusLabel}" Value="被引用"><Setter Property="Foreground" Value="#2563EB" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ListStatusLabel}" Value="不可修改"><Setter Property="Foreground" Value="#D97706" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ListStatusLabel}" Value="设备不匹配"><Setter Property="Foreground" Value="#D97706" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ListStatusLabel}" Value="来源已修改"><Setter Property="Foreground" Value="#D97706" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ListStatusLabel}" Value="来源已删除"><Setter Property="Foreground" Value="#DC2626" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ListStatusLabel}" Value="配置无效"><Setter Property="Foreground" Value="#DC2626" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- 9. 操作按钮组 (查看、编辑、复制、删除) -->
                                    <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- 查看 (所有配置均可查看) -->
                                        <Button Style="{StaticResource RowActionIconBtn}" ToolTip="查看" Click="OnOpenMontageDetailClick">
                                            <Path Data="M 1,9 C 1,9 4.5,3 10,3 C 15.5,3 19,9 19,9 C 19,9 15.5,15 10,15 C 4.5,15 1,9 1,9 Z M 10,12 A 3,3 0 1 0 10,6 A 3,3 0 0 0 10,12 Z" Width="15" Height="13" Stretch="Uniform" Stroke="#334155" StrokeThickness="1.5" />
                                        </Button>

                                        <!-- 编辑 (用户配置可编辑时显示) -->
                                        <Button ToolTip="编辑" Click="OnOpenMontageDetailClick">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RowActionIconBtn}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding CanEdit}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="M 11,2 L 14,5 M 2,14 L 1,17 L 4,16 L 14.5,5.5 A 2.12,2.12 0 0 0 11.5,2.5 L 2,14 Z" Width="14" Height="14" Stretch="Uniform" Stroke="#334155" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>

                                        <!-- 复制 (所有配置均可复制) -->
                                        <Button Style="{StaticResource RowActionIconBtn}" ToolTip="复制为新配置" Click="OnCopyMontageProfileClick">
                                            <Path Data="M 6,3 H 13 A 2,2 0 0 1 15,5 V 12 M 3,6 H 10 A 2,2 0 0 1 12,8 V 15 A 2,2 0 0 1 10,17 H 3 A 2,2 0 0 1 1,15 V 8 A 2,2 0 0 1 3,6 Z" Width="14" Height="14" Stretch="Uniform" Stroke="#334155" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>

                                        <!-- 删除 (仅用户配置且可删除时显示) -->
                                        <Button ToolTip="删除" Click="OnDeleteMontageProfileClick">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RowActionIconBtn}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding CanDelete}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="M 2,5 H 16 M 6,5 V 3 A 1,1 0 0 1 7,2 H 11 A 1,1 0 0 1 12,3 V 5 M 14,5 V 15 A 2,2 0 0 1 12,17 H 6 A 2,2 0 0 1 4,15 V 5 M 7,9 V 13 M 11,9 V 13" Width="14" Height="14" Stretch="Uniform" Stroke="#EF4444" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空数据提示 -->
                    <TextBlock Grid.Row="1" Text="未检索到符合条件的导联配置。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" FontSize="13">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding MontageConfigurations.FilteredProfiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 4. 底部翻页与统计栏 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧总条数 -->
            <TextBlock Text="{Binding MontageConfigurations.TotalItemCount, FallbackValue=0, StringFormat=共 {0} 条数据}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />

            <!-- 右侧翻页器 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Margin="0,0,12,0" Style="{StaticResource PaginationPageSizeComboBoxStyle}" ItemsSource="{Binding MontageConfigurations.PageSizeOptions}" ItemStringFormat="{}{0} 条/页" SelectedItem="{Binding MontageConfigurations.PageSize, Mode=TwoWay}" />
                <views:PaginationControl CurrentPage="{Binding MontageConfigurations.CurrentPage}"
                                         TotalPages="{Binding MontageConfigurations.TotalPages}"
                                         PageRequested="OnMontagePageRequested" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
