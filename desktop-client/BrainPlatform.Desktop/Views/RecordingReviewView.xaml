<UserControl x:Class="BrainPlatform.Desktop.Views.RecordingReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Views"
             Background="#F3F5F8">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <views:EegWorkspaceShell>
        <views:EegWorkspaceShell.TopBar>
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←  返回项目"
                            Click="OnBackClick"
                            Height="32"
                            Padding="12,0"
                            Style="{StaticResource ModernDialogSecondaryButtonStyle}"
                            ToolTip="返回项目列表" />
                    <Separator Width="1" Height="30" Background="#E2E8F0" Margin="18,0" />
                    <TextBlock Text="当前查看导联" Foreground="#334155" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="MontageSelector"
                              Width="210"
                              Style="{StaticResource ModernFilterComboBoxStyle}"
                              ItemsSource="{Binding CompatibleViewingMontages}"
                              DisplayMemberPath="Name"
                              SelectionChanged="OnMontageSelectionChanged"
                              ToolTip="只改变回溯显示方式，不修改原始记录" />
                    <TextBlock Text="显示时长" Foreground="#334155" FontSize="13" VerticalAlignment="Center" Margin="20,0,8,0" />
                    <ComboBox x:Name="DurationSelector"
                              Width="92"
                              Style="{StaticResource ModernFilterComboBoxStyle}"
                              SelectionChanged="OnDurationSelectionChanged">
                        <ComboBoxItem Content="5 秒" Tag="5" />
                        <ComboBoxItem Content="10 秒" Tag="10" />
                        <ComboBoxItem Content="20 秒" Tag="20" />
                    </ComboBox>
                    <Separator Width="1" Height="30" Background="#E2E8F0" Margin="20,0" />
                    <TextBlock Text="采集导联" Foreground="#334155" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border MinWidth="150" MaxWidth="220" Padding="10,6" Background="#F8FAFC"
                            BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5"
                            ToolTip="记录创建时保存的导联快照">
                        <TextBlock Text="{Binding AcquisitionMontageText, Mode=OneWay}"
                                   FontSize="12" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TextBlock Text="采样率" Foreground="#334155" FontSize="13" VerticalAlignment="Center" Margin="14,0,8,0" />
                    <TextBlock Text="{Binding SamplingRateHz, Mode=OneWay, StringFormat={}{0} Hz}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                    <TextBlock Text="原始" Foreground="#334155" FontSize="13" VerticalAlignment="Center" Margin="14,0,8,0" />
                    <TextBlock Text="{Binding SourceChannelCount, Mode=OneWay, StringFormat={}{0} 通道}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                    <TextBlock Text=" / 显示" Foreground="#334155" FontSize="13" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Text="{Binding OutputChannelCount, Mode=OneWay, StringFormat={}{0} 通道}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                </StackPanel>

                <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,6" Background="#EFF6FF"
                        BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5"
                        ToolTip="当前回溯记录所属项目与记录名称">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="项目：" FontSize="12" Foreground="#64748B" />
                        <TextBlock Text="{Binding ProjectName, Mode=OneWay}"
                                   MaxWidth="130" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text=" / " FontSize="12" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding RecordingName, Mode=OneWay}"
                                   MaxWidth="150" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </views:EegWorkspaceShell.TopBar>

        <views:EegWorkspaceShell.Waveform>
            <views:RecordingReviewSciChartCanvas DataContext="{Binding}" />
        </views:EegWorkspaceShell.Waveform>

        <views:EegWorkspaceShell.BottomBar>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="28" Height="28">
                        <Ellipse Fill="#DBEAFE" />
                        <Ellipse Width="12" Height="12" Fill="#2563EB" />
                    </Grid>
                    <TextBlock x:Name="PositionText"
                               Width="145"
                               Margin="10,0,0,0"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="#0F2F68"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Column="1" Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Click="OnPlayClick"
                            Style="{StaticResource BottomPrimaryCircleButtonStyle}"
                            ToolTip="播放或暂停回溯">
                        <Grid Width="18" Height="18">
                            <Path Data="M 9,6 L 9,18 L 19,12 Z" Fill="White" Width="16" Height="16" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="M 7,5 H 10 V 19 H 7 Z M 14,5 H 17 V 19 H 14 Z" Fill="White" Width="16" Height="16" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Slider x:Name="PositionSlider"
                            Grid.Column="1"
                            Margin="18,0,0,0"
                            Minimum="0"
                            Maximum="1"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonUp="OnPositionReleased"
                            ToolTip="拖动到记录中的指定时间" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="回溯" FontSize="12" FontWeight="SemiBold" Foreground="#0F3B78" VerticalAlignment="Center" />
                    <Separator Width="1" Height="28" Background="#CBD5E1" Margin="18,0" />
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               MaxWidth="180" FontSize="12" Foreground="#64748B"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </views:EegWorkspaceShell.BottomBar>
    </views:EegWorkspaceShell>
</UserControl>
