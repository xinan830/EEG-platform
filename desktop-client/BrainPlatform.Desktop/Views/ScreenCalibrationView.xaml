<UserControl x:Class="BrainPlatform.Desktop.Views.ScreenCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- 页面标题 -->
            <!-- ========================================================= -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,22">

                <Button Content="‹  返回设置"
                        Click="OnBackClick"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#475569"
                        HorizontalAlignment="Left"
                        Padding="0"
                        FontSize="13"
                        Cursor="Hand" />

                <TextBlock Text="屏幕尺寸校准"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Margin="0,16,0,0" />

                <TextBlock Text="校准当前显示器的真实物理尺寸，让走纸速度在屏幕上对应准确的毫米长度。"
                           FontSize="13.5"
                           Foreground="#64748B"
                           Margin="0,7,0,0" />

            </StackPanel>


            <!-- ========================================================= -->
            <!-- 当前显示器 -->
            <!-- ========================================================= -->

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,0,18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="当前显示器"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A" />


                    <!-- 屏幕信息 -->

                    <Grid Grid.Row="1"
                          Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />

                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />

                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="分辨率"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ScreenCalibration.ScreenResolutionText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2"
                                   Text="系统缩放"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   Margin="22,0,10,0" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding ScreenCalibration.ScaleText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="4"
                                   Text="DPI"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   Margin="22,0,10,0" />

                        <TextBlock Grid.Column="5"
                                   Text="{Binding ScreenCalibration.DpiText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center" />

                    </Grid>


                    <!-- 说明 -->

                    <TextBlock Grid.Row="2"
                               Text="请输入当前显示器可视区域的实际宽度和高度（不包含边框）。"
                               FontSize="12.5"
                               Foreground="#64748B"
                               Margin="0,20,0,12" />


                    <!-- 输入 -->

                    <Grid Grid.Row="3">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="宽度"
                                   Foreground="#334155"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <TextBox Grid.Column="1"
                                 Height="34"
                                 Padding="9,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ScreenCalibration.WidthCentimetersText,
                                                UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Column="2"
                                   Text="cm"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   Margin="8,0,24,0" />


                        <TextBlock Grid.Column="3"
                                   Text="高度"
                                   Foreground="#334155"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <TextBox Grid.Column="4"
                                 Height="34"
                                 Padding="9,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ScreenCalibration.HeightCentimetersText,
                                                UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Column="5"
                                   Text="cm"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   Margin="8,0,24,0" />


                        <StackPanel Grid.Column="6"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="恢复默认"
                                    Command="{Binding ScreenCalibration.ResetCommand}"
                                    Height="34"
                                    Padding="14,0"
                                    Margin="0,0,8,0" />

                            <Button Content="保存校准"
                                    Command="{Binding ScreenCalibration.SaveCommand}"
                                    Height="34"
                                    Padding="16,0"
                                    Background="#2563EB"
                                    Foreground="White"
                                    BorderThickness="0" />

                        </StackPanel>

                    </Grid>


                    <!-- 计算结果 -->

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                Margin="0,14,0,0">

                        <TextBlock Text="程序计算："
                                   Foreground="#64748B"
                                   FontSize="12" />

                        <TextBlock Text="{Binding ScreenCalibration.ScreenDipSizeText}"
                                   Foreground="#334155"
                                   FontSize="12"
                                   Margin="6,0,18,0" />


                        <TextBlock Text="10 cm 尺宽："
                                   Foreground="#64748B"
                                   FontSize="12" />

                        <TextBlock Text="{Binding ScreenCalibration.HorizontalRulerText}"
                                   Foreground="#334155"
                                   FontSize="12"
                                   Margin="6,0,18,0" />


                        <TextBlock Text="换算："
                                   Foreground="#64748B"
                                   FontSize="12" />

                        <TextBlock Text="{Binding ScreenCalibration.MillimetersPerDipText}"
                                   Foreground="#334155"
                                   FontSize="12"
                                   Margin="6,0,0,0" />

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ========================================================= -->
            <!-- 实体刻度验证 -->
            <!-- ========================================================= -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="实体刻度验证"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A" />

                    <TextBlock Text="将实体尺贴在屏幕上，分别核对横向和纵向 10 cm 刻度。若不一致，请修正上方的实际宽高后重新保存。"
                               FontSize="12.5"
                               Foreground="#64748B"
                               Margin="0,7,0,18"
                               TextWrapping="Wrap" />


                    <!-- ================================================= -->
                    <!-- 横向 10 cm -->
                    <!-- ================================================= -->

                    <TextBlock Text="横向 10 cm"
                               FontSize="12"
                               Foreground="#475569" />


                    <!--
                        注意：

                        HorizontalRulerWidthDips
                        就是 0 cm 到 10 cm 的真实物理跨度。

                        这里不再添加 Padding。
                        不再使用 11 个等宽 Column。

                        而是：
                        10 个等宽 Column
                        11 根边界刻度。

                        这样：
                        0 → 10
                        正好跨越完整 HorizontalRulerWidthDips。
                    -->

                    <Grid Width="{Binding ScreenCalibration.HorizontalRulerWidthDips}"
                          Height="62"
                          HorizontalAlignment="Left"
                          Margin="0,6,0,18">

                        <!-- 背景框 -->
                        <Border BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Background="White" />


                        <!-- 真正的刻度区域 -->
                        <Grid Margin="0">

                            <!-- 10 cm = 10 个间隔 -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>


                            <!-- 0 cm -->
                            <Border Grid.Column="0"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Left"
                                    Width="1"
                                    Height="32"
                                    Margin="0,8,0,0"
                                    VerticalAlignment="Top" />


                            <!-- 1 cm -->
                            <Border Grid.Column="0"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right"
                                    Width="1"
                                    Height="26"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Top" />


                            <!-- 2 cm -->
                            <Border Grid.Column="1"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right"
                                    Width="1"
                                    Height="26"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Top" />


                            <!-- 3 cm -->
                            <Border Grid.Column="2"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right"
                                    Width="1"
                                    Height="26"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Top" />


                            <!-- 4 cm -->
                            <Border Grid.Column="3"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right"
                                    Width="1"
                                    Height="26"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Top" />


                            <!-- 5 cm -->
                            <Border Grid.Column="4"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right"
                                    Width="1"
                                    Height="32"
                                    Margin="0,8,0,0"
                                    VerticalAlignment="Top" />


                            <!-- 6 cm -->
                            <Border Grid.Column="5"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right"
                                    Width="1"
                                    Height="26"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Top" />


                            <!-- 7 cm -->
                            <Border Grid.Column="6"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right"
                                    Width="1"
                                    Height="26"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Top" />


                            <!-- 8 cm -->
                            <Border Grid.Column="7"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right"
                                    Width="1"
                                    Height="26"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Top" />


                            <!-- 9 cm -->
                            <Border Grid.Column="8"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right"
                                    Width="1"
                                    Height="26"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Top" />


                            <!-- 10 cm -->
                            <Border Grid.Column="9"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right"
                                    Width="1"
                                    Height="32"
                                    Margin="0,8,0,0"
                                    VerticalAlignment="Top" />


                            <!-- ================================================= -->
                            <!-- 标签 -->
                            <!-- ================================================= -->

                            <TextBlock Grid.Column="0"
                                       Text="0"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Margin="2,0,0,4" />

                            <TextBlock Grid.Column="0"
                                       Text="1"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,-3,4" />

                            <TextBlock Grid.Column="1"
                                       Text="2"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,-3,4" />

                            <TextBlock Grid.Column="2"
                                       Text="3"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,-3,4" />

                            <TextBlock Grid.Column="3"
                                       Text="4"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,-3,4" />

                            <TextBlock Grid.Column="4"
                                       Text="5"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,-3,4" />

                            <TextBlock Grid.Column="5"
                                       Text="6"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,-3,4" />

                            <TextBlock Grid.Column="6"
                                       Text="7"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,-3,4" />

                            <TextBlock Grid.Column="7"
                                       Text="8"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,-3,4" />

                            <TextBlock Grid.Column="8"
                                       Text="9"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,-3,4" />

                            <TextBlock Grid.Column="9"
                                       Text="10 cm"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,2,4" />

                        </Grid>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- 纵向 10 cm -->
                    <!-- ================================================= -->

                    <TextBlock Text="纵向 10 cm"
                               FontSize="12"
                               Foreground="#475569" />


                    <!--
                        VerticalRulerHeightDips
                        就是 0 → 10 cm 的真实物理高度。

                        与横向完全一样：
                        10 个区间
                        11 根边界刻度。
                    -->

                    <Grid Height="{Binding ScreenCalibration.VerticalRulerHeightDips}"
                          Width="82"
                          HorizontalAlignment="Left"
                          Margin="0,6,0,12">

                        <Border BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Background="White" />

                        <Grid>

                            <!-- 10 cm = 10 个区间 -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>


                            <!-- 0 cm -->
                            <Border Grid.Row="0"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Top"
                                    Height="1"
                                    Width="34"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 1 cm -->
                            <Border Grid.Row="0"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Bottom"
                                    Height="1"
                                    Width="26"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 2 cm -->
                            <Border Grid.Row="1"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Bottom"
                                    Height="1"
                                    Width="26"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 3 cm -->
                            <Border Grid.Row="2"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Bottom"
                                    Height="1"
                                    Width="26"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 4 cm -->
                            <Border Grid.Row="3"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Bottom"
                                    Height="1"
                                    Width="26"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 5 cm -->
                            <Border Grid.Row="4"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Bottom"
                                    Height="1"
                                    Width="34"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 6 cm -->
                            <Border Grid.Row="5"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Bottom"
                                    Height="1"
                                    Width="26"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 7 cm -->
                            <Border Grid.Row="6"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Bottom"
                                    Height="1"
                                    Width="26"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 8 cm -->
                            <Border Grid.Row="7"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Bottom"
                                    Height="1"
                                    Width="26"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 9 cm -->
                            <Border Grid.Row="8"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Bottom"
                                    Height="1"
                                    Width="26"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 10 cm -->
                            <Border Grid.Row="9"
                                    BorderBrush="#2563EB"
                                    BorderThickness="0,1,0,0"
                                    VerticalAlignment="Bottom"
                                    Height="1"
                                    Width="34"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0" />


                            <!-- 标签 -->

                            <TextBlock Grid.Row="0"
                                       Text="0"
                                       FontSize="10"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,0,8,0" />

                            <TextBlock Grid.Row="4"
                                       Text="5"
                                       FontSize="10"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,8,-6" />

                            <TextBlock Grid.Row="9"
                                       Text="10 cm"
                                       FontSize="10"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,4,2" />

                        </Grid>

                    </Grid>


                    <!-- 状态 -->

                    <TextBlock Text="{Binding ScreenCalibration.StatusText}"
                               FontSize="12"
                               Foreground="#64748B" />

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>