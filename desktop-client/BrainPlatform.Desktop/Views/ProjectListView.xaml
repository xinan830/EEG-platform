<UserControl x:Class="BrainPlatform.Desktop.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F5F8">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ProjectCardStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" Padding="12,10" Background="#FFFFFF" BorderBrush="#E2E8F0"
                                    BorderThickness="1" CornerRadius="8" Cursor="Hand">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F8FAFC" /></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#EFF6FF" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#93C5FD" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="项目列表" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="管理研究项目，组织和查看采集数据" Margin="0,5,0,0" FontSize="12" Foreground="#64748B" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,18,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Projects.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" ToolTip="搜索项目名称、编号或说明" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,7" Click="OnCreateProjectClick"
                            Style="{StaticResource ModernDialogPrimaryButtonStyle}">
                        <TextBlock Text="+ 新建项目" />
                    </Button>
                </Grid>
                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding Projects.FilteredProjects}"
                             SelectedItem="{Binding Projects.SelectedProject, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ProjectCardStyle}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="7" Background="#DBEAFE" Margin="0,0,11,0">
                                        <Path Data="M 2,4 C 2,2.9 2.9,2 4,2 H 8 L 10,4 H 16 C 17.1,4 18,4.9 18,6 V 14 C 18,15.1 17.1,16 16,16 H 4 C 2.9,16 2,15.1 2,14 Z"
                                              Fill="#2563EB" Width="19" Height="19" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Number}" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding CreatedAtText}" Margin="0,3,0,0" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="尚无项目" FontSize="15" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" />
                        <TextBlock Text="新建项目后才能开始采集" Margin="0,5,0,0" FontSize="12" Foreground="#94A3B8" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding Projects.Projects.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding Projects.Projects.Count, StringFormat=共 {0} 个项目}"
                           FontSize="12" Foreground="#64748B" />
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24,20">
            <Grid>
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Projects.HasSelectedProject}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="8" Background="#DBEAFE" Margin="0,0,14,0">
                            <Path Data="M 2,4 C 2,2.9 2.9,2 4,2 H 8 L 10,4 H 16 C 17.1,4 18,4.9 18,6 V 14 C 18,15.1 17.1,16 16,16 H 4 C 2.9,16 2,15.1 2,14 Z"
                                  Fill="#2563EB" Width="23" Height="23" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Projects.SelectedProject.Name}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="{Binding Projects.SelectedProject.Description}" Margin="0,5,20,0" FontSize="12.5" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Height="36" Padding="15,0" Click="OnStartAcquisitionClick" Style="{StaticResource ModernDialogPrimaryButtonStyle}" Content="开始采集" />
                            <Button Height="36" Padding="14,0" Margin="10,0,0,0" Click="OnEditProjectClick" Content="项目设置" />
                            <Button Height="36" Padding="14,0" Margin="10,0,0,0" Click="OnDeleteProjectClick" Content="移除项目" Foreground="#DC2626" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,18" Padding="0,0,0,18" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="项目编号" Foreground="#64748B" FontSize="11.5" />
                                <TextBlock Text="{Binding Projects.SelectedProject.Number}" Margin="0,4,0,12" Foreground="#0F172A" FontWeight="SemiBold" />
                                <TextBlock Text="创建时间" Foreground="#64748B" FontSize="11.5" />
                                <TextBlock Text="{Binding Projects.SelectedProject.CreatedAtText}" Margin="0,4,0,12" Foreground="#0F172A" />
                                <TextBlock Text="创建者" Foreground="#64748B" FontSize="11.5" />
                                <TextBlock Text="{Binding Projects.SelectedProject.Creator}" Margin="0,4,0,0" Foreground="#0F172A" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="研究目的" Foreground="#64748B" FontSize="11.5" />
                                <TextBlock Text="{Binding Projects.SelectedProject.Purpose, TargetNullValue=未设置}" Margin="0,4,0,12" Foreground="#0F172A" TextWrapping="Wrap" />
                                <TextBlock Text="项目标签" Foreground="#64748B" FontSize="11.5" />
                                <TextBlock Text="{Binding Projects.SelectedProject.TagsText}" Margin="0,4,0,12" Foreground="#2563EB" />
                                <TextBlock Text="项目目录" Foreground="#64748B" FontSize="11.5" />
                                <TextBlock Text="{Binding Projects.SelectedProject.DirectoryPath}" Margin="0,4,0,0" Foreground="#0F172A" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="采集数据" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Button Content="刷新" HorizontalAlignment="Right" Padding="14,6" Click="OnRefreshRecordingsClick" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <DataGrid ItemsSource="{Binding Projects.Recordings}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="44" ColumnHeaderHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="采集名称" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="采集时间" Binding="{Binding StartedAtText}" Width="1.5*" />
                                <DataGridTextColumn Header="采样率" Binding="{Binding SamplingRateText}" Width="*" />
                                <DataGridTextColumn Header="通道" Binding="{Binding ChannelCountText}" Width="*" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="该项目暂无采集记录" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Projects.Recordings.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Projects.HasSelectedProject}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="选择一个项目查看详情" FontSize="16" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" />
                    <TextBlock Text="所有 EEG 采集都必须归属于项目" Margin="0,6,0,0" Foreground="#94A3B8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
