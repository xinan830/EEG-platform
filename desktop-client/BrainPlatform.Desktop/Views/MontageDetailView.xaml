<UserControl x:Class="BrainPlatform.Desktop.Views.MontageDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cfg="clr-namespace:BrainPlatform.Desktop.Configuration"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- 顶部操作按钮基类 -->
        <Style x:Key="HeaderBaseButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 蓝色轮廓操作按钮 -->
        <Style x:Key="OutlineBlueButton" TargetType="Button" BasedOn="{StaticResource HeaderBaseButton}">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#2563EB" />
        </Style>

        <!-- 主要实色按钮 (保存) -->
        <Style x:Key="PrimaryBlueButton" TargetType="Button" BasedOn="{StaticResource HeaderBaseButton}">
            <Setter Property="Background" Value="#1677FF" /><Setter Property="BorderBrush" Value="#1677FF" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 现代化输入框样式 -->
        <Style x:Key="ModernInputBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" /><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#1677FF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC" /><Setter Property="Foreground" Value="#64748B" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

       <!-- 现代化 ComboBox 样式 -->
       <!-- 现代化 CheckBox 样式 -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Foreground" Value="#334155" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" SnapsToDevicePixels="True" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border x:Name="CheckBorder" Width="16" Height="16" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="4" />
                                <Path x:Name="CheckMark" Data="M 3.5,8 L 6.5,11 L 12.5,5" Width="16" Height="16" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="#1677FF" /><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#1677FF" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#94A3B8" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0. 面包屑与顶部操作栏 -->
                    <RowDefinition Height="Auto" /> <!-- 1. 配置基本信息卡片 -->
                    <RowDefinition Height="Auto" /> <!-- 2. 参考通道组卡片 -->
                    <RowDefinition Height="*" />    <!-- 3. 导联列表卡片 -->
                    <RowDefinition Height="Auto" /> <!-- 4. 底部状态与操作栏 -->
                </Grid.RowDefinitions>

                <!-- 0. 面包屑与顶部操作栏 (对齐通道详情页) -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <!-- 面包屑导航 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="28" Padding="8,0" Cursor="Hand">
                            <Button Style="{StaticResource HeaderBaseButton}" Height="26" Padding="0" Background="Transparent" BorderThickness="0" Click="OnBackToMontageListClick" ToolTip="返回列表">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 12,6 L 6,12 L 12,18 M 6,12 L 18,12" Stroke="#334155" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="返回" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <TextBlock Text="›" FontSize="16" Foreground="#94A3B8" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="导联配置" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Text="/" FontSize="13" Foreground="#CBD5E1" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MontageConfigurations.DraftTitle, FallbackValue='查看导联配置'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 标题栏与右上角按钮组 -->
                    <Grid Grid.Row="1" Margin="0,14,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="导联配置" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="固定源通道来自通道配置。本页仅定义显示重参考，不修改原始 EEG 或分析参考。" Margin="0,6,0,0" FontSize="13" Foreground="#64748B" />
                        </StackPanel>

                        <!-- 右上角操作按钮 (保存配置) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Margin="0,0,10,0" Click="OnCopyMontageConfigurationClick" Content="复制为新配置">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineBlueButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MontageConfigurations.CanCopySelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding MontageConfigurations.SaveDraftCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryBlueButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MontageConfigurations.CanEditDraft}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="保存导联配置" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 1. 配置基本信息卡片 (对齐通道详情页 3 栏式) -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="配置基本信息" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" MinWidth="340" />
                                <ColumnDefinition Width="1*" MinWidth="250" />
                                <ColumnDefinition Width="1.15*" MinWidth="270" />
                            </Grid.ColumnDefinitions>

                            <!-- 左栏：配置名称与配置说明 -->
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="配置名称" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                                        <TextBlock Text="*" Foreground="#EF4444" Margin="2,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource ModernInputBox}" Text="{Binding MontageConfigurations.DraftName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MontageConfigurations.CanEditDraft}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="配置说明" FontSize="13" Foreground="#334155" VerticalAlignment="Top" Margin="0,8,0,0" />
                                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="86">
                                        <TextBox Text="{Binding MontageConfigurations.DraftDescription, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MontageConfigurations.CanEditDraft}" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#334155" Padding="10,8" VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- 中栏：适用通道配置与输出导联数 -->
                            <StackPanel Grid.Column="1" Margin="12,0,20,0">
                                <DockPanel Height="36" Margin="0,0,0,10">
                                    <TextBlock Width="95" Text="适用通道配置" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <ComboBox Style="{StaticResource AppFilterComboBoxStyle}"
                                              ItemsSource="{Binding MontageConfigurations.AvailableChannelConfigurations}"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding MontageConfigurations.DraftChannelConfigurationId, Mode=TwoWay}"
                                              IsEnabled="{Binding MontageConfigurations.CanSelectDraftChannelConfiguration}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Height="32" Margin="0,0,0,8">
                                    <TextBlock Width="95" Text="通道概要" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0">
                                        <TextBlock Text="{Binding MontageConfigurations.DraftChannelSummary}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DockPanel>
                                <DockPanel Height="32">
                                    <TextBlock Width="95" Text="输出导联数" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0">
                                        <TextBlock Text="{Binding MontageConfigurations.DraftRows.Count, StringFormat={}{0} 导}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </Border>
                                </DockPanel>
                            </StackPanel>

                            <!-- 右栏：全局参考概要与状态 -->
                            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                <DockPanel Height="32" Margin="0,0,0,8">
                                    <TextBlock Width="110" Text="平均参考组" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0">
                                        <TextBlock Text="{Binding MontageConfigurations.AverageReferenceSummary}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" />
                                    </Border>
                                </DockPanel>
                                <DockPanel Height="32" Margin="0,0,0,8">
                                    <TextBlock Width="110" Text="指定双参考" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0">
                                        <TextBlock Text="{Binding MontageConfigurations.SpecifiedPairSummary}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" />
                                    </Border>
                                </DockPanel>
                                <DockPanel Height="32">
                                    <TextBlock Width="110" Text="编辑权限" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border CornerRadius="10" Padding="12,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MontageConfigurations.CanEditDraft}" Value="False"><Setter Property="Background" Value="#EFF6FF" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="可编辑" /><Setter Property="Foreground" Value="#16A34A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MontageConfigurations.CanEditDraft}" Value="False"><Setter Property="Text" Value="系统预设（只读）" /><Setter Property="Foreground" Value="#2563EB" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. 全局参考通道组卡片 (仅编辑模式或包含平均/双参考时显示) -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding MontageConfigurations.ShowReferenceGroup}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid IsEnabled="{Binding MontageConfigurations.CanEditDraft}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧说明 -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="参考通道组配置" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="平均参考可选两个或更多；指定双参考必须恰好两个。" Margin="0,4,0,0" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 中间通道勾选区 -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding MontageConfigurations.AverageReferenceChannels}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsIncluded}" Style="{StaticResource ModernCheckBox}" Margin="0,5,16,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 右侧快捷操作按钮组 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Style="{StaticResource OutlineBlueButton}" Command="{Binding MontageConfigurations.ApplyOriginalReferenceToAllCommand}" IsEnabled="{Binding MontageConfigurations.CanApplyOriginalReference}" Margin="0,0,8,0" Content="全部原始参考" ToolTip="将全部导联恢复为原始硬件 REF 参考" />
                            <Button Style="{StaticResource OutlineBlueButton}" Command="{Binding MontageConfigurations.ApplyAverageReferenceToAllCommand}" IsEnabled="{Binding MontageConfigurations.CanApplyAverageReference}" Margin="0,0,8,0" Content="全部平均参考" ToolTip="应用选中的平均参考组到全部导联" />
                            <Button Style="{StaticResource PrimaryBlueButton}" Command="{Binding MontageConfigurations.ApplySpecifiedPairToAllCommand}" IsEnabled="{Binding MontageConfigurations.CanApplySpecifiedPair}" Content="全部指定双参考" ToolTip="应用双通道参考到全部导联" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. 导联配置列表卡片 (与通道详情页完全一致的表头与表行布局) -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <Grid Grid.Row="0" Margin="20,16,20,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="导联重参考列表" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MontageConfigurations.DraftRows.Count, StringFormat=（共 {0} 条导联）}" FontSize="14" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="源通道和顺序由通道配置固定；本卡片仅配置软件重参考方式。" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 表格主体 (表头与每一行使用完全一致的自适应列定义) -->
                        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                                <!-- 表头 (浅蓝底色 #F4F8FD) -->
                                <Border Grid.Row="0" Background="#F4F8FD" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <Grid Margin="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*" MinWidth="130" />
                                            <ColumnDefinition Width="1.0*" MinWidth="100" />
                                            <ColumnDefinition Width="1.4*" MinWidth="140" />
                                            <ColumnDefinition Width="2.0*" MinWidth="200" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="导联名称" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="正极输入" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="重参考方式" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="负极 / 参考组" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="显示顺序" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- 数据行列表 -->
                                <ListBox Grid.Row="1" BorderThickness="0" Background="#FFFFFF" ItemsSource="{Binding MontageConfigurations.DraftRows}" IsEnabled="{Binding MontageConfigurations.CanEditDraft}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="RowBd" Background="#FFFFFF" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"><ContentPresenter /></Border>
                                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBd" Property="Background" Value="#F8FAFC" /></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="48" Margin="16,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.3*" MinWidth="130" />
                                                    <ColumnDefinition Width="1.0*" MinWidth="100" />
                                                    <ColumnDefinition Width="1.4*" MinWidth="140" />
                                                    <ColumnDefinition Width="2.0*" MinWidth="200" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 0. 导联名称 -->
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />

                                                <!-- 1. 正极输入 (来自通道配置) -->
                                                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PositiveLabel}" FontSize="12.5" FontWeight="Medium" Foreground="#334155" />
                                                </Border>

                                                <!-- 2. 重参考方式选择框 -->
                                                <ComboBox Grid.Column="2" Style="{StaticResource AppFilterComboBoxStyle}" Height="32" Margin="0,0,14,0"
                                                          ItemsSource="{Binding DataContext.MontageConfigurations.NegativeKinds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedValuePath="Kind" SelectedValue="{Binding NegativeKind, Mode=TwoWay}"
                                                          IsEnabled="{Binding DataContext.MontageConfigurations.CanEditReferenceMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- 3. 负极 / 参考组选择 -->
                                                <!-- 单参考/平均参考/硬件参考模式 -->
                                                <ComboBox Grid.Column="3" Height="32" Margin="0,0,14,0"
                                                          ItemsSource="{Binding ReferenceOptions}" SelectedItem="{Binding ReferenceSelection, Mode=TwoWay}" IsEnabled="{Binding IsChannelReference}">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource AppFilterComboBoxStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsSpecifiedPairReference}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>

                                                <!-- 指定双参考模式 (两个下拉框) -->
                                                <Grid Grid.Column="3" Margin="0,0,14,0">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsSpecifiedPairReference}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <ComboBox Style="{StaticResource AppFilterComboBoxStyle}" Height="32" ItemsSource="{Binding PairFirstOptions}" SelectedItem="{Binding SelectedPairFirstLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="第一参考通道" />
                                                    <TextBlock Grid.Column="1" Text="+" Margin="6,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#64748B" />
                                                    <ComboBox Grid.Column="2" Style="{StaticResource AppFilterComboBoxStyle}" Height="32" ItemsSource="{Binding PairSecondOptions}" SelectedItem="{Binding SelectedPairSecondLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="第二参考通道" />
                                                </Grid>

                                                <!-- 4. 显示顺序 -->
                                                <TextBlock Grid.Column="4" Text="{Binding DisplayOrder}" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="1" Text="请选择有效的通道配置以加载导联。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" FontSize="13">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding MontageConfigurations.DraftRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- 底部统计 -->
                        <TextBlock Grid.Row="2" Text="{Binding MontageConfigurations.DraftRows.Count, StringFormat=共 {0} 条导联}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="20,14,0,16" />
                    </Grid>
                </Border>

                <!-- 4. 底部状态与操作栏 -->
                <DockPanel Grid.Row="4" Margin="0,16,0,0">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding MontageConfigurations.StatusText}" Foreground="#64748B" FontSize="12.5" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource OutlineBlueButton}" Height="34" Padding="18,0" Margin="0,0,10,0" Click="OnCancelMontageDraftClick" Content="返回" />
                        <Button Command="{Binding MontageConfigurations.SaveDraftCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryBlueButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers><DataTrigger Binding="{Binding MontageConfigurations.CanEditDraft}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="保存导联配置" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
