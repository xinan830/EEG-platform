<Window x:Class="BrainPlatform.Desktop.Views.OperationConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认操作" Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 弹窗右上角精致关闭按钮样式 -->
            <Style x:Key="DialogCloseIconButton" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗底部取消按钮样式 -->
            <Style x:Key="DialogCancelButton" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="MinWidth" Value="80" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#D0D7DE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗底部危险确认按钮样式 -->
            <Style x:Key="DialogDangerButton" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Background" Value="#EF4444" />
                <Setter Property="BorderBrush" Value="#EF4444" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#DC2626" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#B91C1C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 居中浮层卡片外框（外边距为阴影预留空间） -->
    <Border Width="440" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
            Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.14" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0. 顶部标题栏 -->
                <RowDefinition Height="Auto" /> <!-- 1. 主体内容区 -->
                <RowDefinition Height="1" />    <!-- 2. 全宽分割线 -->
                <RowDefinition Height="Auto" /> <!-- 3. 底部操作栏 -->
            </Grid.RowDefinitions>

            <!-- 0. 顶部标题与右上角关闭 X 按钮 -->
            <Grid Grid.Row="0" Margin="24,14,14,0">
                <TextBlock Text="确认操作" FontSize="14" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center" />
                <Button Style="{StaticResource DialogCloseIconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsCancel="True" ToolTip="关闭">
                    <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="10" Height="10" Stretch="Uniform"
                          Stroke="#8E9AAF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <!-- 1. 主体内容区：警示徽章 + 操作标题 + 说明文本 -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="28,16,28,24">
                <!-- 警示图标容器 -->
                <Border Width="52" Height="52" CornerRadius="26" Background="#FEF2F2" BorderBrush="#FEE2E2" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Width="3.5" Height="15" RadiusX="1.75" RadiusY="1.75" Fill="#EF4444" Margin="0,0,0,3.5" />
                        <Ellipse Width="3.5" Height="3.5" Fill="#EF4444" />
                    </StackPanel>
                </Border>

                <!-- 确认操作大标题 -->
                <TextBlock Text="{Binding TitleText}" Margin="0,16,0,0" FontSize="18" FontWeight="Bold"
                           Foreground="#0F172A" HorizontalAlignment="Center" />

                <!-- 详细说明文本 -->
                <TextBlock Text="{Binding MessageText}" Margin="0,10,0,0" FontSize="13.5" LineHeight="22"
                           Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
            </StackPanel>

            <!-- 2. 全宽分割线 -->
            <Border Grid.Row="2" Background="#F1F5F9" />

            <!-- 3. 底部操作栏 -->
            <Border Grid.Row="3" Padding="24,14,24,16" Background="#FFFFFF" CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 取消按钮 -->
                    <Button Style="{StaticResource DialogCancelButton}"
                            Content="取消"
                            IsCancel="True"
                            Margin="0,0,12,0"
                            ToolTip="取消" />

                    <!-- 危险确认按钮 -->
                    <Button Style="{StaticResource DialogDangerButton}"
                            Content="{Binding ConfirmText}"
                            IsDefault="True"
                            Click="OnConfirmClick"
                            ToolTip="{Binding ConfirmText}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
