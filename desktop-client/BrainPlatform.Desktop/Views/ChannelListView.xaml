<UserControl x:Class="BrainPlatform.Desktop.Views.ChannelListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Views"
             mc:Ignorable="d"
             views:SlimScrollBarBehavior.IsEnabled="True"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- 主操作按钮样式 (新建通道配置) -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1677FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#0958D9" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#003EB3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要图标按钮样式 (...) -->
        <Style x:Key="OutlineIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化筛选下拉框样式 -->
        <Style x:Key="ModernFilterComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0,28,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{x:Null}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False" />
                                    <!-- 下拉箭头 -->
                                    <Path x:Name="Arrow"
                                          Data="M 1,1.5 L 5,5.5 L 9,1.5"
                                          Stroke="#64748B"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"
                                          IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="4,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#1677FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Foreground" Value="#334155" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                            <Setter Property="Foreground" Value="#0F172A" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                                            <Setter Property="Foreground" Value="#1677FF" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化 CheckBox 样式 -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="16" Height="16" SnapsToDevicePixels="True">
                            <Border x:Name="CheckBorder" Width="16" Height="16" Background="#FFFFFF"
                                    BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="4" />
                            <Path x:Name="CheckMark" Data="M 3.5,8 L 6.5,11 L 12.5,5"
                                  Width="16" Height="16"
                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#1677FF" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#1677FF" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内操作图标按钮 -->
        <Style x:Key="RowActionIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表表头文字样式 -->
        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 列表行样式 -->
        <Style x:Key="ChannelProfileRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#F8FAFC" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#F0F7FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题栏与新建按钮 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 返回设置主界面按钮 -->
                <Button Style="{StaticResource BackNavigationIconButtonStyle}" Margin="0,0,14,0"
                        Click="OnBackToSettingsClick" ToolTip="返回设置" VerticalAlignment="Center">
                    <Path Data="M 14,8 L 4,8 M 8,4 L 4,8 L 8,12"
                          Stroke="#475569" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="通道配置" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="管理设备的原始输入通道及其显示标签" Margin="0,5,0,0" FontSize="13" Foreground="#64748B" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 新建通道配置按钮 -->
                <Button Style="{StaticResource PrimaryActionButtonStyle}" Click="OnNewChannelConfigurationClick" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="+" FontSize="15" FontWeight="Bold" Margin="0,-1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="新建通道配置" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 更多操作按钮 (...) -->
                <Button Style="{StaticResource OutlineIconButtonStyle}" Command="{Binding ChannelConfigurations.RefreshCommand}" ToolTip="刷新配置列表">
                    <TextBlock Text="•••" FontSize="13" FontWeight="Bold" Foreground="#64748B" Margin="0,-2,0,0" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. 搜索与筛选工具栏 -->
        <Grid Grid.Row="1" Margin="0,18,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 搜索框 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 放大镜图标 -->
                    <Path Data="M 14,14 L 19,19 M 6.5,12 A 5.5,5.5 0 1 1 12,6.5 A 5.5,5.5 0 0 1 6.5,12 Z"
                          Width="14" Height="14" Stretch="Uniform" Stroke="#94A3B8" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" Foreground="#0F172A"
                             Text="{Binding ChannelConfigurations.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- 占位提示文字 (由输入框文本驱动) -->
                    <TextBlock Grid.Column="1" Text="按配置名称、设备型号搜索" FontSize="13" Foreground="#94A3B8"
                               IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 设备型号筛选 -->
            <ComboBox Grid.Column="1" Style="{StaticResource ModernFilterComboBox}" Width="140" Margin="12,0,0,0"
                      ItemsSource="{Binding ChannelConfigurations.DeviceModelFilterOptions}"
                      SelectedItem="{Binding ChannelConfigurations.DeviceModelFilter, Mode=TwoWay}" />

            <!-- 配置来源筛选 -->
            <ComboBox Grid.Column="2" Style="{StaticResource ModernFilterComboBox}" Width="140" Margin="12,0,0,0"
                      ItemsSource="{Binding ChannelConfigurations.SourceFilterOptions}"
                      SelectedItem="{Binding ChannelConfigurations.SourceFilter, Mode=TwoWay}" />

            <!-- 状态筛选 -->
            <ComboBox Grid.Column="3" Style="{StaticResource ModernFilterComboBox}" Width="130" Margin="12,0,0,0"
                      ItemsSource="{Binding ChannelConfigurations.StatusFilterOptions}"
                      SelectedItem="{Binding ChannelConfigurations.StatusFilter, Mode=TwoWay}" />
        </Grid>

        <!-- 3. 数据表格容器 (响应式全宽拉伸自适应) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="TableScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
                <Grid MinWidth="{Binding ViewportWidth, ElementName=TableScrollViewer}" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True"
                      UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 表头 -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                        <Grid Margin="16,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" MinWidth="150" />
                                <ColumnDefinition Width="1.10*" MinWidth="220" />
                                <ColumnDefinition Width="1.05*" MinWidth="150" />
                                <ColumnDefinition Width="85" SharedSizeGroup="Col3" />
                                <ColumnDefinition Width="85" SharedSizeGroup="Col4" />
                                <ColumnDefinition Width="85" SharedSizeGroup="Col5" />
                                <ColumnDefinition Width="110" SharedSizeGroup="Col6" />
                                <ColumnDefinition Width="105" SharedSizeGroup="Col7" />
                                <ColumnDefinition Width="105" SharedSizeGroup="Col8" />
                                <ColumnDefinition Width="115" SharedSizeGroup="Col9" />
                                <ColumnDefinition Width="144" SharedSizeGroup="Col10" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="配置名称" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="10,0,6,0" />
                            <TextBlock Grid.Column="1" Text="配置说明" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="8,0,16,0" />
                            <TextBlock Grid.Column="2" Text="设备型号" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="16,0,8,0" />
                            <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" LineHeight="14">
                                EEG<LineBreak/>输入数
                            </TextBlock>
                            <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" LineHeight="14">
                                当前显示<LineBreak/>通道数
                            </TextBlock>
                            <TextBlock Grid.Column="5" Text="来源" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="6" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" LineHeight="14">
                                被引用的<LineBreak/>导联配置数量
                            </TextBlock>
                            <TextBlock Grid.Column="7" Text="创建时间" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="8" Text="最后修改时间" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="9" Text="当前状态" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="10" Text="操作" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 表格内容 -->
                    <ListBox Grid.Row="1" BorderThickness="0" Background="#FFFFFF"
                             ItemContainerStyle="{StaticResource ChannelProfileRowStyle}"
                             ItemsSource="{Binding ChannelConfigurations.FilteredProfiles}"
                             SelectedItem="{Binding ChannelConfigurations.SelectedProfile, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="56" Margin="16,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" MinWidth="150" />
                                        <ColumnDefinition Width="1.10*" MinWidth="220" />
                                        <ColumnDefinition Width="1.05*" MinWidth="150" />
                                        <ColumnDefinition Width="85" SharedSizeGroup="Col3" />
                                        <ColumnDefinition Width="85" SharedSizeGroup="Col4" />
                                        <ColumnDefinition Width="85" SharedSizeGroup="Col5" />
                                        <ColumnDefinition Width="110" SharedSizeGroup="Col6" />
                                        <ColumnDefinition Width="105" SharedSizeGroup="Col7" />
                                        <ColumnDefinition Width="105" SharedSizeGroup="Col8" />
                                        <ColumnDefinition Width="115" SharedSizeGroup="Col9" />
                                        <ColumnDefinition Width="144" SharedSizeGroup="Col10" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 0. 配置名称 (靠左) -->
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"
                                               VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="10,0,6,0" />

                                    <!-- 1. 配置说明 (靠左，自适应宽度+全格灵敏悬浮详细提示) -->
                                    <Grid Grid.Column="1" Margin="8,0,16,0" Background="Transparent"
                                          ToolTipService.InitialShowDelay="100"
                                          ToolTipService.ShowDuration="20000"
                                          ToolTipService.BetweenShowDelay="0">
                                        <Grid.ToolTip>
                                            <ToolTip Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Padding="12,10">
                                                <ToolTip.Template>
                                                    <ControlTemplate TargetType="ToolTip">
                                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,10" MaxWidth="360">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.35" />
                                                            </Border.Effect>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                    <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 13,17 H 11 V 11 H 13 V 17 Z M 13,9 H 11 V 7 H 13 V 9 Z"
                                                                          Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    <TextBlock Text="配置详细说明" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="18" FontSize="12" Foreground="#F1F5F9" />
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToolTip.Template>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <TextBlock Text="{Binding DescriptionPreview}" FontSize="12" Foreground="#64748B"
                                                   VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Left" />
                                    </Grid>

                                    <!-- 2. 设备型号 (靠左) -->
                                    <Grid Grid.Column="2" Margin="16,0,8,0" Background="Transparent"
                                          ToolTipService.InitialShowDelay="100"
                                          ToolTipService.ShowDuration="20000"
                                          ToolTipService.BetweenShowDelay="0">
                                        <Grid.ToolTip>
                                            <ToolTip Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Padding="12,10">
                                                <ToolTip.Template>
                                                    <ControlTemplate TargetType="ToolTip">
                                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,8" MaxWidth="320">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.35" />
                                                            </Border.Effect>
                                                            <StackPanel>
                                                                <TextBlock Text="设备型号" FontWeight="SemiBold" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                                                                <TextBlock Text="{Binding DeviceModelLabel}" TextWrapping="Wrap" FontSize="12" Foreground="#F1F5F9" />
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToolTip.Template>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <TextBlock Text="{Binding DeviceModelLabel}" FontSize="12.5" Foreground="#475569"
                                                   VerticalAlignment="Center" HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <!-- 3. 实际设备通道数 (居中) -->
                                    <TextBlock Grid.Column="3" Text="{Binding ChannelCount}" FontSize="13" Foreground="#475569"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />

                                    <!-- 4. 当前显示通道数 (居中) -->
                                    <TextBlock Grid.Column="4" Text="{Binding EnabledChannelCount}" FontSize="13" Foreground="#475569"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />

                                    <!-- 5. 来源胶囊 (居中) -->
                                    <Border Grid.Column="5" CornerRadius="4" Padding="7,2.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3E8FF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}" Value="System">
                                                        <Setter Property="Background" Value="#E0F2FE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11.5" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="用户创建" />
                                                    <Setter Property="Foreground" Value="#7C3AED" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source}" Value="System">
                                                            <Setter Property="Text" Value="系统默认" />
                                                            <Setter Property="Foreground" Value="#0284C7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- 6. 被引用的导联配置数量 (居中) -->
                                    <TextBlock Grid.Column="6" Text="{Binding MontageReferenceCount}" FontSize="13" Foreground="#475569"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />

                                    <!-- 7. 创建时间 (居中) -->
                                    <TextBlock Grid.Column="7" Text="{Binding CreatedAtUtc, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="12" Foreground="#64748B"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />

                                    <!-- 8. 最后修改时间 (居中) -->
                                    <TextBlock Grid.Column="8" Text="{Binding UpdatedAtUtc, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="12" Foreground="#64748B"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />

                                    <!-- 9. 当前状态胶囊 (居中) -->
                                    <Border Grid.Column="9" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMontageReferences}" Value="True">
                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCompatibleWithCurrentDevice}" Value="False">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#10B981" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMontageReferences}" Value="True">
                                                                <Setter Property="Fill" Value="#3B82F6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCompatibleWithCurrentDevice}" Value="False">
                                                                <Setter Property="Fill" Value="#94A3B8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ListStatusLabel}" FontSize="12" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#059669" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMontageReferences}" Value="True">
                                                                <Setter Property="Foreground" Value="#2563EB" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCompatibleWithCurrentDevice}" Value="False">
                                                                <Setter Property="Foreground" Value="#64748B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- 10. 操作按钮组 (居中) -->
                                    <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- 1. 查看按钮 -->
                                        <Button Style="{StaticResource RowActionIconBtn}" ToolTip="查看" Click="OnOpenChannelDetailClick">
                                            <Path Data="M 1,9 C 1,9 4.5,3 10,3 C 15.5,3 19,9 19,9 C 19,9 15.5,15 10,15 C 4.5,15 1,9 1,9 Z M 10,12 A 3,3 0 1 0 10,6 A 3,3 0 0 0 10,12 Z"
                                                  Width="15" Height="13" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.5" />
                                        </Button>

                                        <!-- 2. 编辑按钮 -->
                                        <Button ToolTip="编辑" Click="OnOpenChannelDetailClick">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RowActionIconBtn}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanEdit}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSignalLocked}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="M 11,2 L 14,5 M 2,14 L 1,17 L 4,16 L 14.5,5.5 A 2.12,2.12 0 0 0 11.5,2.5 L 2,14 Z"
                                                  Width="14" Height="14" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>

                                        <!-- 3. 复制按钮 -->
                                        <Button Style="{StaticResource RowActionIconBtn}" ToolTip="复制为新配置" Click="OnCopyProfileClick">
                                            <Path Data="M 6,3 H 13 A 2,2 0 0 1 15,5 V 12 M 3,6 H 10 A 2,2 0 0 1 12,8 V 15 A 2,2 0 0 1 10,17 H 3 A 2,2 0 0 1 1,15 V 8 A 2,2 0 0 1 3,6 Z"
                                                  Width="14" Height="14" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>

                                        <!-- 4. 删除按钮 -->
                                        <Button ToolTip="删除" Click="OnDeleteProfileClick">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RowActionIconBtn}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="M 2,5 H 16 M 6,5 V 3 A 1,1 0 0 1 7,2 H 11 A 1,1 0 0 1 12,3 V 5 M 14,5 V 15 A 2,2 0 0 1 12,17 H 6 A 2,2 0 0 1 4,15 V 5 M 7,9 V 13 M 11,9 V 13"
                                                  Width="14" Height="14" Stretch="Uniform" Stroke="#EF4444" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 4. 底部翻页与统计栏 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧总条数 -->
            <TextBlock Text="{Binding ChannelConfigurations.TotalItemCount, FallbackValue=0, StringFormat=共 {0} 条数据}"
                       FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />

            <!-- 右侧翻页器 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 条数选择框 -->
                <ComboBox Margin="0,0,12,0" Style="{StaticResource PaginationPageSizeComboBoxStyle}"
                          ItemsSource="{Binding ChannelConfigurations.PageSizeOptions}"
                          SelectedItem="{Binding ChannelConfigurations.PageSize, Mode=TwoWay}"
                          ItemStringFormat="{}{0} 条/页" />
                <views:PaginationControl CurrentPage="{Binding ChannelConfigurations.CurrentPage}"
                                         TotalPages="{Binding ChannelConfigurations.TotalPages}"
                                         PageRequested="OnChannelPageRequested" />
            </StackPanel>
        </Grid>

        <!-- 新建通道配置的前置步骤：先在列表页确认设备，随后才进入编辑页。 -->
        <Grid Panel.ZIndex="100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ChannelConfigurations.IsDevicePickerVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- 透明遮罩仍会拦截列表操作，但不把页面压暗。 -->
            <Border Background="Transparent" />

            <Border Width="520" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#0F172A" Opacity="0.16" />
                </Border.Effect>
                <Grid Margin="24,22,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="选择设备" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Button Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                Click="OnCancelNewChannelDeviceClick" ToolTip="取消">
                            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="11" Height="11" Stretch="Uniform"
                                  Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,24">
                        <TextBlock Text="选择后自动读取该设备的物理输入和默认电极模板。" FontSize="13" Foreground="#475569" LineHeight="20" />
                        <TextBlock Text="未检测到设备时，请先到采集页测试放大器连接。" FontSize="13" Foreground="#475569" Margin="0,3,0,0" LineHeight="20" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设备" FontSize="13.5" Foreground="#334155" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Height="38"
                                  ItemsSource="{Binding Acquisition.Devices}"
                                  SelectedItem="{Binding ChannelConfigurations.PendingDeviceSelection, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource ModernFilterComboBox}" />
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                        <Button Height="34" Padding="18,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                Foreground="#1677FF" Click="OnCancelNewChannelDeviceClick" Margin="0,0,12,0" Cursor="Hand">
                            <TextBlock Text="取消" FontSize="13" FontWeight="Medium" />
                        </Button>
                        <Button Height="34" Padding="20,0" Background="#1677FF" BorderBrush="#1677FF" BorderThickness="1"
                                Foreground="#FFFFFF" Click="OnConfirmNewChannelDeviceClick"
                                IsEnabled="{Binding ChannelConfigurations.HasPendingDeviceSelection}" Cursor="Hand">
                            <TextBlock Text="确定" FontSize="13" FontWeight="Medium" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
