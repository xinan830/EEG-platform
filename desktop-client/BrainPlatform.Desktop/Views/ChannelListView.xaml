<UserControl x:Class="BrainPlatform.Desktop.Views.ChannelListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F5F8">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ListActionButton" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#F8FAFC" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListPrimaryButton" TargetType="Button" BasedOn="{StaticResource ListActionButton}">
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="BorderBrush" Value="#2563EB" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Style>

            <Style x:Key="ProfileListRow" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="#F1F5F9" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#F8FAFC" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#EFF6FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="#64748B" />
            </Style>

            <Style x:Key="InlineActionButton" TargetType="Button">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ListActionButton}" Width="38" Padding="0" ToolTip="返回设置"
                                Click="OnBackToSettingsClick">
                            <Path Data="M 9,3 L 4,8 L 9,13 M 4,8 H 15" Width="14" Height="12" Stretch="Uniform"
                                  Stroke="#334155" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="通道配置列表" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="保存设备对应的电极标签与波形显示选择。" Margin="0,5,0,0" FontSize="13" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ListActionButton}" Margin="0,0,8,0"
                                Command="{Binding ChannelConfigurations.RefreshCommand}">
                            <TextBlock Text="刷新" FontSize="13" Foreground="#1E293B" />
                        </Button>
                        <Button Style="{StaticResource ListPrimaryButton}"
                                Click="OnNewChannelConfigurationClick">
                            <TextBlock Text="新建通道配置" FontSize="13" FontWeight="Medium" />
                        </Button>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Margin="0,22,0,16" Padding="12,10" Background="#EFF6FF" CornerRadius="7">
                    <TextBlock Text="配置兼容性由设备驱动 ID 与完整物理通道能力（输入编号、角色、单位）共同校验。设备型号只用于识别；设备实例不会绑定配置。"
                               FontSize="12.5" Foreground="#1E40AF" TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="#F8FAFC">
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="1.65*" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="配置名称" Style="{StaticResource ListHeaderTextStyle}" />
                            <TextBlock Grid.Column="1" Text="EEG 输入 / 显示" Style="{StaticResource ListHeaderTextStyle}" />
                            <TextBlock Grid.Column="2" Text="设备型号" Style="{StaticResource ListHeaderTextStyle}" />
                            <TextBlock Grid.Column="3" Text="硬件接线" Style="{StaticResource ListHeaderTextStyle}" />
                            <TextBlock Grid.Column="4" Text="描述" Style="{StaticResource ListHeaderTextStyle}" />
                            <TextBlock Grid.Column="5" Text="创建时间" Style="{StaticResource ListHeaderTextStyle}" />
                            <TextBlock Grid.Column="6" Text="状态" Style="{StaticResource ListHeaderTextStyle}" />
                            <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource ListHeaderTextStyle}" />
                        </Grid>

                        <ListBox Grid.Row="1" BorderThickness="0" Background="#FFFFFF"
                                 ItemContainerStyle="{StaticResource ProfileListRow}"
                                 ItemsSource="{Binding ChannelConfigurations.Profiles}"
                                 SelectedItem="{Binding ChannelConfigurations.SelectedProfile, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1.45*" />
                                            <ColumnDefinition Width="1.65*" />
                                            <ColumnDefinition Width="1.05*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1.1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SourceLabel}" Margin="0,3,0,0" FontSize="11.5" Foreground="#64748B" />
                                            <TextBlock Text="{Binding ReferenceSummary}" Margin="0,2,0,0" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ChannelCount}" Foreground="#334155" />
                                            <TextBlock Text="{Binding EnabledChannelCount, StringFormat=显示 {0}}" FontSize="11.5" Foreground="#64748B" />
                                         </StackPanel>
                                         <TextBlock Grid.Column="2" Text="{Binding DeviceModelLabel}" Margin="12,0" VerticalAlignment="Center" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                         <TextBlock Grid.Column="3" Text="{Binding HardwareWiringSummary}" Margin="12,0" VerticalAlignment="Center" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                                         <TextBlock Grid.Column="4" Text="{Binding Description}" Margin="12,0" VerticalAlignment="Center" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                                         <TextBlock Grid.Column="5" Text="{Binding CreatedAtText}" Margin="12,0" VerticalAlignment="Center" Foreground="#475569" />
                                         <StackPanel Grid.Column="6" Margin="12,0" VerticalAlignment="Center" ToolTip="{Binding StatusDetail}">
                                             <TextBlock Text="{Binding StatusLabel}" FontSize="12.5" FontWeight="Medium" Foreground="#2563EB" />
                                         </StackPanel>
                                         <StackPanel Grid.Column="7" Margin="6,0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button ToolTip="查看或编辑" Click="OnOpenChannelDetailClick">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource InlineActionButton}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding OpenActionLabel}" Foreground="#2563EB" FontSize="12" />
                                            </Button>
                                            <Button ToolTip="删除用户配置" Click="OnDeleteProfileClick">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource InlineActionButton}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding CanDelete}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="删除" Foreground="#DC2626" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChannelConfigurations.Profiles.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <TextBlock Grid.Row="1" Text="尚无可用通道配置。请先连接放大器，确认通道标注后再新建配置。"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChannelConfigurations.Profiles.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ChannelConfigurations.StatusText}" FontSize="12.5" Foreground="#64748B" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ChannelConfigurations.Profiles.Count, StringFormat=共 {0} 个配置}" FontSize="12.5" Foreground="#64748B" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
