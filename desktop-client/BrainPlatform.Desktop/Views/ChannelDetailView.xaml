<UserControl x:Class="BrainPlatform.Desktop.Views.ChannelDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 顶部操作按钮基类 -->
            <Style x:Key="HeaderBaseButton" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 蓝色轮廓操作按钮 (复制、编辑) -->
            <Style x:Key="OutlineBlueButton" TargetType="Button" BasedOn="{StaticResource HeaderBaseButton}">
                <Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#BFDBFE" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#2563EB" />
            </Style>

            <!-- 红色轮廓操作按钮 (删除) -->
            <Style x:Key="OutlineRedButton" TargetType="Button" BasedOn="{StaticResource HeaderBaseButton}">
                <Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#FECACA" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#EF4444" />
            </Style>

            <!-- 主要实色按钮 (保存) -->
            <Style x:Key="PrimaryBlueButton" TargetType="Button" BasedOn="{StaticResource HeaderBaseButton}">
                <Setter Property="Background" Value="#2563EB" /><Setter Property="BorderBrush" Value="#2563EB" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 现代化 Toggle Switch 样式 (对齐 UI 图中的胶囊开关) -->
            <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
                <Setter Property="Width" Value="38" /><Setter Property="Height" Value="20" />
                <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Border x:Name="Track" Width="38" Height="20" Background="#CBD5E1" CornerRadius="10" />
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.15" /></Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#1677FF" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 通用现代化输入框样式 -->
            <Style x:Key="ModernInputBox" TargetType="TextBox">
                <Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#0F172A" />
                <Setter Property="FontSize" Value="13" /><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="10,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#1677FF" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC" /><Setter Property="Foreground" Value="#64748B" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 选择设备弹窗专用的现代 ComboBox 样式 -->
            <Style x:Key="DevicePickerComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="38" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#0F172A" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource ModernFilterComboBoxItemStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="DropDownToggle"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Focusable="False"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <Grid Margin="12,0">
                                                    <!-- 下拉小箭头：复刻原图高饱和蓝调精致箭头 -->
                                                    <Path x:Name="Arrow"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Data="M 0,0 L 4.5,4.5 L 9,0"
                                                          Stroke="#1677FF"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#1677FF" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#1677FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- 占位文字：当未选择设备时显示 -->
                                <TextBlock x:Name="PlaceholderText"
                                           Text="请选择设备"
                                           FontSize="13.5"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Margin="12,0,32,0"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />

                                <!-- 选中的设备文本显示 -->
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{x:Null}"
                                                  Margin="12,0,32,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />

                                <!-- 下拉浮层 -->
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder"
                                                Background="#FFFFFF"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,4,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.12" />
                                            </Border.Effect>
                                            <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SelectedItem" Value="{x:Null}">
                                    <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗右上角关闭按钮样式 -->
            <Style x:Key="DialogCloseIconButton" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗底部取消按钮样式 -->
            <Style x:Key="DialogCancelButton" TargetType="Button">
                <Setter Property="Width" Value="76" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#D0D7DE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#1677FF" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#1677FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗底部确定按钮样式 -->
            <Style x:Key="DialogConfirmButton" TargetType="Button">
                <Setter Property="Width" Value="76" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Background" Value="#1677FF" />
                <Setter Property="BorderBrush" Value="#1677FF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4096FF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#BFDBFE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0. 面包屑与顶部操作栏 -->
                    <RowDefinition Height="Auto" /> <!-- 1. 配置基本信息卡片 -->
                    <RowDefinition Height="*" />    <!-- 2. 通道映射列表卡片 -->
                    <RowDefinition Height="Auto" /> <!-- 3. 底部通道数统计 -->
                </Grid.RowDefinitions>

                <!-- 0. 面包屑与顶部标题及操作按钮 -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 面包屑导航 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="28" Padding="8,0" Cursor="Hand">
                            <Button Style="{StaticResource HeaderBaseButton}" Height="26" Padding="0" Background="Transparent" BorderThickness="0" Click="OnBackToChannelListClick" ToolTip="返回列表">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 12,6 L 6,12 L 12,18 M 6,12 L 18,12" Stroke="#334155" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="返回" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <TextBlock Text="›" FontSize="16" Foreground="#94A3B8" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="通道配置" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Text="/" FontSize="13" Foreground="#CBD5E1" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ChannelConfigurations.DraftTitle, FallbackValue='查看配置'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 标题栏与右上角按钮组 -->
                    <Grid Grid.Row="1" Margin="0,14,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="通道配置" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="管理设备的真实输入通道，以及决定哪些通道以什么标签显示。" Margin="0,6,0,0" FontSize="13" Foreground="#64748B" />
                        </StackPanel>

                        <!-- 右上角操作按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 1. 复制配置按钮 -->
                            <Button Style="{StaticResource OutlineBlueButton}" Click="OnCopyConfigurationClick" Margin="0,0,10,0" ToolTip="复制为新配置">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 6,3 H 13 A 2,2 0 0 1 15,5 V 12 M 3,6 H 10 A 2,2 0 0 1 12,8 V 15 A 2,2 0 0 1 10,17 H 3 A 2,2 0 0 1 1,15 V 8 A 2,2 0 0 1 3,6 Z"
                                          Width="14" Height="14" Stretch="Uniform" Stroke="#2563EB" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="复制配置" Foreground="#2563EB" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 2. 保存配置按钮 (在编辑草稿模式下显示) -->
                            <Button Command="{Binding ChannelConfigurations.SaveDraftCommand}" Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryBlueButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChannelConfigurations.CanEditDraft}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="保存配置" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 3. 删除配置按钮 (仅在允许删除时显示) -->
                            <Button Click="OnDeleteConfigurationClick" ToolTip="删除配置">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineRedButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChannelConfigurations.CanDeleteSelected}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 2,5 H 16 M 6,5 V 3 A 1,1 0 0 1 7,2 H 11 A 1,1 0 0 1 12,3 V 5 M 14,5 V 15 A 2,2 0 0 1 12,17 H 6 A 2,2 0 0 1 4,15 V 5 M 7,9 V 13 M 11,9 V 13"
                                          Width="14" Height="14" Stretch="Uniform" Stroke="#EF4444" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="删除配置" Foreground="#EF4444" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 1. 配置基本信息卡片 -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="配置基本信息" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" MinWidth="340" />
                                <ColumnDefinition Width="1*" MinWidth="250" />
                                <ColumnDefinition Width="1.15*" MinWidth="270" />
                            </Grid.ColumnDefinitions>

                            <!-- 左栏：配置名称与配置说明 -->
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="配置名称" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                                        <TextBlock Text="*" Foreground="#EF4444" Margin="2,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource ModernInputBox}" Text="{Binding ChannelConfigurations.DraftName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ChannelConfigurations.CanEditDraft}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="配置说明" FontSize="13" Foreground="#334155" VerticalAlignment="Top" Margin="0,8,0,0" />
                                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="86">
                                        <TextBox Text="{Binding ChannelConfigurations.DraftDescription, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ChannelConfigurations.CanEditDraft}" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#334155" Padding="10,8" VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- 中栏：来源、厂家、型号、通道数等 -->
                            <StackPanel Grid.Column="1" Margin="12,0,20,0">
                                <DockPanel Height="32" Margin="0,0,0,8">
                                    <TextBlock Width="105" Text="配置来源" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3E8FF" />
                                                <Style.Triggers><DataTrigger Binding="{Binding ChannelConfigurations.DraftSourceLabel}" Value="系统默认"><Setter Property="Background" Value="#E0F2FE" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding ChannelConfigurations.DraftSourceLabel}" /><Setter Property="Foreground" Value="#7C3AED" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding ChannelConfigurations.DraftSourceLabel}" Value="系统默认"><Setter Property="Foreground" Value="#0284C7" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>
                                <DockPanel Height="32" Margin="0,0,0,8">
                                    <TextBlock Width="105" Text="设备厂家" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0"><TextBlock Text="{Binding ChannelConfigurations.DraftDeviceVendor}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" /></Border>
                                </DockPanel>
                                <DockPanel Height="32" Margin="0,0,0,8">
                                    <TextBlock Width="105" Text="设备型号" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0"><TextBlock Text="{Binding ChannelConfigurations.DraftDeviceModel}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" /></Border>
                                </DockPanel>
                                <DockPanel Height="32" Margin="0,0,0,8">
                                    <TextBlock Width="105" Text="EEG 输入数" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0"><TextBlock Text="{Binding ChannelConfigurations.DraftEegInputCount}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" /></Border>
                                </DockPanel>
                                <DockPanel Height="32">
                                    <TextBlock Width="105" Text="当前显示通道数" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0"><TextBlock Text="{Binding ChannelConfigurations.DraftEnabledCount}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" /></Border>
                                </DockPanel>
                            </StackPanel>

                            <!-- 右栏：引用数、时间、状态 -->
                            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                <DockPanel Height="32" Margin="0,0,0,8">
                                    <TextBlock Width="145" Text="被引用的导联配置数量" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0"><TextBlock Text="{Binding ChannelConfigurations.DraftMontageReferenceCount}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" /></Border>
                                </DockPanel>
                                <DockPanel Height="32" Margin="0,0,0,8">
                                    <TextBlock Width="145" Text="创建时间" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0"><TextBlock Text="{Binding ChannelConfigurations.DraftCreatedAtText}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" /></Border>
                                </DockPanel>
                                <DockPanel Height="32" Margin="0,0,0,8">
                                    <TextBlock Width="145" Text="最后修改时间" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Padding="10,0"><TextBlock Text="{Binding ChannelConfigurations.DraftUpdatedAtText}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" /></Border>
                                </DockPanel>
                                <DockPanel Height="32">
                                    <TextBlock Width="145" Text="当前状态" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border CornerRadius="10" Padding="12,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChannelConfigurations.IsSignalLockedDraft}" Value="True"><Setter Property="Background" Value="#EFF6FF" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding ChannelConfigurations.DraftStatusLabel}" /><Setter Property="Foreground" Value="#16A34A" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding ChannelConfigurations.IsSignalLockedDraft}" Value="True"><Setter Property="Foreground" Value="#2563EB" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. 通道映射列表卡片 -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <Grid Grid.Row="0" Margin="20,16,20,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="通道映射列表" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ChannelConfigurations.DraftRows.Count, StringFormat=（共 {0} 个通道）}" FontSize="14" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="全部显示" Command="{Binding ChannelConfigurations.ShowAllDraftChannelsCommand}"
                                        Style="{StaticResource OutlineBlueButton}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                        ToolTip="显示当前通道配置中的全部 EEG 通道" />
                                <Button Content="全部关闭" Command="{Binding ChannelConfigurations.HideAllDraftChannelsCommand}"
                                        Style="{StaticResource OutlineBlueButton}" Height="32" Padding="12,0" Margin="0,0,12,0"
                                        ToolTip="关闭当前通道配置中的全部 EEG 通道显示" />
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="32" Width="220" Padding="8,0">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Path Data="M 14,14 L 19,19 M 6.5,12 A 5.5,5.5 0 1 1 12,6.5 A 5.5,5.5 0 0 1 6.5,12 Z" Width="13" Height="13" Stretch="Uniform" Stroke="#94A3B8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="ChannelFilterBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center" Text="{Binding ChannelConfigurations.ChannelSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="1" Text="搜索通道编号或显示标签..." FontSize="12" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ChannelFilterBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 表格主体 -->
                        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <!-- 表头 (浅蓝底色 #F4F8FD) -->
                                <Border Grid.Row="0" Background="#F4F8FD" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <Grid Margin="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.0*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.0*" />
                                            <ColumnDefinition Width="1.0*" />
                                            <ColumnDefinition Width="1.0*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="设备输入编号" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="设备通道类型" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="设备原始单位" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="当前显示标签" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock Text="*" Foreground="#EF4444" Margin="2,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="显示单位" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock Text="*" Foreground="#EF4444" Margin="2,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="5" Text="是否显示" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="6" Text="当前状态" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </Border>

                                <!-- 数据行列表 -->
                                <ListBox Grid.Row="1" BorderThickness="0" Background="#FFFFFF" ItemsSource="{Binding ChannelConfigurations.FilteredDraftRows}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="RowBd" Background="#FFFFFF" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"><ContentPresenter /></Border>
                                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBd" Property="Background" Value="#F8FAFC" /></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="48" Margin="16,0" IsEnabled="{Binding DataContext.ChannelConfigurations.CanEditSignalDraft, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.0*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="1.0*" />
                                                    <ColumnDefinition Width="1.0*" />
                                                    <ColumnDefinition Width="1.0*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding NativeChannelIndex}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Role}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding DeviceUnit}" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="3" Text="{Binding ElectrodeLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Style="{StaticResource ModernInputBox}" Height="32" Margin="0,0,20,0" Padding="8,0" VerticalAlignment="Center" />
                                                <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="32" Margin="0,0,20,0" Padding="8,0">
                                                    <Grid VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayUnit, FallbackValue='µV'}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <CheckBox Grid.Column="5" IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding IsEegInput}" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                <Border Grid.Column="6" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ConfigurationStatus}" FontSize="11.5" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#16A34A" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Foreground" Value="#64748B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="1" Text="请选择设备以读取通道。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" FontSize="13">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ChannelConfigurations.DraftRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- 底部统计 -->
                        <TextBlock Grid.Row="2" Text="{Binding ChannelConfigurations.DraftEnabledCount, StringFormat=已显示 {0} 个 EEG 通道}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="20,14,0,16" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 选择设备弹窗 (严格复刻 UI 设计与业务逻辑联动) -->
        <Grid Panel.ZIndex="100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ChannelConfigurations.IsDevicePickerVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- 保持模态命中拦截，但不把新建通道页面压成灰色。 -->
            <Border Background="Transparent" />

            <!-- 居中浮层卡片 -->
            <Border Width="520" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#0F172A" Opacity="0.14" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- 0. 主体内容区 -->
                        <RowDefinition Height="1" />    <!-- 1. 全宽分割线 -->
                        <RowDefinition Height="Auto" /> <!-- 2. 底部操作栏 -->
                    </Grid.RowDefinitions>

                    <!-- 主体内容区 -->
                    <Grid Grid.Row="0" Margin="28,24,28,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- 标题栏 -->
                            <RowDefinition Height="Auto" /> <!-- 说明提示文字 -->
                            <RowDefinition Height="Auto" /> <!-- 表单：设备选择行 -->
                        </Grid.RowDefinitions>

                        <!-- 标题栏与右上角关闭 X 按钮 -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="选择设备" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            <Button Style="{StaticResource DialogCloseIconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="OnCancelDeviceSelectionClick" ToolTip="关闭">
                                <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="#8E9AAF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>

                        <!-- 说明提示文字 -->
                        <StackPanel Grid.Row="1" Margin="0,14,0,24">
                            <TextBlock Text="选择后自动读取该设备的物理输入和默认电极模板。" FontSize="13.5" Foreground="#475569" LineHeight="20" />
                            <TextBlock Text="未检测到设备时，请先到采集页测试放大器连接。" FontSize="13.5" Foreground="#475569" Margin="0,4,0,0" LineHeight="20" />
                        </StackPanel>

                        <!-- 表单：设备选择行 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="设备" FontSize="13.5" Foreground="#334155" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="DevicePickerComboBox"
                                      ItemsSource="{Binding Acquisition.Devices}"
                                      SelectedItem="{Binding ChannelConfigurations.PendingDeviceSelection, Mode=TwoWay}"
                                      Style="{StaticResource DevicePickerComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Grid>

                    <!-- 全宽分割线 -->
                    <Border Grid.Row="1" Background="#F1F5F9" />

                    <!-- 底部操作按钮 -->
                    <Border Grid.Row="2" Padding="28,14,28,16" Background="#FFFFFF">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- 取消按钮 -->
                            <Button Style="{StaticResource DialogCancelButton}"
                                    Click="OnCancelDeviceSelectionClick"
                                    Margin="0,0,12,0"
                                    Content="取消"
                                    ToolTip="取消" />
                            <!-- 确定按钮 -->
                            <Button Style="{StaticResource DialogConfirmButton}"
                                    Command="{Binding ChannelConfigurations.ConfirmDeviceSelectionCommand}"
                                    IsEnabled="{Binding ChannelConfigurations.HasPendingDeviceSelection}"
                                    Content="确定"
                                    ToolTip="确定" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
