<Window x:Class="BrainPlatform.Desktop.Views.ProjectEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目设置" Width="620" Height="610" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{Binding DialogTitle}" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock Text="项目目录保存原始采集及后续产物；修改名称不会移动目录。"
                       Margin="0,6,0,0" Foreground="#64748B" FontSize="12.5" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                    <TextBlock Text="项目名称 *" Foreground="#334155" FontSize="12.5" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Padding="9,7" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,14">
                    <TextBlock Text="说明" Foreground="#334155" FontSize="12.5" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                             Padding="9,7" Height="62" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,14">
                    <TextBlock Text="研究目的" Foreground="#334155" FontSize="12.5" />
                    <TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Padding="9,7" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,14">
                    <TextBlock Text="项目标签" Foreground="#334155" FontSize="12.5" />
                    <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Padding="9,7"
                             ToolTip="多个标签使用逗号分隔" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,14">
                    <TextBlock Text="创建者" Foreground="#334155" FontSize="12.5" />
                    <TextBox Text="{Binding Creator, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Padding="9,7" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                    <TextBlock Text="项目目录 *" Foreground="#334155" FontSize="12.5" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}" Padding="9,7" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="选择目录" Margin="10,0,0,0" Padding="14,7" Click="OnBrowseDirectoryClick" />
                    </Grid>
                    <TextBlock Text="每次采集会写入该目录下的 recordings 子目录。" Margin="0,6,0,0"
                               Foreground="#64748B" FontSize="11.5" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="86" Height="34" Margin="0,0,10,0" IsCancel="True" />
                <Button Content="保存项目" Width="100" Height="34" IsDefault="True" Click="OnSaveClick"
                        Style="{StaticResource ModernDialogPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
