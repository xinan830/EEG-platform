<Window x:Class="BrainPlatform.Desktop.Views.ProjectEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Width="740" Height="780" MinWidth="660" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" WindowStyle="None"
        Background="#FFFFFF" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 现代化筛选下拉框样式 -->
            <Style x:Key="ModernFilterComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,0,28,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <Grid>
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          IsHitTestVisible="False" />
                                        <Path x:Name="Arrow"
                                              Data="M 1,1.5 L 5,5.5 L 9,1.5"
                                              Stroke="#64748B"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <ToggleButton x:Name="ToggleButton"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       PopupAnimation="Fade"
                                       VerticalOffset="4"
                                       Focusable="False">
                                    <Border x:Name="DropDownBorder"
                                            Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Padding="4,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08" />
                                        </Border.Effect>
                                        <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8" /></Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#1677FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Height" Value="32" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="FontSize" Value="12.5" />
                            <Setter Property="Foreground" Value="#334155" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#0F172A" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                                                <Setter Property="Foreground" Value="#1677FF" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 标签胶囊样式 -->
            <Style x:Key="TagPillBorder" TargetType="Border">
                <Setter Property="Background" Value="#EFF6FF" />
                <Setter Property="BorderBrush" Value="#DBEAFE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 顶部标题与关闭按钮 -->
            <RowDefinition Height="*" />    <!-- 表单可滚动主体 -->
            <RowDefinition Height="Auto" /> <!-- 底部操作按钮栏 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" MouseLeftButtonDown="OnTitleAreaMouseLeftButtonDown">
                <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="填写项目基本信息，用于组织 EEG 采集数据与研究记录。" Margin="0,6,0,0" Foreground="#64748B" FontSize="13" />
            </StackPanel>

            <!-- 右上角关闭 X 按钮 -->
            <Button Grid.Column="1" Style="{StaticResource ModernCloseCrossButtonStyle}" IsCancel="True"
                    HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="关闭" />
        </Grid>

        <!-- 2. 表单主体 (严格复刻图片结构与自适应对齐) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <!-- Row 1: 项目名称 与 项目目录 (自适应双列) -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- 项目名称 -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="项目名称" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" />
                            <TextBlock Text=" *" FontSize="13" FontWeight="Bold" Foreground="#EF4444" Margin="2,0,0,0" />
                        </StackPanel>
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                            <Grid VerticalAlignment="Center">
                                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                                <TextBlock Text="请输入项目名称" FontSize="13" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 项目目录 -->
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="项目目录" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" />
                            <TextBlock Text=" *" FontSize="13" FontWeight="Bold" Foreground="#EF4444" Margin="2,0,0,0" />
                        </StackPanel>
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="36">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DirPathBox" Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="10,0"
                                         FontSize="13" Foreground="#0F172A" IsReadOnly="True" />
                                <TextBlock Text="请选择项目目录" FontSize="13" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=DirPathBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Padding="0" BorderThickness="1,0,0,0" BorderBrush="#E2E8F0" Background="Transparent"
                                        Click="OnBrowseDirectoryClick" ToolTip="浏览选择目录" Cursor="Hand">
                                    <!-- 用 Border 组合文件夹，避免 Path 几何在当前按钮模板内被裁剪成横线。 -->
                                    <Grid Width="18" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="9" Height="5" Background="#DBEAFE" BorderBrush="#1677FF" BorderThickness="1.4,1.4,1.4,0"
                                                CornerRadius="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0" />
                                        <Border Height="11" Background="#EFF6FF" BorderBrush="#1677FF" BorderThickness="1.4" CornerRadius="2"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 2: 说明 (多行输入 + 字数统计) -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="说明" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Grid>
                            <TextBox x:Name="DescBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" Height="58"
                                     BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0F172A" />
                            <TextBlock Text="请输入项目的简要说明（如研究内容、对象、方法等）" FontSize="13" Foreground="#94A3B8"
                                       IsHitTestVisible="False" VerticalAlignment="Top" Margin="2,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=DescBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Text.Length, ElementName=DescBox, StringFormat={}{0}/500}"
                                       FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Row 3: 研究目的 (多行输入 + 字数统计) -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="研究目的" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Grid>
                            <TextBox x:Name="PurposeBox" Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" Height="58"
                                     BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0F172A" />
                            <TextBlock Text="请输入本项目的研究目的、预期目标或研究问题" FontSize="13" Foreground="#94A3B8"
                                       IsHitTestVisible="False" VerticalAlignment="Top" Margin="2,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PurposeBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Text.Length, ElementName=PurposeBox, StringFormat={}{0}/500}"
                                       FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Row 4: 项目标签、创建者、项目状态 (三列复合布局) -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- 项目标签 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="项目标签" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                            <Grid VerticalAlignment="Center">
                                <TextBox x:Name="TagsBox" Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnTagInputKeyDown"
                                         BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" Foreground="#0F172A" />
                                <TextBlock Text="请输入标签，按回车添加" FontSize="13" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TagsBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TagPillBorder}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#2563EB" FontWeight="Medium" />
                                            <Button Content="×" Tag="{Binding}" Click="OnRemoveTagClick" Background="Transparent" BorderThickness="0"
                                                    Padding="4,0,0,0" FontSize="13" Foreground="#3B82F6" Cursor="Hand" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 创建者 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="创建者" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="36" Padding="12,0">
                            <TextBox Text="{Binding Creator, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" Foreground="#0F172A" />
                        </Border>
                    </StackPanel>

                    <!-- 项目状态 -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="项目状态" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                        <ComboBox Style="{StaticResource ModernFilterComboBox}"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding Status, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <!-- Row 5: 备注 (多行输入 + 字数统计) -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="备注" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Grid>
                            <TextBox x:Name="NotesBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" Height="50"
                                     BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0F172A" />
                            <TextBlock Text="请输入其他补充信息（可选）" FontSize="13" Foreground="#94A3B8"
                                       IsHitTestVisible="False" VerticalAlignment="Top" Margin="2,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NotesBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Text.Length, ElementName=NotesBox, StringFormat={}{0}/500}"
                                       FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. 底部操作按钮栏 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <!-- 错误提示信息 -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />

            <!-- 取消与确定按钮组 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="取消" Width="104" Height="36" Padding="0" Margin="0,0,12,0" IsCancel="True"
                        Style="{StaticResource ModernDialogSecondaryButtonStyle}" />
                <Button Width="120" Height="36" Padding="0" IsDefault="True" Click="OnSaveClick"
                        Style="{StaticResource ModernDialogPrimaryButtonStyle}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="创建项目" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DialogTitle}" Value="项目设置">
                                        <Setter Property="Text" Value="保存设置" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
