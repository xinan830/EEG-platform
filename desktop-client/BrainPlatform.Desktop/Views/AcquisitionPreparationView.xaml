<UserControl x:Class="BrainPlatform.Desktop.Views.AcquisitionPreparationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:InputRangeVoltageConverter x:Key="InputRangeVoltageConverter" />

            <!-- 准备页下拉选择框统一高度 40px，兼顾单屏密度与点击面积。 -->
            <Style x:Key="PreparationComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppFilterComboBoxStyle}">
                <Setter Property="Height" Value="40" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,24,36,28" MaxWidth="1480" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 1. 页面标题、返回与说明 -->
                <RowDefinition Height="Auto" /> <!-- 2. 双卡片区域（当前项目 + 设备状态） -->
                <RowDefinition Height="Auto" /> <!-- 3. 配置设置卡片 -->
                <RowDefinition Height="Auto" /> <!-- 4. 底部操作栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 返回操作与标题放在同一标题行 -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BackNavigationIconButtonStyle}" Click="OnBackClick"
                            VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="返回项目">
                        <Path Data="M 14,8 L 4,8 M 8,4 L 4,8 L 8,12"
                              Stroke="#475569" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Text="采集准备" FontSize="27" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="请确认项目信息、设备状态及采集配置，完成后进入实时采集。"
                           Margin="0,6,0,0" FontSize="14" Foreground="#64748B" LineHeight="21" />
            </Grid>

            <!-- 3. 双卡片区域（并排两列，间距 20px） -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- 左卡片：当前项目 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 头部：图标 + 标题 + 查看项目按钮 -->
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border Width="36" Height="36" Background="#EFF6FF" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M 2,4 C 2,2.9 2.9,2 4,2 H 8 L 10,4 H 16 C 17.1,4 18,4.9 18,6 V 14 C 18,15.1 17.1,16 16,16 H 4 C 2.9,16 2,15.1 2,14 Z"
                                          Width="18" Height="16" Stretch="Uniform" Stroke="#1677FF" Fill="Transparent" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="当前项目" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 查看项目 按钮 -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnViewProjectClick" Cursor="Hand" Height="28" Padding="10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 1,9 C 1,9 4,3 10,3 C 16,3 19,9 19,9 C 19,9 16,15 10,15 C 4,15 1,9 1,9 Z M 10,12 C 11.66,12 13,10.66 13,9 C 13,7.34 11.66,6 10,6 C 8.34,6 7,7.34 7,9 C 7,10.66 8.34,12 10,12 Z"
                                          Width="13" Height="13" Stretch="Uniform" Stroke="#64748B" StrokeThickness="1.3" Fill="Transparent"
                                          VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="查看项目" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 项目字段列表 -->
                        <Grid Grid.Row="1" Margin="2,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="项目名称" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Acquisition.ProjectNameText}"
                                   FontSize="14.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="项目编号" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Acquisition.ProjectNumberText}"
                                   FontSize="14" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="项目目录" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Acquisition.ProjectDirectoryText}"
                                   FontSize="14" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Acquisition.ProjectDirectoryText}" />
                        </Grid>

                        <!-- 蓝色提示条 -->
                        <Border Grid.Row="2" Background="#EFF6FF" CornerRadius="6" Padding="12,9" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 11,7 H 13 V 9 H 11 V 7 Z M 11,11 H 13 V 17 H 11 V 11 Z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="本次原始 EEG 数据会保存到该项目下。" FontSize="13" Foreground="#2563EB" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右卡片：设备状态 -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 头部：图标 + 标题 + 连接状态徽章 -->
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border Width="36" Height="36" Background="#EFF6FF" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M 2,4 C 2,2.9 2.9,2 4,2 H 16 C 17.1,2 18,2.9 18,4 V 13 C 18,14.1 17.1,15 16,15 H 2 C 0.9,15 0,14.1 0,13 V 4 Z M 6,18 H 12 M 9,15 V 18"
                                          Width="18" Height="17" Stretch="Uniform" Stroke="#1677FF" Fill="Transparent" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="设备状态" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 连接状态徽章 -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12" Padding="10,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FEF2F2" />
                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Acquisition.DeviceConnectionStatusText}" Value="已连接">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                                <Setter Property="BorderBrush" Value="#A7F3D0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#EF4444" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Acquisition.DeviceConnectionStatusText}" Value="已连接">
                                                        <Setter Property="Fill" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                <TextBlock Text="{Binding Acquisition.DeviceConnectionStatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#DC2626" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Acquisition.DeviceConnectionStatusText}" Value="已连接">
                                                        <Setter Property="Foreground" Value="#059669" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 设备字段列表（5行数据，必须完整定义5个RowDefinition） -->
                        <Grid Grid.Row="1" Margin="2,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="设备厂家" FontSize="13.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Acquisition.DeviceVendorText}" FontSize="13.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="设备型号" FontSize="13.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Acquisition.DeviceModelText}" FontSize="13.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="实例/序列号" FontSize="13.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Acquisition.DeviceSerialNumberText}" FontSize="13.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,0,10"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Acquisition.DeviceSerialNumberText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="可用采样率" FontSize="13.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Acquisition.SupportedSamplingRatesText}" FontSize="13.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,0,10"
                                       TextWrapping="Wrap" LineHeight="20" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="输入能力" FontSize="13.5" Foreground="#64748B" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Acquisition.DeviceInputCapabilitySummary}" FontSize="13.5" Foreground="#334155" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="20" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. 配置设置卡片 -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <!-- 卡片头部：图标 + 标题 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,22">
                        <Border Width="36" Height="36" Background="#EFF6FF" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="M 19.4,13 C 19.4,12.7 19.5,12.3 19.5,12 C 19.5,11.7 19.4,11.3 19.4,11 L 21.5,9.3 C 21.7,9.1 21.8,8.8 21.6,8.6 L 19.6,5.1 C 19.5,4.9 19.2,4.8 19,4.9 L 16.5,5.9 C 16,5.5 15.4,5.2 14.8,5 L 14.4,2.3 C 14.4,2 14.2,1.8 13.9,1.8 H 9.9 C 9.6,1.8 9.4,2 9.4,2.3 L 9,5 C 8.4,5.2 7.8,5.5 7.3,5.9 L 4.8,4.9 C 4.6,4.8 4.3,4.9 4.2,5.1 L 2.2,8.6 C 2,8.8 2.1,9.1 2.3,9.3 L 4.4,11 C 4.4,11.3 4.3,11.7 4.3,12 C 4.3,12.3 4.4,12.7 4.4,13 L 2.3,14.7 C 2.1,14.9 2,15.2 2.2,15.4 L 4.2,18.9 C 4.3,19.1 4.6,19.2 4.8,19.1 L 7.3,18.1 C 7.8,18.5 8.4,18.8 9,19 L 9.4,21.7 C 9.4,22 9.6,22.2 9.9,22.2 H 13.9 C 14.2,22.2 14.4,22 14.4,21.7 L 14.8,19 C 15.4,18.8 16,18.5 16.5,18.1 L 19,19.1 C 19.2,19.2 19.5,19.1 19.6,18.9 L 21.6,15.4 C 21.8,15.2 21.7,14.9 21.5,14.7 L 19.4,13 Z M 12,15.5 C 10.1,15.5 8.5,13.9 8.5,12 C 8.5,10.1 10.1,8.5 12,8.5 C 13.9,8.5 15.5,10.1 15.5,12 C 15.5,13.9 13.9,15.5 12,15.5 Z"
                                  Width="18" Height="18" Stretch="Uniform" Stroke="#1677FF" Fill="Transparent" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="配置设置" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 第一行：导联配置 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧说明 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="导联配置" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="仅显示与当前设备、通道配置兼容的导联配置。" FontSize="13" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>

                        <!-- 中间下拉选择框 -->
                        <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                  ItemsSource="{Binding MontageConfigurations.AvailableForAcquisition}"
                                  SelectedItem="{Binding Acquisition.SelectedMontageProfile, Mode=TwoWay}"
                                  Style="{StaticResource PreparationComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- 右侧只读信息卡片 -->
                        <Border Grid.Column="3" Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="6" Padding="14,10" VerticalAlignment="Center">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="关联通道配置：" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Acquisition.SelectedMontageChannelConfigurationName}" FontSize="13" Foreground="#0F172A" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="输出导联数：" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Acquisition.SelectedMontageOutputChannelCount}" FontSize="13" Foreground="#0F172A" FontWeight="Medium" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 分割线 -->
                    <Border Height="1" Background="#F1F5F9" Margin="0,20" />

                    <!-- 第二行：采样率 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧说明 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="采样率" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="下拉选项来自当前连接设备支持的采样率。" FontSize="13" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>

                        <!-- 中间下拉选择框 -->
                        <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                  ItemsSource="{Binding Acquisition.SamplingRatesHz}"
                                  SelectedItem="{Binding Acquisition.SelectedSamplingRateHz, Mode=TwoWay}"
                                  Style="{StaticResource PreparationComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0} Hz}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- 分割线 -->
                    <Border Height="1" Background="#F1F5F9" Margin="0,20" />

                    <!-- 第三行：量程设置 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧说明 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="量程设置" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="根据当前设备真实能力提供可选量程，两者组合必须兼容。" FontSize="13" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>

                        <!-- 中间量程区：默认只读；只有进入编辑状态才能更改设备量程。 -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <!-- 自动/已确认量程：不可直接编辑 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Acquisition.IsEditingInputRanges}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="参考输入" FontSize="13" Foreground="#64748B" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Acquisition.ReferenceInputRangeText}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="双极输入" FontSize="13" Foreground="#64748B" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Acquisition.BipolarInputRangeText}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                </StackPanel>
                            </Grid>

                            <!-- 手动编辑：可选项仍完全来自已连接设备。 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Acquisition.IsEditingInputRanges}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="参考输入量程" FontSize="13" Foreground="#64748B" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding Acquisition.ReferenceRangesVolts}"
                                              SelectedItem="{Binding Acquisition.SelectedReferenceRangeVolts, Mode=TwoWay}"
                                              Style="{StaticResource PreparationComboBoxStyle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource InputRangeVoltageConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="双极输入量程" FontSize="13" Foreground="#64748B" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding Acquisition.BipolarRangesVolts}"
                                              SelectedItem="{Binding Acquisition.SelectedBipolarRangeVolts, Mode=TwoWay}"
                                              Style="{StaticResource PreparationComboBoxStyle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource InputRangeVoltageConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 右侧操作：自动状态下只允许显式进入编辑；编辑时须确认或取消。 -->
                        <Grid Grid.Column="3" VerticalAlignment="Center">
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Acquisition.IsEditingInputRanges}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding Acquisition.InputRangeSelectionModeText}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="默认采用设备支持的首组合法兼容量程。" FontSize="13" Foreground="#64748B" Margin="0,4,0,10" TextWrapping="Wrap" LineHeight="20" />
                                <Button Content="编辑量程" Command="{Binding Acquisition.BeginInputRangeEditCommand}"
                                        IsEnabled="{Binding Acquisition.CanEditInputRanges}"
                                        Style="{StaticResource ModernDialogSecondaryButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Acquisition.IsEditingInputRanges}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="取消" Command="{Binding Acquisition.CancelInputRangeEditCommand}"
                                        Style="{StaticResource ModernDialogSecondaryButtonStyle}" />
                                <Button Content="确认" Command="{Binding Acquisition.ConfirmInputRangeEditCommand}"
                                        IsEnabled="{Binding Acquisition.CanConfirmInputRangeEdit}"
                                        Style="{StaticResource ModernDialogPrimaryButtonStyle}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. 底部操作栏 -->
            <Grid Grid.Row="3" Margin="0,4,0,16">
                <!-- 左侧状态与提示信息 -->
                <TextBlock Text="{Binding Acquisition.OperationMessage}" Foreground="#64748B"
                           FontSize="13.5" VerticalAlignment="Center" HorizontalAlignment="Left"
                           TextWrapping="Wrap" LineHeight="20" MaxWidth="680" />

                <!-- 右侧操作按钮组 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 返回项目 按钮 -->
                    <Button Click="OnBackClick" Height="40" Width="110" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="#334155" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="12,0">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="返回项目" VerticalAlignment="Center" />
                    </Button>

                    <!-- 进入实时采集 按钮 -->
                    <Button Click="OnStartClick" IsEnabled="{Binding Acquisition.CanStart}" Height="40" Width="155" Margin="12,0,0,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1677FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontSize" Value="14.5" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="16,0">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#4096FF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0958D9" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Background" Value="#BFDBFE" />
                                                    <Setter Property="Foreground" Value="#EFF6FF" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="进入实时采集" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Acquisition.IsPreparationStartInProgress}" Value="True">
                                                <Setter Property="Text" Value="正在进入..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Path Data="M 1,6 H 11 M 7,2 L 11,6 L 7,10" Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
