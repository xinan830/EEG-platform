<UserControl x:Class="BrainPlatform.Desktop.Views.AcquisitionPreparationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BrainPlatform.Desktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:InputRangeVoltageConverter x:Key="InputRangeVoltageConverter" />

            <!-- 返回项目轻量按钮样式 -->
            <Style x:Key="OutlineNavBtn" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 现代化筛选下拉框样式 -->
            <Style x:Key="ModernFilterComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="38" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,0,28,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <Grid>
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          IsHitTestVisible="False" />
                                        <Path x:Name="Arrow"
                                              Data="M 1,1.5 L 5,5.5 L 9,1.5"
                                              Stroke="#64748B"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <ToggleButton x:Name="ToggleButton"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       PopupAnimation="Fade"
                                       VerticalOffset="4"
                                       Focusable="False">
                                    <Border x:Name="DropDownBorder"
                                            Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Padding="4,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08" />
                                        </Border.Effect>
                                        <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8" /></Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#1677FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Height" Value="32" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="FontSize" Value="12.5" />
                            <Setter Property="Foreground" Value="#334155" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#0F172A" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                                                <Setter Property="Foreground" Value="#1677FF" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,28,36,28" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 1. 返回导航按钮 -->
                <RowDefinition Height="Auto" /> <!-- 2. 页面主标题与说明 -->
                <RowDefinition Height="Auto" /> <!-- 3. 当前项目卡片 -->
                <RowDefinition Height="Auto" /> <!-- 4. 配置设置卡片 -->
                <RowDefinition Height="Auto" /> <!-- 5. 底部操作栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 返回导航按钮 -->
            <Button Grid.Row="0" Style="{StaticResource OutlineNavBtn}" Click="OnBackClick" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 12,4 L 4,12 L 12,20 M 4,12 L 20,12" Width="12" Height="12" Stretch="Uniform"
                          Stroke="#334155" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="返回项目" FontSize="13" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 2. 页面主标题与说明 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 脉冲波形图标 -->
                    <Path Data="M 1,10 L 5,10 L 8,3 L 13,17 L 17,7 L 20,13 L 22,10 L 26,10"
                          Width="22" Height="22" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="2.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="采集准备" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="确认本次项目、导联、采样率与输入量程；进入实时采集后仅启动预览，点击“开始记录”才会创建原始记录。" Margin="0,6,0,0" FontSize="13" Foreground="#64748B" />
            </StackPanel>

            <!-- 3. 当前项目卡片 (严格复刻图片设计) -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <!-- 卡片标题 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="M 2,4 C 2,2.9 2.9,2 4,2 H 8 L 10,4 H 16 C 17.1,4 18,4.9 18,6 V 14 C 18,15.1 17.1,16 16,16 H 4 C 2.9,16 2,15.1 2,14 Z"
                              Width="18" Height="16" Stretch="Uniform" Stroke="#1677FF" Fill="Transparent" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="当前项目" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 项目字段列表 -->
                    <Grid Margin="2,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 项目名称 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="项目名称：" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Acquisition.SelectedProject.Name, TargetNullValue=未选择项目, FallbackValue=未选择项目}"
                                   FontSize="13.5" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,0,10" />

                        <!-- 项目编号 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="项目编号：" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Acquisition.SelectedProject.Number, TargetNullValue=未生成, FallbackValue=未生成}"
                                   FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,0,10" />

                        <!-- 项目目录 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="项目目录：" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Acquisition.SelectedProject.DirectoryPath, TargetNullValue=未配置目录, FallbackValue=未配置目录}"
                                   FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Acquisition.SelectedProject.DirectoryPath}" />
                    </Grid>

                    <!-- 蓝色数据归属提示条 -->
                    <Border Background="#EFF6FF" CornerRadius="6" Padding="14,10" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 11,7 H 13 V 9 H 11 V 7 Z M 11,11 H 13 V 17 H 11 V 11 Z"
                                  Width="15" Height="15" Stretch="Uniform" Fill="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="本次原始 EEG 数据会保存到该项目下。" FontSize="12.5" Foreground="#2563EB" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. 采集配置卡片 -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <!-- 卡片标题 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                        <Path Data="M 19.4,13 C 19.4,12.7 19.5,12.3 19.5,12 C 19.5,11.7 19.4,11.3 19.4,11 L 21.5,9.3 C 21.7,9.1 21.8,8.8 21.6,8.6 L 19.6,5.1 C 19.5,4.9 19.2,4.8 19,4.9 L 16.5,5.9 C 16,5.5 15.4,5.2 14.8,5 L 14.4,2.3 C 14.4,2 14.2,1.8 13.9,1.8 H 9.9 C 9.6,1.8 9.4,2 9.4,2.3 L 9,5 C 8.4,5.2 7.8,5.5 7.3,5.9 L 4.8,4.9 C 4.6,4.8 4.3,4.9 4.2,5.1 L 2.2,8.6 C 2,8.8 2.1,9.1 2.3,9.3 L 4.4,11 C 4.4,11.3 4.3,11.7 4.3,12 C 4.3,12.3 4.4,12.7 4.4,13 L 2.3,14.7 C 2.1,14.9 2,15.2 2.2,15.4 L 4.2,18.9 C 4.3,19.1 4.6,19.2 4.8,19.1 L 7.3,18.1 C 7.8,18.5 8.4,18.8 9,19 L 9.4,21.7 C 9.4,22 9.6,22.2 9.9,22.2 H 13.9 C 14.2,22.2 14.4,22 14.4,21.7 L 14.8,19 C 15.4,18.8 16,18.5 16.5,18.1 L 19,19.1 C 19.2,19.2 19.5,19.1 19.6,18.9 L 21.6,15.4 C 21.8,15.2 21.7,14.9 21.5,14.7 L 19.4,13 Z M 12,15.5 C 10.1,15.5 8.5,13.9 8.5,12 C 8.5,10.1 10.1,8.5 12,8.5 C 13.9,8.5 15.5,10.1 15.5,12 C 15.5,13.9 13.9,15.5 12,15.5 Z"
                              Width="18" Height="18" Stretch="Uniform" Stroke="#1677FF" Fill="Transparent" StrokeThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="采集配置" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 三列配置网格 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <!-- 列 1: 导联配置选择 -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <Path Data="M 12,2 L 21,7 L 21,17 L 12,22 L 3,17 L 3,7 Z M 12,2 V 12 M 12,12 L 21,7 M 12,12 L 3,7"
                                      Width="15" Height="15" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="导联配置选择" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>

                            <ComboBox ItemsSource="{Binding MontageConfigurations.AvailableForAcquisition}"
                                      SelectedItem="{Binding Acquisition.SelectedMontageProfile, Mode=TwoWay}"
                                      DisplayMemberPath="Name" Height="38" Style="{StaticResource ModernFilterComboBox}" />

                            <TextBlock Text="仅显示与当前设备和通道配置兼容的导联配置。" Margin="0,8,0,12" FontSize="12" Foreground="#64748B" />

                            <!-- 灰色只读通道与导联信息框 -->
                            <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="关联通道配置：" FontSize="12.5" Foreground="#64748B" />
                                        <TextBlock Text="{Binding Acquisition.SelectedMontageChannelConfigurationName}" FontSize="12.5" Foreground="#0F172A" FontWeight="Medium" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="输出导联数：" FontSize="12.5" Foreground="#64748B" />
                                        <TextBlock Text="{Binding Acquisition.SelectedMontageOutputChannelCount}" FontSize="12.5" Foreground="#0F172A" FontWeight="Medium" Margin="4,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 列 2: 采样率选择 -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <Path Data="M 1,8 L 4,8 L 6,3 L 9,13 L 12,6 L 14,10 L 16,8 L 19,8"
                                      Width="15" Height="15" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="采样率选择" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>

                            <ComboBox ItemsSource="{Binding Acquisition.SamplingRatesHz}"
                                      SelectedItem="{Binding Acquisition.SelectedSamplingRateHz, Mode=TwoWay}"
                                      Height="38" Style="{StaticResource ModernFilterComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StringFormat={}{0} Hz}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="下拉选项来自当前设备支持的采样率。" Margin="0,8,0,0" FontSize="12" Foreground="#64748B" />
                        </StackPanel>

                        <!-- 列 3: 设备输入量程。默认只读；用户点编辑后才显示可选量程。 -->
                        <StackPanel Grid.Column="4">
                            <!-- 标题行：图标 + 标题 + 模式状态徽标 + 右侧精致编辑按钮 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 2,14 V 18 M 6,9 V 18 M 10,4 V 18 M 14,11 V 18"
                                          Width="15" Height="15" Stretch="Uniform" Stroke="#1677FF" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="设备输入量程" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <!-- 模式徽标 (自动选择 / 手动设置) -->
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Acquisition.InputRangeSelectionModeText}" FontSize="11.5" FontWeight="Medium" Foreground="#1677FF" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding Acquisition.BeginInputRangeEditCommand}"
                                        IsEnabled="{Binding Acquisition.CanEditInputRanges}" Height="28" Padding="10,0" Cursor="Hand" ToolTip="修改设备量程">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F8FAFC" />
                                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="#334155" />
                                            <Setter Property="FontSize" Value="12.5" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                                                                <Setter Property="Foreground" Value="#1677FF" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Acquisition.IsEditingInputRanges}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 11,2 L 14,5 L 5,14 L 2,14 L 2,11 Z" Width="11" Height="11" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="编辑" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 只读卡片容器：呈现双通道量程数据展示块 -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Acquisition.IsEditingInputRanges}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- 双通道量程卡片 -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 参考输入 -->
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="参考输入" FontSize="12.5" Foreground="#64748B" />
                                            <TextBlock Text="{Binding Acquisition.ReferenceInputRangeText}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- 中间浅分割线 -->
                                        <Border Grid.Column="1" Background="#E2E8F0" VerticalAlignment="Stretch" Margin="0,2" />

                                        <!-- 双极输入 -->
                                        <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                            <TextBlock Text="双极输入" FontSize="12.5" Foreground="#64748B" />
                                            <TextBlock Text="{Binding Acquisition.BipolarInputRangeText}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 底部锁定提示行 -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                    <Path Data="M 3,6 V 4.5 A 3,3 0 0 1 9,4.5 V 6 M 1.5,6 H 10.5 V 11.5 H 1.5 Z"
                                          Width="11" Height="12" Stretch="Uniform" Stroke="#94A3B8" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="量程来自当前设备；进入实时采集后将锁定。" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 编辑状态：候选量程由设备 SDK 返回，双极量程会随参考量程自动过滤为兼容组合。 -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Acquisition.IsEditingInputRanges}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="参考输入量程" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding Acquisition.ReferenceRangesVolts}"
                                                  SelectedItem="{Binding Acquisition.SelectedReferenceRangeVolts, Mode=TwoWay}"
                                                  Height="38" Style="{StaticResource ModernFilterComboBox}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource InputRangeVoltageConverter}}" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="双极输入量程" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding Acquisition.BipolarRangesVolts}"
                                                  SelectedItem="{Binding Acquisition.SelectedBipolarRangeVolts, Mode=TwoWay}"
                                                  Height="38" Style="{StaticResource ModernFilterComboBox}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource InputRangeVoltageConverter}}" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button Content="取消" Command="{Binding Acquisition.CancelInputRangeEditCommand}" Width="64" Height="30"
                                            Style="{StaticResource ModernDialogSecondaryButtonStyle}" />
                                    <Button Content="确认" Command="{Binding Acquisition.ConfirmInputRangeEditCommand}" Width="64" Height="30" Margin="8,0,0,0"
                                            Style="{StaticResource ModernDialogPrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. 底部操作栏 (左侧状态提示，右侧主要与次要操作按钮) -->
            <Grid Grid.Row="4" Margin="0,0,0,16">
                <!-- 业务状态诊断提示 -->
                <TextBlock Text="{Binding Acquisition.OperationMessage}" MaxWidth="600" Foreground="#64748B"
                           TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Left" />

                <!-- 操作按钮组 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="返回项目" Width="110" Height="40" Click="OnBackClick"
                            Style="{StaticResource ModernDialogSecondaryButtonStyle}" />
                    <Button Content="进入实时采集" Width="140" Height="40" Margin="16,0,0,0" Click="OnStartClick"
                            IsEnabled="{Binding Acquisition.CanStart}"
                            Style="{StaticResource ModernDialogPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
