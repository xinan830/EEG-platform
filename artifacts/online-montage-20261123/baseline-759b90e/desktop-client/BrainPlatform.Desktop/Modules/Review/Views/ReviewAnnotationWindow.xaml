<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.ReviewAnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="事件标记" Width="384" Height="620" MinWidth="360" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Background="White" FontSize="13" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="5" CornerRadius="8"
                            GlassFrameThickness="1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/WorkspaceStyles.xaml" />
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Shared/Styles/InstrumentWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="EventActionStyle" TargetType="Button" BasedOn="{StaticResource AppCompactActionButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Foreground" Value="#475569" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
            </Style>
            <Style x:Key="EventPrimaryStyle" TargetType="Button" BasedOn="{StaticResource EventActionStyle}">
                <Setter Property="Height" Value="40" />
                <Setter Property="Background" Value="{StaticResource BlueBrandPrimaryBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource BlueBrandPrimaryBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="EventToggleStyle" TargetType="Button" BasedOn="{StaticResource EventActionStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEventEditorOpen}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BlueBrandSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BlueBrandPrimaryBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource BlueBrandPrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="PanelSurface" BorderBrush="#DCE3ED" BorderThickness="1" Background="White" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="27" /></Grid.RowDefinitions>
            <Border Background="#F8FAFC" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="14,0,8,0">
                <DockPanel LastChildFill="True">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource ModernCloseCrossButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick"
                            ToolTip="关闭事件标记" AutomationProperties.Name="关闭事件标记" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BlueBrandSoftBrush}" Margin="0,0,9,0">
                            <Path Data="M 3,1 L 3,15 M 3,2 L 12,2 L 10,6 L 12,10 L 3,10" Stroke="{StaticResource BlueBrandPrimaryBrush}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Width="13" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="事件标记" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BlueBrandDeepBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,18,20,16">
                <StackPanel>


                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding RecordingEventOptions.Count, StringFormat={}{0} 项}" Foreground="#94A3B8" FontSize="12" />
                        <TextBlock Text="已标记事件" FontSize="15" Foreground="#334155" FontWeight="SemiBold" />
                    </DockPanel>
                    <Border x:Name="HistoryEmptyState" Background="#F8FAFC" CornerRadius="8" Padding="14,22">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                            <DataTrigger Binding="{Binding RecordingEventOptions.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="暂无事件标记" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" />
                            <TextBlock Text="还没有标记；可在下方添加新事件" Foreground="#94A3B8" FontSize="12" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="HistoryControls">
                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                            <DataTrigger Binding="{Binding RecordingEventOptions.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></StackPanel.Style>
                        <ComboBox x:Name="HistorySelector" Style="{StaticResource AppFilterComboBoxStyle}" Height="40" FontSize="13"
                                  ItemsSource="{Binding RecordingEventOptions}" SelectedValuePath="Event"
                                  SelectedValue="{Binding SelectedRecordingEvent, Mode=TwoWay}" AutomationProperties.Name="已标记事件">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" ToolTip="{Binding DetailText}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <Button x:Name="JumpButton" Content="定位" Click="OnSeekClick" Margin="0,0,6,0">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource EventActionStyle}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRecordingEvent}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button x:Name="EditButton" Content="编辑" Command="{Binding OpenEventEditorCommand}" IsEnabled="{Binding CanEditSelectedEvent}" Style="{StaticResource EventToggleStyle}" Margin="0,0,6,0" />
                            <Button x:Name="DeleteButton" Content="删除" Command="{Binding DeleteSelectedEventCommand}" IsEnabled="{Binding CanEditSelectedEvent}" Style="{StaticResource EventActionStyle}" />
                        </UniformGrid>
                        <TextBlock Text="仅人工事件支持编辑和删除" FontSize="12" Foreground="#94A3B8" Margin="0,9,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="EventEditor" Margin="0,22,0,0">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                            <MultiDataTrigger><MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEventEditorOpen}" Value="True" /><Condition Binding="{Binding CanEditSelectedEvent}" Value="True" />
                            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                        </Style.Triggers></Style></StackPanel.Style>
                        <Border BorderBrush="#E8EDF4" BorderThickness="0,1,0,0" Margin="0,0,0,12" />
                        <TextBlock Text="编辑事件" FontSize="15" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,14" />
                        <TextBlock Text="标记时间" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox x:Name="EditTimeBox" Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditEventTimeText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="从录音开始计算，格式 00:00:13.740" AutomationProperties.Name="编辑事件标记时间" />
                        <TextBlock Foreground="#64748B" FontSize="12" Margin="0,6,0,14"><Run Text="采集时间：" /><Run Text="{Binding EditEventClockText, Mode=OneWay}" /></TextBlock>
                        <Button x:Name="WaveformMoveButton" Content="波形点击改位 / 拖动事件线" Command="{Binding BeginWaveformMoveCommand}" Style="{StaticResource EventActionStyle}" Margin="0,0,0,14" />
                        <TextBlock Text="备注" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditEventNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="76" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8" Margin="0,0,0,14" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Command="{Binding CloseEventEditorCommand}" Style="{StaticResource EventActionStyle}" Margin="0,0,8,0" />
                            <Button Content="保存" Command="{Binding SaveEditedEventCommand}" Style="{StaticResource EventPrimaryStyle}" MinWidth="72" />
                        </StackPanel>
                    </StackPanel>
                    <Border BorderBrush="#E8EDF4" BorderThickness="0,1,0,0" Margin="0,24,0,20" />
                    <TextBlock Text="添加新事件" FontSize="15" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid>
                        <ComboBox x:Name="DefinitionSelector" Style="{StaticResource AppFilterComboBoxStyle}" Height="40" FontSize="13"
                                  ItemsSource="{Binding EnabledEventDefinitions}" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedEventDefinitionId, Mode=TwoWay}" AutomationProperties.Name="事件类型" ToolTip="选择事件类型">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="选择事件类型" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,30,0">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=DefinitionSelector}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="DefinitionEmptyHint" Text="暂无可用类型，请先在事件设置中启用" Foreground="#64748B" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                            <DataTrigger Binding="{Binding EnabledEventDefinitions.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <DockPanel Margin="0,16,0,6">
                        <Button Content="取当前游标" DockPanel.Dock="Right" Command="{Binding UseCurrentEventTimeCommand}"
                                Style="{StaticResource EventActionStyle}" Height="26" MinHeight="26" FontSize="11" />
                        <TextBlock Text="标记时间" Foreground="#475569" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="AddTimeBox" Style="{StaticResource AppTextBoxStyle}" Text="{Binding AddEventTimeText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="从录音开始计算，格式 00:00:13.740" AutomationProperties.Name="新增事件标记时间" />
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                    <Button x:Name="MarkButton" Content="按时间添加" Command="{Binding MarkSelectedEventCommand}" Margin="0,0,8,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource EventPrimaryStyle}"><Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedEventDefinitionId}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button x:Name="WaveformAddButton" Content="波形点击添加" Command="{Binding BeginWaveformAddCommand}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource EventActionStyle}"><Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedEventDefinitionId}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    </UniformGrid>
                    <Border Background="#EFF6FF" CornerRadius="6" Padding="9" Margin="0,8,0,0">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                            <DataTrigger Binding="{Binding IsEventPlacementActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding EventPlacementHint}" Foreground="{StaticResource BlueBrandPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            <DockPanel Margin="0,4,0,0">
                                <Button Content="取消选点" DockPanel.Dock="Right" Command="{Binding CancelEventPlacementCommand}" Style="{StaticResource EventActionStyle}" Height="26" MinHeight="26" />
                                <TextBlock Text="{Binding EventPreviewTimeText}" Foreground="{StaticResource BlueBrandPrimaryBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding EventErrorText}" Foreground="#C00000" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="#E8EDF4" BorderThickness="0,1,0,0" Padding="16,0">
                <TextBlock Text="拖动标题栏移动 · 关闭前保持显示" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
