<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.Preprocessing.PreprocessingPipelineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="科学预处理流程"
        Width="1120" Height="540" MinWidth="960" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Background="#F6F8FB">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Modules/Review/Views/Preprocessing/PreprocessingFlowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Border Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="科学预处理流程" FontSize="17.5" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="按后端计算顺序依次处理 · 点击任意步骤卡片打开独立配置窗，完成后关闭即可"
                                   FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="14" Padding="12,5" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F8FAFC" />
                                <Setter Property="BorderBrush" Value="#E5E9F0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAnyActivePreprocessing}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrepBrandSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrepBrandBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6.5" Height="6.5" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#94A3B8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnyActivePreprocessing}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource PrepBrandBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ActiveSummaryBadge}" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnyActivePreprocessing}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrepBrandHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ProgressBar VerticalAlignment="Bottom" Style="{StaticResource PrepBusyBarStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource PrepBoolToVis}}" />
        </Grid>

        <!-- Main Flowchart Area -->
        <Grid Grid.Row="1" Margin="24,22,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 5-Step Pipeline Cards -->
            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Node 01: Raw Data Input (Read-only) -->
                <Border Grid.Column="0" Height="224" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1"
                        CornerRadius="12" ClipToBounds="True" ToolTip="{Binding InputNodeDetail}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.04" Color="#0F172A" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#CBD5E1" />
                        <Grid Grid.Row="1" Margin="15,14,15,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepNumberBadgeStyle}">
                                    <TextBlock Text="01" Style="{StaticResource StepNumberTextStyle}" />
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource NodeStatusPillBorderStyle}">
                                    <TextBlock Text="只读输入" Style="{StaticResource NodeStatusPillTextStyle}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="原始数据输入" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Text="{Binding InputNodeSummary}" FontSize="12" Foreground="#64748B"
                                       TextWrapping="Wrap" LineHeight="19" />
                            <Border Grid.Row="3" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock Text="不改动原始采集文件" FontSize="11.5" Foreground="#94A3B8" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Path Grid.Column="1" Style="{StaticResource FlowArrowStyle}" />

                <!-- Node 02: Pre-rereference Bad Channels -->
                <Button Grid.Column="2" Height="224" Click="OnOpenBadChannelDialogClick"
                        Style="{StaticResource ActiveAwareFlowNodeStyle}" Tag="{Binding BadChannelNodeState}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource NodeTopBarStyle}" Tag="{Binding BadChannelNodeState}" />
                        <Grid Grid.Row="1" Margin="15,14,15,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepNumberBadgeStyle}" Tag="{Binding BadChannelNodeState}">
                                    <TextBlock Text="02" Style="{StaticResource StepNumberTextStyle}" Tag="{Binding BadChannelNodeState}" />
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource NodeStatusPillBorderStyle}" Tag="{Binding BadChannelNodeState}">
                                    <TextBlock Text="{Binding BadChannelNodeBadge}" Style="{StaticResource NodeStatusPillTextStyle}" Tag="{Binding BadChannelNodeState}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="重参考前坏导" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Text="{Binding BadChannelNodeHint}" FontSize="12" Foreground="#64748B"
                                       TextWrapping="Wrap" LineHeight="19" />
                            <Border Grid.Row="3" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="体检与配置" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrepBrandBrush}" />
                                    <Path DockPanel.Dock="Right" Data="M 0,0 L 4.5,4.5 L 0,9" Stroke="{StaticResource PrepBrandBrush}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Button>

                <Path Grid.Column="3" Style="{StaticResource FlowArrowStyle}" Tag="{Binding BadChannelNodeState}" />

                <!-- Node 03: Montage & Zero-Phase Filtering -->
                <Button Grid.Column="4" Height="224" Click="OnOpenMontageFilterDialogClick"
                        Style="{StaticResource PrepFlowNodeButtonStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource PrepBrandBorderBrush}" />
                        <Grid Grid.Row="1" Margin="15,14,15,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepNumberBadgeStyle}">
                                    <TextBlock Text="03" Style="{StaticResource StepNumberTextStyle}" />
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource NodeStatusPillBorderStyle}" Tag="active">
                                    <TextBlock Text="自动执行" Style="{StaticResource NodeStatusPillTextStyle}" Tag="active" />
                                </Border>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="导联与零相位滤波" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Text="{Binding MontageNodeSummary}" FontSize="12" Foreground="#64748B"
                                       TextWrapping="Wrap" LineHeight="19" />
                            <Border Grid.Row="3" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="查看滤波契约" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                                    <Path DockPanel.Dock="Right" Data="M 0,0 L 4.5,4.5 L 0,9" Stroke="#94A3B8"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Button>

                <Path Grid.Column="5" Style="{StaticResource FlowArrowStyle}" />

                <!-- Node 04: Artifact Segments -->
                <Button Grid.Column="6" Height="224" Click="OnOpenArtifactSegmentDialogClick"
                        Style="{StaticResource ActiveAwareFlowNodeStyle}" Tag="{Binding ArtifactNodeState}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource NodeTopBarStyle}" Tag="{Binding ArtifactNodeState}" />
                        <Grid Grid.Row="1" Margin="15,14,15,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepNumberBadgeStyle}" Tag="{Binding ArtifactNodeState}">
                                    <TextBlock Text="04" Style="{StaticResource StepNumberTextStyle}" Tag="{Binding ArtifactNodeState}" />
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource NodeStatusPillBorderStyle}" Tag="{Binding ArtifactNodeState}">
                                    <TextBlock Text="{Binding ArtifactNodeBadge}" Style="{StaticResource NodeStatusPillTextStyle}" Tag="{Binding ArtifactNodeState}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="坏段质控" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Text="{Binding ArtifactNodeHint}" FontSize="12" Foreground="#64748B"
                                       TextWrapping="Wrap" LineHeight="19" />
                            <Border Grid.Row="3" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="扫描与配置" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrepBrandBrush}" />
                                    <Path DockPanel.Dock="Right" Data="M 0,0 L 4.5,4.5 L 0,9" Stroke="{StaticResource PrepBrandBrush}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Button>

                <Path Grid.Column="7" Style="{StaticResource FlowArrowStyle}" Tag="{Binding ArtifactNodeState}" />

                <!-- Node 05: Artifact Removal (ICA / SSP / EOG) -->
                <Button Grid.Column="8" Height="224" Click="OnOpenArtifactRemovalDialogClick"
                        Style="{StaticResource ActiveAwareFlowNodeStyle}" Tag="{Binding RemovalNodeState}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource NodeTopBarStyle}" Tag="{Binding RemovalNodeState}" />
                        <Grid Grid.Row="1" Margin="15,14,15,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepNumberBadgeStyle}" Tag="{Binding RemovalNodeState}">
                                    <TextBlock Text="05" Style="{StaticResource StepNumberTextStyle}" Tag="{Binding RemovalNodeState}" />
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource NodeStatusPillBorderStyle}" Tag="{Binding RemovalNodeState}">
                                    <TextBlock Text="{Binding RemovalNodeBadge}" Style="{StaticResource NodeStatusPillTextStyle}" Tag="{Binding RemovalNodeState}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="眼电 / 心电去伪迹" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Text="{Binding RemovalNodeHint}" FontSize="12" Foreground="#64748B"
                                       TextWrapping="Wrap" LineHeight="19" />
                            <Border Grid.Row="3" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="去伪迹与审查" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrepBrandBrush}" />
                                    <Path DockPanel.Dock="Right" Data="M 0,0 L 4.5,4.5 L 0,9" Stroke="{StaticResource PrepBrandBrush}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Button>
            </Grid>

            <!-- Quiet Status & Scope Strip -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="10"
                    Padding="14,11" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PrepBrandBrush}" CornerRadius="1.5" Margin="0,1,0,1" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="Medium" Foreground="#0F172A" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse Width="5.5" Height="5.5" Fill="{StaticResource PrepAlertAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ArtifactRemovalScopeNotice}" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0">
                        <CheckBox Content="科学波形对比（浅灰科学基线 vs 深灰处理后）"
                                  IsChecked="{Binding IsOverlayCompareEnabled, Mode=TwoWay}"
                                  Style="{StaticResource PrepToggleSwitchStyle}" />
                        <TextBlock Text="{Binding OverlayStatusText}" ToolTip="{Binding OverlayStatusText}" TextWrapping="Wrap" MaxWidth="650" FontSize="11" Foreground="#64748B" Margin="48,3,0,0" />
                    </StackPanel>
                    <CheckBox Content="波形显示坏段色带"
                              IsChecked="{Binding ShowArtifactBandsOnWaveform, Mode=TwoWay}"
                              Style="{StaticResource PrepToggleSwitchStyle}" VerticalAlignment="Top" Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="重置全部" Command="{Binding ResetAllCommand}"
                            Style="{StaticResource PrepGhostButtonStyle}" Margin="0,0,10,0" />
                    <Button Content="完成并关闭" Click="OnCloseClick" IsDefault="True"
                            Style="{StaticResource PrepPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
