<Window x:Class="BrainPlatform.Desktop.Modules.Review.Views.IcaReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:topomap="clr-namespace:BrainPlatform.Desktop.Shared.Controls.Topomap"
        xmlns:prep="clr-namespace:BrainPlatform.Desktop.Modules.Review.Preprocessing"
        Title="ICA 独立成分审查（2D 头皮热力图与时间波形）"
        Width="1220" Height="740" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F8FB">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BrainPlatform.Desktop;component/Modules/Review/Views/Preprocessing/PreprocessingDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="ICA 生理伪迹成分审查" FontSize="17.5" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock x:Name="HeaderSubtitleText" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E5E9F0" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock x:Name="FingerprintText" FontFamily="Consolas" FontSize="11.5" Foreground="#475569" />
                    </Border>
                </Grid>

                <!-- Classifier status + quick filter bar -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ClassifierBanner" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E5E9F0" BorderThickness="1"
                            CornerRadius="8" Padding="12,7" VerticalAlignment="Center"
                            ToolTipService.InitialShowDelay="80" ToolTipService.ShowDuration="25000">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClassifierStatusText" Grid.Column="0" FontSize="12" Foreground="#475569"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border x:Name="ClassifierInfoBadge" Grid.Column="1" Margin="8,0,0,0"
                                    Style="{StaticResource PrepInfoBadgeStyle}">
                                <TextBlock x:Name="ClassifierInfoBadgeText" Text="!" FontSize="11" FontWeight="Bold"
                                           Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <RadioButton x:Name="FilterAllRadio" GroupName="IcaCardFilter" Content="全部成分" IsChecked="True"
                                     Checked="OnFilterChanged" Style="{StaticResource PrepPolicyOptionCardStyle}"
                                     Padding="11,6" FontSize="12" Margin="0,0,8,0" />
                        <RadioButton x:Name="FilterRecommendedRadio" GroupName="IcaCardFilter" Content="仅看建议剔除"
                                     Checked="OnFilterChanged" Style="{StaticResource PrepPolicyOptionCardStyle}"
                                     Padding="11,6" FontSize="12" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Component Cards Grid (Fixed 4 cards per row) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="17,12">
            <ItemsControl x:Name="ComponentsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6" CornerRadius="12" Padding="12" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.035" Color="#0F172A" />
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="BorderBrush" Value="#E5E9F0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrepAlertAccentBrush}" />
                                            <Setter Property="Background" Value="{StaticResource PrepAlertSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- Card Header: Checkbox + IC Title + Classification Pill -->
                                <DockPanel LastChildFill="False" Margin="0,0,0,8" ToolTip="{Binding ScoreTooltip}">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                              Content="{Binding Title}" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A"
                                              VerticalAlignment="Center" Checked="OnSelectionChanged" Unchecked="OnSelectionChanged" />
                                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,2.5" VerticalAlignment="Center"
                                            ToolTip="{Binding ScoreTooltip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBrainClassification}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrepBrandSoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RecommendedExclude}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrepAlertPillBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ScoreBadgeText}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBrainClassification}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PrepBrandHoverBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RecommendedExclude}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PrepAlertBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>

                                <!-- 2D Scalp Topomap (head centered, colorbar aligned right) -->
                                <Border Height="150" Background="#FAFBFD" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="4">
                                    <topomap:TopomapCanvas Field="{Binding Topomap}" ShowFieldTitle="False" />
                                </Border>

                                <!-- 10s Component Sparkline -->
                                <prep:IcSparklineControl Samples="{Binding PreviewWaveform}" TimesSeconds="{Binding PreviewTimesSeconds}"
                                                         DurationSeconds="{Binding PreviewDurationSeconds}" Height="44" Margin="0,0,0,8">
                                    <prep:IcSparklineControl.Style>
                                        <Style TargetType="prep:IcSparklineControl">
                                            <Setter Property="StrokeBrush" Value="{StaticResource PrepBrandBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                    <Setter Property="StrokeBrush" Value="{StaticResource PrepAlertAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </prep:IcSparklineControl.Style>
                                </prep:IcSparklineControl>

                                <!-- Card Footer: Reference / Timecourse hint + Explained Variance -->
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DetailHintText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding EvrText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F0" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="SelectionSummaryText" DockPanel.Dock="Left" FontSize="12.5" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="恢复系统推荐" Click="OnResetRecommendedClick" Style="{StaticResource PrepGhostButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="取消" Click="OnCancelClick" IsCancel="True" Style="{StaticResource PrepSecondaryButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="确认剔除选中成分" Click="OnConfirmClick" IsDefault="True" Style="{StaticResource PrepPrimaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
